+func setClientH2(c *utls.UConn, config *Config) error {
+	if len(config.Alpn) != 1 || config.Alpn[0] != "h2" || config.Fingerprint != "chrome" {
+		return errors.New("REALITY: invalid client ALPN override")
+	}
+	var alpn *utls.ALPNExtension
+	for _, extension := range c.Extensions {
+		if candidate, ok := extension.(*utls.ALPNExtension); ok {
+			if alpn != nil {
+				return errors.New("REALITY: duplicate ClientHello ALPN extension")
+			}
+			alpn = candidate
+		}
+	}
+	if alpn == nil {
+		return errors.New("REALITY: missing ClientHello ALPN extension")
+	}
+	alpn.AlpnProtocols = []string{"h2"}
+	// Raw используется как AAD REALITY. Пересобираем его до записи Session ID.
+	return c.BuildHandshakeState()
+}
+
+func checkNegotiatedH2(config *Config, protocol string, conn net.Conn) error {
+	if len(config.Alpn) == 0 || protocol == "h2" {
+		return nil
+	}
+	conn.Close()
+	return errors.New("REALITY: expected negotiated h2")
+}
