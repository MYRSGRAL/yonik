diff --git a/transport/internet/reality/yonik_alpn_test.go b/transport/internet/reality/yonik_alpn_test.go
new file mode 100644
index 0000000..de02d43
--- /dev/null
+++ b/transport/internet/reality/yonik_alpn_test.go
@@ -0,0 +1,162 @@
+package reality
+
+import (
+	"bytes"
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/ecdh"
+	"crypto/hkdf"
+	"crypto/rand"
+	"crypto/sha256"
+	"errors"
+	"net"
+	"slices"
+	"testing"
+
+	utls "github.com/refraction-networking/utls"
+	xnet "github.com/xtls/xray-core/common/net"
+	"golang.org/x/crypto/cryptobyte"
+)
+
+var errHelloCaptured = errors.New("client hello captured")
+
+type captureHello struct {
+	net.Conn
+	record []byte
+	closed bool
+}
+
+func (c *captureHello) LocalAddr() net.Addr { return &net.TCPAddr{} }
+func (c *captureHello) Write(data []byte) (int, error) {
+	c.record = bytes.Clone(data)
+	return 0, errHelloCaptured
+}
+func (c *captureHello) Close() error { c.closed = true; return nil }
+
+func TestYonikRealityClientHello(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name           string
+		override, want []string
+	}{
+		{"default", nil, []string{"h2", "http/1.1"}},
+		{"explicit", []string{"h2"}, []string{"h2"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			conn := &captureHello{}
+			shortID := []byte{1, 2, 3, 4, 5, 6, 7, 8}
+			_, err := UClient(conn, &Config{
+				Fingerprint: "chrome", ServerName: "synthetic.example", PublicKey: key.PublicKey().Bytes(),
+				ShortId: shortID, Alpn: tc.override,
+			}, context.Background(), xnet.TCPDestination(xnet.DomainAddress("synthetic.example"), 443))
+			if !errors.Is(err, errHelloCaptured) {
+				t.Fatalf("Handshake: %v", err)
+			}
+			wire := cryptobyte.String(conn.record)
+			var recordType, helloType uint8
+			var raw, body, sessionID, ignored, exts cryptobyte.String
+			var random []byte
+			if !wire.ReadUint8(&recordType) || recordType != 22 || !wire.Skip(2) ||
+				!wire.ReadUint16LengthPrefixed(&raw) || !wire.Empty() {
+				t.Fatal("invalid TLS record")
+			}
+			header := raw
+			if !raw.ReadUint8(&helloType) || helloType != 1 || !raw.ReadUint24LengthPrefixed(&body) ||
+				!raw.Empty() || !body.Skip(2) || !body.ReadBytes(&random, 32) ||
+				!body.ReadUint8LengthPrefixed(&sessionID) || len(sessionID) != 32 ||
+				!body.ReadUint16LengthPrefixed(&ignored) || !body.ReadUint8LengthPrefixed(&ignored) ||
+				!body.ReadUint16LengthPrefixed(&exts) || !body.Empty() {
+				t.Fatal("invalid ClientHello")
+			}
+			var protocols []string
+			var public []byte
+			var count int
+			for !exts.Empty() {
+				var typ uint16
+				var extension, list, value cryptobyte.String
+				if !exts.ReadUint16(&typ) || !exts.ReadUint16LengthPrefixed(&extension) {
+					t.Fatal("invalid ClientHello extension")
+				}
+				switch typ {
+				case 16:
+					count++
+					if !extension.ReadUint16LengthPrefixed(&list) || !extension.Empty() {
+						t.Fatal("invalid ALPN extension")
+					}
+					for !list.Empty() {
+						if !list.ReadUint8LengthPrefixed(&value) {
+							t.Fatal("invalid protocol")
+						}
+						protocols = append(protocols, string(value))
+					}
+				case 51:
+					if !extension.ReadUint16LengthPrefixed(&list) || !extension.Empty() {
+						t.Fatal("invalid key shares")
+					}
+					for !list.Empty() {
+						var group uint16
+						if !list.ReadUint16(&group) || !list.ReadUint16LengthPrefixed(&value) {
+							t.Fatal("invalid key share")
+						}
+						if group == uint16(utls.X25519) {
+							public = value
+						}
+					}
+				}
+			}
+			if count != 1 || !slices.Equal(protocols, tc.want) {
+				t.Fatalf("ALPN count=%d protocols=%q, want %q", count, protocols, tc.want)
+			}
+			peer, err := ecdh.X25519().NewPublicKey(public)
+			if err != nil {
+				t.Fatal(err)
+			}
+			shared, err := key.ECDH(peer)
+			if err != nil {
+				t.Fatal(err)
+			}
+			authKey, err := hkdf.Key(sha256.New, shared, random[:20], "REALITY", 32)
+			if err != nil {
+				t.Fatal(err)
+			}
+			block, err := aes.NewCipher(authKey)
+			if err != nil {
+				t.Fatal(err)
+			}
+			aead, err := cipher.NewGCM(block)
+			if err != nil {
+				t.Fatal(err)
+			}
+			aad := bytes.Clone(header)
+			clear(aad[39:71])
+			plain, err := aead.Open(nil, random[20:], sessionID, aad)
+			if err != nil || len(plain) != 16 || !bytes.Equal(plain[8:], shortID) {
+				t.Fatalf("wire ClientHello did not authenticate: %v", err)
+			}
+		})
+	}
+}
+
+func TestYonikRealityNegotiatedH2(t *testing.T) {
+	for _, tc := range []struct {
+		alpn     []string
+		protocol string
+		reject   bool
+	}{
+		{nil, "", false},
+		{nil, "http/1.1", false},
+		{[]string{"h2"}, "h2", false},
+		{[]string{"h2"}, "", true},
+		{[]string{"h2"}, "http/1.1", true},
+	} {
+		conn := &captureHello{}
+		err := checkNegotiatedH2(&Config{Alpn: tc.alpn}, tc.protocol, conn)
+		if (err != nil) != tc.reject || conn.closed != tc.reject {
+			t.Fatalf("ALPN %v negotiated %q: err=%v closed=%v", tc.alpn, tc.protocol, err, conn.closed)
+		}
+	}
+}
