@@ -0,0 +1,57 @@
+package conf
+
+import (
+	"encoding/json"
+	"github.com/xtls/xray-core/transport/internet/reality"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestYonikRealityALPNConfig(t *testing.T) {
+	for _, tc := range []struct {
+		name, network, fields string
+		ok                    bool
+	}{
+		{"default", "grpc", "", true},
+		{"grpc", "grpc", `,"alpn":["h2"]`, true},
+		{"xhttp", "xhttp", `,"alpn":["h2"]`, true},
+		{"raw", "tcp", `,"alpn":["h2"]`, false},
+		{"empty", "grpc", `,"alpn":[]`, false},
+		{"null", "grpc", `,"alpn":null`, false},
+		{"other fingerprint", "grpc", `,"alpn":["h2"]`, false},
+		{"scalar", "grpc", `,"alpn":"h2"`, false},
+		{"two", "grpc", `,"alpn":["h2","http/1.1"]`, false},
+		{"other", "grpc", `,"alpn":["http/1.1"]`, false},
+		{"server", "grpc", `,"alpn":["h2"],"target":"localhost:443"`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			config := &StreamConfig{}
+			raw := `{"security":"reality","network":"` + tc.network + `","realitySettings":{"fingerprint":"chrome","password":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"` + tc.fields + `}}`
+			if tc.name == "other fingerprint" {
+				raw = strings.Replace(raw, `"chrome"`, `"firefox"`, 1)
+			}
+			err := json.Unmarshal([]byte(raw), config)
+			if err == nil {
+				stream, buildErr := config.Build()
+				err = buildErr
+				if err == nil && tc.ok {
+					settings, decodeErr := stream.SecuritySettings[0].GetInstance()
+					if decodeErr != nil {
+						t.Fatal(decodeErr)
+					}
+					var want []string
+					if tc.fields != "" {
+						want = []string{"h2"}
+					}
+					if !slices.Equal(settings.(*reality.Config).Alpn, want) {
+						t.Fatalf("protobuf ALPN = %v, want %v", settings.(*reality.Config).Alpn, want)
+					}
+				}
+			}
+			if (err == nil) != tc.ok {
+				t.Fatalf("Build: %v, want success %v", err, tc.ok)
+			}
+		})
+	}
+}
