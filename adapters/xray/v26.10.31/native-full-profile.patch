+func TestYonikR9MuxFactoryProcessStopAndEarlyEOFDoNotSelfWait(t *testing.T) {
+	for _, early := range []bool{false, true} {
+		entered := make(chan struct{})
+		canceled, releaseProcess := make(chan struct{}), make(chan struct{})
+		var processCalls, processExited atomic.Int32
+		factory := &DialingWorkerFactory{profileContext: context.Background(), Proxy: r9MuxProxy{process: func(ctx context.Context, _ *transport.Link, _ internet.Dialer) error {
+			processCalls.Add(1)
+			close(entered)
+			defer processExited.Add(1)
+			<-ctx.Done()
+			close(canceled)
+			<-releaseProcess
+			return ctx.Err()
+		}}}
+		var tasks []func()
+		retired := make(chan error, 1)
+		worker, e := factory.createWorker(func(e error) { retired <- e }, func(task func()) { tasks = append(tasks, task) })
+		if e != nil {
+			t.Fatal(e)
+		}
+		if len(tasks) != 3 || worker.managed == nil {
+			t.Fatal("factory lifecycle не установлен до goroutines")
+		}
+		if early {
+			worker.requestClose()
+			tasks[2]()
+		} else {
+			go tasks[2]()
+			<-entered
+		}
+		result := make(chan error, 1)
+		go func() { result <- worker.Close() }()
+		<-worker.done.Wait()
+		go tasks[0]()
+		monitorDone := make(chan struct{})
+		go func() { tasks[1](); close(monitorDone) }()
+		if !early {
+			<-canceled
+			select {
+			case <-result:
+				t.Fatal("Close не дождался actual process exit")
+			default:
+			}
+			select {
+			case <-retired:
+				t.Fatal("retirement до actual process exit")
+			default:
+			}
+			close(releaseProcess)
+		}
+		<-monitorDone
+		if e = <-result; e != nil {
+			t.Fatal(e)
+		}
+		if e = <-retired; e != nil {
+			t.Fatal(e)
+		}
+		want := int32(1)
+		if early {
+			want = 0
+		}
+		if processCalls.Load() != want || processExited.Load() != want {
+			t.Fatal("process стартовал после stop или cleanup не дождался process")
+		}
+	}
+}
