+	"errors"
+	"net/netip"
+	"sync"
+	"time"
+)
+
+var errProfileFlowBusy = errors.New("full-profile control budget exhausted")
+
+type profileDestinationValue struct {
+	address         string
+	port            uint16
+	family, network byte
+}
+
+func (d profileDestinationValue) valid() bool {
+	if d.port == 0 || d.network != 6 && d.network != 17 {
+		return false
+	}
+	if d.family == 3 {
+		return profileDomain([]byte(d.address))
+	}
+	a, e := netip.ParseAddr(d.address)
+	return e == nil && a.Zone() == "" && !a.Is4In6() && !a.IsUnspecified() && !a.IsMulticast() && (d.family == 4 && a.Is4() || d.family == 6 && a.Is6())
+}
+func (d profileDestinationValue) encode() []byte {
+	if !d.valid() {
+		return nil
+	}
+	var address []byte
+	if d.family == 3 {
+		address = []byte(d.address)
+	} else {
+		a, e := netip.ParseAddr(d.address)
+		if e != nil {
+			return nil
+		}
+		address = a.AsSlice()
+	}
+	b := make([]byte, 8+len(address))
+	b[0] = d.family
+	b[1] = d.network
+	be.PutUint16(b[2:], d.port)
+	be.PutUint16(b[4:], uint16(len(address)))
+	copy(b[8:], address)
+	c := profileCursor{b: b}
+	profileDestination(&c)
+	if !c.done() {
+		return nil
+	}
+	return b
+}
+
+type profileReceiptKey struct{}
+type profileGrantKey struct{}
+type profileRouteKey struct{}
+type profileAcceptedKey struct{}
+
+func profileTupleValid(t [40]byte) bool {
+	if t[0] != 6 && t[0] != 17 || !zero(t[2:4]) || u16(t[:], 4) == 0 || u16(t[:], 6) == 0 {
+		return false
+	}
+	if t[1] == 4 {
+		return zero(t[12:24]) && zero(t[28:40]) && profileIP(t[8:12]) && profileIP(t[24:28])
+	}
+	return t[1] == 6 && profileIP(t[8:24]) && profileIP(t[24:40])
+}
+
+type profileReceipt struct {
+	control             *profileFlowControl
+	ctx                 context.Context
+	cancel              context.CancelFunc
+	association         *profileAccepted
+	original            profileDestinationValue
+	tuple               [40]byte
+	id, revision        uint64
+	slot, index         uint16
+	provenance          byte
+	closed, cancelSent  bool
+	pending, grantCount int
+	openOperation       *profileOperation
+}
+type profileGrant struct {
+	receipt                             *profileReceipt
+	ctx                                 context.Context
+	cancel                              context.CancelFunc
+	effective                           profileDestinationValue
+	deadline, ownerDeadline             time.Time
+	id, revision, ownerID               uint64
+	subject, scope, stream, chain, slot uint16
+	branch, ownerKind                   byte
+	closed, cancelSent                  bool
+	pending                             int
+	refresh                             *profileOperation
+}
+type profileOperation struct {
+	ctx                                     context.Context
+	receipt                                 *profileReceipt
+	grant                                   *profileGrant
+	done                                    chan struct{}
+	err                                     error
+	body                                    []byte
+	sent, deadline                          time.Time
+	sessionDeadline                         time.Time
+	sequence, object                        uint64
+	kind                                    uint16
+	cancelled, completed, submitted, queued bool
+}
+type profileTombstone struct {
+	sequence, cancelSequence, objectCancelSequence, objectID uint64
+	deadline                                                 time.Time
+	kind                                                     uint16
+	targetKind                                               byte
+	replied, cancelled                                       bool
+}
+type profileFlowControl struct {
+	mu                                             sync.Mutex
+	manifest                                       profileCapsule
+	mode                                           byte
+	clock                                          func() time.Time
+	write                                          func(uint16, uint64, []byte) (uint64, error)
+	reply                                          func(uint16, uint64, []byte) error
+	alive                                          func() bool
+	receipts                                       [4096]*profileReceipt
+	accepted                                       [4096]*profileAccepted
+	grants                                         [4096]*profileGrant
+	pending                                        [64]*profileOperation
+	tombs                                          [256]profileTombstone
+	watermark, lastSent, highestFlow, highestGrant uint64
+	buffered                                       uint64
+	operations                                     int
+	revoked                                        bool
+	sessionDeadline                                time.Time
+}
+
+func newProfileFlowControl(m profileCapsule, mode byte, clock func() time.Time, write func(uint16, uint64, []byte) (uint64, error), alive func() bool) *profileFlowControl {
+	return &profileFlowControl{manifest: m, mode: mode, clock: clock, write: write, alive: alive, sessionDeadline: clock().Add(time.Duration(m.lease) * time.Millisecond)}
+}
+func (c *profileFlowControl) live() bool {
+	return !c.revoked && c.alive != nil && c.alive() && c.clock().Before(c.sessionDeadline)
+}
+func (c *profileFlowControl) receiptLive(r *profileReceipt) bool {
+	return c.live() && r != nil && r.control == c && !r.closed && r.ctx.Err() == nil && c.receipts[r.slot] == r
+}
+func (c *profileFlowControl) grantLive(g *profileGrant) bool {
+	return g != nil && c.receiptLive(g.receipt) && !g.closed && g.ctx.Err() == nil && c.grants[g.slot] == g && c.clock().Before(g.deadline)
+}
+func (c *profileFlowControl) operation(ctx context.Context, r *profileReceipt, g *profileGrant, kind uint16, object uint64, body []byte) (*profileOperation, error) {
+	if ctx == nil || ctx.Err() != nil || len(body) > 1024 || !c.live() || !c.operationAvailable() {
+		return nil, errProfile
+	}
+	c.operations++
+	r.pending++
+	if g != nil {
+		g.pending++
+	}
+	return &profileOperation{ctx: ctx, receipt: r, grant: g, kind: kind, object: object, body: body, done: make(chan struct{})}, nil
+}
+func (c *profileFlowControl) operationAvailable() bool {
+	if c.operations >= int(c.manifest.caps[3]) || c.operations >= 64 {
+		return false
+	}
+	// Pending и будущий tombstone резервируются одновременно, до enqueue.
+	reserved := c.operations
+	for _, t := range c.tombs {
+		if t.sequence != 0 {
+			reserved++
+		}
+	}
+	if reserved >= int(c.manifest.caps[7]) || reserved >= 256 {
+		return false
+	}
+	return true
+}
+func (c *profileFlowControl) open(ctx context.Context, index uint16, provenance byte, tuple [40]byte, original profileDestinationValue, association *profileAccepted) (*profileReceipt, *profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.live() || ctx == nil || ctx.Err() != nil || int(index) >= len(c.manifest.rows[6]) || original.address == "v1.mux.cool" || original.network != tuple[0] || !original.valid() || !profileTupleValid(tuple) {
+		return nil, nil, errProfile
+	}
+	row := c.manifest.rows[6][index]
+	mask := byte(1)
+	if tuple[0] == 17 {
+		mask = 2
+	} else if tuple[0] != 6 {
+		return nil, nil, errProfile
+	}
+	if row[1]&mask == 0 || provenance == 1 && (c.mode != 2 || row[0] != 1) || provenance == 2 && (tuple[0] != 6 || row[0] != 2 && row[0] != 3) || provenance == 3 && (tuple[0] != 17 || row[0] != 2) || provenance < 1 || provenance > 3 {
+		return nil, nil, errProfile
+	}
+	if provenance == 3 && association == nil {
+		return nil, nil, errProfile
+	}
+	var slot = -1
+	for i, r := range c.receipts {
+		if r == nil && slot < 0 && i < int(c.manifest.caps[6]) {
+			slot = i
+		}
+		if provenance == 3 && r != nil && r.association == association && r.original == original && r.tuple == tuple {
+			if !c.receiptLive(r) {
+				return nil, nil, errProfile
+			}
+			if r.id != 0 {
+				return r, nil, nil
+			}
+			if r.openOperation != nil {
+				return r, r.openOperation, nil
+			}
+			return nil, nil, errProfile
+		}
+	}
+	if slot < 0 || !c.operationAvailable() {
+		return nil, nil, errProfile
+	}
+	// Immutable strings/buffer capacity включены в общий session budget.
+	extra := uint64((len(original.address) + 15) &^ 15)
+	if c.buffered+extra+c.manifest.memoryCredit > uint64(c.manifest.caps[4]) {
+		return nil, nil, errProfile
+	}
+	child, cancel := context.WithCancel(ctx)
+	r := &profileReceipt{control: c, ctx: child, cancel: cancel, association: association, original: original, tuple: tuple, index: index, provenance: provenance, slot: uint16(slot)}
+	body := make([]byte, 44)
+	be.PutUint16(body, index)
+	body[2] = provenance
+	copy(body[4:], tuple[:])
+	body = append(body, original.encode()...)
+	op, e := c.operation(child, r, nil, 16, 0, body)
+	if e != nil {
+		cancel()
+		return nil, nil, e
+	}
+	c.receipts[slot] = r
+	r.openOperation = op
+	c.buffered += extra
+	return r, op, nil
+}
+func (c *profileFlowControl) authorize(ctx context.Context, r *profileReceipt, scope uint16, branch byte, effective profileDestinationValue, refresh *profileGrant) (*profileGrant, *profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.authorizeLocked(ctx, r, scope, branch, effective, refresh)
+}
+func (c *profileFlowControl) authorizeLocked(ctx context.Context, r *profileReceipt, scope uint16, branch byte, effective profileDestinationValue, refresh *profileGrant) (*profileGrant, *profileOperation, error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, nil, errProfile
+	}
+	if !c.receiptLive(r) || r.id == 0 || !c.operationAvailable() || int(scope) >= len(c.manifest.rows[8]) || branch > 1 || !effective.valid() {
+		return nil, nil, errProfile
+	}
+	s := c.manifest.rows[8][scope]
+	if s[3]&(1<<branch) == 0 || s[2] != effective.network {
+		return nil, nil, errProfile
+	}
+	if s[20+int(branch)] == 3 && effective.family == 3 {
+		return nil, nil, errProfile
+	}
+	subject, stream, chain := u16(s, 0), u16(s, 12+int(branch)*2), u16(s, 16+int(branch)*2)
+	var g *profileGrant
+	var object uint64
+	if refresh != nil {
+		if !c.grantLive(refresh) || refresh.receipt != r || refresh.scope != scope || refresh.branch != branch || refresh.effective != effective {
+			return nil, nil, errProfile
+		}
+		if refresh.refresh != nil {
+			return refresh, refresh.refresh, nil
+		}
+		g = refresh
+		object = g.id
+	} else {
+		slot := -1
+		for i, item := range c.grants {
+			if item == nil && i < int(c.manifest.caps[0]) {
+				slot = i
+				break
+			}
+		}
+		extra := uint64((len(effective.address) + 15) &^ 15)
+		if slot < 0 || c.buffered+extra+c.manifest.memoryCredit > uint64(c.manifest.caps[4]) {
+			return nil, nil, errProfile
+		}
+		child, cancel := context.WithCancel(ctx)
+		g = &profileGrant{receipt: r, ctx: child, cancel: cancel, effective: effective, slot: uint16(slot), subject: subject, scope: scope, stream: stream, chain: chain, branch: branch}
+		c.grants[slot] = g
+		r.grantCount++
+		c.buffered += extra
+	}
+	b := make([]byte, 20)
+	be.PutUint64(b, r.id)
+	b[8] = 1
+	be.PutUint16(b[10:], subject)
+	be.PutUint16(b[12:], chain)
+	be.PutUint16(b[14:], stream)
+	be.PutUint16(b[16:], scope)
+	b[18] = branch
+	b = append(b, r.original.encode()...)
+	b = append(b, effective.encode()...)
+	// resolverIndex=None, empty queryName, OwnerReceiptKind=None/id=0:
+	// issuer выполняет fresh lookup; credential/session не подставляются как proof.
+	b = append(b, 255, 255, 0, 0)
+	b = append(b, make([]byte, 16)...)
+	op, e := c.operation(ctx, r, g, 18, object, b)
+	if e != nil && refresh == nil {
+		c.closeGrant(g)
+	}
+	if e == nil && refresh != nil {
+		g.refresh = op
+	}
+	return g, op, e
+}
+func (c *profileFlowControl) closeGrant(g *profileGrant) {
+	if g != nil && !g.closed {
+		g.closed = true
+		g.cancel()
+	}
+}
+func (c *profileFlowControl) closeReceipt(r *profileReceipt) {
+	if r != nil && !r.closed {
+		r.closed = true
+		r.cancel()
+	}
+}
+func (c *profileFlowControl) finish(op *profileOperation, e error) {
+	if op.completed {
+		return
+	}
+	op.completed = true
+	if op.receipt.openOperation == op {
+		op.receipt.openOperation = nil
+	}
+	c.operations--
+	op.receipt.pending--
+	if op.grant != nil {
+		op.grant.pending--
+		if op.grant.refresh == op {
+			op.grant.refresh = nil
+		}
+	}
+	op.err = e
+	close(op.done)
+}
+func (c *profileFlowControl) abort(op *profileOperation) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	op.cancelled = true
+	if op.kind == 16 {
+		c.closeReceipt(op.receipt)
+	} else {
+		c.closeGrant(op.grant)
+	}
+}
+func (c *profileFlowControl) cancelWire(kind byte, id uint64) (uint64, error) {
+	body := make([]byte, 12)
+	body[0] = kind
+	be.PutUint64(body[4:], id)
+	seq, e := c.write(32, 0, body)
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	return seq, e
+}
+func (c *profileFlowControl) cancel(kind byte, id uint64) (uint64, error) {
+	if kind == 1 {
+		return c.cancelWire(kind, id)
+	}
+	reserved := c.operations
+	for _, t := range c.tombs {
+		if t.sequence != 0 {
+			reserved++
+		}
+	}
+	if reserved >= int(c.manifest.caps[7]) || reserved >= 256 {
+		return 0, errProfileFlowBusy
+	}
+	for i, t := range c.tombs {
+		if t.sequence == 0 {
+			seq, e := c.cancelWire(kind, id)
+			if e != nil {
+				return seq, e
+			}
+			c.tombs[i] = profileTombstone{sequence: seq, kind: 32, targetKind: kind, objectID: id, deadline: c.clock().Add(time.Second)}
+			return seq, nil
+		}
+	}
+	return 0, errProfileFlowBusy
+}
+func (c *profileFlowControl) tomb(op *profileOperation, cancelled bool) error {
+	for i, t := range c.tombs {
+		if t.sequence == 0 {
+			entry := profileTombstone{sequence: op.sequence, deadline: op.deadline.Add(time.Second), kind: op.kind, replied: !cancelled, cancelled: cancelled}
+			if cancelled {
+				seq, e := c.cancel(1, op.sequence)
+				if e != nil {
+					return e
+				}
+				entry.cancelSequence = seq
+			}
+			c.tombs[i] = entry
+			return nil
+		}
+	}
+	return errProfile
+}
+func (c *profileFlowControl) dispatch(op *profileOperation) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.dispatchLocked(op)
+}
+func (c *profileFlowControl) dispatchLocked(op *profileOperation) error {
+	if op.completed {
+		return nil
+	}
+	if op.submitted {
+		return nil
+	}
+	if !c.live() || op.cancelled || op.ctx.Err() != nil || !c.receiptLive(op.receipt) {
+		if op.kind == 16 {
+			c.closeReceipt(op.receipt)
+		} else {
+			c.closeGrant(op.grant)
+		}
+		c.finish(op, errProfile)
+		return nil
+	}
+	slot := -1
+	for i, p := range c.pending {
+		if p == nil {
+			slot = i
+			break
+		}
+	}
+	if slot < 0 {
+		return errProfile
+	}
+	op.sent = c.clock()
+	op.sessionDeadline = c.sessionDeadline
+	op.deadline = op.sent.Add(time.Second)
+	if op.kind == 18 && c.mode == 2 {
+		op.deadline = op.sent.Add(20 * time.Millisecond)
+	}
+	if deadline, ok := op.ctx.Deadline(); ok && deadline.Before(op.deadline) {
+		op.deadline = deadline
+	}
+	seq, e := c.write(op.kind, op.object, op.body)
+	if e != nil {
+		c.finish(op, e)
+		return e
+	}
+	op.sequence = seq
+	op.submitted = true
+	c.pending[slot] = op
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	return nil
+}
+func (c *profileFlowControl) accept(f profilePacket) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.live() {
+		return errProfile
+	}
+	if f.kind == 32 {
+		b := f.body
+		if f.reply != 0 || f.object != 0 || len(b) != 12 || !zero(b[2:4]) || b[0] < 2 || b[0] > 4 || u64(b, 4) == 0 && b[0] != 4 || b[0] == 4 && u64(b, 4) != 0 {
+			return errProfile
+		}
+		id := u64(b, 4)
+		if b[0] == 2 {
+			for _, r := range c.receipts {
+				if r != nil && r.id == id {
+					c.closeReceipt(r)
+				}
+			}
+		} else if b[0] == 3 {
+			for _, g := range c.grants {
+				if g != nil && g.id == id {
+					c.closeGrant(g)
+				}
+			}
+		} else {
+			c.revoked = true
+			for _, r := range c.receipts {
+				c.closeReceipt(r)
+			}
+		}
+		ack := make([]byte, 12)
+		ack[0] = b[0]
+		ack[1] = 3
+		be.PutUint64(ack[4:], id)
+		if c.reply == nil || c.reply(34, f.sequence, ack) != nil {
+			return errProfile
+		}
+		if b[0] == 4 {
+			return errProfile
+		}
+		return nil
+	}
+	for i, op := range c.pending {
+		if op == nil || op.sequence != f.reply {
+			continue
+		}
+		expected := uint16(19)
+		if op.kind == 16 {
+			expected = 17
+		}
+		if f.kind != expected {
+			return errProfile
+		}
+		c.pending[i] = nil
+		cancelled := op.cancelled || op.ctx.Err() != nil || !c.receiptLive(op.receipt) || !c.clock().Before(op.deadline)
+		if cancelled {
+			if op.kind == 16 {
+				c.closeReceipt(op.receipt)
+			} else {
+				c.closeGrant(op.grant)
+			}
+			if e := c.tomb(op, true); e != nil {
+				return e
+			}
+			c.finish(op, errProfile)
+			return c.discardLate(f, op.kind)
+		}
+		e := c.publish(op, f)
+		if e != nil {
+			if op.kind == 16 {
+				c.closeReceipt(op.receipt)
+			} else {
+				c.closeGrant(op.grant)
+			}
+		}
+		if te := c.tomb(op, false); te != nil {
+			return te
+		}
+		c.finish(op, e)
+		return nil
+	}
+	for i, t := range c.tombs {
+		if t.sequence == f.reply {
+			if t.kind == 32 {
+				if t.replied {
+					return errProfile
+				}
+				if !profileCloseACK(f, t.targetKind, t.objectID) {
+					return errProfile
+				}
+				c.tombs[i].replied = true
+				return nil
+			}
+			if !t.cancelled || t.replied {
+				return errProfile
+			}
+			if e := c.discardLate(f, t.kind); e != nil {
+				return e
+			}
+			c.tombs[i].replied = true
+			return nil
+		}
+		if t.cancelSequence != 0 && t.cancelSequence == f.reply {
+			if !profileCloseACK(f, 1, t.sequence) {
+				return errProfile
+			}
+			c.tombs[i].cancelSequence = 0
+			return nil
+		}
+		if t.objectCancelSequence != 0 && t.objectCancelSequence == f.reply {
+			if !profileCloseACK(f, t.targetKind, t.objectID) {
+				return errProfile
+			}
+			c.tombs[i].objectCancelSequence = 0
+			return nil
+		}
+	}
+	if f.reply != 0 && f.reply <= c.watermark {
+		return nil
+	}
+	return errProfile
+}
+func (c *profileFlowControl) discardLate(f profilePacket, kind uint16) error {
+	var target byte
+	if kind == 18 {
+		if f.kind != 19 || len(f.body) != 56 {
+			return errProfile
+		}
+		target = 3
+		if f.body[0] == 1 && (u64(f.body, 4) == 0 || f.object != u64(f.body, 4)) {
+			return errProfile
+		}
+	}
+	if kind == 16 {
+		if f.kind != 17 || len(f.body) != 24 || f.object != 0 {
+			return errProfile
+		}
+		target = 2
+		if f.body[0] == 1 && u64(f.body, 4) == 0 {
+			return errProfile
+		}
+	}
+	if target != 0 {
+		if f.body[0] == 2 || f.body[0] == 3 {
+			return nil
+		}
+		if f.body[0] != 1 {
+			return errProfile
+		}
+		id := u64(f.body, 4)
+		seq, e := c.cancelWire(target, id)
+		if e != nil {
+			return e
+		}
+		for i, t := range c.tombs {
+			if t.sequence == f.reply {
+				c.tombs[i].objectCancelSequence = seq
+				c.tombs[i].targetKind = target
+				c.tombs[i].objectID = id
+				c.tombs[i].replied = true
+				return nil
+			}
+		}
+		return errProfile
+	}
+	return errProfile
+}
+func profileCloseACK(f profilePacket, kind byte, id uint64) bool {
+	return f.kind == 34 && f.object == 0 && len(f.body) == 12 && f.body[0] == kind && (f.body[1] == 1 || f.body[1] == 3) && zero(f.body[2:4]) && u64(f.body, 4) == id
+}
+func (c *profileFlowControl) publish(op *profileOperation, f profilePacket) error {
+	if op.kind == 16 {
+		b := f.body
+		if f.kind != 17 || f.object != 0 || len(b) != 24 || b[0] != 1 || b[1] != c.mode-1 || !zero(b[2:4]) || u64(b, 4) == 0 || u64(b, 4) <= c.highestFlow || u32(b, 12) != 0 || u64(b, 16) == 0 {
+			return errProfile
+		}
+		op.receipt.id = u64(b, 4)
+		op.receipt.revision = u64(b, 16)
+		c.highestFlow = op.receipt.id
+		return nil
+	}
+	b := f.body
+	g := op.grant
+	if f.kind != 19 || len(b) != 56 || b[0] != 1 || b[1] != 1 || b[2] != c.mode-1 || b[3] != 0 || u64(b, 4) == 0 || f.object != u64(b, 4) || u64(b, 12) != op.receipt.id || u32(b, 20) == 0 || u32(b, 20) > 1000 || u64(b, 24) != op.receipt.revision || !zero(b[41:48]) {
+		return errProfile
+	}
+	id := u64(b, 4)
+	if op.object == 0 {
+		if id <= c.highestGrant {
+			return errProfile
+		}
+	} else if id != op.object || g.id != id || !c.grantLive(g) {
+		return errProfile
+	}
+	ownerNS, ownerKind, ownerID := u64(b, 32), b[40], u64(b, 48)
+	if c.mode == 1 {
+		if ownerNS != 0 || ownerKind != 0 || ownerID != 0 {
+			return errProfile
+		}
+	} else if ownerNS == 0 || ownerNS > uint64(20*time.Millisecond) || ownerKind < 1 || ownerKind > 2 || ownerID == 0 {
+		return errProfile
+	}
+	deadline := op.sent.Add(time.Duration(u32(b, 20)) * time.Millisecond)
+	if op.sessionDeadline.Before(deadline) {
+		deadline = op.sessionDeadline
+	}
+	ownerDeadline := op.sent.Add(time.Duration(ownerNS))
+	if op.object != 0 && ownerKind == g.ownerKind && ownerID == g.ownerID && g.ownerDeadline.Before(ownerDeadline) {
+		ownerDeadline = g.ownerDeadline
+	}
+	if !c.clock().Before(deadline) || c.mode == 2 && !c.clock().Before(ownerDeadline) {
+		return errProfile
+	}
+	g.id = id
+	g.deadline = deadline
+	g.ownerDeadline = ownerDeadline
+	g.ownerKind = ownerKind
+	g.ownerID = ownerID
+	g.revision = u64(b, 24)
+	if id > c.highestGrant {
+		c.highestGrant = id
+	}
+	return nil
+}
+func (c *profileFlowControl) tick() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.clock()
+	for i, t := range c.tombs {
+		if t.sequence != 0 && !now.Before(t.deadline) {
+			c.tombs[i] = profileTombstone{}
+		}
+	}
+	for i, a := range c.accepted {
+		if a != nil && a.ctx.Err() != nil {
+			c.accepted[i] = nil
+		}
+	}
+	for i, op := range c.pending {
+		if op != nil && (op.cancelled || op.ctx.Err() != nil || !c.receiptLive(op.receipt) || !now.Before(op.deadline)) {
+			if op.kind == 16 {
+				c.closeReceipt(op.receipt)
+			} else {
+				c.closeGrant(op.grant)
+			}
+			if e := c.tomb(op, true); e != nil {
+				return e
+			}
+			c.pending[i] = nil
+			c.finish(op, errProfile)
+		}
+	}
+	for i, g := range c.grants {
+		if g == nil {
+			continue
+		}
+		if g.ctx.Err() != nil || !g.deadline.IsZero() && !now.Before(g.deadline) {
+			c.closeGrant(g)
+		}
+		if !g.closed && g.id != 0 && g.refresh == nil && c.receiptLive(g.receipt) && g.deadline.Sub(now) <= 250*time.Millisecond {
+			_, op, e := c.authorizeLocked(g.ctx, g.receipt, g.scope, g.branch, g.effective, g)
+			if e == nil {
+				op.queued = true
+				if e = c.dispatchLocked(op); e != nil {
+					return e
+				}
+			}
+		}
+		if g.closed {
+			if g.id != 0 && !g.cancelSent {
+				if _, e := c.cancel(3, g.id); e != nil {
+					if e == errProfileFlowBusy {
+						break
+					}
+					return e
+				}
+				g.cancelSent = true
+			}
+			if g.pending == 0 {
+				c.buffered -= uint64((len(g.effective.address) + 15) &^ 15)
+				g.receipt.grantCount--
+				c.grants[i] = nil
+			}
+		}
+	}
+	for i, r := range c.receipts {
+		if r == nil {
+			continue
+		}
+		if r.ctx.Err() != nil {
+			c.closeReceipt(r)
+		}
+		if r.closed {
+			if r.id != 0 && !r.cancelSent {
+				if _, e := c.cancel(2, r.id); e != nil {
+					if e == errProfileFlowBusy {
+						break
+					}
+					return e
+				}
+				r.cancelSent = true
+			}
+			if r.pending == 0 && r.grantCount == 0 && (r.provenance != 3 || r.association == nil || r.association.ctx.Err() != nil) {
+				c.buffered -= uint64((len(r.original.address) + 15) &^ 15)
+				c.receipts[i] = nil
+			}
+		}
+	}
+	floor := c.lastSent + 1
+	for _, op := range c.pending {
+		if op != nil && op.sequence < floor {
+			floor = op.sequence
+		}
+	}
+	for _, t := range c.tombs {
+		if t.sequence == 0 {
+			continue
+		}
+		ready := (t.replied || t.cancelled && t.cancelSequence == 0) && t.cancelSequence == 0 && t.objectCancelSequence == 0
+		if !ready && t.sequence < floor {
+			floor = t.sequence
+		}
+	}
+	if floor > 0 && floor-1 > c.watermark {
+		c.watermark = floor - 1
+	}
+	for i, t := range c.tombs {
+		if t.sequence != 0 && t.sequence <= c.watermark {
+			c.tombs[i] = profileTombstone{}
+		}
+	}
+	return nil
+}
+func (c *profileFlowControl) revoke() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.revoked = true
+	for _, r := range c.receipts {
+		c.closeReceipt(r)
+	}
+	for i, op := range c.pending {
+		if op != nil {
+			c.finish(op, errProfile)
+			c.pending[i] = nil
+		}
+	}
+}
