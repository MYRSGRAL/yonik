+package socks
+
+import (
+	"bytes"
+	"errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	hooks "github.com/xtls/xray-core/common/yonikbroker"
+	"io"
+	gonet "net"
+	"testing"
+	"time"
+)
+
+type profileHandshakeConn struct{ bytes.Buffer }
+
+func (*profileHandshakeConn) Read([]byte) (int, error) { return 0, io.EOF }
+func (*profileHandshakeConn) Close() error             { return nil }
+func (*profileHandshakeConn) LocalAddr() gonet.Addr {
+	return &gonet.TCPAddr{IP: gonet.IPv4(127, 0, 0, 1), Port: 1080}
+}
+func (*profileHandshakeConn) RemoteAddr() gonet.Addr {
+	return &gonet.TCPAddr{IP: gonet.IPv4(192, 0, 2, 1), Port: 32001}
+}
+func (*profileHandshakeConn) SetDeadline(time.Time) error      { return nil }
+func (*profileHandshakeConn) SetReadDeadline(time.Time) error  { return nil }
+func (*profileHandshakeConn) SetWriteDeadline(time.Time) error { return nil }
+
+func TestYonikUDPv2SOCKSControlCannotBecomeChildListener(t *testing.T) {
+	for _, ack := range []error{nil, hooks.ErrProfileUnsupported} {
+		s := &ServerSession{config: &ServerConfig{UdpEnabled: true}, address: net.LocalHostIP, port: 1080}
+		conn := &profileHandshakeConn{}
+		calls := 0
+		request, e := profileHandshakeBeforeUDPFactory(s, bytes.NewReader([]byte{5, 1, 0, 5, 3, 0}), conn, func() error { calls++; return ack })
+		if request != nil || !errors.Is(e, hooks.ErrProfileUnsupported) || calls != 1 {
+			t.Fatal("control ACK created authority", e, calls)
+		}
+		response := conn.Bytes()
+		if len(response) != 12 || response[3] != statusCmdNotSupport {
+			t.Fatal("UDP success response", response)
+		}
+	}
+}
+func TestYonikUDPv2SOCKSTCPKeepsNativeHandshake(t *testing.T) {
+	for _, input := range [][]byte{{5, 1, 0, 5, 1, 0, 1, 192, 0, 2, 2, 1, 187}, {4, 1, 1, 187, 192, 0, 2, 2, 0}} {
+		s := &ServerSession{config: &ServerConfig{UdpEnabled: true}, address: net.LocalHostIP, port: 1080}
+		actual, legacy := &profileHandshakeConn{}, &profileHandshakeConn{}
+		request, e := profileHandshakeBeforeUDPFactory(s, bytes.NewReader(input), actual, func() error { t.Fatal("TCP entered UDP admission"); return nil })
+		old, udp, oldError := s.Handshake(bytes.NewReader(input), legacy)
+		if e != nil || oldError != nil || udp != nil || request.Command != protocol.RequestCommandTCP || request.Destination() != old.Destination() || !bytes.Equal(actual.Bytes(), legacy.Bytes()) {
+			t.Fatal("TCP native parity", e, oldError)
+		}
+	}
+}
+func TestYonikUDPv2SOCKSAuthFailureNeverAdmitsControl(t *testing.T) {
+	s := &ServerSession{config: &ServerConfig{UdpEnabled: true}}
+	_, e := profileHandshakeBeforeUDPFactory(s, bytes.NewReader([]byte{5, 1, 2}), &profileHandshakeConn{}, func() error { t.Fatal("unauthenticated admission"); return nil })
+	if e == nil {
+		t.Fatal("auth failure accepted")
+	}
+}
