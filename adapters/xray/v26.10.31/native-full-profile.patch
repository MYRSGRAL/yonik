+
+func profileGrantCredit(g *profileGrant) uint64 {
+	return uint64((len(g.effective.address)+15)&^15) + uint64((len(g.query)+15)&^15)
+}
+func profileDecodedDestination(b []byte) (profileDestinationValue, bool) {
+	c := profileCursor{b: b}
+	h := c.take(8)
+	if h == nil {
+		return profileDestinationValue{}, false
+	}
+	a := c.take(int(u16(h, 4)))
+	v := profileDestinationValue{family: h[0], network: h[1], port: u16(h, 2), address: string(a)}
+	if h[0] != 3 {
+		ip, ok := netip.AddrFromSlice(a)
+		if !ok {
+			return v, false
+		}
+		v.address = ip.String()
+	}
+	return v, !c.bad && v.valid()
+}
+func (c *profileFlowControl) resolverPeer(index uint16, system bool) (profileDestinationValue, bool) {
+	if int(index) >= len(c.manifest.rows[4]) {
+		return profileDestinationValue{}, false
+	}
+	row := c.manifest.rows[4][index]
+	if system && row[0] != 2 {
+		return profileDestinationValue{}, false
+	}
+	v, ok := profileDecodedDestination(row[36:])
+	return v, ok && v.family != 3 && row[1] == v.network
+}
+func (c *profileFlowControl) allocateService(ctx context.Context, r *profileReceipt, g *profileGrant, kind uint16, body []byte) (*profileGrant, *profileOperation, error) {
+	if ctx == nil || ctx.Err() != nil || !c.live() || !c.operationAvailable() || r != nil && (!c.receiptLive(r) || r.id == 0) {
+		return nil, nil, errProfile
+	}
+	slot := -1
+	for i, item := range c.grants {
+		if item == nil && i < int(c.manifest.caps[0]) {
+			slot = i
+			break
+		}
+	}
+	extra := profileGrantCredit(g)
+	if slot < 0 || c.buffered+extra+c.manifest.memoryCredit > uint64(c.manifest.caps[4]) {
+		return nil, nil, errProfileFlowBusy
+	}
+	g.ctx, g.cancel = context.WithCancel(ctx)
+	g.slot, g.receipt = uint16(slot), r
+	c.grants[slot] = g
+	c.buffered += extra
+	if r != nil {
+		r.grantCount++
+	}
+	op, e := c.operation(g.ctx, r, g, kind, 0, body)
+	if e != nil {
+		c.closeGrant(g)
+	}
+	return g, op, e
+}
+func (c *profileFlowControl) dnsBody(g *profileGrant) []byte {
+	b := make([]byte, 20)
+	be.PutUint64(b, g.receipt.id)
+	b[8] = 3
+	for _, offset := range []int{10, 12, 14, 16} {
+		be.PutUint16(b[offset:], 65535)
+	}
+	b = append(b, g.receipt.original.encode()...)
+	b = append(b, g.effective.encode()...)
+	var field [4]byte
+	be.PutUint16(field[:], g.resolver)
+	be.PutUint16(field[2:], uint16(len(g.query)))
+	b = append(b, field[:]...)
+	b = append(b, g.query...)
+	b = append(b, make([]byte, 16)...)
+	return b
+}
+func (c *profileFlowControl) authorizeDNS(ctx context.Context, r *profileReceipt, index uint16, query string) (*profileGrant, *profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	peer, ok := c.resolverPeer(index, false)
+	if !ok || !profileDomain([]byte(query)) || r == nil {
+		return nil, nil, errProfile
+	}
+	g := &profileGrant{class: 3, resolver: index, query: query, effective: peer, subject: 65535, scope: 65535, stream: 65535, chain: 65535, receipt: r, bound: true}
+	return c.allocateService(ctx, r, g, 18, c.dnsBody(g))
+}
+func profileProbeBody(g *profileGrant) []byte {
+	b := make([]byte, 8)
+	be.PutUint16(b, g.purpose)
+	be.PutUint16(b[2:], g.serviceIndex)
+	be.PutUint16(b[4:], g.subject)
+	be.PutUint16(b[6:], g.resolver)
+	return b
+}
+func (c *profileFlowControl) probe(ctx context.Context, purpose, index, subject, resolver uint16) (*profileGrant, *profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if int(subject) >= len(c.manifest.rows[0]) {
+		return nil, nil, errProfile
+	}
+	g := &profileGrant{class: 2, purpose: purpose, serviceIndex: index, subject: subject, resolver: resolver, chain: 65535, stream: 65535, scope: 65535}
+	if purpose == 1 {
+		if int(index) >= len(c.manifest.rows[7]) || resolver != 65535 {
+			return nil, nil, errProfile
+		}
+		row := c.manifest.rows[7][index]
+		cur := profileCursor{b: row[4:]}
+		host := string(cur.str(253))
+		cur.str(2048)
+		n := int(cur.n16())
+		found := false
+		for i := 0; i < n; i++ {
+			if cur.n16() == subject {
+				found = true
+			}
+		}
+		if !found || !cur.done() {
+			return nil, nil, errProfile
+		}
+		g.effective = profileDestinationValue{family: 3, network: 6, port: u16(row, 2), address: host}
+		if ip, e := netip.ParseAddr(host); e == nil {
+			g.effective.family = 6
+			if ip.Is4() {
+				g.effective.family = 4
+			}
+		}
+		s := c.manifest.rows[0][subject]
+		g.scope = u16(s, len(s)-4)
+	} else if purpose == 2 {
+		if int(index) >= len(c.manifest.rows[1]) {
+			return nil, nil, errProfile
+		}
+		ep, ok := profileDecodedDestination(c.manifest.rows[1][index])
+		if !ok || ep.family != 3 {
+			return nil, nil, errProfile
+		}
+		found := false
+		for _, s := range c.manifest.rows[8] {
+			if u16(s, 0) == subject && (s[20] == 1 && u16(s, 8) == index || s[21] == 1 && u16(s, 10) == index) {
+				found = true
+			}
+		}
+		peer, ok := c.resolverPeer(resolver, true)
+		if !found || !ok {
+			return nil, nil, errProfile
+		}
+		g.class, g.query, g.effective, g.bound = 3, ep.address, peer, true
+	} else {
+		return nil, nil, errProfile
+	}
+	return c.allocateService(ctx, nil, g, 20, profileProbeBody(g))
+}
+func (c *profileFlowControl) refreshServiceLocked(g *profileGrant) (*profileOperation, error) {
+	if !c.grantLive(g) || g.id == 0 {
+		return nil, errProfile
+	}
+	if g.refresh != nil {
+		return g.refresh, nil
+	}
+	kind, body := uint16(20), profileProbeBody(g)
+	if g.receipt != nil {
+		kind, body = 18, c.dnsBody(g)
+	}
+	op, e := c.operation(g.ctx, g.receipt, g, kind, g.id, body)
+	if e == nil {
+		g.refresh = op
+	}
+	return op, e
+}
+func (c *profileFlowControl) publishService(op *profileOperation, f profilePacket) error {
+	g, b := op.grant, f.body
+	flow, revision := uint64(0), c.manifest.policy
+	// Только private original receipt связывает USER DNS с System attribution.
+	if g.receipt != nil {
+		if g.class != 3 || g.purpose != 0 || op.kind != 18 || op.receipt != g.receipt || !c.receiptLive(g.receipt) || g.receipt.id == 0 {
+			return errProfile
+		}
+		flow, revision = g.receipt.id, g.receipt.revision
+	} else if op.kind != 20 || op.receipt != nil || g.purpose == 0 {
+		return errProfile
+	}
+	required := byte(0)
+	if c.mode == 2 && g.receipt != nil {
+		required = 1
+	}
+	if f.kind != 19 || len(b) != 56 || b[0] != 1 || b[1] != g.class || b[2] != required || b[3] != 0 || u64(b, 4) == 0 || f.object != u64(b, 4) || u64(b, 12) != flow || u32(b, 20) == 0 || u32(b, 20) > 1000 || u64(b, 24) != revision || !zero(b[41:48]) {
+		return errProfile
+	}
+	ownerNS, ownerKind, ownerID := u64(b, 32), b[40], u64(b, 48)
+	if required == 0 {
+		if ownerNS != 0 || ownerKind != 0 || ownerID != 0 {
+			return errProfile
+		}
+	} else if ownerNS == 0 || ownerNS > uint64(20*time.Millisecond) || ownerKind < 1 || ownerKind > 2 || ownerID == 0 {
+		return errProfile
+	}
+	id := u64(b, 4)
+	if op.object == 0 {
+		if id <= c.highestGrant {
+			return errProfile
+		}
+	} else if id != op.object || g.id != id || !c.grantLive(g) {
+		return errProfile
+	}
+	deadline := op.sent.Add(time.Duration(u32(b, 20)) * time.Millisecond)
+	if op.sessionDeadline.Before(deadline) {
+		deadline = op.sessionDeadline
+	}
+	ownerDeadline := op.sent.Add(time.Duration(ownerNS))
+	if op.object != 0 && ownerKind == g.ownerKind && ownerID == g.ownerID && g.ownerDeadline.Before(ownerDeadline) {
+		ownerDeadline = g.ownerDeadline
+	}
+	if !c.clock().Before(deadline) || required == 1 && !c.clock().Before(ownerDeadline) {
+		return errProfile
+	}
+	g.id, g.deadline, g.revision = id, deadline, revision
+	g.ownerDeadline, g.ownerKind, g.ownerID = ownerDeadline, ownerKind, ownerID
+	if id > c.highestGrant {
+		c.highestGrant = id
+	}
+	return nil
+}
+func profileEnsureService(ctx context.Context, g *profileGrant) error {
+	p := profileRuntime(ctx)
+	if p == nil || g == nil || g.class != 2 && g.class != 3 || ctx.Err() != nil || !p.flowFresh() {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	if !c.grantLive(g) {
+		c.mu.Unlock()
+		return errProfile
+	}
+	renew := g.deadline.Sub(c.clock()) <= 250*time.Millisecond || c.serviceOwnerRequired(g) && g.ownerDeadline.Sub(c.clock()) <= 5*time.Millisecond
+	var op *profileOperation
+	var e error
+	if renew {
+		op, e = c.refreshServiceLocked(g)
+	}
+	c.mu.Unlock()
+	if e != nil {
+		return e
+	}
+	if op != nil {
+		if e = p.flowRPC(op); e != nil {
+			return e
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.grantLive(g) || c.serviceOwnerRequired(g) && !c.clock().Before(g.ownerDeadline) {
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) serviceOwnerRequired(g *profileGrant) bool {
+	return c.mode == 2 && g.class == 3 && g.receipt != nil
+}
+func profileServiceGrant(ctx context.Context) *profileGrant {
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	if g != nil && g.class == 2 {
+		return g
+	}
+	return nil
+}
+func profileSourceValid(ctx context.Context) error {
+	if g := profileServiceGrant(ctx); g != nil {
+		return profileEnsureService(ctx, g)
+	}
+	return ProfileOriginalValid(ctx)
+}
+func profileProbeTarget(ctx context.Context, target profileDestinationValue, subject *uint16) error {
+	g := profileServiceGrant(ctx)
+	if profileEnsureService(ctx, g) != nil || target != g.effective || subject != nil && *subject != g.subject {
+		return errProfile
+	}
+	return nil
+}
+
+// URL/tag выбирают только exact manifest scope. Authority приходит из GRANT.
+func ProfileOpenProbe(ctx context.Context, tag, rawURL string) (context.Context, func(), error) {
+	p := profileRuntime(ctx)
+	noop := func() {}
+	if p == nil {
+		return ctx, noop, nil
+	}
+	if len(rawURL) > 253+2048+32 || len(tag) > 160 || !p.flowFresh() || len(p.flow.manifest.rows[7]) != 1 {
+		return ctx, noop, errProfile
+	}
+	row := p.flow.manifest.rows[7][0]
+	cur := profileCursor{b: row[4:]}
+	host, path := string(cur.str(253)), string(cur.str(2048))
+	u, e := url.Parse(rawURL)
+	scheme := "http"
+	if row[0] == 2 {
+		scheme = "https"
+	}
+	if e != nil || u.User != nil || u.Fragment != "" || u.Hostname() != host || u.Scheme != scheme {
+		return ctx, noop, errProfile
+	}
+	port := u.Port()
+	if port == "" {
+		port = "80"
+		if u.Scheme == "https" {
+			port = "443"
+		}
+	}
+	actualPath := u.EscapedPath()
+	if actualPath == "" {
+		actualPath = "/"
+	}
+	if u.RawQuery != "" || u.ForceQuery {
+		actualPath += "?" + u.RawQuery
+	}
+	portValue, portError := strconv.ParseUint(port, 10, 16)
+	if portError != nil || uint16(portValue) != u16(row, 2) || actualPath != path {
+		return ctx, noop, errProfile
+	}
+	subject, ok := profileSubject(&p.flow.manifest, tag)
+	if !ok {
+		return ctx, noop, errProfile
+	}
+	g, op, e := p.flow.probe(ctx, 1, 0, subject, 65535)
+	if e != nil {
+		return ctx, noop, e
+	}
+	if e = p.flowRPC(op); e != nil {
+		return ctx, noop, e
+	}
+	return context.WithValue(g.ctx, profileGrantKey{}, g), func() { p.flow.mu.Lock(); p.flow.closeGrant(g); p.flow.mu.Unlock() }, nil
+}
+
+func profileBindProbe(ctx context.Context, route profileSelectedRoute, branch byte) (context.Context, func(), error) {
+	p := profileRuntime(ctx)
+	g := profileServiceGrant(ctx)
+	noop := func() {}
+	if profileProbeTarget(ctx, route.effective, &route.subject) != nil {
+		return ctx, noop, errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	s := c.manifest.rows[8][g.scope]
+	if branch > 1 || s[3]&(1<<branch) == 0 || g.bound && g.branch != branch {
+		return ctx, noop, errProfile
+	}
+	if g.bound {
+		return ctx, noop, nil
+	}
+	g.branch, g.stream, g.chain, g.bound = branch, u16(s, 12+int(branch)*2), u16(s, 16+int(branch)*2), true
+	return ctx, noop, nil
+}
+
+func profileResolverAddress(v profileDestinationValue) string {
+	return net.JoinHostPort(v.address, strconv.Itoa(int(v.port)))
+}
+func profileCanonicalQuery(name string) string { return strings.ToLower(strings.TrimSuffix(name, ".")) }
+func ProfileProbeDialContext(parent, callback context.Context) (context.Context, func(), error) {
+	if parent == nil || callback == nil || parent.Err() != nil || callback.Err() != nil {
+		return nil, func() {}, errProfile
+	}
+	g := profileServiceGrant(parent)
+	if ProfileSession(parent) && (profileEnsureService(parent, g) != nil || profileRuntime(callback) != nil && profileRuntime(callback) != profileRuntime(parent)) {
+		return nil, func() {}, errProfile
+	}
+	base := CarryProfileSession(parent, callback)
+	deadline, hasDeadline := parent.Deadline()
+	if other, ok := callback.Deadline(); ok && (!hasDeadline || other.Before(deadline)) {
+		deadline, hasDeadline = other, true
+	}
+	var ctx context.Context
+	var cancel context.CancelFunc
+	if hasDeadline {
+		ctx, cancel = context.WithDeadline(base, deadline)
+	} else {
+		ctx, cancel = context.WithCancel(base)
+	}
+	stop := context.AfterFunc(parent, cancel)
+	stopGrant := func() bool { return false }
+	if g != nil {
+		ctx = context.WithValue(ctx, profileGrantKey{}, g)
+		stopGrant = context.AfterFunc(g.ctx, cancel)
+	}
+	return ctx, func() { stop(); stopGrant(); cancel() }, nil
+}
+
+func ProfileProbeDialTarget(ctx context.Context, target xnet.Destination) error {
+	if !ProfileSession(ctx) {
+		return nil
+	}
+	v, e := profileValue(target)
+	if e != nil {
+		return e
+	}
+	return profileProbeTarget(ctx, v, nil)
+}
