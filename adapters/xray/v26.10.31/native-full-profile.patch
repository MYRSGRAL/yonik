+import "github.com/xtls/xray-core/common/session"
+
+// Private producer использует только verified consuming association. Public
+// caller не может передать tuple, original destination или mint grant.
+const profileUDPProducerCredit = 8192
+const profileUDPDownstreamCredit = 65536*3 + 32768 + 8192
+
+type profileUDPProducer struct {
+	association                          *profileUDPAssociation
+	runtime                              *ProfileRuntime
+	request                              *profileUDPControlRequest
+	dispatch                             func(context.Context, xnet.Destination, *transport.Link) error
+	flows                                [256]*profileUDPFlow
+	count                                int
+	current                              *profileUDPFlow
+	readDone                             chan error
+	reading, stopping, durable, finished bool
+	closeID                              uint64
+	closeError, result                   error
+	consumed                             [256]byte
+	consumedPending                      bool
+	peek                                 [256]byte
+	peekLength                           int
+	peekPending                          bool
+	controlDone                          chan error
+	controlJoined                        bool
+	closingDeadline                      time.Time
+	retiredRuntime                       uint64
+	latePermit, lateMatch                bool
+	notified                             bool
+}
+
+type profileUDPFlow struct {
+	mu                                 sync.Mutex
+	producer                           *profileUDPProducer
+	receipt                            *profileReceipt
+	open                               *profileOperation
+	ctx                                context.Context
+	cancel                             context.CancelFunc
+	grant                              *profileGrant
+	grantContext                       context.Context
+	tuple                              [40]byte
+	original, target                   profileDestinationValue
+	packet, permit, sequence           uint64
+	deadline                           time.Time
+	payload, response                  []byte
+	read, transferred, closed, retired bool
+	tasks                              int
+	result                             error
+	dispatchError                      error
+	done                               chan struct{}
+	doneClosed                         bool
+	credit                             bool
+	cookie                             uint64
+	matched                            atomic.Bool
+}
+
+func (c *ProfileUDPControl) Serve(dispatch func(context.Context, xnet.Destination, *transport.Link) error, control func() error) error {
+	if _, e := c.startProducer(dispatch, control); e != nil {
+		return e
+	}
+	<-c.request.closed
+	c.actor.mu.Lock()
+	defer c.actor.mu.Unlock()
+	if c.request.producer.finished {
+		return c.request.producer.result
+	}
+	return c.request.err
+}
+func (c *ProfileUDPControl) startProducer(dispatch func(context.Context, xnet.Destination, *transport.Link) error, control func() error) (*profileUDPProducer, error) {
+	if c == nil || c.actor == nil || dispatch == nil || control == nil {
+		return nil, errProfile
+	}
+	a := c.actor
+	a.mu.Lock()
+	r := c.request
+	if r == nil || r.phase != 4 || r.association == nil || r.ctx.Err() != nil || r.producer != nil {
+		a.mu.Unlock()
+		return nil, errProfile
+	}
+	f := a.runtime.flow
+	f.mu.Lock()
+	if !f.live() || f.buffered+f.manifest.memoryCredit+profileUDPProducerCredit > uint64(f.manifest.caps[4]) {
+		f.mu.Unlock()
+		a.mu.Unlock()
+		return nil, errProfileFlowBusy
+	}
+	f.buffered += profileUDPProducerCredit
+	f.mu.Unlock()
+	p := &profileUDPProducer{association: r.association, runtime: a.runtime, request: r, dispatch: dispatch, readDone: make(chan error, 1), controlDone: make(chan error, 1)}
+	r.producer = p
+	// Managed lifetime: legacy actor не закрывает receiver раньше producer joins.
+	// Phase5 сохраняет custody, но не является UCR/KnownClosed.
+	r.phase = 5
+	go func() { e := control(); r.cancel(); p.controlDone <- e }()
+	a.mu.Unlock()
+	return p, nil
+}
+
+func (p *profileUDPProducer) transfer(ctx context.Context, g *profileGrant) error {
+	a := p.association
+	if a == nil || g == nil || g.receipt == nil || g.receipt.provenance != 3 || g.id == 0 || g.class == 2 || g.class == 3 || profileReceiptFrom(ctx) != g.receipt || profileLinkGate(ctx, g) != nil {
+		return errProfile
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.phase != profileUDPMatched || a.ctx.Err() != nil || g.receipt.original != a.original || g.receipt.tuple != a.permitTuple() || g.receipt.openSequence != a.openSequence || !a.flow.clock().Before(a.deadline) {
+		return errProfile
+	}
+	u := g.receipt.udp
+	if u == nil || u.producer != p || u.receipt != g.receipt || !u.credit || !bytes.Equal(u.payload, a.buffers[0][a.header:a.length]) {
+		return errProfile
+	}
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if u.closed || u.ctx.Err() != nil || u.transferred || u.original != a.original || u.tuple != a.permitTuple() {
+		return errProfile
+	}
+	u.grant = g
+	u.grantContext = ctx
+	u.target = g.effective
+	if u.target.family == 3 || u.target.network != 17 {
+		return ErrProfileUnsupported
+	}
+	u.transferred = true
+	clear(a.buffers[0])
+	clear(a.buffers[1])
+	a.length = 0
+	a.header = 0
+	a.openSequence = 0
+	a.consumedSent = time.Time{}
+	a.flow.mu.Lock()
+	if a.operation {
+		a.flow.udpBudget.entries[a.operationSlot].terminal = true
+		a.flow.udpBudget.proofPending--
+		a.operation = false
+	}
+	a.flow.mu.Unlock()
+	a.phase = profileUDPBound
+	return nil
+}
+func (a *profileUDPAssociation) permitTuple() (t [40]byte) { copy(t[:], a.permit[160:200]); return }
+
+// Вызывается только существующим monitor, до legacy tick и runtime dispatch.
+func (a *profileUDPActor) producerTick() error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.failed != nil {
+		return a.failed
+	}
+	for _, r := range a.requests {
+		if r != nil && r.producer != nil {
+			if e := r.producer.tick(); e != nil {
+				return a.failLocked(e)
+			}
+		}
+	}
+	return nil
+}
+func (p *profileUDPProducer) tick() error {
+	if p.finished {
+		return nil
+	}
+	r, a, c := p.request, p.association, p.runtime.flow
+	if r.ctx.Err() != nil || p.runtime.ctx.Err() != nil {
+		p.beginClose()
+	}
+	if p.stopping {
+		return p.closeProgress()
+	}
+	for i, u := range p.flows[:p.count] {
+		if u == nil || u == p.current || !u.mu.TryLock() {
+			continue
+		}
+		ready := u.closed && u.tasks == 0
+		result := u.result
+		u.mu.Unlock()
+		if result != nil {
+			return result
+		}
+		if ready && p.flowRetired(u) {
+			p.retireFlow(i, u)
+		}
+	}
+	if p.current != nil {
+		u := p.current
+		if p.consumedPending {
+			e := p.runtime.udpActor.send(p.consumed[:], nil)
+			if e == errProfileProofBusy {
+				return nil
+			}
+			if e != nil {
+				return e
+			}
+			p.consumedPending = false
+		}
+		c.mu.Lock()
+		complete, failed := u.open.completed, u.open.err
+		c.mu.Unlock()
+		a.mu.Lock()
+		phase := a.phase
+		expired := !c.clock().Before(a.deadline)
+		a.mu.Unlock()
+		if failed != nil || phase == profileUDPDenied {
+			u.cancel()
+			u.mu.Lock()
+			u.closed = true
+			u.mu.Unlock()
+		}
+		if !u.mu.TryLock() {
+			return nil
+		}
+		transferred := u.transferred
+		tasks := u.tasks
+		closed := u.closed
+		u.mu.Unlock()
+		if closed && !transferred && tasks == 0 && (phase == profileUDPMatched || phase == profileUDPDenied) {
+			c.mu.Lock()
+			c.closeReceipt(u.receipt)
+			c.mu.Unlock()
+			if !p.flowRetired(u) {
+				return nil
+			}
+			a.mu.Lock()
+			if a.phase == profileUDPMatched {
+				a.phase = profileUDPDenied
+			}
+			a.mu.Unlock()
+			if e := a.RetirePayload(); e != nil {
+				return e
+			}
+			p.current = nil
+			for i, v := range p.flows[:p.count] {
+				if v == u {
+					p.retireFlow(i, u)
+					break
+				}
+			}
+			return nil
+		}
+		if !transferred && expired {
+			return errProfileTimeout
+		}
+		if complete && phase == profileUDPMatched && tasks == 0 && !closed {
+			u.mu.Lock()
+			u.tasks++
+			u.mu.Unlock()
+			go p.runFlow(u)
+		}
+		if transferred {
+			p.current = nil
+		}
+		return nil
+	}
+	if p.reading {
+		select {
+		case e := <-p.readDone:
+			p.reading = false
+			if e != nil {
+				return e
+			}
+			return p.openConsumed()
+		default:
+			return nil
+		}
+	}
+	a.mu.Lock()
+	phase := a.phase
+	a.mu.Unlock()
+	if phase == profileUDPBound {
+		if e := a.BeginPeek(c.clock().Add(time.Second)); e != nil {
+			return e
+		}
+		var tail [32]byte
+		be.PutUint64(tail[:], a.id)
+		c.mu.Lock()
+		operation := c.udpBudget.entries[a.operationSlot].operation
+		c.mu.Unlock()
+		be.PutUint64(tail[8:], operation)
+		be.PutUint64(tail[16:], a.control)
+		b, n, e := profileUDPEncode(a.launch, 4, tail[:])
+		if e != nil {
+			return e
+		}
+		p.peek = b
+		p.peekLength = n
+		p.peekPending = true
+	}
+	if p.peekPending {
+		e := p.runtime.udpActor.send(p.peek[:p.peekLength], nil)
+		if e == errProfileProofBusy {
+			return nil
+		}
+		if e != nil {
+			return e
+		}
+		p.peekPending = false
+	}
+	return nil
+}
+
+func (p *profileUDPProducer) packet(kind int, b []byte) error {
+	if p.stopping && kind != 8 {
+		if kind == 5 {
+			return p.retireLatePermit(b)
+		}
+		if kind == 7 && !p.lateMatch && !p.consumedPending && p.current != nil && u64(b, 136) == p.current.packet && u64(b, 144) == p.current.permit && u64(b, 152) == p.current.sequence && b[160] != 3 {
+			p.lateMatch = true
+			return nil
+		}
+		return errProfile
+	}
+	switch kind {
+	case 5:
+		if p.reading || p.current != nil || p.peekPending {
+			return errProfile
+		}
+		if e := p.association.Permit(b); e != nil {
+			return e
+		}
+		p.reading = true
+		go func() { p.readDone <- p.association.ConsumePermit() }()
+		return nil
+	case 7:
+		if p.consumedPending || p.current == nil {
+			return errProfile
+		}
+		if e := p.association.Match(b); e != nil {
+			return e
+		}
+		p.association.mu.Lock()
+		matched := p.association.phase == profileUDPMatched
+		p.association.mu.Unlock()
+		if matched && p.current != nil {
+			p.current.matched.Store(true)
+		}
+		return nil
+	case 8:
+		if p.closeID != 0 || u64(b, 128) != p.association.id || u64(b, 144) != p.association.control {
+			return errProfile
+		}
+		id := u64(b, 136)
+		for _, r := range p.runtime.udpActor.requests {
+			if r != nil && r.issuerClose == id {
+				return errProfile
+			}
+		}
+		p.request.issuerClose = id
+		c := p.runtime.flow
+		c.mu.Lock()
+		entry := &c.udpBudget.entries[p.request.slot+2]
+		entry.namespace = 3
+		entry.operation = id
+		c.mu.Unlock()
+		p.closeID = u64(b, 136)
+		p.durable = true
+		p.beginClose()
+		return nil
+	}
+	return errProfile
+}
+
+// Closing-only DATA ledger: никакого Read/OPEN/authority из late permit.
+// KnownClosed всё ещё требует actual duplicate close, joins и durable UCQ.
+func (p *profileUDPProducer) retireLatePermit(b []byte) error {
+	a := p.association
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if p.latePermit || p.peekPending || p.reading || p.current != nil || a.phase != profileUDPWaiting || !a.operation || u64(b, 152) != a.cookie || u64(b, 136) <= a.lastPacket || u64(b, 144) <= a.lastPermit || u16(b, 166) != a.bound.port {
+		return errProfile
+	}
+	c := p.runtime.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if u64(b, 136) <= c.udpBudget.lastPacket || u64(b, 144) <= c.udpBudget.lastPermit {
+		return errProfile
+	}
+	p.latePermit = true
+	a.lastPacket = u64(b, 136)
+	a.lastPermit = u64(b, 144)
+	c.udpBudget.lastPacket = a.lastPacket
+	c.udpBudget.lastPermit = a.lastPermit
+	entry := &c.udpBudget.entries[a.operationSlot]
+	entry.packet = a.lastPacket
+	entry.permit = a.lastPermit
+	return nil
+}
+
+func (p *profileUDPProducer) openConsumed() error {
+	a, c := p.association, p.runtime.flow
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.phase != profileUDPHeld || a.original.family == 3 || !c.clock().Before(a.deadline) {
+		return ErrProfileUnsupported
+	}
+	c.mu.Lock()
+	if !c.live() || p.count >= 256 || p.count >= int(c.manifest.caps[6]) || c.buffered+c.manifest.memoryCredit+profileUDPDownstreamCredit > uint64(c.manifest.caps[4]) {
+		c.mu.Unlock()
+		return errProfileFlowBusy
+	}
+	c.buffered += profileUDPDownstreamCredit
+	c.mu.Unlock()
+	ctx, cancel := context.WithCancel(p.request.ctx)
+	accepted := &profileAccepted{runtime: p.runtime, ctx: ctx, index: p.request.accepted.index, provenance: 3, tuple: a.permitTuple()}
+	r, op, e := c.open(ctx, accepted.index, 3, accepted.tuple, a.original, accepted)
+	if e != nil {
+		cancel()
+		c.mu.Lock()
+		c.buffered -= profileUDPDownstreamCredit
+		c.mu.Unlock()
+		return e
+	}
+	u := &profileUDPFlow{producer: p, ctx: ctx, cancel: cancel, tuple: accepted.tuple, original: a.original, cookie: a.cookie, packet: a.lastPacket, permit: a.lastPermit, deadline: a.deadline, payload: append([]byte(nil), a.buffers[0][a.header:a.length]...), response: make([]byte, 65536), done: make(chan struct{}), credit: true}
+	u.receipt, u.open = r, op
+	r.udp = u
+	op.fixedDeadline = u.deadline
+	c.mu.Lock()
+	if op.udpSlot >= 0 {
+		entry := &c.udpBudget.entries[op.udpSlot]
+		entry.association = a.id
+		entry.packet = a.lastPacket
+		entry.permit = a.lastPermit
+		entry.control = a.control
+		entry.cookie = a.cookie
+	}
+	c.mu.Unlock()
+	p.flows[p.count] = u
+	p.count++
+	p.current = u
+	a.flows++
+	// open() не читает association mutex; release перед Consumed после seq.
+	a.mu.Unlock()
+	e = c.dispatch(op)
+	if e == nil {
+		u.sequence = op.sequence
+		p.consumed, e = a.Consumed(op.sequence)
+		p.consumedPending = e == nil
+	}
+	a.mu.Lock()
+	return e
+}
+
+func (p *profileUDPProducer) runFlow(u *profileUDPFlow) {
+	defer func() {
+		u.mu.Lock()
+		u.tasks--
+		if u.tasks == 0 {
+			u.closed = true
+			u.cancel()
+			if u.done != nil && !u.doneClosed {
+				u.doneClosed = true
+				close(u.done)
+			}
+		}
+		u.mu.Unlock()
+	}()
+	ctx := context.WithValue(context.WithValue(u.ctx, profileContextKey{}, p.runtime), profileReceiptKey{}, u.receipt)
+	target := xnet.UDPDestination(xnet.ParseAddress(u.original.address), xnet.Port(u.original.port))
+	var e error
+	if content := session.ContentFromContext(ctx); content != nil && content.SniffingRequest.Enabled && !content.SniffingRequest.MetadataOnly {
+		e = ErrProfileUnsupported
+	} else {
+		e = p.dispatch(ctx, target, &transport.Link{Reader: &profileUDPPayloadReader{flow: u}, Writer: &profileUDPResponseWriter{flow: u}})
+	}
+	u.mu.Lock()
+	u.dispatchError = e
+	u.mu.Unlock()
+}
+
+type profileUDPPayloadReader struct{ flow *profileUDPFlow }
+
+func (r *profileUDPPayloadReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	u := r.flow
+	u.mu.Lock()
+	if u.closed || u.ctx.Err() != nil {
+		u.mu.Unlock()
+		return nil, io.EOF
+	}
+	if !u.transferred || u.grant == nil || u.grant.receipt != u.receipt || profileReceiptFrom(u.grantContext) != u.receipt || profileLinkGate(u.grantContext, u.grant) != nil {
+		u.mu.Unlock()
+		return nil, errProfile
+	}
+	if !u.read {
+		u.read = true
+		b := buf.FromBytes(u.payload)
+		u.mu.Unlock()
+		return buf.MultiBuffer{b}, nil
+	}
+	u.mu.Unlock()
+	<-u.ctx.Done()
+	return nil, io.EOF
+}
+func (r *profileUDPPayloadReader) ReadMultiBufferTimeout(time.Duration) (buf.MultiBuffer, error) {
+	return r.ReadMultiBuffer()
+}
+func (r *profileUDPPayloadReader) Close() error          { r.flow.cancel(); return nil }
+func (r *profileUDPPayloadReader) ProfileCleanup() error { return r.Close() }
+
+type profileUDPResponseWriter struct{ flow *profileUDPFlow }
+
+func (w *profileUDPResponseWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	for _, b := range mb {
+		if e := w.flow.reply(b); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+func (w *profileUDPResponseWriter) Close() error          { w.flow.cancel(); return nil }
+func (w *profileUDPResponseWriter) ProfileCleanup() error { return w.Close() }
+
+func (u *profileUDPFlow) reply(b *buf.Buffer) error {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if !u.transferred || !u.credit || u.closed || u.ctx.Err() != nil || u.grant == nil || u.grant.receipt != u.receipt || u.receipt.provenance != 3 || u.grant.class == 2 || u.grant.class == 3 || u.receipt.tuple != u.tuple || u.receipt.original != u.original || u.receipt.revision != u.grant.revision || u.cookie != u.producer.association.cookie || u.receipt.control != u.producer.association.flow || u.target != u.grant.effective || profileReceiptFrom(u.grantContext) != u.receipt {
+		return errProfile
+	}
+	if b == nil {
+		return errProfile
+	}
+	if b.UDP != nil {
+		v, e := profileValue(*b.UDP)
+		if e != nil || v != u.target {
+			return errProfile
+		}
+	}
+	target := u.target
+	if target.family == 3 || target.network != 17 || !target.valid() {
+		return ErrProfileUnsupported
+	}
+	address, e := profileNumericAddress(target)
+	if e != nil {
+		return e
+	}
+	header := 6 + len(address)
+	if int(b.Len())+header > 65507 {
+		return errProfile
+	}
+	gate := func() error {
+		if u.ctx.Err() != nil || u.grant.receipt != u.receipt {
+			return errProfile
+		}
+		return profileLinkGate(u.grantContext, u.grant)
+	}
+	if e = gate(); e != nil {
+		return e
+	}
+	frame := u.response[:header+int(b.Len())]
+	clear(frame[:header])
+	frame[3] = 1
+	if target.family == 6 {
+		frame[3] = 4
+	}
+	copy(frame[4:], address)
+	be.PutUint16(frame[4+len(address):], target.port)
+	copy(frame[header:], b.Bytes())
+	ctx, cancel := context.WithTimeout(u.ctx, time.Second)
+	defer cancel()
+	send := u.producer.association.reply
+	if send == nil {
+		return ErrProfileUnsupported
+	}
+	e = send(ctx, frame, u.tuple, gate)
+	if e != nil {
+		if errors.Is(e, errProfileUDPResponseUncertain) || errors.Is(e, errProfileUDPNamespace) {
+			u.result = errors.Join(u.result, e)
+			if runtime := u.producer.runtime; runtime != nil {
+				runtime.mu.Lock()
+				runtime.admission.state = profileUnknown
+				runtime.mu.Unlock()
+				runtime.cancel()
+			}
+		}
+		u.cancel()
+	}
+	if u.result == nil {
+		clear(frame)
+	}
+	return e
+}
+func (p *profileUDPProducer) beginClose() {
+	if p.stopping {
+		return
+	}
+	p.stopping = true
+	p.closingDeadline = p.runtime.flow.clock().Add(time.Second)
+	p.request.cancel()
+	for _, u := range p.flows[:p.count] {
+		if u == nil {
+			continue
+		}
+		u.cancel()
+		p.runtime.flow.mu.Lock()
+		p.runtime.flow.closeReceipt(u.receipt)
+		p.runtime.flow.mu.Unlock()
+	}
+	// Close actual duplicate до ожидания reader/send; receiver.Close идемпотентен.
+	if p.association.receiver != nil {
+		p.closeError = errors.Join(p.closeError, p.association.receiver.Close())
+	}
+}
+func (p *profileUDPProducer) closeProgress() error {
+	c := p.runtime.flow
+	if !c.clock().Before(p.closingDeadline) {
+		return errors.Join(errProfileTimeout, p.closeError)
+	}
+	if p.reading {
+		select {
+		case <-p.readDone:
+			p.reading = false
+		default:
+			return nil
+		}
+	}
+	if !p.controlJoined {
+		select {
+		case <-p.controlDone:
+			p.controlJoined = true
+		default:
+			return nil
+		}
+	}
+	for _, u := range p.flows[:p.count] {
+		if u == nil {
+			continue
+		}
+		if !u.mu.TryLock() {
+			return nil
+		}
+		tasks := u.tasks
+		result := u.result
+		u.mu.Unlock()
+		if tasks != 0 {
+			return nil
+		}
+		if result != nil {
+			return result
+		}
+		if !p.flowRetired(u) {
+			return nil
+		}
+	}
+	if !p.durable {
+		return nil
+	}
+	c.mu.Lock()
+	for _, entry := range c.udpBudget.entries[:c.udpBudget.used] {
+		if entry.namespace == 1 && entry.association == p.association.id && entry.closeKind != 0 && (!entry.terminal || entry.closeStatus != 1) {
+			c.mu.Unlock()
+			return nil
+		}
+	}
+	c.mu.Unlock()
+	if p.closeError != nil {
+		return p.closeError
+	}
+	c.mu.Lock()
+	live := c.live()
+	c.mu.Unlock()
+	if p.runtime.ctx.Err() != nil || !live {
+		return errProfile
+	}
+	p.association.mu.Lock()
+	p.association.flows = 0
+	p.association.mu.Unlock()
+	if e := p.association.CloseAndJoin(); e != nil {
+		return e
+	}
+	var tail [64]byte
+	be.PutUint64(tail[:], p.association.id)
+	be.PutUint64(tail[8:], p.closeID)
+	be.PutUint64(tail[16:], p.association.lastPacket)
+	tail[28] = 1
+	tail[29] = 1
+	be.PutUint64(tail[32:], p.association.cookie)
+	be.PutUint64(tail[40:], p.retiredRuntime)
+	for _, u := range p.flows[:p.count] {
+		if u == nil {
+			continue
+		}
+		if u.sequence > u64(tail[:], 40) {
+			be.PutUint64(tail[40:], u.sequence)
+		}
+	}
+	b, n, e := profileUDPEncode(p.association.launch, 9, tail[:])
+	if e != nil {
+		return e
+	}
+	e = p.runtime.udpActor.send(b[:n], nil)
+	if e == errProfileProofBusy {
+		return nil
+	}
+	if e != nil {
+		return e
+	}
+	for i, u := range p.flows[:p.count] {
+		if u != nil {
+			p.retireFlow(i, u)
+		}
+	}
+	p.finished = true
+	p.request.err = nil
+	p.notified = true
+	close(p.request.closed)
+	return nil
+}
+func (p *profileUDPProducer) flowRetired(u *profileUDPFlow) bool {
+	c := p.runtime.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !u.open.completed || u.receipt.pending != 0 || u.receipt.grantCount != 0 {
+		return false
+	}
+	if u.receipt.id == 0 && u.open.denied {
+		return true
+	}
+	kind, id := byte(2), u.receipt.id
+	if id == 0 {
+		if !u.open.submitted {
+			return true
+		}
+		kind, id = 1, u.open.sequence
+	}
+	for _, entry := range c.udpBudget.entries[:c.udpBudget.used] {
+		if entry.closeKind == kind && entry.objectID == id {
+			return entry.terminal && entry.closeStatus == 1
+		}
+	}
+	return false
+}
+
+func (p *profileUDPProducer) retireFlow(i int, u *profileUDPFlow) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if !u.credit {
+		return
+	}
+	clear(u.payload)
+	clear(u.response)
+	u.payload = nil
+	u.response = nil
+	u.credit = false
+	u.retired = true
+	c := p.runtime.flow
+	c.mu.Lock()
+	c.buffered -= profileUDPDownstreamCredit
+	c.mu.Unlock()
+	p.association.mu.Lock()
+	if p.association.flows > 0 {
+		p.association.flows--
+	}
+	p.association.mu.Unlock()
+	p.flows[i] = nil
+	if u.sequence > p.retiredRuntime {
+		p.retiredRuntime = u.sequence
+	}
+}
+
+func (c *profileFlowControl) udpCloseACK(f profilePacket, kind byte, id uint64) error {
+	if c.udpBudget == nil {
+		return nil
+	}
+	for i := 0; i < c.udpBudget.used; i++ {
+		e := &c.udpBudget.entries[i]
+		if e.namespace == 1 && e.runtimeSequence == f.reply && e.closeKind == kind && e.objectID == id {
+			if e.terminal {
+				return errProfile
+			}
+			e.closeStatus = f.body[1]
+			e.terminal = true
+			if e.closeStatus == 1 {
+				c.udpBudget.proofPending--
+				return nil
+			}
+			return errProfile
+		}
+	}
+	return errProfile
+}
+
+// Task credit и registration предшествуют actual mux input goroutine.
+func ProfileBeginLogicalTask(ctx context.Context) (func(error), error) {
+	if profileQueryFrom(ctx) != nil {
+		task, e := ProfileDNSBeginTask(ctx)
+		if e != nil {
+			return nil, e
+		}
+		var once sync.Once
+		return func(result error) { once.Do(func() { task.Finish(result) }) }, nil
+	}
+	r := profileReceiptFrom(ctx)
+	if r == nil || r.udp == nil {
+		return func(error) {}, nil
+	}
+	u := r.udp
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if u.closed || u.ctx.Err() != nil {
+		return nil, errProfile
+	}
+	c := r.control
+	c.mu.Lock()
+	if !c.receiptLive(r) || c.buffered+c.manifest.memoryCredit+4096 > uint64(c.manifest.caps[4]) {
+		c.mu.Unlock()
+		return nil, errProfileFlowBusy
+	}
+	c.buffered += 4096
+	c.mu.Unlock()
+	u.tasks++
+	var once sync.Once
+	return func(e error) {
+		once.Do(func() {
+			u.mu.Lock()
+			defer u.mu.Unlock()
+			u.tasks--
+			if e != nil {
+				u.result = errors.Join(u.result, e)
+			} else {
+				c.mu.Lock()
+				c.buffered -= 4096
+				c.mu.Unlock()
+			}
+			if u.tasks == 0 {
+				u.closed = true
+				u.cancel()
+				if u.done != nil && !u.doneClosed {
+					u.doneClosed = true
+					close(u.done)
+				}
+			}
+		})
+	}, nil
+}
+func profileNumericAddress(v profileDestinationValue) ([]byte, error) {
+	if v.family == 3 || !v.valid() {
+		return nil, ErrProfileUnsupported
+	}
+	a, e := netip.ParseAddr(v.address)
+	if e != nil {
+		return nil, e
+	}
+	return a.AsSlice(), nil
+}
