+	late := f.grantReply(oa, 0)
+	gb, ob := f.pendingGrant(t, b)
+	good := f.grantReply(ob, 0)
+	f.c.abort(oa)
+	if e := f.c.tick(); e != nil {
+		t.Fatal(e)
+	}
+	cancel := f.writes[len(f.writes)-1]
+	ack := make([]byte, 12)
+	ack[0] = 1
+	ack[1] = 3
+	be.PutUint64(ack[4:], oa.sequence)
+	if e := f.c.accept(profilePacket{kind: 34, reply: cancel.sequence, body: ack}); e != nil {
+		t.Fatal(e)
