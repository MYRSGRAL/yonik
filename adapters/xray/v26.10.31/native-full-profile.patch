diff --git a/app/observatory/yonik_profile_service_test.go b/app/observatory/yonik_profile_service_test.go
new file mode 100644
--- /dev/null
+++ b/app/observatory/yonik_profile_service_test.go
@@ -0,0 +1,50 @@
+package observatory
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+type probeContextTestKey struct{}
+
+func TestYonikProbeRequestKeepsParentDeadlineCancelAndURL(t *testing.T) {
+	parent, cancel := context.WithCancel(context.WithValue(context.Background(), probeContextTestKey{}, "owned-values"))
+	defer cancel()
+	o := &Observer{ctx: parent, config: &Config{ProbeUrl: "http://synthetic.invalid/health?fixed=1"}}
+	called := false
+	result := o.probeWithClient("subject", func(client *http.Client, req *http.Request) (*http.Response, error) {
+		called = true
