+func ProfileDNSAcquirePhysicalContext(ctx context.Context) (context.Context, func(), error) {
+	noop := func() {}
+	if ctx == nil {
+		return ctx, noop, ErrProfileUnsupported
+	}
+	p := profileRuntime(ctx)
+	s, _ := ctx.Value(profileDNSCapture4Key{}).(*profileDNSCapture4)
+	if p == nil || !p.dns4CaptureReviewed || s == nil || s.runtime != p {
+		return ctx, noop, ErrProfileUnsupported
+	}
+	x, op, err := p.flow.dnsContext4Acquire(ctx, s, nil)
+	if err != nil {
+		return ctx, noop, err
+	}
+	if err = p.flowRPC(op); err != nil {
+		return ctx, noop, err
+	}
+	p.flow.mu.Lock()
+	live := p.flow.dnsContext4Live(x)
+	p.flow.mu.Unlock()
+	if !live {
+		return ctx, noop, errProfile
+	}
+	release := func() { p.flow.mu.Lock(); p.flow.dnsContext4Close(x); p.flow.mu.Unlock() }
+	metadata := context.WithValue(x.ctx, profileGrantKey{}, (*profileGrant)(nil))
+	return context.WithValue(metadata, profileDNSContext4Key{}, x), release, nil
