+func TestYonikR9MuxVoidInterruptIsNotCleanupProof(t *testing.T) {
+	leaf := &r9MuxVoid{}
+	retired := make(chan error, 1)
+	w, tasks := r9MuxConstruct(t, transport.Link{Reader: leaf, Writer: leaf}, func(e error) { retired <- e })
+	result := make(chan error, 1)
+	go func() { result <- w.Close() }()
+	<-w.done.Wait()
+	tasks.fetch()
+	tasks.monitor()
+	if e := <-result; e == nil {
+		t.Fatal("void Interrupt выдан за KnownClosed")
+	}
+	if e := <-retired; e == nil {
+		t.Fatal("неподтверждённый cleanup освободил custody")
+	}
+	if !leaf.interrupted.Load() {
+		t.Fatal("не сделана даже best-effort остановка")
+	}
+}
