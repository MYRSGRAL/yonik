+func TestProfileProofBootstrapRejectsMismatchAndClosesEveryRight(t *testing.T) {
+	for _, what := range []string{"valid", "binding", "credentials", "uid", "count", "truncated", "peer", "expired", "type", "ack", "read", "local", "duplicate"} {
+		t.Run(what, func(t *testing.T) {
+			r, v := proofVector(t)
+			now := time.Now()
+			fd, extra := &proofFakeFD{}, &proofFakeFD{}
+			io := &proofFakeBootstrap{packet: profileProofPacket{body: proofBytes(t, v.Bootstrap), count: 1, rightsMessages: 1, credentials: 1, pid: 7, uid: 0}, alive: true, clock: &now}
+			io.packet.rights[0] = fd
+			deadline := now.Add(time.Second)
+			switch what {
+			case "binding":
+				io.packet.body[16] ^= 1
+			case "credentials":
+				io.packet.credentials = 2
+			case "uid":
+				io.packet.uid = 1000
+			case "count":
+				io.packet.count = 2
+				io.packet.rights[1] = extra
+			case "truncated":
+				io.packet.invalid = true
+			case "peer":
+				io.alive = false
+			case "expired":
+				io.advance = time.Second
+			case "type":
+				io.validateError = errProfile
+			case "ack":
+				io.ackError = errProfile
+			case "read":
+				io.readError = errProfile
+			case "local":
+				r.mode = 1
+			}
+			channel := &profileProofChannel{}
+			e := channel.bootstrap(r, io, deadline, func() time.Time { return now })
+			if what == "valid" || what == "duplicate" {
+				if e != nil || !bytes.Equal(io.ack, proofBytes(t, v.Ack)) {
+					t.Fatal("valid bootstrap", e)
+				}
+				if what == "duplicate" && channel.bootstrap(r, io, deadline, func() time.Time { return now }) == nil {
+					t.Fatal("duplicate bootstrap")
+				}
+				channel.Close()
+				if fd.calls != 1 {
+					t.Fatal("bootstrap custody")
+				}
+				return
+			}
+			if e == nil || len(io.ack) != 0 && what != "ack" {
+				t.Fatal("invalid bootstrap accepted", what, e)
+			}
+			if what == "local" {
+				if io.reads != 0 {
+					t.Fatal("Local consumed System bootstrap")
+				}
+				return
+			}
+			if fd.calls != 1 || what == "count" && extra.calls != 1 {
+				t.Fatal("unexpected right leaked", fd.calls, extra.calls)
+			}
+		})
+	}
+}
