+		}
+		cancel()
+		<-req.Context().Done()
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(""))}, nil
+	})
+	if !called || result.Alive {
+		t.Fatal("late response после cancel отмечен Alive")
+	}
+}
+func TestYonikCancelledProbeDoesNotReachHTTPClient(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
