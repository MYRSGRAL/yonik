+			op := n.dnsTo42(t)
+			reply, _ := numericGolden(t, 2, op.receipt.id)
+			if err := n.wire.f.c.dispatch(op); err != nil {
+				t.Fatal(err)
+			}
+			reply.reply = op.sequence
+			switch fault {
+			case "flow":
+				be.PutUint64(reply.body[12:], 2)
+			case "revision":
+				be.PutUint64(reply.body[24:], 2)
+			case "object":
+				reply.object++
+			case "class":
+				reply.body[1] = 3
+			case "required":
+				reply.body[2] = 0
+			case "owner-kind":
+				reply.body[40] = 3
+			case "owner-none":
+				clear(reply.body[32:])
+			case "owner-expired":
+				n.wire.f.now = op.sent.Add(11 * time.Millisecond)
+			case "late":
+				n.wire.f.now = op.deadline
+			case "root-expired":
+				op.dnsNumeric.waiter.bundle.exchange.root.ownerDeadline = n.wire.f.now
+			case "reservation-expired":
+				op.dnsNumeric.waiter.reservationDeadline = n.wire.f.now
+			case "cancel":
+				n.wire.f.c.abort(op)
+			case "unknown", "deny":
+				reply.object = 0
+				clear(reply.body[2:])
+				reply.body[0] = 2
+				if fault == "unknown" {
+					reply.body[0] = 3
+				}
+			}
+			err := n.wire.f.c.accept(reply)
+			if err != nil {
+				n.wire.f.p.cancel()
+			}
+			result := n.result(t)
+			if fault == "duplicate" {
+				if result.err != nil {
+					t.Fatal(result.err)
+				}
+				defer result.release()
+				if n.wire.f.c.accept(reply) == nil {
+					t.Fatal("GRANT replay accepted")
+				}
+				return
+			}
+			if result.err == nil {
+				result.release()
+				t.Fatal("bad USER grant published", fault)
+			}
+			if fault == "unknown" && !op.dnsNumeric.unknown {
+				t.Fatal("Unknown custody lost")
+			}
+		})
+	}
