+		if len(b) != 36 || b[0] < 1 || b[0] > 4 || b[1] > 2 || !zero(b[2:4]) || zero(b[4:]) {
+			return false
+		}
+	}
+	var physical [512]bool
+	physicalCount := uint32(0)
+	for i, b := range m.rows[8] {
+		if len(b) != 24 || int(u16(b, 0)) >= counts(1) || (b[2] != 6 && b[2] != 17) || b[3] == 0 || b[3]&^byte(3) != 0 || !zero(b[22:]) {
+			return false
+		}
