+	}
+	if g := x.source.service; g != nil && g.deadline.Before(op.deadline) {
+		op.deadline = g.deadline
+	}
+	if d, ok := op.ctx.Deadline(); ok && d.Before(op.deadline) {
+		op.deadline = d
+	}
+	lease := op.deadline
+	if x.revision != 0 && x.deadline.Before(op.deadline) {
+		op.deadline = x.deadline
+	}
+	if !op.sent.Before(op.deadline) {
+		c.dnsContext4Close(x)
+		c.dnsNotify(op, errProfile)
+		c.operations -= 2
+		x.pending = nil
+		return nil
+	}
+	be.PutUint64(op.body[40:], uint64(lease.Sub(op.sent)))
+	op.submitted = true
+	seq, err := c.write(55, 0, op.body)
+	op.sequence = seq
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	if err != nil || !profileDNSV2ID(seq) {
+		x.unknown = true
+		c.dnsContext4Close(x)
+		c.dnsNotify(op, errProfile)
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) dnsContext4Accept(f profilePacket) (bool, error) {
+	for _, x := range c.dnsContexts4[:c.dnsContext4Used] {
+		for _, op := range x.requests[:x.used] {
+			if op.submitted && op.sequence == f.reply && f.kind == 56 {
+				if op.dns4Replied || op.dns4CancelAck || f.object != 0 {
+					x.unknown = true
+					c.dnsContext4Close(x)
+					c.dnsNotify(op, errProfile)
+					return true, errProfile
+				}
+				op.dns4Replied = true
+				if !profileDNSV2Body(56, f.body) {
+					x.unknown = true
+					c.dnsContext4Close(x)
+					c.dnsNotify(op, errProfile)
+					return true, errProfile
+				}
+				if f.body[2] != 1 {
+					c.dnsContext4Close(x)
+					c.dnsNotify(op, errProfile)
+					if f.body[2] == 3 {
+						x.unknown = true
+					} else {
+						c.dnsContext4Settle(op)
+					}
+					return true, nil
+				}
+				id, ok := profileDNSV2ContextReply(op.body, f.body)
+				if !ok || id.kind != x.identity.kind || !c.dnsClaimContextIdentity(x.identity, id.id) {
+					x.unknown = true
+					c.dnsContext4Close(x)
+					c.dnsNotify(op, errProfile)
+					return true, errProfile
+				}
+				deadline := op.sent.Add(time.Duration(u64(f.body, 40)))
+				if x.closed || x.ctx.Err() != nil || op.ctx.Err() != nil || !c.dnsCapture4Live(&x.source) || !c.clock().Before(deadline) || !c.clock().Before(op.deadline) {
+					c.dnsContext4Close(x)
+					c.dnsNotify(op, errProfile)
+				} else {
+					x.deadline = deadline
+					x.revision = u64(f.body, 56)
+					c.dnsNotify(op, nil)
+				}
+				c.dnsContext4Settle(op)
+				return true, nil
+			}
+			if f.kind == 48 && op.dns4CancelSequence != 0 && f.reply == op.dns4CancelSequence {
+				if op.dns4CancelAck || f.object != 0 || !profileDNSV2Body(48, f.body) || !c.clock().Before(x.cleanupDeadline) {
+					x.unknown = true
+					return true, errProfile
+				}
+				if f.body[2] != 1 {
+					x.unknown = true
+					c.dnsContext4Close(x)
+					return true, nil
+				}
+				if u64(f.body, 8) != op.sequence {
+					x.unknown = true
+					return true, errProfile
+				}
+				op.dns4CancelAck = true
+				c.dnsContext4Settle(op)
+				return true, nil
+			}
+		}
+		if f.kind == 48 && x.closeSequence != 0 && f.reply == x.closeSequence {
+			if x.closeAck || f.object != 0 || !profileDNSV2Body(48, f.body) || !c.clock().Before(x.cleanupDeadline) {
+				x.unknown = true
+				return true, errProfile
+			}
+			if f.body[2] != 1 {
+				x.unknown = true
+				c.dnsContext4Close(x)
+				return true, nil
+			}
+			if u64(f.body, 8) != x.identity.id {
+				x.unknown = true
+				return true, errProfile
+			}
+			x.closeAck = true
+			return true, nil
+		}
+	}
+	return false, nil
+}
+func (c *profileFlowControl) dnsContext4Tick() error {
+	for _, x := range c.dnsContexts4[:c.dnsContext4Used] {
+		if x.released || x.unknown {
+			continue
+		}
+		if !c.dnsCapture4Live(&x.source) || x.ctx.Err() != nil || x.revision != 0 && !c.clock().Before(x.deadline) {
+			c.dnsContext4Close(x)
+		}
+		if op := x.pending; op != nil && !op.dns4Replied && (x.closed || op.submitted && !c.clock().Before(op.deadline)) {
+			c.dnsContext4Close(x)
+			c.dnsNotify(op, errProfile)
+			if !op.submitted {
+				op.dns4Replied = true
+				c.dnsContext4Settle(op)
+			} else if !op.cancelled {
+				op.cancelled = true
+				seq, err := c.dnsCancel(1, op.sequence)
+				op.dns4CancelSequence = seq
+				if err != nil {
+					x.unknown = true
+					return err
+				}
+			}
+			if op.dns4CancelAck && !c.clock().Before(op.deadline) {
+				op.dns4Replied = true
+				c.dnsContext4Settle(op)
+			}
+		}
+		if !x.closed {
+			continue
+		}
+		if !c.clock().Before(x.cleanupDeadline) {
+			x.unknown = true
+			continue
+		}
+		if x.pending == nil && x.identity.id != 0 && x.closeSequence == 0 && x.hostReferences == 0 {
+			seq, err := c.dnsCancel(8, x.identity.id)
+			x.closeSequence = seq
+			if err != nil {
+				x.unknown = true
+				return err
+			}
+		}
+		if x.pending == nil && x.hostReferences == 0 && (x.identity.id == 0 || x.closeAck) {
+			x.released = true
+			c.operations--
+			if x.source.service != nil {
+				x.source.service.pending--
+			}
+		}
+	}
+	return nil
+}
+func (c *profileFlowControl) dnsContext4Floor(floor uint64) uint64 {
+	for _, x := range c.dnsContexts4[:c.dnsContext4Used] {
+		if x.released {
+			continue
+		}
+		for _, op := range x.requests[:x.used] {
+			if op.submitted && !op.dns4Replied && op.sequence < floor {
+				floor = op.sequence
+			}
+			if op.dns4CancelSequence != 0 && !op.dns4CancelAck && op.dns4CancelSequence < floor {
+				floor = op.dns4CancelSequence
+			}
+		}
+		if x.closeSequence != 0 && !x.closeAck && x.closeSequence < floor {
+			floor = x.closeSequence
+		}
+	}
+	return floor
+}
+func (c *profileFlowControl) dnsContext4Settle(op *profileOperation) {
+	if !op.dns4Settled && op.dns4Replied && (!op.cancelled || op.dns4CancelAck) {
+		op.dns4Settled = true
+		c.operations -= 2
+		if op.dnsContext4.pending == op {
+			op.dnsContext4.pending = nil
+		}
+	}
+}
