+			case "memory":
+				f.c.buffered = uint64(f.c.manifest.caps[4])
+			case "history":
+				f.c.dnsHistoryUsed = 256
+			case "id-cap":
+				f.c.dnsExportedUsed = len(f.c.dnsExported)
+			}
+			x, op, err := f.c.dnsContext4Acquire(ctx, s, nil)
+			if fault == "sourcegate" || fault == "role" || fault == "mapping" || fault == "parent" || fault == "peer" || fault == "path" || fault == "query" || fault == "credits" || fault == "memory" || fault == "history" || fault == "id-cap" {
+				if err == nil || op != nil || x != nil || f.p.ctx.Err() != nil {
+					t.Fatal("local preflight", err)
+				}
+				return
+			}
+			if err != nil || f.c.dispatch(op) != nil {
+				t.Fatal(err)
+			}
+			reply := dnsBundleReply(op, 701, 1)
+			switch fault {
+			case "late":
+				f.now = op.deadline
+			case "cancel":
+				f.c.mu.Lock()
+				f.c.dnsContext4Close(x)
+				f.c.mu.Unlock()
+				if f.c.dnsTick() != nil || op.dns4CancelSequence == 0 {
+					t.Fatal("request cancel")
+				}
+				ack := make([]byte, 32)
+				be.PutUint16(ack, 2)
+				ack[2] = 1
+				be.PutUint64(ack[8:], op.sequence)
+				be.PutUint64(ack[16:], f.c.lastSent)
+				if f.c.accept(profilePacket{kind: 48, reply: op.dns4CancelSequence, body: ack}) != nil {
+					t.Fatal("cancel ACK")
+				}
+			case "unknown":
+				clear(reply.body[3:])
+				reply.body[2] = 3
+			case "wrong-root":
+				be.PutUint64(reply.body[16:], 99)
+			case "wrong-epoch":
+				be.PutUint64(reply.body[32:], 99)
+			case "wrong-count":
+				be.PutUint16(reply.body[48:], 2)
+			case "wrong-revision":
+				be.PutUint64(reply.body[56:], 2)
+			case "lease":
+				be.PutUint64(reply.body[40:], u64(op.body, 40)+1)
+			}
+			_ = f.c.accept(reply)
+			if f.c.dnsContext4Live(x) || !x.closed || f.p.ctx.Err() != nil {
+				t.Fatal("bad/late reply published context or killed neighbor")
+			}
+			if fault != "late" && !x.unknown {
+				t.Fatal("uncertain cleanup lost custody")
