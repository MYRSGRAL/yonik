+	}
+	if e := f.c.accept(good); e != nil || opb.err != nil {
+		t.Fatal(e, opb.err)
+	}
+	if e := f.c.accept(late); e != nil {
+		t.Fatal(e)
+	}
+	if ga.id != 0 || !ga.closed || !f.c.grantLive(gb) || !f.c.receiptLive(b) {
+		t.Fatal("late grant/соседний flow")
+	}
+	last := f.writes[len(f.writes)-1]
+	if last.kind != 32 || last.body[0] != 3 || u64(last.body, 4) != late.object {
+		t.Fatal("late GRANT не отменён")
+	}
+	f.c.revoke()
+	if f.c.grantLive(gb) || b.ctx.Err() == nil {
+		t.Fatal("global revoke")
+	}
+}
