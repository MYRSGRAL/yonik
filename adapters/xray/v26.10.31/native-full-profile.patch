+	for _, id := range []uint64{0, ^uint64(0)} {
+		if _, e = profileSocketRecord(r, 3, id, 0, tuple); e == nil {
+			t.Fatal("invalid proof ID")
+		}
+	}
+	r.mode = 1
+	if _, e = profileProofBootstrap(r); e == nil {
+		t.Fatal("Local minted System bootstrap")
+	}
+	if _, e = profileSocketRecord(r, 3, 1, 0, tuple); e == nil {
+		t.Fatal("Local minted System socket proof")
