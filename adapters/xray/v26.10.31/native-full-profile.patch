+			case "cookie":
+				x.receiver.got.cookie++
+			case "peer":
+				x.receiver.got.tuple[5]++
+			case "flags":
+				x.receiver.got.flags = 1
+			}
+			if e := x.actor.receive(func() (profileProofPacket, error) {
+				return profileProofPacket{body: permit, credentials: 1, pid: 7}, nil
+			}); e != nil {
+				t.Fatal(e)
+			}
+			e := <-x.producer.readDone
+			x.producer.readDone <- e
+			_ = x.actor.producerTick()
+			if len(x.f.writes) != 0 || x.sends.Load() != 0 || x.f.p.admission.state != profileUnknown {
+				t.Fatal("mismatch published authority")
+			}
+		})
+	}
+}
+
+func TestProfileUDPProducerDelayedSendBlocksKnownCloseAndUncertainIsSticky(t *testing.T) {
+	for _, uncertain := range []bool{false, true} {
+		t.Run(map[bool]string{false: "delayed-completion", true: "uncertain-send"}[uncertain], func(t *testing.T) {
+			x := newUDPProducerFixture(t, 32002)
