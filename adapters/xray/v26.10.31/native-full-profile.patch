+func TestProfileDNSSetupActualBootFence(t *testing.T) {
+	_, r := syntheticProfileCapsule()
+	r.hostPID = 1001
+	r.hostStart = 42
+	record := make([]byte, 192)
+	copy(record, "YNKLOC01")
+	be.PutUint16(record[8:], 1)
+	be.PutUint16(record[10:], 192)
+	copy(record[16:], r.nonce[:])
+	copy(record[48:], r.digest[:])
+	copy(record[80:], r.session[:])
+	copy(record[96:], r.invocation[:])
+	be.PutUint64(record[112:], r.generation)
+	be.PutUint64(record[120:], r.epoch)
+	be.PutUint32(record[128:], r.hostPID)
+	be.PutUint64(record[136:], r.hostStart)
+	copy(record[152:], r.manifest[:])
+	for _, mode := range []string{"matching", "wrong-hash", "late", "cancel", "peer-death", "rights", "send-error", "wrong-sender"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			now := time.Unix(10, 0)
+			deadline := now.Add(time.Second)
+			stage := 0
+			rejected := 0
+			started := false
+			ops := profileDNSSetupOps{now: func() time.Time { return now }, alive: func() bool { return mode != "peer-death" }}
+			ops.send = func(b []byte) error {
+				if stage != 0 || len(b) != 272 {
+					t.Fatal("setup ordering")
+				}
+				stage = 1
+				return nil
+			}
+			if mode == "send-error" {
+				ops.send = func([]byte) error { return errors.New("failed") }
+			}
+			ops.receive = func(d time.Time) (profileProofPacket, error) {
+				if stage != 1 || d != deadline {
+					t.Fatal("deadline/order")
+				}
+				stage = 2
+				descriptor, e := profileDNSV2Descriptor(record)
+				if e != nil {
+					t.Fatal(e)
+				}
+				h := sha256.Sum256(descriptor[:])
+				b := append([]byte("DNSACK02"), h[:]...)
+				if mode == "wrong-hash" {
+					b[8] ^= 1
+				}
+				if mode == "late" {
+					now = deadline
+				}
+				if mode == "cancel" {
+					cancel()
+				}
+				p := profileProofPacket{body: b, credentials: 1, pid: int32(r.hostPID), uid: 1000}
+				if mode == "rights" {
+					p.count = 1
+				}
+				if mode == "wrong-sender" {
+					p.pid++
+				}
+				return p, nil
+			}
+			ops.reject = func(profileProofPacket) error { rejected++; return nil }
+			e := profileDNSSetup(ctx, r, record, deadline, 1000, ops)
+			if e == nil {
+				started = true
+			}
+			if started != (mode == "matching") {
+				t.Fatal("setup allowed/denied", mode, e)
+			}
+			if stage == 2 && rejected != 1 {
+				t.Fatal("packet custody not settled")
+			}
+		})
+	}
+}
