+// Проверяет consumed wire extent без materialization compressed names.
+func ownedDNSWireExtent(raw []byte) bool {
+	if len(raw) < 12 {
+		return false
+	}
+	off := 12
+	name := func() bool {
+		for {
+			if off >= len(raw) {
+				return false
+			}
+			n := int(raw[off])
+			off++
+			if n == 0 {
+				return true
+			}
+			if n&192 == 192 {
+				if off >= len(raw) {
+					return false
+				}
+				target := ((n & 63) << 8) | int(raw[off])
+				off++
+				return target < len(raw)
+			}
+			if n > 63 || off+n > len(raw) {
+				return false
+			}
+			off += n
+		}
+	}
+	for section := 0; section < 4; section++ {
+		count := int(binary.BigEndian.Uint16(raw[4+2*section:]))
+		for i := 0; i < count; i++ {
+			if !name() {
+				return false
+			}
+			size := 4
+			if section != 0 {
+				size = 10
+			}
+			if off+size > len(raw) {
+				return false
+			}
+			if section != 0 {
+				size += int(binary.BigEndian.Uint16(raw[off+8:]))
+			}
+			off += size
+			if off > len(raw) {
+				return false
+			}
+		}
+	}
+	return off == len(raw)
+}
