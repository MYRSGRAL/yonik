+func TestProfilePooledChainPerFlowWireAndPhysicalLifetime(t *testing.T) {
+	f := newFlowFixture(t, 1)
+	f.chainGraph(t, "grpc-udp-to-tcp")
+	defer f.serve(t)()
+	choose := func(tag string, d xnet.Destination) (bool, error) {
+		if tag != "b" || d.Network != xnet.Network_TCP || d.Port != 443 {
+			t.Error("actual hop selector", tag, d)
