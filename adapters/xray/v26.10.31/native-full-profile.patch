+func flowSubject(name string, kind byte, stream, tcp, udp uint16) []byte {
+	b := []byte{0, byte(len(name))}
+	b = append(b, []byte(name)...)
+	b = append(b, kind, 0)
+	for _, v := range []uint16{stream, tcp, udp} {
+		p := make([]byte, 2)
+		be.PutUint16(p, v)
+		b = append(b, p...)
+	}
+	return b
+}
+func flowScope(subject uint16, input, dial, carrier, action byte, endpoint, stream, chain uint16) []byte {
+	b := make([]byte, 24)
+	be.PutUint16(b, subject)
+	b[2] = input
+	b[3] = 1
+	b[4] = dial
+	b[5] = carrier
+	for i := 8; i < 20; i++ {
+		b[i] = 255
+	}
+	be.PutUint16(b[8:], endpoint)
+	be.PutUint16(b[12:], stream)
+	be.PutUint16(b[16:], chain)
+	b[20] = action
+	return b
+}
+func flowEndpoint(network byte, address string, port uint16) []byte {
+	return append((profileDestinationValue{network: network, address: address, port: port, family: 4}).encode(), 0, 0, 0, 0)
+}
+func flowEdge(source, next uint16) []byte {
+	b := make([]byte, 8)
+	be.PutUint16(b, source)
+	be.PutUint16(b[2:], next)
+	b[5] = 1
+	return b
+}
