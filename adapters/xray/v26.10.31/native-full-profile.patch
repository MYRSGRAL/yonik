+func TestProfileDNSNumericActualCallerRustPairAndPhysicalGuard(t *testing.T) {
+	for _, mode := range []byte{1, 2} {
+		for _, dnsNetwork := range []byte{6, 17} {
+			t.Run(string([]byte{'0' + mode, '0' + dnsNetwork%10}), func(t *testing.T) {
+				n := numericPublished(t, mode, dnsNetwork)
+				n.launch(t, n.source, n.target)
+				op := n.dnsTo42(t)
+				select {
+				case <-n.done:
+					t.Fatal("USER handoff before durable GRANT")
+				default:
+				}
+				if op.receipt.numericOnly {
+					t.Fatal("narrowing happened before effectful send")
+				}
+				plain, _ := op.ctx.Value(profileGrantKey{}).(*profileGrant)
+				if plain != nil {
+					t.Fatal("DNS grant leaked into USER request")
+				}
+				n.ack(t, op)
+				result := n.result(t)
+				if result.err != nil || !result.handled {
+					t.Fatal(result.err)
+				}
+				defer result.release()
+				if result.target.Address.String() != "203.0.113.9" || result.target.Port != 443 || result.target.Network != xnet.Network_TCP {
+					t.Fatal("DNS carrier/port replaced USER carrier")
+				}
+				if profileQueryFrom(result.ctx) != nil || profileDNSExchangeFrom(result.ctx) != nil {
+					t.Fatal("DNS context leaked into USER handoff")
+				}
+				if ProfileCheckDial(result.ctx, result.target, false) != nil || ProfileLogicalGate(result.ctx) != nil {
+					t.Fatal("private USER guard denied")
+				}
+				calls := 0
+				conn, err := ProfileDialPhysical(result.ctx, result.target, func(ctx context.Context) (net.Conn, error) {
+					calls++
+					if ProfilePhysicalGate(ctx) != nil {
+						t.Fatal("factory missing private physical scope")
+					}
+					if _, ok := ctx.Deadline(); !ok {
+						t.Fatal("numeric dial lost original deadline")
+					}
+					return &flowFakeConn{}, nil
+				})
+				if err != nil || conn == nil || calls != 1 {
+					t.Fatal("guarded factory failed", err)
+				}
+				_ = conn.Close()
+				if _, err = ProfileDialPhysical(result.ctx, result.target, func(context.Context) (net.Conn, error) { calls++; return &flowFakeConn{}, nil }); err == nil || calls != 1 {
+					t.Fatal("numeric grant reused for another physical dial")
+				}
+				if _, _, err = ProfileAuthorizeHandler(n.source, "a", n.target, false); !errors.Is(err, ErrProfileUnsupported) {
+					t.Fatal("ordinary AUTHORIZE bypass after narrowing", err)
+				}
+				if _, _, err = n.wire.f.c.authorize(result.ctx, op.receipt, 0, 0, op.grant.effective, op.grant); !errors.Is(err, ErrProfileUnsupported) {
+					t.Fatal("numeric refresh resurrected source", err)
+				}
+				wrong := result.target
+				wrong.Port++
+				if ProfileCheckDial(result.ctx, wrong, false) == nil {
+					t.Fatal("port hijack")
+				}
+				n.wire.f.now = op.grant.deadline
+				if ProfileLogicalGate(result.ctx) == nil {
+					t.Fatal("expired grant reused")
+				}
+			})
+		}
+	}
+}
