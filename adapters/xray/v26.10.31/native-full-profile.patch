--- /dev/null
+++ b/common/yonikbroker/profile_udp_actor_linux.go
@@ -0,0 +1,434 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+)
+
+// Единственный consumer proof-v2 — существующий runtime monitor. Submit не
+// выполняет I/O; actor methods вызываются только его goroutine.
+type profileUDPControlRequest struct {
+	producer                                              *profileUDPProducer
+	ctx                                                   context.Context
+	cancel                                                context.CancelFunc
+	accepted                                              *profileAccepted
+	done                                                  chan struct{}
+	closed                                                chan struct{}
+	association                                           *profileUDPAssociation
+	err                                                   error
+	slot                                                  int
+	operation, associate, closeID, proof, control, cookie uint64
+	deadline, sent                                        time.Time
+	phase                                                 byte
+	cancelPhase                                           byte
+	lateDelivery                                          bool
+	issuerClose                                           uint64
+}
+
+type profileUDPActor struct {
+	namespace func(profileProofFD, profileProofFD) error
+	runtime   *ProfileRuntime
+	mu        sync.Mutex
+	requests  [8]*profileUDPControlRequest
+	rejected  [32]profileProofFD
+	fdCredits int
+	failed    error
+	send      func([]byte, profileProofFD) error
+	inspect   func(profileProofFD, []byte) (profileUDPReceiver, error)
+}
+
+func (a *profileUDPActor) submit(ctx context.Context, accepted *profileAccepted) (*profileUDPControlRequest, error) {
+	p := a.runtime
+	if ctx == nil || ctx.Err() != nil || accepted == nil || accepted.runtime != p || accepted.ctx == nil || accepted.ctx.Err() != nil || accepted.provenance != 2 || accepted.proof == nil || !profileUDPv2Tuple(accepted.tuple, 6) || p.proofs == nil || p.proofs.version != 2 || !p.flowFresh() {
+		return nil, errProfile
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.failed != nil {
+		return nil, a.failed
+	}
+	slot := -1
+	for i, r := range a.requests {
+		if r != nil && r.accepted == accepted {
+			return nil, errProfile
+		}
+		if r == nil {
+			slot = i
+			break
+		}
+	}
+	if slot < 0 || a.fdCredits+6 > 64 {
+		return nil, errProfileFlowBusy
+	}
+	s := p.transportState()
+	s.mu.Lock()
+	count := s.pending
+	for _, v := range s.sockets {
+		if v != nil {
+			count++
+		}
+	}
+	for _, v := range s.objects {
+		if v != nil {
+			if _, ok := v.value.(*profileDNSConnection); ok {
+				count++
+			}
+		}
+	}
+	if !s.live() || count >= min(int(p.flow.manifest.caps[1]), 128) {
+		s.mu.Unlock()
+		return nil, errProfileFlowBusy
+	}
+	s.pending++
+	s.mu.Unlock()
+	reserved := false
+	defer func() {
+		if !reserved {
+			s.mu.Lock()
+			s.pending--
+			s.mu.Unlock()
+		}
+	}()
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	b := c.udpBudget
+	if b == nil || !c.live() || c.profileFDUsed()+6 > 64 || b.used+3 > min(int(c.manifest.caps[7]), 256) || c.profilePendingUsed()+3 > min(int(c.manifest.caps[3]), 64) || b.nextProofOperation > ^uint64(0)-4 || c.buffered+c.manifest.memoryCredit+profileUDPAssociationCredit > uint64(c.manifest.caps[4]) {
+		return nil, errProfileFlowBusy
+	}
+	// История control, associate и будущего close резервируется до первого send.
+	start := b.used
+	for range 3 {
+		c.udpReserveLocked()
+	}
+	p.proofs.mu.Lock()
+	if p.proofs.closed || p.proofs.lastProof >= ^uint64(0)-1 {
+		p.proofs.mu.Unlock()
+		return nil, errProfile
+	}
+	p.proofs.lastProof++
+	proof := p.proofs.lastProof
+	p.proofs.mu.Unlock()
+	child, cancel := context.WithCancel(ctx)
+	r := &profileUDPControlRequest{ctx: child, cancel: cancel, accepted: accepted, done: make(chan struct{}), closed: make(chan struct{}), slot: start, operation: b.entries[start].operation, associate: b.entries[start+1].operation, closeID: b.entries[start+2].operation, proof: proof, deadline: profileUDPControlDeadline(ctx, c.clock(), c.sessionDeadline)}
+	c.buffered += profileUDPAssociationCredit
+	a.fdCredits += 6
+	b.fdSlots += 6
+	a.requests[slot] = r
+	reserved = true
+	return r, nil
+}
+
+func (a *profileUDPActor) failLocked(e error) error {
+	a.failed = errors.Join(a.failed, e, errProfile)
+	for _, r := range a.requests {
+		if r == nil {
+			continue
+		}
+		r.cancel()
+		if r.association != nil {
+			a.failed = errors.Join(a.failed, r.association.CloseAndJoin())
+		}
+		if r.phase < 4 {
+			close(r.done)
+		}
+		r.err = a.failed
+		if r.producer != nil && !r.producer.notified {
+			r.producer.result = a.failed
+			r.producer.notified = true
+			close(r.closed)
+		}
+		if r.phase != 5 {
+			close(r.closed)
+		}
+		r.phase = 5
+	}
+	// Local duplicate cleanup не является durable issuer retirement. Все
+	// credits/custody остаются retained; UCR/KnownClosed здесь не публикуется.
+	a.runtime.flow.mu.Lock()
+	a.runtime.flow.revoked = true
+	a.runtime.flow.mu.Unlock()
+	a.runtime.mu.Lock()
+	a.runtime.admission.state = profileUnknown
+	a.runtime.mu.Unlock()
+	a.runtime.cancel()
+	return a.failed
+}
+
+func (a *profileUDPActor) tick() error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.failed != nil {
+		return a.failed
+	}
+	p := a.runtime
+	for _, r := range a.requests {
+		if r == nil {
+			continue
+		}
+		if r.ctx.Err() != nil || r.accepted.ctx.Err() != nil {
+			a.retireCancelledLocked(r)
+			// Отмена control изолирована. До durable retirement ACK credits и
+			// tombstones этого request остаются retained, соседний relay жив.
+			continue
+		}
+		if !p.flow.clock().Before(r.deadline) && r.phase < 4 {
+			return a.failLocked(errProfile)
+		}
+		if r.phase == 5 {
+			continue
+		}
+		if r.phase == 4 {
+			continue
+		}
+		var tail [64]byte
+		kind, n := 0, 64
+		be.PutUint64(tail[:], r.operation)
+		if r.phase == 0 {
+			be.PutUint64(tail[8:], r.proof)
+			be.PutUint16(tail[16:], r.accepted.index)
+			tail[18] = 3
+			copy(tail[20:60], r.accepted.tuple[:])
+		} else if r.phase == 2 {
+			kind, n = 2, 32
+			be.PutUint64(tail[:], r.associate)
+			be.PutUint64(tail[8:], r.control)
+			be.PutUint64(tail[16:], r.cookie)
+		} else {
+			return nil
+		}
+		b, size, e := profileUDPEncode(p.admission.launch, kind, tail[:n])
+		if e != nil || a.send == nil {
+			return a.failLocked(errProfile)
+		}
+		var fd profileProofFD
+		if kind == 0 {
+			fd = r.accepted.proof
+		}
+		e = a.send(b[:size], fd)
+		if e == errProfileProofBusy {
+			return nil
+		}
+		if e != nil {
+			return a.failLocked(e)
+		}
+		if r.phase == 0 {
+			r.sent = p.flow.clock()
+			r.phase = 1
+		} else {
+			r.phase = 3
+		}
+		if r.ctx.Err() != nil || r.accepted.ctx.Err() != nil {
+			a.retireCancelledLocked(r)
+		}
+		return nil
+	}
+	return nil
+}
+
+func (a *profileUDPActor) retireCancelledLocked(r *profileUDPControlRequest) {
+	if r.phase == 5 {
+		return
+	}
+	r.cancelPhase = r.phase
+	r.cancel()
+	r.err = errProfile
+	if r.association != nil {
+		r.err = errors.Join(r.err, r.association.CloseAndJoin())
+	}
+	if r.phase < 4 {
+		close(r.done)
+	}
+	r.phase = 5
+	close(r.closed)
+}
+
+// Резервируются все16 ancillary scratch rights ДО recvmsg/materialization.
+func (a *profileUDPActor) receive(read func() (profileProofPacket, error)) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.failed != nil {
+		return errProfile
+	}
+	release, err := a.runtime.leaseProfileRX()
+	if err != nil {
+		return err
+	}
+	clean := false
+	defer func() { release(clean) }()
+	packet, e := read()
+	if e == nil {
+		e = a.packetLocked(packet)
+	}
+	if e != nil {
+		for i, fd := range packet.rights {
+			if fd != nil {
+				if ce := fd.Close(); ce != nil {
+					a.rejected[i] = fd
+					e = errors.Join(e, ce)
+				}
+			}
+		}
+		return a.failLocked(e)
+	}
+	clean = true
+	return nil
+}
+
+func (a *profileUDPActor) packetLocked(packet profileProofPacket) error {
+	p := a.runtime
+	if packet.invalid || packet.credentials != 1 || !profileSenderValid(p.admission.launch, packet.pid, packet.uid, 0) || packet.rightsMessages != packet.count || packet.count > 1 {
+		return errProfile
+	}
+	kind, e := profileUDPDecode(p.admission.launch, packet.body, packet.count, true)
+	if e != nil {
+		return e
+	}
+	if kind == 5 || kind == 7 || kind == 8 {
+		for _, r := range a.requests {
+			if r != nil && r.producer != nil && r.association != nil && u64(packet.body, 128) == r.association.id {
+				return r.producer.packet(kind, packet.body)
+			}
+		}
+	}
+	for _, r := range a.requests {
+		if r == nil {
+			continue
+		}
+		if r.ctx.Err() != nil || r.accepted.ctx.Err() != nil {
+			a.retireCancelledLocked(r)
+		}
+		if kind == 8 && r.association != nil && u64(packet.body, 128) == r.association.id && u64(packet.body, 144) == r.control {
+			id := u64(packet.body, 136)
+			for _, other := range a.requests {
+				if other != nil && other.issuerClose == id {
+					return errProfile
+				}
+			}
+			r.issuerClose = id
+			p.flow.mu.Lock()
+			entry := &p.flow.udpBudget.entries[r.slot+2]
+			entry.namespace = 3
+			entry.operation = id
+			p.flow.mu.Unlock()
+			r.cancel()
+			r.err = errors.Join(ErrProfileUnsupported, r.association.CloseAndJoin())
+			if r.phase != 5 {
+				r.phase = 5
+				close(r.closed)
+			}
+			return nil
+		}
+		if r.phase >= 4 {
+			if r.phase == 5 && r.ctx.Err() != nil {
+				if kind == 1 && r.cancelPhase == 1 && r.control == 0 && u64(packet.body, 128) == r.operation {
+					r.control = u64(packet.body, 136)
+					r.cookie = u64(packet.body, 144)
+					return nil
+				}
+				if kind == 3 && r.cancelPhase == 3 && !r.lateDelivery && u64(packet.body, 128) == r.associate && u64(packet.body, 136) == r.control && packet.rights[0] != nil {
+					r.lateDelivery = true
+					return packet.rights[0].Close()
+				}
+			}
+			continue
+		}
+		if r.ctx.Err() != nil || r.accepted.ctx.Err() != nil || !p.flow.clock().Before(r.deadline) {
+			return errProfile
+		}
+		b := packet.body
+		if kind == 1 && r.phase == 1 && u64(b, 128) == r.operation {
+			r.control, r.cookie = u64(b, 136), u64(b, 144)
+			limit := r.sent.Add(time.Duration(u64(b, 152)))
+			if limit.Before(r.deadline) {
+				r.deadline = limit
+			}
+			if !p.flow.clock().Before(r.deadline) {
+				return errProfile
+			}
+			r.phase = 2
+			p.flow.mu.Lock()
+			entry := &p.flow.udpBudget.entries[r.slot]
+			if !entry.terminal {
+				entry.terminal = true
+				p.flow.udpBudget.proofPending--
+			}
+			p.flow.mu.Unlock()
+			return nil
+		}
+		if kind == 3 && r.phase == 3 && u64(b, 128) == r.associate && u64(b, 136) == r.control && packet.rights[0] != nil && a.inspect != nil {
+			if a.namespace == nil {
+				return ErrProfileUnsupported
+			}
+			p.flow.mu.Lock()
+			control := r.accepted.proof
+			p.flow.mu.Unlock()
+			if e := a.namespace(control, packet.rights[0]); e != nil {
+				return e
+			}
+			var receiver profileUDPReceiver
+			var inspectError error
+			receiver, inspectError = a.inspect(packet.rights[0], b)
+			if inspectError != nil || receiver == nil {
+				return errors.Join(errProfile, inspectError)
+			}
+			if owned, ok := receiver.(*profileOSUDPReceiver); ok {
+				owned.namespace = func() error {
+					p.flow.mu.Lock()
+					control := r.accepted.proof
+					p.flow.mu.Unlock()
+					return profileKernelSocketNamespace(control, owned.fd)
+				}
+			}
+			// Ownership передаётся только после exact FD inspection. Constructor
+			// уже владеет prepaid buffer/history reservation, в том числе при error.
+			r.association, e = profileNewUDPAssociationReserved(p.flow, p.admission.launch, r.ctx, b, func() (profileUDPReceiver, error) { return receiver, nil }, r.slot+1)
+			if e != nil {
+				if r.ctx.Err() != nil || r.accepted.ctx.Err() != nil {
+					var cleanup error
+					if r.association != nil {
+						cleanup = r.association.CloseAndJoin()
+					} else {
+						cleanup = errors.Join(receiver.Close(), receiver.Join())
+					}
+					a.retireCancelledLocked(r)
+					return cleanup
+				}
+				return e
+			}
+			r.phase = 4
+			close(r.done)
+			return nil
+		}
+	}
+	return errProfile
+}
+
+// Deadline задаётся до первого control effect и не обновляется ответом.
+func profileUDPControlDeadline(ctx context.Context, now, session time.Time) time.Time {
+	d := now.Add(time.Second)
+	if session.Before(d) {
+		d = session
+	}
+	if v, ok := ctx.Deadline(); ok && v.Before(d) {
+		d = v
+	}
+	return d
+}
+
+func (p *ProfileRuntime) reserveUDPInput() (func(bool), error) {
+	if p.flow == nil {
+		return nil, errProfile
+	}
+	p.flow.mu.Lock()
+	ready := p.flow.udpBudget != nil
+	p.flow.mu.Unlock()
+	if !ready {
+		return nil, errProfile
+	}
+	return p.leaseProfileRX()
+}
