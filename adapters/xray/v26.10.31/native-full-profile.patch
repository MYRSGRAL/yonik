+func TestProfileUDPConsumingProducerTransfersOnlyMatchedUserGrant(t *testing.T) {
+	f, a, receiver := udpStateFixture(t)
+	if e := a.BeginPeek(f.now.Add(time.Second)); e != nil {
+		t.Fatal(e)
+	}
+	if e := a.Permit(udpPermit(t, a, receiver, 1, 1)); e != nil {
+		t.Fatal(e)
+	}
+	if e := a.ConsumePermit(); e != nil {
+		t.Fatal(e)
+	}
+	producer := &profileUDPProducer{association: a}
+	if e := producer.transfer(f.p.ctx, nil); e == nil {
+		t.Fatal("pre-Match payload released")
+	}
+	accepted := &profileAccepted{runtime: f.p, ctx: f.p.ctx, index: 0, provenance: 3, tuple: receiver.got.tuple}
+	r, op, e := f.c.open(f.p.ctx, 0, 3, receiver.got.tuple, a.original, accepted)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = f.c.dispatch(op); e != nil {
+		t.Fatal(e)
+	}
+	if _, e = a.Consumed(op.sequence); e != nil {
+		t.Fatal(e)
+	}
+	if e = a.Match(udpMatch(t, a, 1)); e != nil {
+		t.Fatal(e)
+	}
+	producer.current = &profileUDPFlow{producer: producer, receipt: r, ctx: f.p.ctx, cancel: func() {}, tuple: r.tuple, original: r.original, payload: append([]byte(nil), a.buffers[0][a.header:a.length]...), credit: true}
+	r.udp = producer.current
+	r.udp.matched.Store(true)
+	if e = producer.transfer(f.p.ctx, nil); e == nil {
+		t.Fatal("Match became FlowGrant")
+	}
+	if e = f.c.accept(f.ingressReply(op)); e != nil {
+		t.Fatal(e)
+	}
+	g, authorize, e := f.c.authorize(f.p.ctx, r, 1, 0, a.original, nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = f.c.dispatch(authorize); e != nil {
+		t.Fatal(e)
+	}
+	if e = producer.transfer(f.p.ctx, g); e == nil {
+		t.Fatal("AUTHORIZE became grant")
+	}
+	if e = f.c.accept(f.grantReply(authorize, 2)); e != nil {
+		t.Fatal(e)
+	}
+	ctx := context.WithValue(context.WithValue(context.WithValue(f.p.ctx, profileContextKey{}, f.p), profileReceiptKey{}, r), profileGrantKey{}, g)
+	if e = producer.transfer(ctx, g); e != nil {
+		t.Fatal("actual matched UDP class1 GRANT cannot transfer", e)
+	}
+}
