+// Вход только из classic producer: exact packed query, не JSON/tag/session grant.
+func ProfileDNSExchangeContext(ctx context.Context, request []byte, target xnet.Destination) (context.Context, func(), error) {
+	noop := func() {}
+	if ctx == nil {
+		return ctx, noop, errProfile
+	}
+	if !ProfileResolverRequired(ctx) {
+		return ctx, noop, nil
+	}
+	p := profileRuntime(ctx)
+	q := profileQueryFrom(ctx)
+	if p == nil || q == nil || q.runtime != p || ctx.Err() != nil || !p.dnsV2 || len(request) < 12 || len(request) > 512 || u16(request, 4) != 1 || u16(request, 6) != 0 || u16(request, 8) != 0 || u16(request, 10) > 1 || q.receipt == nil || len(q.original) < 1 || len(q.original) > 253 {
+		return ctx, noop, ErrProfileUnsupported
+	}
+	targetValue, err := profileValue(target)
+	if err != nil || targetValue.family == 3 {
+		return ctx, noop, ErrProfileUnsupported
+	}
+	c := p.flow
+	c.mu.Lock()
+	if !q.liveLocked() || c.nextDNSQuery >= ^uint64(0)-1 || c.buffered+c.manifest.memoryCredit+profileDNSExchangeCredit > uint64(c.manifest.caps[4]) {
+		c.mu.Unlock()
+		return ctx, noop, errProfileFlowBusy
+	}
+	resolver := -1
+	for i, row := range c.manifest.rows[4] {
+		peer, ok := profileDecodedDestination(row[36:])
+		if ok && peer == targetValue {
+			if resolver != -1 {
+				c.mu.Unlock()
+				return ctx, noop, ErrProfileUnsupported
+			}
+			resolver = i
+		}
+	}
+	if resolver < 0 {
+		c.mu.Unlock()
+		return ctx, noop, ErrProfileUnsupported
+	}
+	if c.manifest.rows[4][resolver][0] == 2 && (p.snapshot == nil || len(c.manifest.rows[10]) != 1 || u32(c.manifest.rows[10][0], 72)&2 == 0) {
+		c.mu.Unlock()
+		return ctx, noop, ErrProfileUnsupported
+	}
+	q.refs++
+	c.buffered += profileDNSExchangeCredit
+	c.nextDNSQuery++
+	id := c.nextDNSQuery
+	c.mu.Unlock()
+	child, cancel := context.WithCancel(ctx)
+	// Original receipt остаётся private source; прежний USER FlowGrant не
+	// переносится в DNS logical consumer и не становится DNSHopPermit.
+	child = context.WithValue(child, profileGrantKey{}, (*profileGrant)(nil))
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			cancel()
+			c.mu.Lock()
+			q.refs--
+			c.buffered -= profileDNSExchangeCredit
+			q.releaseLocked()
+			c.mu.Unlock()
+		})
+	}
+	var message dnsmessage.Message
+	if err = message.Unpack(request); err != nil || message.Header.Response || message.Header.Truncated || message.Header.OpCode != 0 || message.Header.RCode != 0 || len(message.Questions) != 1 {
+		release()
+		return ctx, noop, errProfile
+	}
+	question := message.Questions[0]
+	// Protected classic producer использует тот же AppendPack. Сравнение
+	// закрывает trailing/alternate encoding, исходные bytes не переписываются.
+	packed, packError := message.Pack()
+	if packError != nil || !bytes.Equal(packed, request) {
+		release()
+		return ctx, noop, errProfile
+	}
+	if question.Class != dnsmessage.ClassINET || question.Type != dnsmessage.TypeA && question.Type != dnsmessage.TypeAAAA || profileCanonicalQuery(question.Name.String()) != q.name {
+		release()
+		return ctx, noop, errProfile
+	}
+	e := &profileDNSExchange{query: q, id: id, original: q.original, target: targetValue, qtype: uint16(question.Type)}
+	if message.Header.RecursionDesired {
+		e.options |= 1
+	}
+	if message.Header.CheckingDisabled {
+		e.options |= 2
+	}
+	if message.Header.AuthenticData {
+		e.options |= 16
+	}
+	for _, opt := range message.Additionals {
+		if opt.Header.Type != dnsmessage.TypeOPT || opt.Header.Name.String() != "." {
+			release()
+			return ctx, noop, ErrProfileUnsupported
+		}
+		e.options |= 8
+		e.payload = uint16(opt.Header.Class)
+		if opt.Header.TTL&32768 != 0 {
+			e.options |= 4
+		}
+	}
+	if e.options&8 == 0 && (e.payload != 0 || e.options&4 != 0) || e.options&8 != 0 && (e.payload < 512 || e.payload > 4096) {
+		release()
+		return ctx, noop, errProfile
+	}
+	e.ctx = context.WithValue(child, profileDNSExchangeKey{}, e)
+	e.request = append([]byte(nil), request...)
+	g, op, err := c.authorizeDNS(e.ctx, q.receipt, uint16(resolver), q.name)
+	if err == nil {
+		err = p.flowRPC(op)
+	}
+	if err != nil {
+		release()
+		return ctx, noop, err
+	}
+	c.mu.Lock()
+	e.root = g
+	g.dnsOwner = e
+	c.mu.Unlock()
+	stop := context.AfterFunc(child, func() {
+		release()
+		c.mu.Lock()
+		c.closeGrant(g)
+		if e.bundle != nil {
+			c.dnsClose(e.bundle)
+		}
+		c.mu.Unlock()
+	})
+	return e.ctx, func() {
+		stop()
+		release()
+		c.mu.Lock()
+		c.closeGrant(g)
+		if e.bundle != nil {
+			c.dnsClose(e.bundle)
+		}
+		c.mu.Unlock()
+	}, nil
+}
+
+// Gate разрешает только metadata route selection. Payload/physical factory
+// по-прежнему требуют bundle и отдельный не реализованный transport proof.
+func profileDNSDispatchGate(ctx context.Context, target xnet.Destination) error {
+	e := profileDNSExchangeFrom(ctx)
+	p := profileRuntime(ctx)
+	value, err := profileValue(target)
+	if e == nil || p == nil || e.query.runtime != p || profileQueryFrom(ctx) != e.query || profileReceiptFrom(ctx) != e.query.receipt || err != nil || value != e.target || ctx.Err() != nil {
+		return errProfile
+	}
+	p.flow.mu.Lock()
+	defer p.flow.mu.Unlock()
+	if !p.flow.dnsRootLive(e) {
+		return errProfile
+	}
+	return nil
+}
