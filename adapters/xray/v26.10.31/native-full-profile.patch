+			query, release, e := ProfileDNSQueryContext(ctx, "192.0.2.1")
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer release()
+			ips, _, e := profileLookupSnapshot(query, "192.0.2.1", true, false)
+			if mapping == 4 {
+				if e == nil || len(ips) != 0 {
+					t.Fatal("mapping4 received V1 snapshot result without WaiterReceipt")
+				}
+			} else if e != nil || len(ips) != 1 {
+				t.Fatal("legacy snapshot changed", e)
+			}
+		})
+	}
+}
diff --git a/common/yonikbroker/profile_dns_tasks_linux.go b/common/yonikbroker/profile_dns_tasks_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_dns_tasks_linux.go
@@ -0,0 +1,193 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"errors"
+	"io"
+	"sync"
+)
+
+const profileDNSTaskCredit = 384 * 1024
+const profileDNSTaskRetainedCredit = 16 * 1024
+
+// Только lifetime/custody. Task не разрешает DNS I/O и не является grant.
+type ProfileDNSTask struct {
+	query             *profileDNSQuery
+	slot              int
+	mu                sync.Mutex
+	value             io.Closer
+	settled, finished bool
+	once              sync.Once
+	err               error
+	finalErr          error
+	finishedDone      chan struct{}
+	stop              func() bool
+}
+
+func ProfileDNSBeginTask(ctx context.Context) (*ProfileDNSTask, error) {
+	if ctx == nil {
+		return nil, errProfile
+	}
+	if !ProfileResolverRequired(ctx) || profileQueryFrom(ctx) == nil {
+		return nil, nil
+	}
+	p := profileRuntime(ctx)
+	q := profileQueryFrom(ctx)
+	if p == nil || q == nil || q.runtime != p {
+		return nil, ErrProfileUnsupported
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	pending := c.profilePendingUsed()
+	history := c.dnsTasksUsed + c.dnsHistoryUsed
+	if c.udpBudget != nil {
+		history = c.udpBudget.used
+	} else {
+		history += c.operations
+		for _, entry := range c.tombs {
+			if entry.sequence != 0 {
+				history++
+			}
+		}
+	}
+	if !q.liveLocked() || pending >= 64 || pending >= int(c.manifest.caps[3]) || history >= 256 || history >= int(c.manifest.caps[7]) || c.dnsTasksUsed >= len(c.dnsTasks) || c.buffered+c.manifest.memoryCredit+profileDNSTaskCredit > uint64(c.manifest.caps[4]) {
+		return nil, errProfileFlowBusy
+	}
+	slot := -1
+	if c.udpBudget != nil {
+		c.udpBudget.entries[c.udpBudget.used] = profileUDPRetainedOperation{namespace: 9}
+		slot = c.udpBudget.used
+		c.udpBudget.used++
+	}
+	t := &ProfileDNSTask{query: q, slot: slot, finishedDone: make(chan struct{})}
+	c.dnsTasks[c.dnsTasksUsed] = t
+	c.dnsTasksUsed++
+	c.dnsTasksActive++
+	q.refs++
+	c.buffered += profileDNSTaskCredit
+	return t, nil
+}
+
+// Только query metadata scope; network permission всё равно требует class3.
+func ProfileDNSQueryGate(ctx context.Context) error {
+	if ctx == nil {
+		return errProfile
+	}
+	if !ProfileResolverRequired(ctx) {
+		return nil
+	}
+	p := profileRuntime(ctx)
+	q := profileQueryFrom(ctx)
+	if p == nil || q == nil || q.runtime != p {
+		return ErrProfileUnsupported
+	}
+	p.flow.mu.Lock()
+	defer p.flow.mu.Unlock()
+	if !q.liveLocked() {
+		return errProfile
+	}
+	return nil
+}
+
+// Own вызывается ровно один раз после synchronous factory, даже при value+error.
+// До результата factory reservation остаётся visible; cancel не теряет custody.
+func (t *ProfileDNSTask) Own(value io.Closer) error {
+	if t == nil {
+		return nil
+	}
+	return t.OwnContext(t.query.ctx, value)
+}
+
+// Deadline конкретного exchange может быть короче lifetime query. Factory
+// result всё равно сначала попадает в custody, даже при foreign/cancelled ctx.
+func (t *ProfileDNSTask) OwnContext(ctx context.Context, value io.Closer) error {
+	if t == nil {
+		return nil
+	}
+	t.mu.Lock()
+	if t.settled || t.finished {
+		t.mu.Unlock()
+		return errProfile
+	}
+	t.value = value
+	t.settled = true
+	valid := ctx != nil && profileQueryFrom(ctx) == t.query
+	if valid {
+		t.stop = context.AfterFunc(ctx, func() { _ = t.closeValue() })
+	}
+	cancelled := !valid || ctx.Err() != nil || t.query.ctx.Err() != nil
+	t.mu.Unlock()
+	if cancelled {
+		return errors.Join(errProfile, t.closeValue())
+	}
+	return nil
+}
+
+func (t *ProfileDNSTask) closeValue() error {
+	t.once.Do(func() {
+		t.mu.Lock()
+		value := t.value
+		t.mu.Unlock()
+		if value != nil {
+			t.err = ProfileCleanupResource(value)
+			if t.err != nil {
+				t.unknown()
+			}
+		}
+	})
+	return t.err
+}
+
+func (t *ProfileDNSTask) unknown() {
+	p := t.query.runtime
+	p.mu.Lock()
+	p.admission.state = profileUnknown
+	p.mu.Unlock()
+	p.cancel()
+}
+
+// Вызывается worker в самом конце, не из Close callback самого resource.
+func (t *ProfileDNSTask) Finish(cause ...error) error {
+	if t == nil {
+		return nil
+	}
+	t.mu.Lock()
+	if t.finished {
+		done := t.finishedDone
+		t.mu.Unlock()
+		<-done
+		return t.finalErr
+	}
+	t.finished = true
+	t.settled = true
+	stop := t.stop
+	t.mu.Unlock()
+	if stop != nil {
+		stop()
+	}
+	result := errors.Join(append([]error{t.closeValue()}, cause...)...)
+	q := t.query
+	c := q.runtime.flow
+	c.mu.Lock()
+	if result == nil {
+		if t.slot >= 0 {
+			c.udpBudget.entries[t.slot].terminal = true
+		}
+		q.refs--
+		c.dnsTasksActive--
+		c.buffered -= profileDNSTaskCredit - profileDNSTaskRetainedCredit
+		q.releaseLocked()
+	}
+	c.mu.Unlock()
+	if result != nil {
+		t.unknown()
+	}
+	// Unknown удерживает value/query/credit. Known task metadata также retained:
+	// ID/history не переиспользуются и не превращаются в long-lived обещание.
+	t.finalErr = result
+	close(t.finishedDone)
+	return result
+}
diff --git a/common/yonikbroker/profile_dns_tasks_linux_test.go b/common/yonikbroker/profile_dns_tasks_linux_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_dns_tasks_linux_test.go
@@ -0,0 +1,126 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+)
+
+type dnsTaskCloser struct {
+	entered, release chan struct{}
+	calls            atomic.Int32
+	err              error
+}
+
+func (c *dnsTaskCloser) Close() error { c.calls.Add(1); close(c.entered); <-c.release; return c.err }
+
+func dnsTaskFixture(t *testing.T) (*flowFixture, context.Context, func()) {
+	f := newFlowFixture(t, 1)
+	r := f.admittedReceipt(t, "task.invalid")
+	ctx := context.WithValue(context.WithValue(f.p.ctx, profileContextKey{}, f.p), profileReceiptKey{}, r)
+	q, release, e := ProfileDNSQueryContext(ctx, "task.invalid")
+	if e != nil {
+		t.Fatal(e)
+	}
+	return f, q, release
+}
+
+func TestProfileDNSTaskCancelJoinAndUnknownCustody(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "known", true: "unknown"}[failed], func(t *testing.T) {
+			f, ctx, release := dnsTaskFixture(t)
+			q := profileQueryFrom(ctx)
+			before := f.c.buffered
+			task, e := ProfileDNSBeginTask(ctx)
+			if e != nil {
+				t.Fatal(e)
+			}
+			value := &dnsTaskCloser{entered: make(chan struct{}), release: make(chan struct{})}
+			if failed {
+				value.err = errors.New("cleanup unknown")
+			}
+			if e = task.Own(value); e != nil {
+				t.Fatal(e)
+			}
+			release()
+			<-value.entered
+			if q.refs != 1 || f.c.dnsQueries[q.slot] != q || f.c.buffered < before+profileDNSTaskCredit {
+				t.Fatal("cancel освободил ещё живой worker")
+			}
+			done := make(chan error, 1)
+			go func() { done <- task.Finish() }()
+			select {
+			case <-done:
+				t.Fatal("Finish не дождался Close")
+			default:
+			}
+			close(value.release)
+			e = <-done
+			if failed {
+				if e == nil || q.refs != 1 || f.c.dnsQueries[q.slot] != q || f.p.admission.state != profileUnknown || task.value != value {
+					t.Fatal("Unknown потерял custody")
+				}
+			} else {
+				if e != nil || q.refs != 0 || f.c.dnsQueries[q.slot] != nil {
+					t.Fatal("known join не освобождён", e)
+				}
+			}
+			if again := task.Finish(); again != e || value.calls.Load() != 1 {
+				t.Fatal("повторный Finish изменил final result")
+			}
+		})
+	}
+}
+
+func TestProfileDNSTaskPendingCancelBeforeFactoryResult(t *testing.T) {
+	f, ctx, release := dnsTaskFixture(t)
+	q := profileQueryFrom(ctx)
+	task, e := ProfileDNSBeginTask(ctx)
+	if e != nil {
+		t.Fatal(e)
+	}
+	release()
+	value := &dnsTaskCloser{entered: make(chan struct{}), release: make(chan struct{}), err: errors.New("late cleanup unknown")}
+	close(value.release)
+	if e = task.Own(value); e == nil {
+		t.Fatal("cancelled factory result опубликован")
+	}
+	if e = task.Finish(); e == nil || q.refs != 1 || f.c.dnsQueries[q.slot] != q || task.value != value || value.calls.Load() != 1 {
+		t.Fatal("late resource потерян")
+	}
+}
+
+func TestProfileDNSTaskPrecreditBeforeAllocation(t *testing.T) {
+	f, ctx, release := dnsTaskFixture(t)
+	defer release()
+	q := profileQueryFrom(ctx)
+	f.c.buffered = uint64(f.c.manifest.caps[4])
+	if task, e := ProfileDNSBeginTask(ctx); e == nil || task != nil || q.refs != 0 || f.c.dnsTasksUsed != 0 {
+		t.Fatal("task до credits")
+	}
+}
+
+func TestProfileDNSTaskActualExchangeDeadlineDoesNotBorrowParentLifetime(t *testing.T) {
+	f, ctx, release := dnsTaskFixture(t)
+	defer release()
+	child, cancel := context.WithCancel(ctx)
+	cancel()
+	task, e := ProfileDNSBeginTask(ctx)
+	if e != nil {
+		t.Fatal(e)
+	}
+	value := &dnsTaskCloser{entered: make(chan struct{}), release: make(chan struct{})}
+	close(value.release)
+	if e = task.OwnContext(child, value); e == nil {
+		t.Fatal("expired exchange published under live parent query")
+	}
+	if e = task.Finish(); e != nil {
+		t.Fatal(e)
+	}
+	if value.calls.Load() != 1 || f.p.ctx.Err() != nil || profileQueryFrom(ctx).closed {
+		t.Fatal("exchange cancel killed query/session or lost custody")
+	}
+}
