+			return false
+		}
+		if p[0] == 2 {
+			if counts(11) != 1 || !bytes.Equal(p[4:], m.rows[10][0][:32]) {
+				return false
+			}
+		}
+	}
+	for _, b := range m.rows[5] {
+		c := profileCursor{b: b}
+		p := c.take(2)
+		category := c.str(160)
+		hash := c.take(32)
+		size := c.take(8)
