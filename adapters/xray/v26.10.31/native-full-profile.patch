+		rows[8] = [][]byte{flowScope(0, 6, 6, 17, 2, 0, 0, 0), flowScope(0, 17, 6, 17, 2, 0, 0, 1), flowScope(1, 6, 6, 6, 1, 1, 1, 65535), flowScope(1, 17, 17, 17, 1, 2, 65535, 65535)}
+		rows[2] = [][]byte{flowEdge(0, 3), flowEdge(1, 3)}
+		// TCP mux disabled, XUDP enabled, UDP/443 skip: B TCP normal;
+		// B UDP имеет обе branches, но source endpoint:443 выбирает normal.
+		s := rows[8][3]
