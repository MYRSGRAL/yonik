+func syntheticProfileCapsule() ([]byte, profileLaunch) {
+	r := profileLaunch{mode: 1, generation: 1, epoch: 1}
+	r.digest = sha256.Sum256([]byte("config"))
+	r.nonce[0] = 1
+	r.session[0] = 1
+	r.invocation[0] = 2
+	var rows [11][][]byte
+	subject := []byte{0, 1, 'a', 5, 0, 0, 0, 0, 0, 0, 1}
+	rows[0] = [][]byte{subject}
+	stream := make([]byte, 36)
+	stream[0] = 1
+	stream[4] = 1
+	rows[3] = [][]byte{stream}
+	ingress := []byte{2, 3, 0x12, 0x34, 0, 1, 'i'}
+	rows[6] = [][]byte{ingress}
+	for i, network := range []byte{6, 17} {
+		s := make([]byte, 24)
+		s[2] = network
+		s[3] = 1
+		s[4] = network
+		s[5] = network
+		for j := 8; j < 20; j++ {
+			s[j] = 255
+		}
+		if i == 0 {
+			be.PutUint16(s[12:], 0)
+		}
+		s[20] = 3
+		rows[8] = append(rows[8], s)
+	}
+	b := make([]byte, 128)
+	be.PutUint64(b[64:], 1)
+	be.PutUint32(b[72:], 60000)
+	b[76] = 1
+	be.PutUint16(b[78:], 3)
+	be.PutUint64(b[80:], 1)
+	for i, v := range profileMaxCaps {
+		be.PutUint32(b[88+i*4:], v)
+	}
+	be.PutUint16(b[120:], 11)
+	for i, table := range rows {
+		var encoded []byte
+		for _, row := range table {
+			p := make([]byte, 4)
+			be.PutUint16(p, uint16(len(row)))
+			encoded = append(encoded, p...)
+			encoded = append(encoded, row...)
+		}
+		prefix := make([]byte, 8)
+		be.PutUint16(prefix, uint16(i+1))
+		be.PutUint16(prefix[2:], uint16(len(table)))
+		be.PutUint32(prefix[4:], uint32(len(encoded)))
+		b = append(b, prefix...)
+		b = append(b, encoded...)
+	}
+	rehashProfileCapsule(b, &r)
+	return b, r
+}
+func rehashProfileCapsule(b []byte, r *profileLaunch) {
+	h := sha256.New()
+	h.Write([]byte("YNKCAP-MANIFEST-v1\x00"))
+	h.Write(r.digest[:])
+	h.Write(b[76:78])
+	h.Write(b[80:120])
+	h.Write(b[128:])
+	copy(r.manifest[:], h.Sum(nil))
+	copy(b, r.manifest[:])
+}
