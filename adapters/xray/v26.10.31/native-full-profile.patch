+			u := x.producer.flows[0]
+			entered, release, done := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+			x.producer.association.reply = func(ctx context.Context, _ []byte, _ [40]byte, gate func() error) error {
+				if e := gate(); e != nil {
+					return e
+				}
+				close(entered)
+				<-release
+				if uncertain {
+					return errProfileUDPResponseUncertain
+				}
+				return nil
+			}
