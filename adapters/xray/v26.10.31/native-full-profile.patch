+func profileDNSExchangeFrom(ctx context.Context) *profileDNSExchange {
+	if ctx == nil {
+		return nil
+	}
+	e, _ := ctx.Value(profileDNSExchangeKey{}).(*profileDNSExchange)
+	return e
+}
