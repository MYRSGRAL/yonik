+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"testing"
+)
+
+func TestProfileInvalidLocatorReturnsErrorWithoutPanic(t *testing.T) {
+	// Отказ до потребления FD: проверяется настоящий OS wrapper без OS I/O.
+	t.Setenv(profileLocatorNames[0], "invalid")
+	runtime, err := openProfileRuntime(nil)
+	if err != errProfile || runtime != nil {
+		t.Fatal("повреждённый locator должен вернуть отказ без runtime")
+	}
+}
+
+func TestProfileUnknownCleanupRetainsCustody(t *testing.T) {
+	p := &ProfileRuntime{ctx: context.Background(), admission: profileAdmission{state: profileUnknown}}
+	// Никаких OS FD: отказ обязан произойти до Close/Shutdown/file operations.
+	for i := 0; i < 2; i++ {
+		if p.Close() == nil || p.closed || p.admission.state != profileUnknown {
+			t.Fatal("Unknown стал KnownClosed")
+		}
+	}
+}
