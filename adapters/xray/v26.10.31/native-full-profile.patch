+func (c *profileFlowControl) dnsContext4Dispatch(op *profileOperation) error {
+	x := op.dnsContext4
+	if op.submitted || op.completed {
+		return nil
+	}
+	immutable := false
+	for i, request := range x.requests[:x.used] {
