+func TestProfileUDPResponseSinkExactReceiptTupleEndpointAndFreshOwner(t *testing.T) {
+	for _, port := range []uint16{32002, 43017} {
+		t.Run(fmt.Sprint(port), func(t *testing.T) {
+			x := newUDPProducerFixture(t, port)
+			x.responseWait = make(chan struct{})
+			op := x.consume(t, true)
+			if e := x.f.c.accept(x.f.grantReply(op, 2)); e != nil {
+				t.Fatal(e)
+			}
+			<-x.forwarded
+			u := x.producer.flows[0]
+			if u16(u.tuple[:], 4) == u16(x.producer.request.accepted.tuple[:], 4) {
+				t.Fatal("UDP borrowed TCP port")
+			}
+			originalTuple, cookie, revision, receipt, class := u.tuple, u.cookie, u.grant.revision, u.grant.receipt, u.grant.class
+			other := *receipt
+			for _, mutation := range []string{"receipt", "tuple", "cookie", "revision", "probe", "dns", "endpoint", "hostname"} {
+				b := buf.FromBytes([]byte("response"))
+				switch mutation {
+				case "receipt":
+					u.grant.receipt = &other
+				case "tuple":
+					be.PutUint16(u.tuple[4:], 32001)
+				case "cookie":
+					u.cookie++
+				case "revision":
+					u.grant.revision++
+				case "probe":
+					u.grant.class = 2
+				case "dns":
+					u.grant.class = 3
+				case "endpoint":
+					wrong := xnet.UDPDestination(xnet.ParseAddress("203.0.113.8"), 53)
+					b.UDP = &wrong
+				case "hostname":
+					wrong := xnet.UDPDestination(xnet.ParseAddress("response.invalid"), 53)
+					b.UDP = &wrong
+				}
+				if e := u.reply(b); e == nil || x.sends.Load() != 0 {
+					t.Fatal("response escaped immutable binding", mutation, e)
+				}
+				u.tuple, u.cookie, u.grant.revision, u.grant.receipt, u.grant.class = originalTuple, cookie, revision, receipt, class
+			}
+			// Expired owner proof требует actual refresh до send, новый lease не proof.
+			x.f.now = x.f.now.Add(25 * time.Millisecond)
+			done := make(chan error, 1)
+			go func() { done <- u.reply(buf.FromBytes([]byte("response"))) }()
+			refresh := <-x.f.p.flowQueue
+			if refresh.object != u.grant.id || refresh.receipt != u.receipt || x.sends.Load() != 0 {
+				t.Fatal("owner expiry bypassed")
+			}
+			if e := x.f.c.dispatch(refresh); e != nil {
+				t.Fatal(e)
+			}
+			bad := x.f.grantReply(refresh, 2)
+			be.PutUint64(bad.body[32:], 0)
+			if e := x.f.c.accept(bad); e != nil {
+				t.Fatal(e)
+			}
+			if e := <-done; e == nil || x.sends.Load() != 0 {
+				t.Fatal("Unknown owner became response grant")
+			}
+			x.finishFlow(t)
+		})
+	}
+}
