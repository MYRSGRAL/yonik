+func (c *profileFlowControl) dnsResultsTick() error {
+	for _, o := range c.dnsResults[:c.dnsResultUsed] {
+		if o.released || o.unknown {
+			continue
+		}
+		for _, op := range o.requests[:o.used] {
+			if op.submitted && !op.dnsResult.received && !c.clock().Before(op.deadline) {
+				o.closed = true
+			}
+		}
+		if o.waiter != nil && (!c.dnsResultLive(o) || o.waiter.id != 0 && !c.clock().Before(o.waiter.deadline)) || o.data != nil && (o.data.id != 0 && !c.dnsDataLive(o.data) || o.data.id == 0 && !c.dnsResultLive(o)) {
+			o.closed = true
+		}
+		if !o.closed {
+			continue
+		}
+		if o.waiter != nil && o.waiter.numeric != nil && !o.waiter.numeric.released {
+			continue
+		}
+		if o.stage == 0 {
+			until := c.clock()
+			if o.data != nil && o.data.id != 0 {
+				until = o.data.expires
+			} else if o.waiter != nil && o.waiter.id != 0 {
+				until = o.waiter.deadline
+			} else {
+				for _, op := range o.requests[:o.used] {
+					if op.submitted {
+						until = op.deadline
+						break
+					}
+				}
+			}
+			o.cleanupDeadline = until.Add(time.Second)
+			if c.sessionDeadline.Before(o.cleanupDeadline) {
+				o.cleanupDeadline = c.sessionDeadline
+			}
+			o.stage = 1
+		}
+		if !c.clock().Before(o.cleanupDeadline) {
+			o.unknown = true
+			continue
+		}
+		waiting := false
+		for _, op := range o.requests[:o.used] {
+			r := op.dnsResult
+			if !op.submitted {
+				c.dnsNotify(op, errProfile)
+				r.received = true
+				continue
+			}
+			if !r.received {
+				c.dnsNotify(op, errProfile)
+				if r.cancelSequence == 0 {
+					seq, err := c.dnsCancel(1, op.sequence)
+					if err != nil {
+						o.unknown = true
+						return err
+					}
+					r.cancelSequence = seq
+				}
+				if !r.cancelAck {
+					waiting = true
+				}
+			}
+		}
+		if waiting {
+			continue
+		}
+		if o.cleanupSequence != 0 {
+			if !o.cleanupAck {
+				continue
+			}
+			o.cleanupSequence = 0
+			o.cleanupAck = false
+			o.stage++
+		}
+		for o.stage <= 3 {
+			id := uint64(0)
+			target := byte(0)
+			if o.stage == 1 {
+				if o.data != nil {
+					id, target = o.data.id, 5
+					o.data.closed = true
+				} else {
+					id, target = o.waiter.id, 6
+				}
+			}
+			if o.stage == 2 && o.waiter != nil {
+				id, target = o.waiter.reservation, 7
+			}
+			if id != 0 {
+				seq, err := c.dnsCancel(target, id)
+				if err != nil {
+					o.unknown = true
+					return err
+				}
+				o.cleanupSequence, o.cleanupTarget, o.cleanupID = seq, target, id
+				break
+			}
+			o.stage++
+		}
+		if o.stage > 3 {
+			o.released = true
+			c.operations -= profileDNSResultPending
+			c.buffered -= profileDNSResultCredit - 8192
+			o.query.refs--
+			o.query.releaseLocked()
+		}
+	}
+	return nil
+}
+func (c *profileFlowControl) dnsResultsFloor(floor uint64) uint64 {
+	for _, o := range c.dnsResults[:c.dnsResultUsed] {
+		if o.released {
+			continue
+		}
+		for _, op := range o.requests[:o.used] {
+			if op.submitted && !op.dnsResult.received && op.sequence < floor {
+				floor = op.sequence
+			}
+			if op.dnsResult.cancelSequence != 0 && !op.dnsResult.cancelAck && op.dnsResult.cancelSequence < floor {
+				floor = op.dnsResult.cancelSequence
+			}
+		}
+		if o.cleanupSequence != 0 && !o.cleanupAck && o.cleanupSequence < floor {
+			floor = o.cleanupSequence
+		}
+	}
+	return floor
+}
