+	if e := hooks.BeforeSocketDial(c.owner.ctx); e != nil {
+		return 0, e
+	}
+	if a == nil || a.String() != c.owner.RemoteAddr().String() {
+		return 0, errors.New("UDP peer mismatch")
+	}
+	return c.packet.WriteTo(b, a)
