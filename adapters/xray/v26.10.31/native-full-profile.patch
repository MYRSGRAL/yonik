+// Independent consumer grammar; issuer повторяет parsing и kernel/resource
+// fences. Bounded allocation оплачена result owner до Unpack/maps.
+func profileDNSParseData(d *ProfileDNSProducerData, request, response []byte) error {
+	e := d.exchange
+	if len(request) < 12 || len(request) > 512 || len(response) < 12 || len(response) > 32768 || u16(response, 4) != 1 || int(u16(response, 6))+int(u16(response, 8))+int(u16(response, 10)) > 512 || !profileDNSWireExtent(request) || !profileDNSWireExtent(response) {
+		return errProfile
+	}
+	var req, rep dnsmessage.Message
+	if req.Unpack(request) != nil || rep.Unpack(response) != nil || len(req.Questions) != 1 || len(rep.Questions) != 1 || req.Questions[0] != rep.Questions[0] && (req.Questions[0].Type != rep.Questions[0].Type || req.Questions[0].Class != rep.Questions[0].Class || profileCanonicalQuery(req.Questions[0].Name.String()) != profileCanonicalQuery(rep.Questions[0].Name.String())) {
+		return errProfile
+	}
+	flags := uint16(0)
+	if e.options&1 != 0 {
+		flags |= 0x100
+	}
+	if e.options&2 != 0 {
+		flags |= 0x10
+	}
+	if e.options&16 != 0 {
+		flags |= 0x20
+	}
+	if u16(request, 2) != flags || u16(response, 0) != u16(request, 0) || u16(response, 2)&0xf800 != 0x8000 || u16(response, 2)&0x024f != 0 || u16(response, 2)&0x110 != flags&0x110 || profileCanonicalQuery(req.Questions[0].Name.String()) != e.root.query || uint16(req.Questions[0].Type) != e.qtype || req.Questions[0].Class != dnsmessage.ClassINET {
+		return errProfile
+	}
+	checkOPT := func(rows []dnsmessage.Resource, request bool) bool {
+		n := 0
+		for _, rr := range rows {
+			if rr.Header.Type != dnsmessage.TypeOPT {
+				if rr.Header.Class != dnsmessage.ClassINET {
+					return false
+				}
+				continue
+			}
+			n++
+			opt, ok := rr.Body.(*dnsmessage.OPTResource)
+			if !ok || len(opt.Options) != 0 || rr.Header.Name.String() != "." || e.options&8 == 0 || uint16(rr.Header.Class) < 512 || uint16(rr.Header.Class) > 4096 || request && uint16(rr.Header.Class) != e.payload || rr.Header.TTL & ^uint32(32768) != 0 || (rr.Header.TTL&32768 != 0) != (e.options&4 != 0) {
+				return false
+			}
+		}
+		return n <= 1
+	}
+	if !checkOPT(req.Additionals, true) || !checkOPT(rep.Additionals, false) {
+		return ErrProfileUnsupported
+	}
+	for _, rr := range rep.Authorities {
+		if rr.Header.Class != dnsmessage.ClassINET || rr.Header.Type == dnsmessage.TypeOPT {
+			return errProfile
+		}
+	}
+	name := e.root.query
+	seen := make(map[string]bool, 32)
+	ttl := ^uint32(0)
+	for depth := 0; depth < 32; depth++ {
+		if seen[name] {
+			return errProfile
+		}
+		seen[name] = true
+		next := ""
+		hasAddress := false
+		for _, rr := range rep.Answers {
+			if profileCanonicalQuery(rr.Header.Name.String()) != name {
+				continue
+			}
+			if rr.Header.Class != dnsmessage.ClassINET {
+				return errProfile
+			}
+			switch v := rr.Body.(type) {
+			case *dnsmessage.CNAMEResource:
+				target := profileCanonicalQuery(v.CNAME.String())
+				if next != "" && next != target {
+					return errProfile
+				}
+				next = target
+				if rr.Header.TTL < ttl {
+					ttl = rr.Header.TTL
+				}
+			case *dnsmessage.AResource, *dnsmessage.AAAAResource:
+				hasAddress = true
+			}
+		}
+		if next == "" {
+			break
+		}
+		if hasAddress || depth == 31 {
+			return errProfile
+		}
+		name = next
+	}
+	for _, rr := range rep.Answers {
+		owner := profileCanonicalQuery(rr.Header.Name.String())
+		if !seen[owner] || rr.Header.Class != dnsmessage.ClassINET {
+			return errProfile
+		}
+		var ip netip.Addr
+		switch v := rr.Body.(type) {
+		case *dnsmessage.AResource:
+			if e.qtype != 1 {
+				return errProfile
+			}
+			ip = netip.AddrFrom4(v.A)
+		case *dnsmessage.AAAAResource:
+			if e.qtype != 28 {
+				return errProfile
+			}
+			ip = netip.AddrFrom16(v.AAAA)
+		case *dnsmessage.CNAMEResource:
+			continue
+		default:
+			continue
+		}
+		if owner != name || !ip.IsValid() || ip.IsUnspecified() || ip.IsMulticast() || ip.Is4In6() {
+			return errProfile
+		}
+		if ip.Is4() {
+			v := ip.As4()
+			if v[0] == 0 || v[0] >= 240 || v == [4]byte{255, 255, 255, 255} {
+				return errProfile
+			}
+		}
+		if rr.Header.TTL < ttl {
+			ttl = rr.Header.TTL
+		}
+		found := false
+		for _, old := range d.members[:d.count] {
+			if old == ip {
+				found = true
+				break
+			}
+		}
+		if !found {
+			if d.count == len(d.members) {
+				return errProfileFlowBusy
+			}
+			d.members[d.count] = ip
+			d.count++
+		}
+	}
+	if d.count == 0 || ttl == 0 {
+		return errProfile
+	}
+	d.ttl = ttl
+	return nil
+}
+
+// Структурные extent/backward-pointer fences до dnsmessage allocation.
+func profileDNSWireExtent(raw []byte) bool {
+	if len(raw) < 12 {
+		return false
+	}
+	name := func(start int) (int, bool) {
+		pos, end, pointers, length := start, 0, 0, 0
+		for {
+			if pos >= len(raw) {
+				return 0, false
+			}
+			n := int(raw[pos])
+			if n&192 == 192 {
+				if pos+1 >= len(raw) {
+					return 0, false
+				}
+				target := (n&63)<<8 | int(raw[pos+1])
+				pointers++
+				if pointers > 16 || target >= pos || target < 12 {
+					return 0, false
+				}
+				if end == 0 {
+					end = pos + 2
+				}
+				pos = target
+				continue
+			}
+			pos++
+			if n == 0 {
+				if end == 0 {
+					end = pos
+				}
+				return end, true
+			}
+			if n > 63 || pos+n > len(raw) || length+n+1 > 254 {
+				return 0, false
+			}
+			length += n + 1
+			pos += n
+		}
+	}
+	at := 12
+	for section := 0; section < 4; section++ {
+		for i := 0; i < int(u16(raw, 4+section*2)); i++ {
+			end, ok := name(at)
+			if !ok {
+				return false
+			}
+			at = end
+			if section == 0 {
+				at += 4
+				if at > len(raw) {
+					return false
+				}
+				continue
+			}
+			if at+10 > len(raw) {
+				return false
+			}
+			kind := u16(raw, at)
+			size := int(u16(raw, at+8))
+			at += 10
+			if at+size > len(raw) {
+				return false
+			}
+			if kind == 5 {
+				end, ok = name(at)
+				if !ok || end != at+size {
+					return false
+				}
+			}
+			at += size
+		}
+	}
+	return at == len(raw)
+}
+
+func (c *profileFlowControl) dnsPublicationSettled(t *profileDNSDirect) bool {
+	for _, o := range c.dnsResults[:c.dnsResultUsed] {
+		if o.transport != t {
+			continue
+		}
+		if o.unknown {
+			return false
+		}
+		for _, op := range o.requests[:o.used] {
+			r := op.dnsResult
+			if op.submitted && !r.received && (!r.cancelAck || c.clock().Before(op.deadline)) {
+				return false
+			}
+		}
+	}
+	return true
+}
