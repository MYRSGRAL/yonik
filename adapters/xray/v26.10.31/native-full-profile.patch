+func (s *profileServer) Start() error { return s.launch.Start(s.Server.Start) }
+func (s *profileServer) Close() error {
+	s.once.Do(func() {
+		s.launch.Revoke()
+		b := s.Server.Close()
+		if b != nil {
+			s.launch.RevokeUnknown()
+			s.closeErr = b
+			return
+		}
+		a := s.launch.Close()
+		s.closeErr = a
+		if s.closeErr == nil {
+			s.closeErr = b
+		}
+	})
+	return s.closeErr
+}
