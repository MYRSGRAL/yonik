+// Cache waiter повторяет actual forced/router/default native selection, но не
+// создаёт link/worker/transport. Protected DNS caller уже задаёт metadata ctx.
+func (d *DefaultDispatcher) ProfileDNSWaiterContext(ctx context.Context, destination net.Destination) (context.Context, func(), error) {
+	noop := func() {}
+	if !nativehooks.ProfileDNSDirectRequired(ctx) || nativehooks.ProfileDispatchEntry(ctx, destination) != nil || nativehooks.RoutingEntry(ctx) != nil {
+		return ctx, noop, nativehooks.ErrDenied
+	}
+	original := session.OutboundsFromContext(ctx)
+	if len(original) > 256 {
+		return ctx, noop, nativehooks.ErrProfileUnsupported
+	}
+	cloned := make([]*session.Outbound, len(original))
+	for i, v := range original {
+		if v != nil {
+			copy := *v
+			cloned[i] = &copy
+		}
+	}
+	if len(cloned) == 0 {
+		cloned = []*session.Outbound{{}}
+	}
+	if cloned[len(cloned)-1] == nil {
+		return ctx, noop, nativehooks.ErrProfileUnsupported
