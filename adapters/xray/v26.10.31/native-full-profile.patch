+func TestProfileDNSCodec4ActualActorVariantsNoIOAndTypedRetirement(t *testing.T) {
+	for _, hosts := range []bool{false, true} {
+		t.Run(strconv.FormatBool(hosts), func(t *testing.T) {
+			f, ctx, s := dnsContext4Fixture(t, hosts)
+			done := make(chan error, 1)
+			var result context.Context
+			var release func()
+			go func() { var err error; result, release, err = ProfileDNSAcquirePhysicalContext(ctx); done <- err }()
+			var op *profileOperation
+			select {
+			case op = <-f.p.flowQueue:
+			case err := <-done:
+				t.Fatal("actor rejected before RPC", err)
+			case <-time.After(time.Second):
+				t.Fatal("actor queue blocked")
+			}
+			if op.kind != 55 || op.dnsContext4 == nil || u16(op.body, 48) != 8 || u64(op.body, 8) == 0 != hosts {
+				t.Fatal("root4 request")
+			}
+			select {
+			case <-done:
+				t.Fatal("before ACK")
+			default:
+			}
+			if f.c.dispatch(op) != nil || f.c.accept(dnsBundleReply(op, 700, 1)) != nil {
+				t.Fatal("context actor ACK")
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+			x := op.dnsContext4
+			if !f.c.dnsContext4Live(x) || (x.identity.kind == profileDNSHostsRoot) != hosts {
+				t.Fatal("typed context")
+			}
+			if g, _ := result.Value(profileGrantKey{}).(*profileGrant); g != nil {
+				t.Fatal("context promoted to grant")
+			}
+			if ProfileCheckDial(result, profileNumericDestination(s.frontier.target), false) == nil {
+				t.Fatal("metadata context permits I/O")
+			}
+			if ProfileDNSBundleGuard(result, "a", profileNumericDestination(s.frontier.target), false) == nil {
+				t.Fatal("typed context promoted to UserDns bundle")
+			}
+			if f.c.operations < 1 {
+				t.Fatal("retirement precredit absent")
+			}
+			release()
+			if f.c.dnsTick() != nil || x.closeSequence == 0 || x.released {
+				t.Fatal("missing cancel8 barrier")
+			}
+			ack := make([]byte, 32)
+			be.PutUint16(ack, 2)
+			ack[2] = 1
+			be.PutUint64(ack[8:], 700)
+			be.PutUint64(ack[16:], f.c.lastSent)
+			if f.c.accept(profilePacket{kind: 48, reply: x.closeSequence, body: ack}) != nil || f.c.dnsTick() != nil || !x.released {
+				t.Fatal("typed cleanup")
+			}
+			release()
+			if f.c.dnsTick() != nil || !x.released || x.unknown {
+				t.Fatal("repeat close")
+			}
+			other := f.c.dnsReserveContextIdentity(profileDNSUserRoot)
+			if f.c.dnsClaimContextIdentity(other, 700) {
+				t.Fatal("retired context ID reused as UserDns")
+			}
+		})
+	}
