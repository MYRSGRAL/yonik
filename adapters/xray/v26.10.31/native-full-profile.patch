+func dnsFactoryRetired(op *profileOperation, status byte) profilePacket {
+	body := make([]byte, 40)
+	be.PutUint16(body, 2)
+	body[2], body[3] = status, op.body[2]
+	be.PutUint64(body[8:], u64(op.body, 8))
+	be.PutUint64(body[16:], u64(op.body, 16))
+	be.PutUint64(body[32:], op.sequence)
+	if status == 1 {
+		body[28] = 1
+	} else {
+		be.PutUint16(body[26:], 1)
+	}
+	return profilePacket{kind: 46, reply: op.sequence, body: body}
+}
