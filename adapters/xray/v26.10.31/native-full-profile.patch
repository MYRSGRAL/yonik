+func TestProfileUDPResponseTransportNoRetryAfterUncertainAndCancelBeforeWrite(t *testing.T) {
+	tuple := fakeFlowTuple(17)
+	be.PutUint16(tuple[6:], 49152)
+	if e := profileSendUDPResponse(context.Background(), []byte("response"), tuple, func() error { return nil }, profileUDPResponseOps{validate: func() error { return nil }, wait: func(context.Context) error { t.Fatal("uncertain retry"); return nil }, send: func([]byte, [40]byte) (int, error) { return 1, context.Canceled }}); !errors.Is(e, errProfileUDPResponseUncertain) {
+		t.Fatal("partial cancel lost Unknown custody", e)
+	}
+	for _, partial := range []bool{false, true} {
+		ctx, cancel := context.WithCancel(context.Background())
+		calls, waits := 0, 0
+		e := profileSendUDPResponse(ctx, []byte("response"), tuple, func() error { return ctx.Err() }, profileUDPResponseOps{
+			validate: func() error { return nil }, wait: func(context.Context) error { waits++; cancel(); return nil },
+			send: func([]byte, [40]byte) (int, error) {
+				calls++
+				if partial {
+					return 2, errProfileProofBusy
+				}
+				return 0, errProfileProofBusy
+			},
+		})
+		if e == nil || calls != 1 || partial && waits != 0 || !partial && waits != 1 {
+			t.Fatal("cancel/partial retried", e, calls, waits)
+		}
+		cancel()
+	}
+	if e := profileSendUDPResponse(context.Background(), []byte("response"), tuple, func() error { return nil }, profileUDPResponseOps{validate: func() error { return errors.New("foreign namespace") }, wait: func(context.Context) error { t.Fatal("wait before namespace proof"); return nil }, send: func([]byte, [40]byte) (int, error) { t.Fatal("send before namespace proof"); return 0, nil }}); e == nil {
+		t.Fatal("namespace bypass")
+	}
+}
