+	// issuer выполняет fresh lookup; credential/session не подставляются как proof.
+	b = append(b, 255, 255, 0, 0)
+	b = append(b, make([]byte, 16)...)
+	op, e := c.operation(ctx, r, g, 18, object, b)
+	if e != nil && refresh == nil {
+		c.closeGrant(g)
+	}
+	if e == nil && refresh != nil {
+		g.refresh = op
+	}
+	return g, op, e
+}
+func (c *profileFlowControl) closeGrant(g *profileGrant) {
+	if g != nil && !g.closed {
+		g.closed = true
+		g.cancel()
+	}
+}
+func (c *profileFlowControl) closeReceipt(r *profileReceipt) {
+	if r != nil && !r.closed {
+		r.closed = true
+		r.cancel()
+	}
+}
+func (c *profileFlowControl) finish(op *profileOperation, e error) {
+	if op.hostsObservation != nil {
+		c.hostsObservationClose(op.hostsObservation)
+		c.dnsNotify(op, e)
+		return
+	}
+	if op.dnsContext4 != nil {
+		c.dnsContext4Close(op.dnsContext4)
+		c.dnsNotify(op, e)
+		return
+	}
+	if op.dnsNumeric != nil {
+		c.numericClose(op.dnsNumeric)
+		c.dnsNotify(op, e)
+		return
+	}
+	if op.dnsResult != nil {
+		op.dnsResult.owner.closed = true
+		c.dnsNotify(op, e)
+		return
+	}
+	if op.dnsDirect != nil {
+		op.dnsDirect.owner.closed = true
+		op.dnsDirect.owner.cancel()
+		c.dnsNotify(op, e)
+		return
+	}
+	if op.dns != nil {
+		c.dnsFinish(op, e)
+		return
+	}
+	if op.completed {
+		return
+	}
+	op.completed = true
+	if c.udpBudget != nil && op.udpSlot >= 0 {
+		c.udpBudget.entries[op.udpSlot].terminal = true
+	}
+	if op.receipt != nil && op.receipt.openOperation == op {
+		op.receipt.openOperation = nil
+	}
+	c.operations--
+	if op.receipt != nil {
+		op.receipt.pending--
+	}
+	if op.grant != nil {
+		op.grant.pending--
+		if op.grant.refresh == op {
+			op.grant.refresh = nil
+		}
+	}
+	op.err = e
+	close(op.done)
+}
+func (c *profileFlowControl) abort(op *profileOperation) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if op.hostsObservation != nil {
+		c.hostsObservationClose(op.hostsObservation)
+		return
+	}
+	if op.dnsContext4 != nil {
+		c.dnsContext4Close(op.dnsContext4)
+		return
+	}
+	if op.dnsNumeric != nil {
+		c.numericClose(op.dnsNumeric)
+		return
+	}
+	if op.dnsResult != nil {
+		op.dnsResult.owner.closed = true
+		return
+	}
+	if op.dnsDirect != nil {
+		op.dnsDirect.owner.closed = true
+		op.dnsDirect.owner.cancel()
+		return
+	}
+	if op.dns != nil {
+		c.dnsClose(op.dns.bundle)
+		return
+	}
+	op.cancelled = true
+	if op.kind == 16 {
+		c.closeReceipt(op.receipt)
+	} else {
+		c.closeGrant(op.grant)
+	}
+}
+func (c *profileFlowControl) cancelWire(kind byte, id uint64) (uint64, error) {
+	slot := -1
+	if b := c.udpBudget; b != nil {
+		if b.used >= min(int(c.manifest.caps[7]), 256) || c.profilePendingUsed() >= min(int(c.manifest.caps[3]), 64) {
+			return 0, errProfileFlowBusy
+		}
+		slot = b.used
+		b.entries[slot] = profileUDPRetainedOperation{namespace: 1, closeKind: kind, objectID: id}
+		for _, r := range c.receipts {
+			if r != nil && r.udp != nil && kind == 2 && r.id == id {
+				b.entries[slot].association = r.udp.producer.association.id
+				break
+			}
+		}
+		for _, g := range c.grants {
+			if g != nil && g.receipt != nil && g.receipt.udp != nil && kind == 3 && g.id == id {
+				b.entries[slot].association = g.receipt.udp.producer.association.id
+				break
+			}
+		}
+		for _, op := range c.pending {
+			if op != nil && op.receipt != nil && op.receipt.udp != nil && kind == 1 && op.sequence == id {
+				b.entries[slot].association = op.receipt.udp.producer.association.id
+				break
+			}
+		}
+		b.used++
+		b.proofPending++
+	}
+	body := make([]byte, 12)
+	body[0] = kind
+	be.PutUint64(body[4:], id)
+	seq, e := c.write(32, 0, body)
+	if slot >= 0 {
+		c.udpBudget.entries[slot].runtimeSequence = seq
+	}
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	return seq, e
+}
+func (c *profileFlowControl) cancel(kind byte, id uint64) (uint64, error) {
+	if kind == 1 {
+		return c.cancelWire(kind, id)
+	}
+	reserved := c.operations + c.dnsHistoryUsed + c.dnsTasksUsed
+	for _, t := range c.tombs {
+		if t.sequence != 0 {
+			reserved++
+		}
+	}
+	if reserved >= int(c.manifest.caps[7]) || reserved >= 256 {
+		return 0, errProfileFlowBusy
+	}
+	for i, t := range c.tombs {
+		if t.sequence == 0 {
+			seq, e := c.cancelWire(kind, id)
+			if e != nil {
+				return seq, e
+			}
+			c.tombs[i] = profileTombstone{sequence: seq, kind: 32, targetKind: kind, objectID: id, deadline: c.clock().Add(time.Second)}
+			return seq, nil
+		}
+	}
+	return 0, errProfileFlowBusy
+}
+func (c *profileFlowControl) tomb(op *profileOperation, cancelled bool) error {
+	for i, t := range c.tombs {
+		if t.sequence == 0 {
+			entry := profileTombstone{sequence: op.sequence, deadline: op.deadline.Add(time.Second), kind: op.kind, replied: !cancelled, cancelled: cancelled}
+			if op.receipt != nil && op.receipt.udp != nil {
+				entry.association = op.receipt.udp.producer.association.id
+			}
+			if cancelled {
+				seq, e := c.cancel(1, op.sequence)
+				if e != nil {
+					return e
+				}
+				entry.cancelSequence = seq
+				if c.udpBudget != nil {
+					for j := 0; j < c.udpBudget.used; j++ {
+						if c.udpBudget.entries[j].runtimeSequence == seq {
+							c.udpBudget.entries[j].association = entry.association
+						}
+					}
+				}
+			}
+			c.tombs[i] = entry
+			return nil
+		}
+	}
+	return errProfile
+}
+func (c *profileFlowControl) dispatch(op *profileOperation) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.dispatchLocked(op)
+}
+func (c *profileFlowControl) dispatchLocked(op *profileOperation) error {
+	if op.hostsObservation != nil {
+		return c.hostsObservationDispatch(op)
+	}
+	if op.dnsContext4 != nil {
+		return c.dnsContext4Dispatch(op)
+	}
+	if op.dnsNumeric != nil {
+		return c.numericDispatch(op)
+	}
+	if op.dnsResult != nil {
+		return c.dnsResultDispatch(op)
+	}
+	if op.dnsDirect != nil {
+		return c.dnsDirectDispatch(op)
+	}
+	if op.dns != nil {
+		return c.dnsDispatch(op)
+	}
+	if op.completed {
+		return nil
+	}
+	if op.submitted {
+		return nil
+	}
+	if !c.live() || op.cancelled || op.ctx.Err() != nil || !c.operationLive(op) {
+		if op.kind == 16 {
+			c.closeReceipt(op.receipt)
+		} else {
+			c.closeGrant(op.grant)
+		}
+		c.finish(op, errProfile)
+		return nil
+	}
+	slot := -1
+	for i, p := range c.pending {
+		if p == nil {
+			slot = i
+			break
+		}
+	}
+	if slot < 0 {
+		return errProfile
+	}
+	if c.proofRequired(op) {
+		if c.prepareProof == nil {
+			return errProfile
+		}
+		if e := c.prepareProof(op); e != nil {
+			if e == errProfileProofCancelled {
+				c.closeReceipt(op.receipt)
+				c.finish(op, e)
+				return nil
+			}
+			return e
+		}
+	}
+	op.sent = c.clock()
+	op.sessionDeadline = c.sessionDeadline
+	op.deadline = op.sent.Add(time.Second)
+	if op.kind == 18 && op.receipt != nil && c.mode == 2 {
+		op.deadline = op.sent.Add(20 * time.Millisecond)
+	}
+	if deadline, ok := op.ctx.Deadline(); ok && deadline.Before(op.deadline) {
+		op.deadline = deadline
+	}
+	if !op.fixedDeadline.IsZero() && op.fixedDeadline.Before(op.deadline) {
+		op.deadline = op.fixedDeadline
+	}
+	seq, e := c.write(op.kind, op.object, op.body)
+	if e != nil {
+		c.finish(op, e)
+		return e
+	}
+	op.sequence = seq
+	if op.kind == 16 {
+		op.receipt.openSequence = seq
+	}
+	if c.udpBudget != nil && op.udpSlot >= 0 {
+		c.udpBudget.entries[op.udpSlot].runtimeSequence = seq
+	}
+	op.submitted = true
+	c.pending[slot] = op
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	return c.tryProof(op)
+}
+func (c *profileFlowControl) accept(f profilePacket) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.live() {
+		return errProfile
+	}
+	if handled, err := c.numericAccept(f); handled {
+		return err
+	}
+	if profileDNSV2Operation(f.kind) {
+		if handled, err := c.hostsObservationAccept(f); handled {
+			return err
+		}
+		if handled, err := c.dnsContext4Accept(f); handled {
+			return err
+		}
+		if handled, err := c.dnsResultAccept(f); handled {
+			return err
+		}
+		if handled, err := c.dnsDirectAccept(f); handled {
+			return err
+		}
+	}
+	if f.kind == 56 || f.kind == 48 {
+		return c.dnsAccept(f)
+	}
+	if profileDNSV2Operation(f.kind) {
+		return errProfile
+	}
+	if f.kind == 32 {
+		b := f.body
+		if f.reply != 0 || f.object != 0 || len(b) != 12 || !zero(b[2:4]) || b[0] < 2 || b[0] > 4 || u64(b, 4) == 0 && b[0] != 4 || b[0] == 4 && u64(b, 4) != 0 {
+			return errProfile
+		}
+		id := u64(b, 4)
+		if b[0] == 2 {
+			for _, r := range c.receipts {
+				if r != nil && r.id == id {
+					c.closeReceipt(r)
+				}
+			}
+		} else if b[0] == 3 {
+			for _, g := range c.grants {
+				if g != nil && g.id == id {
+					c.closeGrant(g)
+				}
+			}
+		} else {
+			c.revoked = true
+			for _, g := range c.grants {
+				c.closeGrant(g)
+			}
+			for _, r := range c.receipts {
+				c.closeReceipt(r)
+			}
+		}
+		ack := make([]byte, 12)
+		ack[0] = b[0]
+		ack[1] = 3
+		be.PutUint64(ack[4:], id)
+		if c.reply == nil || c.reply(34, f.sequence, ack) != nil {
+			return errProfile
+		}
+		if b[0] == 4 {
+			return errProfile
+		}
+		return nil
+	}
+	for i, op := range c.pending {
+		if op == nil || op.sequence != f.reply {
+			continue
+		}
+		if f.kind == 22 && op.receipt != nil && op.receipt.udp != nil {
+			// Rust Status::Deny=2 — known refusal; Unknown=3 сохраняет custody.
+			if f.object != 0 || len(f.body) != 8 || f.body[0] != 2 || !zero(f.body[2:]) {
+				return errProfile
+			}
+			c.pending[i] = nil
+			op.denied = true
+			if op.kind == 16 {
+				c.closeReceipt(op.receipt)
+			} else {
+				c.closeGrant(op.grant)
+			}
+			if e := c.tomb(op, false); e != nil {
+				return e
+			}
+			c.finish(op, errProfile)
+			return nil
+		}
+		expected := uint16(19)
+		if op.kind == 16 {
+			expected = 17
+		}
+		if f.kind != expected {
+			return errProfile
+		}
+		c.pending[i] = nil
+		cancelled := op.cancelled || op.ctx.Err() != nil || !c.operationLive(op) || !c.clock().Before(op.deadline)
+		if cancelled {
+			if op.kind == 16 {
+				c.closeReceipt(op.receipt)
+			} else {
+				c.closeGrant(op.grant)
+			}
+			if e := c.tomb(op, true); e != nil {
+				return e
+			}
+			c.finish(op, errProfile)
+			return c.discardLate(f, op.kind)
+		}
+		e := c.publish(op, f)
+		if e != nil {
+			if op.kind == 16 {
+				c.closeReceipt(op.receipt)
+			} else {
+				c.closeGrant(op.grant)
+			}
+		}
+		if te := c.tomb(op, false); te != nil {
+			return te
+		}
+		c.finish(op, e)
+		return nil
+	}
+	for i, t := range c.tombs {
+		if t.sequence == f.reply {
+			if t.kind == 32 {
+				if t.replied {
+					return errProfile
+				}
+				if !profileCloseACK(f, t.targetKind, t.objectID) {
+					return errProfile
+				}
+				if e := c.udpCloseACK(f, t.targetKind, t.objectID); e != nil {
+					return e
+				}
+				c.tombs[i].replied = true
+				c.tombs[i].closeStatus = f.body[1]
+				return nil
+			}
+			if !t.cancelled || t.replied {
+				return errProfile
+			}
+			if e := c.discardLate(f, t.kind); e != nil {
+				return e
+			}
+			c.tombs[i].replied = true
+			return nil
+		}
+		if t.cancelSequence != 0 && t.cancelSequence == f.reply {
+			if !profileCloseACK(f, 1, t.sequence) {
+				return errProfile
+			}
+			if e := c.udpCloseACK(f, 1, t.sequence); e != nil {
+				return e
+			}
+			c.tombs[i].cancelSequence = 0
+			return nil
+		}
+		if t.objectCancelSequence != 0 && t.objectCancelSequence == f.reply {
+			if !profileCloseACK(f, t.targetKind, t.objectID) {
+				return errProfile
+			}
+			if e := c.udpCloseACK(f, t.targetKind, t.objectID); e != nil {
+				return e
+			}
+			c.tombs[i].objectCancelSequence = 0
+			return nil
+		}
+	}
+	if f.reply != 0 && f.reply <= c.watermark {
+		return nil
+	}
+	return errProfile
+}
+func (c *profileFlowControl) discardLate(f profilePacket, kind uint16) error {
+	var target byte
+	if kind == 18 || kind == 20 {
+		if f.kind != 19 || len(f.body) != 56 {
+			return errProfile
+		}
+		target = 3
+		if f.body[0] == 1 && (u64(f.body, 4) == 0 || f.object != u64(f.body, 4)) {
+			return errProfile
+		}
+	}
+	if kind == 16 {
+		if f.kind != 17 || len(f.body) != 24 || f.object != 0 {
+			return errProfile
+		}
+		target = 2
+		if f.body[0] == 1 && u64(f.body, 4) == 0 {
+			return errProfile
+		}
+	}
+	if target != 0 {
+		if f.body[0] == 2 || f.body[0] == 3 {
+			return nil
+		}
+		if f.body[0] != 1 {
+			return errProfile
+		}
+		id := u64(f.body, 4)
+		seq, e := c.cancelWire(target, id)
+		if e != nil {
+			return e
+		}
+		for i, t := range c.tombs {
+			if t.sequence == f.reply {
+				c.tombs[i].objectCancelSequence = seq
+				if c.udpBudget != nil {
+					for j := 0; j < c.udpBudget.used; j++ {
+						if c.udpBudget.entries[j].runtimeSequence == seq {
+							c.udpBudget.entries[j].association = t.association
+						}
+					}
+				}
+				c.tombs[i].targetKind = target
+				c.tombs[i].objectID = id
+				c.tombs[i].replied = true
+				return nil
+			}
+		}
+		return errProfile
+	}
+	return errProfile
+}
+func profileCloseACK(f profilePacket, kind byte, id uint64) bool {
+	return f.kind == 34 && f.object == 0 && len(f.body) == 12 && f.body[0] == kind && (f.body[1] == 1 || f.body[1] == 3) && zero(f.body[2:4]) && u64(f.body, 4) == id
+}
+func (c *profileFlowControl) publish(op *profileOperation, f profilePacket) error {
+	if op.kind == 16 {
+		b := f.body
+		if c.proofRequired(op) && !op.proofSent {
+			return errProfile
+		}
+		if f.kind != 17 || f.object != 0 || len(b) != 24 || b[0] != 1 || b[1] != c.mode-1 || !zero(b[2:4]) || u64(b, 4) == 0 || u64(b, 4) <= c.highestFlow || u32(b, 12) != 0 || u64(b, 16) == 0 {
+			return errProfile
+		}
+		op.receipt.id = u64(b, 4)
+		op.receipt.revision = u64(b, 16)
+		c.highestFlow = op.receipt.id
+		return nil
+	}
+	b := f.body
+	g := op.grant
+	if g.class == 2 || g.class == 3 {
+		return c.publishService(op, f)
+	}
+	if f.kind != 19 || len(b) != 56 || b[0] != 1 || b[1] != 1 || b[2] != c.mode-1 || b[3] != 0 || u64(b, 4) == 0 || f.object != u64(b, 4) || u64(b, 12) != op.receipt.id || u32(b, 20) == 0 || u32(b, 20) > 1000 || u64(b, 24) != op.receipt.revision || !zero(b[41:48]) {
+		return errProfile
+	}
+	id := u64(b, 4)
+	if op.object == 0 {
+		if id <= c.highestGrant {
+			return errProfile
+		}
+	} else if id != op.object || g.id != id || !c.grantLive(g) {
+		return errProfile
+	}
+	ownerNS, ownerKind, ownerID := u64(b, 32), b[40], u64(b, 48)
+	if c.mode == 1 {
+		if ownerNS != 0 || ownerKind != 0 || ownerID != 0 {
+			return errProfile
+		}
+	} else if ownerNS == 0 || ownerNS > uint64(20*time.Millisecond) || ownerKind < 1 || ownerKind > 2 || ownerID == 0 {
+		return errProfile
+	}
+	deadline := op.sent.Add(time.Duration(u32(b, 20)) * time.Millisecond)
+	if op.sessionDeadline.Before(deadline) {
+		deadline = op.sessionDeadline
+	}
+	ownerDeadline := op.sent.Add(time.Duration(ownerNS))
+	if op.object != 0 && ownerKind == g.ownerKind && ownerID == g.ownerID && g.ownerDeadline.Before(ownerDeadline) {
+		ownerDeadline = g.ownerDeadline
+	}
+	if !c.clock().Before(deadline) || c.mode == 2 && !c.clock().Before(ownerDeadline) {
+		return errProfile
+	}
+	g.id = id
+	g.deadline = deadline
+	g.ownerDeadline = ownerDeadline
+	g.ownerKind = ownerKind
+	g.ownerID = ownerID
+	g.revision = u64(b, 24)
+	if id > c.highestGrant {
+		c.highestGrant = id
+	}
+	return nil
+}
+func (c *profileFlowControl) tick() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if err := c.dnsTick(); err != nil {
+		return err
+	}
+	now := c.clock()
+	for i, t := range c.tombs {
+		if c.udpBudget == nil && t.sequence != 0 && !now.Before(t.deadline) {
+			c.tombs[i] = profileTombstone{}
+		}
+	}
+	for i, a := range c.accepted {
+		if a != nil && a.ctx.Err() != nil {
+			if e := a.closeProofLocked(c); e != nil {
+				return e
+			}
+			c.accepted[i] = nil
+		}
+	}
+	for i, op := range c.pending {
+		if op != nil && !op.cancelled && op.ctx.Err() == nil && now.Before(op.deadline) {
+			if e := c.tryProof(op); e != nil {
+				return e
+			}
+		}
+		if op != nil && (op.cancelled || op.ctx.Err() != nil || !c.operationLive(op) || !now.Before(op.deadline)) {
+			if op.kind == 16 {
+				c.closeReceipt(op.receipt)
+			} else {
+				c.closeGrant(op.grant)
+			}
+			if e := c.tomb(op, true); e != nil {
+				return e
+			}
+			c.pending[i] = nil
+			c.finish(op, errProfile)
+		}
+	}
+	for i, g := range c.grants {
+		if g == nil {
+			continue
+		}
+		if g.numeric != nil {
+			if !c.numericParentLive(g.numeric) || !g.deadline.IsZero() && !now.Before(g.deadline) {
+				c.numericClose(g.numeric)
+			}
+			continue
+		}
+		if g.ctx.Err() != nil || !g.deadline.IsZero() && !now.Before(g.deadline) {
+			c.closeGrant(g)
+		}
+		if !g.closed && g.id != 0 && g.refresh == nil && (g.class == 2 || g.class == 3) && c.grantLive(g) && (g.deadline.Sub(now) <= 250*time.Millisecond || c.serviceOwnerRequired(g) && g.ownerDeadline.Sub(now) <= 5*time.Millisecond) {
+			if op, e := c.refreshServiceLocked(g); e == nil {
+				op.queued = true
+				if e = c.dispatchLocked(op); e != nil {
+					return e
+				}
+			}
+		}
+		if !g.closed && g.id != 0 && g.refresh == nil && c.receiptLive(g.receipt) && g.deadline.Sub(now) <= 250*time.Millisecond {
+			if g.class == 3 {
+				continue
+			}
+			_, op, e := c.authorizeLocked(g.ctx, g.receipt, g.scope, g.branch, g.effective, g)
+			if e == nil {
+				op.queued = true
+				if e = c.dispatchLocked(op); e != nil {
+					return e
+				}
+			}
+		}
+		if g.closed {
+			if g.id != 0 && !g.cancelSent {
+				if _, e := c.cancel(3, g.id); e != nil {
+					if e == errProfileFlowBusy {
+						break
+					}
+					return e
+				}
+				g.cancelSent = true
+			}
+			if g.pending == 0 {
+				c.buffered -= profileGrantCredit(g)
+				if g.receipt != nil {
+					g.receipt.grantCount--
+				}
+				c.grants[i] = nil
+			}
+		}
+	}
+	for i, r := range c.receipts {
+		if r == nil {
+			continue
+		}
+		if r.ctx.Err() != nil {
+			c.closeReceipt(r)
+		}
+		if r.closed {
+			if r.id != 0 && !r.cancelSent {
+				if _, e := c.cancel(2, r.id); e != nil {
+					if e == errProfileFlowBusy {
+						break
+					}
+					return e
+				}
+				r.cancelSent = true
+			}
+			if r.pending == 0 && r.grantCount == 0 && (r.provenance != 3 || r.association == nil || r.association.ctx.Err() != nil) {
+				c.buffered -= uint64((len(r.original.address) + 15) &^ 15)
+				c.receipts[i] = nil
+			}
+		}
+	}
+	floor := c.dnsFloor(c.lastSent + 1)
+	for _, op := range c.pending {
+		if op != nil && op.sequence < floor {
+			floor = op.sequence
+		}
+	}
+	for _, t := range c.tombs {
+		if t.sequence == 0 {
+			continue
+		}
+		ready := (t.replied || t.cancelled && t.cancelSequence == 0) && t.cancelSequence == 0 && t.objectCancelSequence == 0
+		if !ready && t.sequence < floor {
+			floor = t.sequence
+		}
+	}
+	if floor > 0 && floor-1 > c.watermark {
+		c.watermark = floor - 1
+	}
+	for i, t := range c.tombs {
+		if t.sequence != 0 && t.sequence <= c.watermark {
+			c.tombs[i] = profileTombstone{}
+		}
+	}
+	return nil
+}
+func (c *profileFlowControl) revoke() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.revoked = true
+	for _, h := range c.hostsObservations[:c.hostsObservationUsed] {
+		c.hostsObservationClose(h)
+		if !h.released {
+			h.unknown = true
+		}
+		if h.pending != nil {
+			c.dnsNotify(h.pending, errProfile)
+		}
+	}
+	for _, x := range c.dnsContexts4[:c.dnsContext4Used] {
+		c.dnsContext4Close(x)
+		if !x.released {
+			x.unknown = true
+		}
+		if x.pending != nil {
+			c.dnsNotify(x.pending, errProfile)
+		}
+	}
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		t.closed = true
+		t.cancel()
+		if !t.released {
+			t.unknown = true
+		}
+		for _, op := range t.requests[:t.used] {
+			c.dnsNotify(op, errProfile)
+		}
+	}
+	for _, op := range c.dnsRequests[:c.dnsRequestUsed] {
+		if !op.dns.bundle.released {
+			c.dnsUnknown(op.dns.bundle)
+		}
+		c.dnsNotify(op, errProfile)
+	}
+	for _, q := range c.dnsQueries {
+		if q != nil {
+			q.closeLocked()
+		}
+	}
+	for _, g := range c.grants {
+		c.closeGrant(g)
+	}
+	for _, r := range c.receipts {
+		c.closeReceipt(r)
+	}
+	for i, op := range c.pending {
+		if op != nil {
+			c.finish(op, errProfile)
+			c.pending[i] = nil
+		}
+	}
+}
