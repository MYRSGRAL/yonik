+		t.Fatal(e)
+	}
+	cancel := f.writes[len(f.writes)-1]
+	ack := make([]byte, 12)
+	ack[0] = 1
+	ack[1] = 3
+	be.PutUint64(ack[4:], oa.sequence)
+	if e := f.c.accept(profilePacket{kind: 34, reply: cancel.sequence, body: ack}); e != nil {
+		t.Fatal(e)
+	}
+	if e := f.c.tick(); e != nil {
+		t.Fatal(e)
+	}
+	if f.c.watermark < oa.sequence || f.c.watermark >= ob.sequence {
+		t.Fatal("watermark crossed live hole")
+	}
+	if e := f.c.accept(late); e != nil || ga.id != 0 {
+		t.Fatal("retired late publication", e)
+	}
+	if e := f.c.accept(good); e != nil || ob.err != nil || !f.c.grantLive(gb) {
+		t.Fatal("neighbour lost", e, ob.err)
+	}
+	if e := f.c.accept(profilePacket{kind: 19, reply: 999, object: 99, body: make([]byte, 56)}); e == nil {
+		t.Fatal("future reply accepted")
+	}
+}
+func TestProfileFlowTUNProofIsSystemAndTupleBound(t *testing.T) {
+	f := newFlowFixture(t, 2)
+	rows := f.c.manifest.rows
+	rows[6] = append(rows[6], []byte{1, 3, 0, 0, 0, 1, 't'})
+	f.installManifest(t, rows)
+	defer f.serve(t)()
+	ctx := context.WithValue(f.p.ctx, profileContextKey{}, f.p)
+	conn := fakeTCPFlowConn()
+	dest := xnet.TCPDestination(xnet.IPAddress(net.IPv4(203, 0, 113, 50)), 443)
+	flow, release, e := ProfileOpenTUN(ctx, conn, dest)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer release()
+	r := profileReceiptFrom(flow)
+	if r.provenance != 1 || r.index != 1 || r.original.family != 4 || !bytes.Equal(r.tuple[8:12], []byte{192, 0, 2, 1}) || !bytes.Equal(r.tuple[24:28], []byte{203, 0, 113, 50}) {
+		t.Fatal("TUN original tuple")
+	}
+	local := newFlowFixture(t, 1)
+	localCtx := context.WithValue(local.p.ctx, profileContextKey{}, local.p)
+	if _, _, e = ProfileOpenTUN(localCtx, conn, dest); e == nil {
+		t.Fatal("Local minted System receipt")
+	}
+}
+func TestProfileFlowIdleCONNECTRefreshesWithoutResurrection(t *testing.T) {
+	f := newFlowFixture(t, 1)
+	r := f.admittedReceipt(t, "connect.invalid")
+	g := f.granted(t, r)
+	id := g.id
+	start := f.now
+	for i := 0; i < 4; i++ {
+		f.now = f.now.Add(800 * time.Millisecond)
+		old := g.deadline
+		if e := f.c.tick(); e != nil {
+			t.Fatal(e)
+		}
+		op := g.refresh
+		if op == nil || op.object != id || !op.submitted || g.deadline != old {
+			t.Fatal("idle CONNECT missing/eager refresh")
+		}
+		if e := f.c.accept(f.grantReply(op, 0)); e != nil || op.err != nil {
+			t.Fatal(e, op.err)
+		}
+	}
+	if !f.c.grantLive(g) || g.receipt.id != r.id || f.now.Sub(start) <= time.Second {
+		t.Fatal("CONNECT did not survive >1s")
+	}
+	f.now = f.now.Add(800 * time.Millisecond)
+	if e := f.c.tick(); e != nil {
+		t.Fatal(e)
+	}
+	op := g.refresh
+	reply := f.grantReply(op, 0)
+	f.c.mu.Lock()
+	f.c.closeReceipt(r)
+	f.c.mu.Unlock()
+	if e := f.c.accept(reply); e != nil {
+		t.Fatal(e)
+	}
+	if op.err == nil || !g.closed || f.c.grantLive(g) {
+		t.Fatal("refresh resurrected closed CONNECT")
+	}
+}
