+// Использует native auth/address/response helpers, но UDP command перехватывает
+// ДО handshake5::ListenSystemPacket. Child port/tempUDPConn не является proof.
+func profileHandshakeBeforeUDPFactory(s *ServerSession, reader io.Reader, writer net.Conn, admit func() error) (*protocol.RequestHeader, error) {
+	var prefix [2]byte
+	if _, e := io.ReadFull(reader, prefix[:]); e != nil {
+		return nil, e
+	}
+	if prefix[0] == socks4Version {
+		return s.handshake4(prefix[1], reader, writer)
+	}
+	if prefix[0] != socks5Version {
+		return nil, nativehooks.ErrProfileUnsupported
+	}
+	username, e := s.auth5(prefix[1], reader, writer)
+	if e != nil {
+		return nil, e
+	}
+	var command [3]byte
+	if _, e = io.ReadFull(reader, command[:]); e != nil {
+		return nil, e
+	}
+	if command[1] == cmdUDPAssociate {
+		if command[0] != 5 || command[2] != 0 || !s.config.UdpEnabled || admit == nil {
+			return nil, nativehooks.ErrProfileUnsupported
+		}
+		e = admit()
+		responseError := writeSocks5Response(writer, statusCmdNotSupport, net.AnyIP, 0)
+		// Control ACK не даёт relay/sourceFlow/FlowGrant. До issuer FD delivery
+		// и consuming actor bridge этот endpoint closed даже при nil error.
+		return nil, goerrors.Join(nativehooks.ErrProfileUnsupported, e, responseError)
+	}
+	if command[1] != cmdTCPConnect && command[1] != cmdTorResolve && command[1] != cmdTorResolvePTR {
+		writeSocks5Response(writer, statusCmdNotSupport, net.AnyIP, 0)
+		return nil, nativehooks.ErrProfileUnsupported
+	}
+	address, port, e := addrParser.ReadAddressPort(nil, reader)
+	if e != nil {
+		return nil, e
+	}
+	request := &protocol.RequestHeader{Command: protocol.RequestCommandTCP, Version: socks5Version, Address: address, Port: port}
+	if username != "" {
+		request.User = &protocol.MemoryUser{Email: username}
+	}
+	if e = writeSocks5Response(writer, statusSuccess, s.address, s.port); e != nil {
+		return nil, e
+	}
+	return request, nil
+}
