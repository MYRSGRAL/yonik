+			constructed := false
+			prepare := func(actual []byte, check bool, _ func(context.Context) error) (*nativehooks.ProfileRuntime, error) {
+				if check || !bytes.Equal(actual, data) {
+					t.Fatal("изменены exact bytes/mode")
+				}
+				return nil, errors.New(reason)
+			}
+			s, p, e := prepareProfileServer(data, prepare, func(context.Context, []byte) (core.Server, error) { constructed = true; return nil, nil })
+			if e == nil || s != nil || p != nil || constructed {
+				t.Fatal("main обошёл admission")
