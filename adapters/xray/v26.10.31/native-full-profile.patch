+			Name  string `json:"name"`
+			Tuple string `json:"tupleHex"`
+		}
+	}
+	if e := json.Unmarshal(profileOriginalFlowV3, &v); e != nil {
+		t.Fatal(e)
+	}
+	// Tuple vectors не являются System proof. UDP positive остаётся Local;
+	// System association Unsupported проверяется proof controls отдельно.
+	f := newFlowFixture(t, 1)
+	rows := f.c.manifest.rows
+	be.PutUint16(rows[6][0][2:], 1080)
+	f.installManifest(t, rows)
+	defer f.serve(t)()
+	ctx := context.WithValue(f.p.ctx, profileContextKey{}, f.p)
+	tcp := &flowFakeConn{local: &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 1080}, remote: &net.TCPAddr{IP: net.IPv4(192, 0, 2, 10), Port: 12000}}
+	accepted, e := ProfileAccept(ctx, tcp, "i")
+	if e != nil {
+		t.Fatal(e)
+	}
+	first, release, e := ProfileOpenOriginal(accepted, xnet.TCPDestination(xnet.DomainAddress("one.invalid"), 443))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer release()
+	udp := &flowFakeConn{local: &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 49152}, remote: &net.UDPAddr{IP: net.IPv4(192, 0, 2, 10), Port: 12001}}
+	association, e := ProfileAssociateUDP(accepted, udp)
+	if e != nil {
+		t.Fatal(e)
+	}
+	second, _, e := ProfileOpenOriginal(association, xnet.UDPDestination(xnet.DomainAddress("two.invalid"), 443))
+	if e != nil {
+		t.Fatal(e)
+	}
+	for i, flow := range []context.Context{first, second} {
+		r := profileReceiptFrom(flow)
+		if hex.EncodeToString(r.tuple[:]) != v.Rows[i].Tuple {
+			t.Fatal("tuple orientation mismatch", v.Rows[i].Name)
+		}
+	}
+	if profileReceiptFrom(first).tuple == profileReceiptFrom(second).tuple {
+		t.Fatal("TCP owner promoted to UDP")
+	}
