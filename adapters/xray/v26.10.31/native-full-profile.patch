+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"sync"
+	"time"
+)
+
+var errProfileFlowBusy = errors.New("full-profile control budget exhausted")
+
+type profileDestinationValue struct {
+	address         string
+	port            uint16
+	family, network byte
+}
+
+func (d profileDestinationValue) valid() bool {
+	if d.port == 0 || d.network != 6 && d.network != 17 {
+		return false
+	}
+	if d.family == 3 {
+		return profileDomain([]byte(d.address))
+	}
+	a, e := netip.ParseAddr(d.address)
+	return e == nil && a.Zone() == "" && !a.Is4In6() && !a.IsUnspecified() && !a.IsMulticast() && (d.family == 4 && a.Is4() || d.family == 6 && a.Is6())
+}
+func (d profileDestinationValue) encode() []byte {
+	if !d.valid() {
+		return nil
+	}
+	var address []byte
+	if d.family == 3 {
+		address = []byte(d.address)
+	} else {
+		a, e := netip.ParseAddr(d.address)
+		if e != nil {
+			return nil
+		}
+		address = a.AsSlice()
+	}
+	b := make([]byte, 8+len(address))
+	b[0] = d.family
+	b[1] = d.network
+	be.PutUint16(b[2:], d.port)
+	be.PutUint16(b[4:], uint16(len(address)))
+	copy(b[8:], address)
+	c := profileCursor{b: b}
+	profileDestination(&c)
+	if !c.done() {
+		return nil
+	}
+	return b
+}
