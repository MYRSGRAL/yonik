+		return two, nil
+	}
+	type outcome struct {
+		ips []net.IP
+		e   error
+	}
+	result1, result2 := make(chan outcome, 1), make(chan outcome, 1)
+	go func() { ips, _, e := ProfileLookupSnapshot(ctx1, "same", true, false); result1 <- outcome{ips, e} }()
+	go func() { ips, _, e := ProfileLookupSnapshot(ctx2, "same", true, false); result2 <- outcome{ips, e} }()
+	<-one.entered
+	<-two.entered
+	cancel1()
+	first := <-result1
+	if first.e == nil || len(first.ips) != 0 {
+		t.Fatal("cancelled waiter published answer")
