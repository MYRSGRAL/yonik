+			return c.PacketConn, c.RemoteAddr(), nil
+		case *cnc.Connection:
+			return &FakePacketConn{Conn: c}, &net.UDPAddr{IP: []byte{0, 0, 0, 0}}, nil
+		}
+	}
+	if conn != nil {
+		conn.Close()
+	}
+	return nil, nil, errors.New("guarded UDP capability unavailable")
+}
