+// Длина проверяется до allocation; partial frame не становится DNS answer.
+func readOwnedDNSResponse(reader io.Reader) ([]byte, error) {
+	var size [2]byte
+	if _, e := io.ReadFull(reader, size[:]); e != nil {
+		return nil, e
+	}
+	n := int(binary.BigEndian.Uint16(size[:]))
+	if n < 12 || n > 32768 {
