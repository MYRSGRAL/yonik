+func TestProfileDNSNumericGrant19ForeignExpiredUnknownAndLate(t *testing.T) {
+	for _, fault := range []string{"flow", "revision", "object", "class", "required", "owner-kind", "owner-none", "owner-expired", "late", "root-expired", "reservation-expired", "cancel", "unknown", "deny", "duplicate"} {
