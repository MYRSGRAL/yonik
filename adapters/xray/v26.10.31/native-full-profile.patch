+type fakeProfileRenew struct {
+	r        profileLaunch
+	body     []byte
+	request  uint64
+	sequence uint64
+	ack      bool
+	fail     bool
+}
+
+func (f *fakeProfileRenew) send(kind uint16, reply uint64, b []byte) error {
+	if kind == 21 {
+		if reply != 0 || len(b) != 40 || u64(b, 0) != 1 || !bytes.Equal(b[8:], f.r.manifest[:]) {
+			return errProfile
+		}
+		return nil
+	}
+	if kind != 3 || reply != f.sequence || len(b) != 48 || u64(b, 32) != 2 {
+		return errProfile
+	}
+	f.ack = true
+	if f.fail {
+		return io.ErrClosedPipe
+	}
+	return nil
+}
+func (f *fakeProfileRenew) receive(time.Time) ([]byte, error) {
+	return f.r.packet(2, f.sequence, f.request, f.body), nil
+}
+func TestProfileRenewalDoesNotResurrectOrExtendOnStaleACK(t *testing.T) {
+	body, r := syntheticProfileCapsule()
+	m, e := decodeProfileCapsule(body, r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	now := time.Now()
+	old := profileAdmission{launch: r, capsule: m, state: profileAdmitted, deadline: now.Add(time.Second)}
+	next := append([]byte(nil), body...)
+	copy(next[32:], r.manifest[:])
+	be.PutUint64(next[64:], 2)
+	f := &fakeProfileRenew{r: r, body: next, request: 3, sequence: 2}
+	renewed, e := renewProfile(old, f, 3, 2, func() time.Time { return now })
+	if e != nil || !f.ack || !renewed.deadline.After(old.deadline) {
+		t.Fatal("renew", e)
+	}
+	for _, fault := range []string{"expired", "revoked", "ACK", "reply", "replay", "manifest"} {
+		t.Run(fault, func(t *testing.T) {
+			a := old
+			ff := *f
+			ff.body = append([]byte(nil), next...)
+			switch fault {
+			case "expired":
+				a.deadline = now
+			case "revoked":
+				a.state = profileRevoked
+			case "ACK":
+				ff.fail = true
+			case "reply":
+				ff.request = 999
+			case "replay":
+				ff.sequence = 1
+			case "manifest":
+				ff.body[32] ^= 1
+			}
+			got, e := renewProfile(a, &ff, 3, 2, func() time.Time { return now })
+			if e == nil || got.deadline != a.deadline {
+				t.Fatal("renewed after", fault)
+			}
+		})
+	}
+}
