+package nativehooks
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"net/netip"
+	"unicode/utf8"
+)
+
+type profileCursor struct {
+	b   []byte
+	bad bool
+}
+
+func (c *profileCursor) take(n int) []byte {
+	if n < 0 || n > len(c.b) {
+		c.bad = true
+		return nil
+	}
+	b := c.b[:n]
+	c.b = c.b[n:]
+	return b
+}
+func (c *profileCursor) n16() uint16 {
+	b := c.take(2)
+	if b == nil {
+		return 0
+	}
+	return u16(b, 0)
+}
+func (c *profileCursor) str(max int) []byte {
+	n := int(c.n16())
+	if n > max {
+		c.bad = true
+		return nil
+	}
+	return c.take(n)
+}
+func (c *profileCursor) done() bool { return !c.bad && len(c.b) == 0 }
+func profileName(b []byte, max int) bool {
+	if len(b) == 0 || len(b) > max || !utf8.Valid(b) {
+		return false
+	}
+	for _, r := range string(b) {
+		if r < 32 || r == 127 {
+			return false
+		}
+	}
+	return true
+}
+func profileDomain(b []byte) bool {
+	return profileLabels(b, false, true)
+}
+func profileLabels(b []byte, underscore, uppercase bool) bool {
+	if len(b) == 0 || len(b) > 253 {
+		return false
+	}
+	start := 0
+	for i, v := range b {
+		if v == '.' {
+			if i == start || i-start > 63 || b[start] == '-' || b[i-1] == '-' {
+				return false
+			}
+			start = i + 1
+			continue
+		}
+		if !(v >= 'a' && v <= 'z' || uppercase && v >= 'A' && v <= 'Z' || v >= '0' && v <= '9' || v == '-' || underscore && v == '_') {
+			return false
+		}
+	}
+	return start < len(b) && len(b)-start <= 63 && b[start] != '-' && b[len(b)-1] != '-'
+}
+func profileIP(b []byte) bool {
+	a, ok := netip.AddrFromSlice(b)
+	return ok && !a.Is4In6() && !a.IsUnspecified() && !a.IsMulticast()
+}
+func profileHost(b []byte) bool {
+	if profileDomain(b) {
+		return true
+	}
+	a, e := netip.ParseAddr(string(b))
+	return e == nil && a.Zone() == "" && !a.Is4In6() && !a.IsUnspecified() && !a.IsMulticast()
+}
+func profileDestination(c *profileCursor) byte {
+	h := c.take(8)
+	if h == nil {
+		return 0
+	}
+	n := int(u16(h, 4))
+	a := c.take(n)
+	if c.bad || (h[1] != 6 && h[1] != 17) || u16(h, 2) == 0 || !zero(h[6:]) {
+		c.bad = true
+		return 0
+	}
+	if !(h[0] == 3 && profileDomain(a) || h[0] == 4 && n == 4 && profileIP(a) || h[0] == 6 && n == 16 && profileIP(a)) {
+		c.bad = true
+	}
+	return h[1]
+}
+
+type profileAsset struct {
+	digest [32]byte
+	size   uint64
+	dns    bool
+	source [32]byte
+	flags  uint32
+}
+
+func profileAssetPath(path, root string, m *profileCapsule) int {
+	for i := 0; i < m.assetCount; i++ {
+		a := m.assets[i]
+		name := hex.EncodeToString(a.digest[:]) + ".dat"
+		if a.dns {
+			name = "dns-" + hex.EncodeToString(a.digest[:]) + ".bin"
+		}
+		if path == root+"/"+name {
+			return i
+		}
+	}
+	return -1
+}
+
+type profileCapsule struct {
+	hash       [32]byte
+	admission  uint64
+	lease      uint32
+	policy     uint64
+	caps       [8]uint32
+	rows       [11][][]byte
+	assets     [16]profileAsset
+	assetCount int
+}
+
+var profileRowCaps = [11]int{256, 512, 1024, 256, 64, 16, 4, 1, 512, 16, 1}
+var profileMaxCaps = [8]uint32{4096, 128, 128, 64, 8388608, 30000, 4096, 256}
+
+func profileIndex(i uint16, n int, optional bool) bool { return int(i) < n || optional && i == 65535 }
+
+func decodeProfileCapsule(b []byte, r profileLaunch) (m profileCapsule, err error) {
+	return decodeProfileCapsulePrevious(b, r, [32]byte{})
+}
+func decodeProfileCapsulePrevious(b []byte, r profileLaunch, previous [32]byte) (m profileCapsule, err error) {
+	if len(b) < 128 || len(b) > profileFrameLimit-128 || !bytes.Equal(b[:32], r.manifest[:]) || !bytes.Equal(b[32:64], previous[:]) || u64(b, 64) == 0 || u32(b, 72) == 0 || u32(b, 72) > 60000 || b[76] != r.mode || b[77] != r.mode-1 || u16(b, 78) != 3 || u64(b, 80) == 0 || u16(b, 120) != 11 || !zero(b[122:128]) {
+		return m, errProfile
+	}
+	copy(m.hash[:], b[:32])
+	m.admission = u64(b, 64)
+	m.lease = u32(b, 72)
+	m.policy = u64(b, 80)
+	for i, limit := range profileMaxCaps {
+		v := u32(b, 88+i*4)
+		if v == 0 || v > limit {
+			return profileCapsule{}, errProfile
+		}
+		m.caps[i] = v
+	}
+	if uint64(m.caps[4]) < uint64(512*1024+len(b)*3) {
+		return profileCapsule{}, errProfile
+	}
+	h := sha256.New()
+	h.Write([]byte("YNKCAP-MANIFEST-v1\x00"))
+	h.Write(r.digest[:])
+	h.Write(b[76:78])
+	h.Write(b[80:120])
+	h.Write(b[128:])
+	if !bytes.Equal(h.Sum(nil), m.hash[:]) {
+		return profileCapsule{}, errProfile
+	}
+	// Первый проход не материализует rows. Все counts и lengths до make.
+	c := profileCursor{b: b[128:]}
+	for i, limit := range profileRowCaps {
+		p := c.take(8)
+		if p == nil || int(u16(p, 0)) != i+1 {
+			return profileCapsule{}, errProfile
+		}
+		n := int(u16(p, 2))
+		size := int(u32(p, 4))
+		if n > limit || size < n*4 {
+			return profileCapsule{}, errProfile
+		}
+		rows := profileCursor{b: c.take(size)}
+		if c.bad {
+			return profileCapsule{}, errProfile
+		}
+		for j := 0; j < n; j++ {
+			length := int(rows.n16())
+			reserved := rows.n16()
+			rows.take(length)
+			if reserved != 0 || rows.bad {
+				return profileCapsule{}, errProfile
+			}
+		}
+		if !rows.done() {
+			return profileCapsule{}, errProfile
+		}
+	}
+	if !c.done() {
+		return profileCapsule{}, errProfile
+	}
+	c = profileCursor{b: b[128:]}
+	for i := range m.rows {
+		p := c.take(8)
+		n := int(u16(p, 2))
+		rows := profileCursor{b: c.take(int(u32(p, 4)))}
+		m.rows[i] = make([][]byte, n)
+		for j := range m.rows[i] {
+			length := int(rows.n16())
+			rows.n16()
+			m.rows[i][j] = rows.take(length)
+		}
+	}
+	if !m.validate(r.mode) {
+		return profileCapsule{}, errProfile
+	}
+	// Одновременные frame/rows/strings, fixed decoder state, snapshot
+	// и streaming DAT category index резервируются до materialization assets.
+	credit := uint64(512*1024 + len(b)*3)
+	dat := false
+	for i := 0; i < m.assetCount; i++ {
+		a := m.assets[i]
+		if a.dns {
+			credit += a.size
+		} else {
+			dat = true
+		}
+	}
+	if dat {
+		credit += 2*1024*1024 + 32768
+	}
+	if credit > uint64(m.caps[4]) {
+		return profileCapsule{}, errProfile
+	}
+	return m, nil
+}
+
+func (m *profileCapsule) validate(mode byte) bool {
+	counts := func(table int) int { return len(m.rows[table-1]) }
+	if counts(1) == 0 || counts(7) == 0 {
+		return false
+	}
+	var names [256]string
+	for i, b := range m.rows[0] {
+		c := profileCursor{b: b}
+		name := c.str(160)
+		p := c.take(8)
+		if !c.done() || p == nil || !profileName(name, 160) || p[0] < 1 || p[0] > 7 || p[1] != 0 || !profileIndex(u16(p, 2), counts(4), false) || !profileIndex(u16(p, 4), counts(9), false) || !profileIndex(u16(p, 6), counts(9), false) {
+			return false
+		}
