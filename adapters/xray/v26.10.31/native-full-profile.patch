+// Незамороженная proof-v2 extension. Runtime/ABI260 остаются rights-free.
+var profileUDPShapes = [...]struct {
+	magic          string
+	length, rights int
+	issuer         bool
+}{
+	{"YNKUCS01", 192, 1, false}, {"YNKUCA01", 160, 0, true},
+	{"YNKUAQ01", 160, 0, false}, {"YNKUAC01", 192, 1, true},
+	{"YNKUPQ01", 160, 0, false}, {"YNKURP01", 256, 0, true},
+	{"YNKUCM01", 256, 0, false}, {"YNKUMR01", 192, 0, true},
