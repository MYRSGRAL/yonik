+		streamA[1] = 0
+		rows[1] = [][]byte{flowEndpoint(6, "198.51.100.1", 443), flowEndpoint(17, "198.51.100.1", 443), flowEndpoint(6, "198.51.100.2", 8388)}
+		rows[8] = [][]byte{flowScope(0, 6, 6, 6, 2, 0, 0, 0), flowScope(0, 17, 17, 17, 2, 1, 65535, 1), flowScope(1, 6, 6, 6, 1, 2, 1, 65535), flowScope(1, 17, 6, 6, 1, 2, 1, 65535)}
+		rows[2] = [][]byte{flowEdge(0, 2), flowEdge(1, 3)}
