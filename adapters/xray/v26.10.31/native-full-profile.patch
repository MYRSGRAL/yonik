+	if _, e = pool.NewResource(func(context.Context, func(error)) (ProfileCloser, error) { calls++; return &profilePureClose{}, nil }); e != nil {
+		t.Fatal(e)
+	}
+	allocations := testing.AllocsPerRun(20, func() {
+		if _, e = pool.NewResource(func(context.Context, func(error)) (ProfileCloser, error) { calls++; return nil, nil }); e == nil {
+			t.Fatal("object cap")
+		}
+	})
+	if calls != 1 || allocations != 0 {
+		t.Fatal("overflow before allocation", calls, allocations)
+	}
+}
+
+type profileErrorConn struct {
+	flowFakeConn
+	count int
+}
+
+func (c *profileErrorConn) Close() error { c.count++; return errors.New("unknown socket cleanup") }
+func TestProfilePhysicalUnknownCleanupRetainsCustody(t *testing.T) {
+	f := newFlowFixture(t, 1)
+	r := f.admittedReceipt(t, "one.invalid")
+	g := f.granted(t, r)
+	ctx := context.WithValue(context.WithValue(g.ctx, profileContextKey{}, f.p), profileGrantKey{}, g)
+	socket := &profileErrorConn{flowFakeConn: *fakeTCPFlowConn()}
+	dest := xnet.TCPDestination(xnet.IPAddress(net.IPv4(203, 0, 113, 9)), 443)
+	if _, e := ProfileDialPhysical(ctx, dest, func(context.Context) (net.Conn, error) {
+		f.c.mu.Lock()
+		f.c.closeReceipt(r)
+		f.c.mu.Unlock()
+		return socket, nil
+	}); e == nil {
+		t.Fatal("late socket published")
+	}
+	if e := f.p.closeTransports(); e == nil || socket.count != 1 {
+		t.Fatal("Unknown erased or close retried", e, socket.count)
+	}
+	state := f.p.transports
+	retained := false
+	for _, s := range state.sockets {
+		if s != nil {
+			retained = true
+		}
+	}
+	if !retained || f.p.ctx.Err() == nil {
+		t.Fatal("lost Unknown custody/fence")
+	}
+}
+
+func TestProfilePhysicalFactoryRejectsBeforeRunnerAndFencesPublication(t *testing.T) {
+	f := newFlowFixture(t, 1)
+	r := f.admittedReceipt(t, "one.invalid")
+	g := f.granted(t, r)
+	ctx := context.WithValue(context.WithValue(g.ctx, profileContextKey{}, f.p), profileGrantKey{}, g)
+	target := xnet.TCPDestination(xnet.IPAddress(net.IPv4(203, 0, 113, 9)), 443)
+	calls := 0
+	runner := func(context.Context) (net.Conn, error) { calls++; return fakeTCPFlowConn(), nil }
+	if _, e := ProfileDialPhysical(ctx, xnet.TCPDestination(xnet.DomainAddress("pinned.invalid"), 443), runner); !errors.Is(e, ErrProfileUnsupported) || calls != 0 {
+		t.Fatal("live resolver fallback", e, calls)
+	}
+	if _, e := ProfileDialPhysical(context.WithValue(f.p.ctx, profileContextKey{}, f.p), target, runner); e == nil || calls != 0 {
+		t.Fatal("session credential opened socket")
+	}
+	socket := fakeTCPFlowConn()
+	runner = func(context.Context) (net.Conn, error) {
+		calls++
+		f.c.mu.Lock()
+		f.c.closeReceipt(r)
+		f.c.mu.Unlock()
+		return socket, nil
+	}
+	if _, e := ProfileDialPhysical(ctx, target, runner); e == nil || !socket.closed || calls != 1 {
+		t.Fatal("late cancelled socket publication")
+	}
+}
+
+func TestProfileTransportChainPoolRequiresEveryHopGrant(t *testing.T) {
+	f := newFlowFixture(t, 1)
+	f.chainGraph(t, "hysteria")
+	r := f.admittedReceipt(t, "one.invalid")
+	g := f.granted(t, r)
