+func TestProfileFrameRejectsReplayBindingAndOverflow(t *testing.T) {
+	_, r := syntheticProfileCapsule()
+	b := r.packet(2, 1, 1, nil)
+	if _, e := r.decodePacket(b, 1); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := r.decodePacket(b, 2); e == nil {
+		t.Fatal("replay")
+	}
+	for _, offset := range []int{0, 8, 12, 16, 32, 48, 64, 96, 104, 120} {
+		bad := append([]byte(nil), b...)
+		bad[offset] ^= 1
+		if _, e := r.decodePacket(bad, 1); e == nil {
+			t.Fatal(offset)
+		}
+	}
+	if _, e := r.decodePacket(make([]byte, 65537), 1); e == nil {
+		t.Fatal("overflow")
+	}
+}
