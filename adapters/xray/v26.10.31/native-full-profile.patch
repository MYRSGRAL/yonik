+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport"
+)
+
+type profileAccepted struct {
+	runtime    *ProfileRuntime
+	ctx        context.Context
+	tuple      [40]byte
+	index      uint16
+	provenance byte
+}
+type profileSelectedRoute struct {
+	subject, scope uint16
+	branches       byte
+	effective      profileDestinationValue
+	chained        bool
+}
+
+func profileRuntime(ctx context.Context) *ProfileRuntime {
+	if ctx == nil {
+		return nil
+	}
+	p, _ := ctx.Value(profileContextKey{}).(*ProfileRuntime)
+	return p
+}
+func ProfileSession(ctx context.Context) bool { return profileRuntime(ctx) != nil }
+func CarryProfileSession(source, target context.Context) context.Context {
+	if p := profileRuntime(source); p != nil {
+		return context.WithValue(target, profileContextKey{}, p)
+	}
+	return target
+}
+func profileValue(d xnet.Destination) (profileDestinationValue, error) {
+	if !d.IsValid() {
+		return profileDestinationValue{}, errProfile
+	}
+	v := profileDestinationValue{port: uint16(d.Port)}
+	switch d.Network {
+	case xnet.Network_TCP:
+		v.network = 6
+	case xnet.Network_UDP:
+		v.network = 17
+	default:
+		return v, errProfile
+	}
+	if d.Address.Family().IsDomain() {
+		v.family = 3
+		v.address = d.Address.Domain()
+	} else {
+		a, ok := netip.AddrFromSlice(d.Address.IP())
+		if !ok {
+			return v, errProfile
+		}
+		a = a.Unmap()
+		v.address = a.String()
+		v.family = 6
+		if a.Is4() {
+			v.family = 4
+		}
+	}
+	if !v.valid() {
+		return v, errProfile
+	}
+	return v, nil
+}
+func profileTuple(local, remote xnet.Destination) (t [40]byte, e error) {
+	a, e := profileValue(local)
+	if e != nil {
+		return t, e
+	}
+	b, e := profileValue(remote)
+	if e != nil || a.family == 3 || b.family == 3 || a.family != b.family || a.network != b.network {
+		return t, errProfile
+	}
+	t[0] = a.network
+	t[1] = a.family
+	be.PutUint16(t[4:], a.port)
+	be.PutUint16(t[6:], b.port)
+	la, _ := netip.ParseAddr(a.address)
+	ra, _ := netip.ParseAddr(b.address)
+	copy(t[8:24], la.AsSlice())
+	copy(t[24:40], ra.AsSlice())
+	return t, nil
+}
+func (p *ProfileRuntime) flowFresh() bool {
+	if p == nil || p.ctx == nil || p.flow == nil {
+		return false
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.flowFence != nil && p.flowFence()
+}
+func (p *ProfileRuntime) flowRPC(op *profileOperation) error {
+	if op == nil {
+		return nil
+	}
+	p.flow.mu.Lock()
+	enqueue := !op.queued
+	op.queued = true
+	p.flow.mu.Unlock()
+	if enqueue {
+		select {
+		case p.flowQueue <- op:
+		case <-op.ctx.Done():
+			p.flow.mu.Lock()
+			p.flow.finish(op, errProfile)
+			p.flow.mu.Unlock()
+			return errProfile
+		case <-p.ctx.Done():
+			p.flow.mu.Lock()
+			p.flow.finish(op, errProfile)
+			p.flow.mu.Unlock()
+			return errProfile
+		}
+	}
+	select {
+	case <-op.done:
+		return op.err
+	case <-op.ctx.Done():
+		p.flow.abort(op)
+		return errProfile
+	case <-p.ctx.Done():
+		p.flow.abort(op)
+		return errProfile
+	}
+}
+
+// ProfileAccept вызывается только owning accepted worker с actual socket tuple.
+// Tag выбирает manifest row, но без private runtime не создаёт authority.
+func ProfileAccept(ctx context.Context, conn xnet.Conn, tag string) (context.Context, error) {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return ctx, nil
+	}
+	if !p.flowFresh() || conn == nil {
+		return ctx, errProfile
+	}
+	tuple, e := profileTuple(xnet.DestinationFromAddr(conn.RemoteAddr()), xnet.DestinationFromAddr(conn.LocalAddr()))
+	if e != nil {
+		return ctx, e
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.live() {
+		return ctx, errProfile
+	}
+	index := -1
+	for i, row := range c.manifest.rows[6] {
+		cur := profileCursor{b: row[4:]}
+		alias := cur.str(160)
+		if string(alias) == tag && (row[0] == 2 || row[0] == 3) && u16(row, 2) == u16(tuple[:], 6) {
+			index = i
+			break
+		}
+	}
+	if index < 0 {
+		return ctx, errProfile
+	}
+	provenance := byte(2)
+	if tuple[0] == 17 {
+		provenance = 3
+	}
+	for i, a := range c.accepted {
+		if a == nil && i < int(c.manifest.caps[6]) {
+			a = &profileAccepted{runtime: p, ctx: ctx, index: uint16(index), provenance: provenance, tuple: tuple}
+			c.accepted[i] = a
+			return context.WithValue(ctx, profileAcceptedKey{}, a), nil
+		}
+	}
+	return ctx, errProfile
+}
+
+// Actual UDP association port — ephemeral; TCP tuple/owner не переносится.
+func ProfileAssociateUDP(ctx context.Context, conn xnet.Conn) (context.Context, error) {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return ctx, nil
+	}
+	parent, _ := ctx.Value(profileAcceptedKey{}).(*profileAccepted)
+	if parent == nil || parent.runtime != p || parent.ctx.Err() != nil || conn == nil || !p.flowFresh() {
+		return ctx, errProfile
+	}
+	tuple, e := profileTuple(xnet.DestinationFromAddr(conn.RemoteAddr()), xnet.DestinationFromAddr(conn.LocalAddr()))
+	if e != nil || tuple[0] != 17 {
+		return ctx, errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.live() || c.manifest.rows[6][parent.index][0] != 2 {
+		return ctx, errProfile
+	}
+	for i, a := range c.accepted {
+		if a == nil && i < int(c.manifest.caps[6]) {
+			a = &profileAccepted{runtime: p, ctx: ctx, index: parent.index, provenance: 3, tuple: tuple}
+			c.accepted[i] = a
+			return context.WithValue(ctx, profileAcceptedKey{}, a), nil
+		}
+	}
+	return ctx, errProfile
+}
+func ProfileOpenOriginal(ctx context.Context, destination xnet.Destination) (context.Context, func(), error) {
+	p := profileRuntime(ctx)
+	noop := func() {}
+	if p == nil {
+		return ctx, noop, nil
+	}
+	accepted, _ := ctx.Value(profileAcceptedKey{}).(*profileAccepted)
+	if accepted == nil || accepted.runtime != p || accepted.ctx.Err() != nil || !p.flowFresh() {
+		return ctx, noop, errProfile
+	}
+	original, e := profileValue(destination)
+	if e != nil {
+		return ctx, noop, e
+	}
+	r, op, e := p.flow.open(ctx, accepted.index, accepted.provenance, accepted.tuple, original, accepted)
+	if e != nil {
+		return ctx, noop, e
+	}
+	if e = p.flowRPC(op); e != nil {
+		return ctx, noop, e
+	}
+	ctx = context.WithValue(r.ctx, profileReceiptKey{}, r)
+	release := func() { p.flow.mu.Lock(); p.flow.closeReceipt(r); p.flow.mu.Unlock() }
+	if accepted.provenance == 3 {
+		release = noop
+	}
+	return ctx, release, nil
+}
+func ProfileOpenTUN(ctx context.Context, conn xnet.Conn, destination xnet.Destination) (context.Context, func(), error) {
+	p := profileRuntime(ctx)
+	noop := func() {}
+	if p == nil {
+		return ctx, noop, nil
+	}
+	if !p.flowFresh() || p.admission.launch.mode != 2 || conn == nil {
+		return ctx, noop, errProfile
+	}
+	original, e := profileValue(destination)
+	if e != nil {
+		return ctx, noop, e
+	}
+	source := xnet.DestinationFromAddr(conn.RemoteAddr())
+	source.Network = destination.Network
+	// TUN local endpoint — immutable original destination, не TUN gateway.
+	tuple, e := profileTuple(source, destination)
+	if e != nil {
+		return ctx, noop, e
+	}
+	index := -1
+	for i, row := range p.flow.manifest.rows[6] {
+		if row[0] == 1 {
+			index = i
+			break
+		}
+	}
+	if index < 0 {
+		return ctx, noop, errProfile
+	}
+	r, op, e := p.flow.open(ctx, uint16(index), 1, tuple, original, nil)
+	if e != nil {
+		return ctx, noop, e
+	}
+	if e = p.flowRPC(op); e != nil {
+		return ctx, noop, e
+	}
+	return context.WithValue(r.ctx, profileReceiptKey{}, r), func() { p.flow.mu.Lock(); p.flow.closeReceipt(r); p.flow.mu.Unlock() }, nil
+}
+func profileReceiptFrom(ctx context.Context) *profileReceipt {
+	r, _ := ctx.Value(profileReceiptKey{}).(*profileReceipt)
+	return r
+}
+func ProfileOriginalValid(ctx context.Context) error {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return nil
+	}
+	r := profileReceiptFrom(ctx)
+	if r == nil || !p.flowFresh() {
+		return errProfile
+	}
+	p.flow.mu.Lock()
+	defer p.flow.mu.Unlock()
+	if !p.flow.receiptLive(r) || r.id == 0 {
+		return errProfile
+	}
+	return nil
+}
+func ProfileDispatchEntry(ctx context.Context, destination xnet.Destination) error {
+	if !ProfileSession(ctx) {
+		return nil
+	}
+	if ProfileOriginalValid(ctx) != nil {
+		return errProfile
+	}
+	v, e := profileValue(destination)
+	r := profileReceiptFrom(ctx)
+	if e != nil || v != r.original || v.address == "v1.mux.cool" {
+		return errProfile
+	}
+	return nil
+}
+func ProfileSameOriginal(a, b context.Context) bool {
+	if !ProfileSession(a) && !ProfileSession(b) {
+		return true
+	}
+	return profileRuntime(a) == profileRuntime(b) && profileReceiptFrom(a) != nil && profileReceiptFrom(a) == profileReceiptFrom(b)
+}
+func profileSubject(m *profileCapsule, tag string) (uint16, bool) {
+	for i, row := range m.rows[0] {
+		cur := profileCursor{b: row}
+		name := cur.str(160)
+		if string(name) == tag {
+			return uint16(i), true
+		}
+	}
+	return 0, false
+}
+func ProfileSelectRoute(ctx context.Context, tag string, effective xnet.Destination) (context.Context, error) {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return ctx, nil
+	}
+	if ProfileOriginalValid(ctx) != nil {
+		return ctx, errProfile
+	}
+	subject, ok := profileSubject(&p.flow.manifest, tag)
+	if !ok {
+		return ctx, errProfile
+	}
+	v, e := profileValue(effective)
+	if e != nil {
+		return ctx, e
+	}
+	if v.network != profileReceiptFrom(ctx).original.network {
+		return ctx, errProfile
+	}
+	return context.WithValue(ctx, profileRouteKey{}, profileSelectedRoute{subject: subject, branches: 3, effective: v}), nil
+}
+func ProfileHandlerEntry(ctx context.Context, tag string, target xnet.Destination) error {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return nil
+	}
+	if ProfileOriginalValid(ctx) != nil {
+		return errProfile
+	}
+	route, ok := ctx.Value(profileRouteKey{}).(profileSelectedRoute)
+	subject, found := profileSubject(&p.flow.manifest, tag)
+	if !ok || !found || subject != route.subject {
+		return errProfile
+	}
+	v, e := profileValue(target)
+	if e != nil || v != route.effective {
+		return errProfile
+	}
+	return nil
+}
+func ProfileAuthorizeHandler(ctx context.Context, tag string, target xnet.Destination, mux bool) (context.Context, func(), error) {
+	p := profileRuntime(ctx)
+	noop := func() {}
+	if p == nil {
+		return ctx, noop, nil
+	}
+	if ProfileHandlerEntry(ctx, tag, target) != nil {
+		return ctx, noop, errProfile
+	}
+	route := ctx.Value(profileRouteKey{}).(profileSelectedRoute)
+	v, e := profileValue(target)
+	if e != nil {
+		return ctx, noop, e
+	}
+	branch := byte(0)
+	if mux {
+		branch = 1
+	}
+	if route.branches&(1<<branch) == 0 {
+		return ctx, noop, errProfile
+	}
+	row := p.flow.manifest.rows[0][route.subject]
+	offset := len(row) - 4
+	if v.network == 17 {
+		offset += 2
+	}
+	scope := u16(row, offset)
+	if route.chained && scope != route.scope {
+		return ctx, noop, errProfile
+	}
+	g, op, e := p.flow.authorize(ctx, profileReceiptFrom(ctx), scope, branch, v, nil)
+	if e != nil {
+		return ctx, noop, e
+	}
+	if e = p.flowRPC(op); e != nil {
+		return ctx, noop, e
+	}
+	return context.WithValue(g.ctx, profileGrantKey{}, g), func() { p.flow.mu.Lock(); p.flow.closeGrant(g); p.flow.mu.Unlock() }, nil
+}
+func profileEnsureGrant(ctx context.Context, g *profileGrant) error {
+	p := profileRuntime(ctx)
+	if p == nil || g == nil || g.receipt.control != p.flow || !p.flowFresh() {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	if !c.grantLive(g) {
+		c.mu.Unlock()
+		return errProfile
+	}
+	now := c.clock()
+	renew := g.deadline.Sub(now) <= 250*time.Millisecond || c.mode == 2 && g.ownerDeadline.Sub(now) <= 5*time.Millisecond
+	c.mu.Unlock()
+	if renew {
+		_, op, e := c.authorize(g.ctx, g.receipt, g.scope, g.branch, g.effective, g)
+		if e != nil {
+			return e
+		}
+		if e = p.flowRPC(op); e != nil {
+			return e
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.grantLive(g) || c.mode == 2 && !c.clock().Before(g.ownerDeadline) {
+		return errProfile
+	}
+	return nil
+}
+func ProfileCheckDial(ctx context.Context, target xnet.Destination, carrier bool) error {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return nil
+	}
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	if profileEnsureGrant(ctx, g) != nil {
+		return errProfile
+	}
+	v, e := profileValue(target)
+	if e != nil {
+		return e
+	}
+	s := p.flow.manifest.rows[8][g.scope]
+	b := int(g.branch)
+	expected := s[4+b*2]
+	if carrier {
+		expected = s[5+b*2]
+	}
+	if v.network != expected {
+		return errProfile
+	}
+	action := s[20+b]
+	if action == 4 {
+		return errProfile
+	}
+	if action == 3 {
+		if v.address != g.effective.address || v.port != g.effective.port {
+			return errProfile
+		}
+		return nil
+	}
+	ep := p.flow.manifest.rows[1][u16(s, 8+b*2)]
+	encoded := v.encode()
+	if carrier {
+		if len(ep) != len(encoded)+4 || string(ep[:len(encoded)]) != string(encoded) {
+			return errProfile
+		}
+	} else {
+		encoded[1] = s[5+b*2]
+		if len(ep) != len(encoded)+4 || string(ep[:len(encoded)]) != string(encoded) {
+			return errProfile
+		}
+	}
+	return nil
+}
+func ProfileChain(ctx context.Context, target xnet.Destination, nextTag string) (context.Context, error) {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return ctx, nil
+	}
+	if ProfileCheckDial(ctx, target, true) != nil {
+		return ctx, errProfile
+	}
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	s := p.flow.manifest.rows[8][g.scope]
+	if s[20+int(g.branch)] != 2 || g.chain == 65535 {
+		return ctx, errProfile
+	}
+	edge := p.flow.manifest.rows[2][g.chain]
+	nextScope := u16(edge, 2)
+	next := p.flow.manifest.rows[8][nextScope]
+	subject, ok := profileSubject(&p.flow.manifest, nextTag)
+	v, e := profileValue(target)
+	if !ok || e != nil || u16(next, 0) != subject || next[2] != v.network || u16(edge, 0) != g.scope || edge[4] != g.branch {
+		return ctx, errProfile
+	}
+	ctx = context.WithValue(ctx, profileGrantKey{}, (*profileGrant)(nil))
+	return context.WithValue(ctx, profileRouteKey{}, profileSelectedRoute{subject: subject, scope: nextScope, branches: edge[5], effective: v, chained: true}), nil
+}
+
+type profileFlowReader struct {
+	ctx    context.Context
+	grant  *profileGrant
+	reader buf.Reader
+}
+
+func (r *profileFlowReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	if profileEnsureGrant(r.ctx, r.grant) != nil {
+		return nil, errProfile
+	}
+	mb, e := r.reader.ReadMultiBuffer()
+	if profileEnsureGrant(r.ctx, r.grant) != nil {
+		buf.ReleaseMulti(mb)
+		return nil, errProfile
+	}
+	for _, b := range mb {
+		if b.UDP != nil {
+			v, e := profileValue(*b.UDP)
+			if e != nil || v != r.grant.effective {
+				buf.ReleaseMulti(mb)
+				return nil, errProfile
+			}
+		}
+	}
+	return mb, e
+}
+func (r *profileFlowReader) Close() error { return common.Interrupt(r.reader) }
+
+type profileFlowWriter struct {
+	ctx    context.Context
+	grant  *profileGrant
+	writer buf.Writer
+}
+
+func (w *profileFlowWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if profileEnsureGrant(w.ctx, w.grant) != nil {
+		buf.ReleaseMulti(mb)
+		return errProfile
+	}
+	return w.writer.WriteMultiBuffer(mb)
+}
+func (w *profileFlowWriter) Close() error { return common.Close(w.writer) }
+func ProfileGuardLink(ctx context.Context, link *transport.Link) {
+	if !ProfileSession(ctx) {
+		return
+	}
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	link.Reader = &profileFlowReader{ctx, g, link.Reader}
+	link.Writer = &profileFlowWriter{ctx, g, link.Writer}
+}
