--- /dev/null
+++ b/common/yonikbroker/profile_snapshot.go
@@ -0,0 +1,194 @@
+package nativehooks
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"net/netip"
+)
+
+// Snapshot пока удерживает exact verified encoding. DNS consumer следующего
+// milestone получает только этот тип, а не произвольный filename/hash.
+type profileSnapshot struct {
+	encoded  []byte
+	peers    [3][]byte
+	families [3]byte
+	count    int
+}
+
+func profileDNSName(b []byte, root bool) bool {
+	if root && (len(b) == 0 || bytes.Equal(b, []byte("."))) {
+		return true
+	}
+	if len(b) > 0 && b[len(b)-1] == '.' {
+		b = b[:len(b)-1]
+	}
+	// Pinned netgo isDomainName допускает SRV-like underscore labels.
+	// Dynamic flow Destination использует отдельную, более строгую LDH grammar.
+	return profileLabels(b, true, true)
+}
+
+func profileHostsAlias(b []byte) bool {
+	for _, v := range b {
+		if v >= 'A' && v <= 'Z' {
+			return false
+		}
+	}
+	return profileDNSName(b, false) && (bytes.IndexByte(b, '.') < 0 || b[len(b)-1] == '.')
+}
+
+func profileHostsLiteral(b []byte) bool {
+	ip, ok := netip.AddrFromSlice(b)
+	// Hosts data не являются разрешением physical endpoint или resolver peer.
+	return ok && !ip.Is4In6()
+}
+
+func decodeProfileSnapshot(b []byte, a profileAsset) (*profileSnapshot, error) {
+	if !a.dns || sha256.Sum256(b) != a.digest || uint64(len(b)) != a.size || len(b) < 120 || len(b) > 2*1024*1024 || string(b[:8]) != "YNKDNS01" || u16(b, 8) != 1 || u16(b, 10) != 120 || int(u32(b, 12)) != len(b) || !bytes.Equal(b[16:48], a.source[:]) || !zero(b[112:120]) {
+		return nil, errProfile
+	}
+	c := profileCursor{b: b[120:]}
+	hash := c.take(32)
+	p := c.take(8)
+	flags := c.n16()
+	if hash == nil || p == nil || p[0] < 1 || p[0] > 4 || p[1] > 15 || p[2] < 1 || p[2] > 5 || p[3] != 0 || u32(p, 4) == 0 || u32(p, 4) > 30000 || flags&^uint16(31) != 0 {
+		return nil, errProfile
+	}
+	if !profileDNSName(c.str(253), true) {
+		return nil, errProfile
+	}
+	search := int(c.n16())
+	if search > 6 {
+		return nil, errProfile
+	}
+	for i := 0; i < search; i++ {
+		if !profileDNSName(c.str(253), true) {
+			return nil, errProfile
+		}
+	}
+	peers := int(c.n16())
+	snapshot := &profileSnapshot{encoded: b, count: peers}
+	// Pinned netgo использует первые три valid nameserver, включая duplicates.
+	if peers == 0 || peers > 3 {
+		return nil, errProfile
+	}
+	for i := 0; i < peers; i++ {
+		h := c.take(4)
+		if h == nil || h[1] != 0 || u16(h, 2) != 53 {
+			return nil, errProfile
+		}
+		n := 4
+		if h[0] == 6 {
+			n = 16
+		} else if h[0] != 4 {
+			return nil, errProfile
+		}
+		address := c.take(n)
+		if !profileIP(address) {
+			return nil, errProfile
+		}
+		snapshot.peers[i] = address
+		snapshot.families[i] = h[0]
+	}
+	hosts := int(c.n16())
+	if hosts > 4096 || a.flags&1 != 0 && hosts != 0 {
+		return nil, errProfile
+	}
+	// O(n log n) duplicate check с fixed stack storage, без map capacity.
+	var aliases [4096][]byte
+	for i := 0; i < hosts; i++ {
+		alias := c.str(253)
+		if !profileHostsAlias(alias) {
+			return nil, errProfile
+		}
+		aliases[i] = alias
+		n := int(c.n16())
+		if n < 1 || n > 16 {
+			return nil, errProfile
+		}
+		for j := 0; j < n; j++ {
+			family := c.take(1)
+			if family == nil {
+				return nil, errProfile
+			}
+			size := 4
+			if family[0] == 6 {
+				size = 16
+			} else if family[0] != 4 {
+				return nil, errProfile
+			}
+			if !profileHostsLiteral(c.take(size)) {
+				return nil, errProfile
+			}
+		}
+	}
+	if !c.done() {
+		return nil, errProfile
+	}
+	// Heapsort избегает allocations и квадратичного поведения на hosts cap.
+	less := func(i, j int) bool { return bytes.Compare(aliases[i], aliases[j]) < 0 }
+	var down func(int, int)
+	down = func(i, n int) {
+		for {
+			child := i*2 + 1
+			if child >= n {
+				return
+			}
+			if child+1 < n && less(child, child+1) {
+				child++
+			}
+			if !less(i, child) {
+				return
+			}
+			aliases[i], aliases[child] = aliases[child], aliases[i]
+			i = child
+		}
+	}
+	for i := hosts/2 - 1; i >= 0; i-- {
+		down(i, hosts)
+	}
+	for i := hosts - 1; i > 0; i-- {
+		aliases[0], aliases[i] = aliases[i], aliases[0]
+		down(0, i)
+	}
+	for i := 1; i < hosts; i++ {
+		if bytes.Equal(aliases[i-1], aliases[i]) {
+			return nil, errProfile
+		}
+	}
+	return snapshot, nil
+}
+
+func (s *profileSnapshot) validatesResolvers(m *profileCapsule) bool {
+	var coverage [3]byte
+	for _, row := range m.rows[4] {
+		if row[0] != 2 {
+			continue
+		}
+		c := profileCursor{b: row[36:]}
+		h := c.take(8)
+		if h == nil || u16(h, 2) != 53 {
+			return false
+		}
+		ip := c.take(int(u16(h, 4)))
+		found := false
+		for i := 0; i < s.count; i++ {
+			if h[0] == s.families[i] && bytes.Equal(ip, s.peers[i]) {
+				found = true
+				if h[1] == 6 {
+					coverage[i] |= 1
+				} else {
+					coverage[i] |= 2
+				}
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	for i := 0; i < s.count; i++ {
+		if coverage[i] != 3 {
+			return false
+		}
+	}
+	return true
+}
