+func TestYonikMuxSessionCloseDoesNotCloseNeighbour(t *testing.T) {
+	manager := NewSessionManager()
+	a := manager.Allocate(&ClientStrategy{}, nil, nil)
+	b := manager.Allocate(&ClientStrategy{}, nil, nil)
+	if e := (profileMuxSession{a}).Close(); e != nil {
+		t.Fatal(e)
+	}
+	if !a.closed || b.closed || manager.Size() != 1 {
+		t.Fatal("mux neighbour cancelled")
+	}
+	b.Close(false)
+}
+func TestYonikMuxOwnedWorkerRetiresExactlyOnce(t *testing.T) {
+	count := 0
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	factory := &DialingWorkerFactory{profileContext: ctx}
+	workerCtx, stop := factory.workerContext()
+	defer stop()
+	cancel()
+	if workerCtx.Err() != context.Canceled {
+		t.Fatal("worker context detached")
+	}
+	target := session.OutboundsFromContext(workerCtx)[0].Target
+	if target.Network != net.Network_TCP || target.Address != muxCoolAddress {
+		t.Fatal("mux worker input changed")
+	}
+	worker, tasks := r9MuxConstruct(t, transport.Link{Reader: &r9MuxEndpoint{}, Writer: &r9MuxEndpoint{}}, func(error) { count++ })
+	worker.requestClose()
+	tasks.fetch()
+	tasks.monitor()
+	worker.Close()
+	if count != 1 || !worker.Closed() {
+		t.Fatal("worker retirement")
+	}
+}
