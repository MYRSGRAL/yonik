+func (x *udpProducerFixture) consume(t *testing.T, replyBeforeMatch bool) *profileOperation {
+	t.Helper()
+	if e := x.actor.producerTick(); e != nil {
+		t.Fatal(e)
+	}
+	if len(x.proofs) != 1 || string(x.proofs[0][:8]) != "YNKUPQ01" || x.receiver.reads.Load() != 0 {
+		t.Fatal("Peek/ReadPermit order")
+	}
+	permit := udpPermit(t, x.producer.association, x.receiver, 1, 1)
+	packet := profileProofPacket{body: permit, credentials: 1, pid: 7}
+	if e := x.actor.receive(func() (profileProofPacket, error) { return packet, nil }); e != nil {
+		t.Fatal(e)
+	}
+	e := <-x.producer.readDone
+	x.producer.readDone <- e
+	if e = x.actor.producerTick(); e != nil {
+		t.Fatal(e)
+	}
+	u := x.producer.current
+	if u == nil || u.receipt.provenance != 3 || u.receipt.tuple != x.receiver.got.tuple || u.receipt.original != x.producer.association.original {
+		t.Fatal("OPEN lost immutable provenance")
+	}
+	if e = x.actor.producerTick(); e != nil {
+		t.Fatal(e)
+	}
+	if len(x.proofs) != 2 || string(x.proofs[1][:8]) != "YNKUCM01" || u64(x.proofs[1], 240) != u.open.sequence {
+		t.Fatal("Consumed not bound to actual OPEN")
+	}
+	if e := u.reply(buf.FromBytes([]byte("early"))); e == nil {
+		t.Fatal("response before Match/GRANT")
+	}
+	if replyBeforeMatch {
+		if e = x.f.c.accept(x.f.ingressReply(u.open)); e != nil {
+			t.Fatal(e)
+		}
+		if _, _, e = x.f.c.authorize(x.f.p.ctx, u.receipt, 1, 0, u.original, nil); e == nil {
+			t.Fatal("private original published before Match")
+		}
+		if e = x.actor.producerTick(); e != nil {
+			t.Fatal(e)
+		}
+		select {
+		case <-x.forwarded:
+			t.Fatal("payload before Match")
+		default:
+		}
+	}
+	packet.body = udpMatch(t, x.producer.association, 1)
+	if e = x.actor.receive(func() (profileProofPacket, error) { return packet, nil }); e != nil {
+		t.Fatal(e)
+	}
+	if !replyBeforeMatch {
+		if e = x.f.c.accept(x.f.ingressReply(u.open)); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if e = x.actor.producerTick(); e != nil {
+		t.Fatal(e)
+	}
+	op := <-x.f.p.flowQueue
+	if op.kind != 18 || op.receipt != u.receipt || op.receipt.tuple != x.receiver.got.tuple {
+		t.Fatal("AUTHORIZE borrowed source")
+	}
+	if e = x.f.c.dispatch(op); e != nil {
+		t.Fatal(e)
+	}
+	select {
+	case <-x.forwarded:
+		t.Fatal("payload before GRANT")
+	default:
+	}
+	if x.sends.Load() != 0 || x.producer.association.phase != profileUDPMatched {
+		t.Fatal("premature response/retirement")
+	}
+	return op
+}
