+			if handler == nil {
+				return ctx, noop, nativehooks.ErrDenied
+			}
+		}
+	}
+	if handler == nil {
+		handler = d.ohm.GetDefaultHandler()
+	}
+	if handler == nil {
+		return ctx, noop, nativehooks.ErrDenied
+	}
+	var err error
+	ctx, err = nativehooks.ProfileSelectRoute(ctx, handler.Tag(), destination)
+	if err != nil {
+		return ctx, noop, err
+	}
+	chooser, ok := handler.(interface {
+		ProfileDNSPrepareWaiter(context.Context, net.Destination) (context.Context, func(), error)
+	})
