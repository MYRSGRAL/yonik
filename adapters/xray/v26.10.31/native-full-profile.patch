+				a.deadline = now
+			case "revoked":
+				a.state = profileRevoked
+			case "ACK":
+				ff.fail = true
+			case "reply":
+				ff.request = 999
+			case "replay":
+				ff.sequence = 1
+			case "manifest":
+				ff.body[32] ^= 1
+			}
+			got, e := renewProfile(a, &ff, 3, 2, func() time.Time { return now })
+			if e == nil || got.deadline != a.deadline {
