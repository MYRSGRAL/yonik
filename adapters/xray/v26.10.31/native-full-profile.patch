+func serveService(t *testing.T, f *flowFixture, alter func(*profileOperation, *profilePacket)) func() {
+	t.Helper()
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case <-stop:
+				return
+			case op := <-f.p.flowQueue:
+				if e := f.c.dispatch(op); e != nil {
+					f.c.mu.Lock()
+					f.c.finish(op, e)
+					f.c.mu.Unlock()
+					continue
+				}
+				if op.completed {
+					continue
+				}
+				reply := serviceReply(f, op)
+				if alter != nil {
+					alter(op, &reply)
+				}
+				if e := f.c.accept(reply); e != nil {
+					f.c.mu.Lock()
+					f.c.finish(op, e)
+					f.c.mu.Unlock()
+				}
+			}
+		}
+	}()
+	return func() { close(stop); <-done }
+}
