@@ -0,0 +1,668 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"bytes"
+	"context"
+	_ "embed"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+//go:embed profile-udp-proof-v2-source.json
+var udpSourceVectors []byte
+
+//go:embed profile-udp-proof-v2-rust.json
+var udpRustVectors []byte
+
+func TestProfileUDPv2ExactRustD79RecordsAckAndWholeDatagramFingerprint(t *testing.T) {
+	var v struct {
+		Launch      string `json:"launch_hex"`
+		Bootstrap   string `json:"bootstrap_hex"`
+		Ack         string `json:"ack_hex"`
+		Payload     string `json:"payload_hex"`
+		Fingerprint string `json:"fingerprint_hex"`
+		Vectors     []struct {
+			Magic, Hex string
+			Rights     int
+			FromGo     bool `json:"from_go"`
+		}
+	}
+	if e := json.Unmarshal(udpRustVectors, &v); e != nil {
+		t.Fatal(e)
+	}
+	decode := func(s string) []byte {
+		b, e := hex.DecodeString(s)
+		if e != nil {
+			t.Fatal(e)
+		}
+		return b
+	}
+	r, e := decodeProfileLaunch(decode(v.Launch))
+	if e != nil {
+		t.Fatal(e)
+	}
+	b, e := profileProofBootstrapV2(r)
+	if e != nil || !bytes.Equal(b[:], decode(v.Bootstrap)) {
+		t.Fatal("PF002 Rust parity", e)
+	}
+	ack := profileProofAck(b)
+	if !bytes.Equal(ack[:], decode(v.Ack)) {
+		t.Fatal("PFA02 Rust hash parity")
+	}
+	if len(v.Vectors) != 10 {
+		t.Fatal("missing record kinds")
+	}
+	for i, row := range v.Vectors {
+		raw := decode(row.Hex)
+		kind, e := profileUDPDecode(r, raw, row.Rights, !row.FromGo)
+		if e != nil || kind != i {
+			t.Fatal(row.Magic, e)
+		}
+		encoded, n, e := profileUDPEncode(r, kind, raw[128:])
+		if e != nil || !bytes.Equal(encoded[:n], raw) {
+			t.Fatal("exact Rust record bytes", row.Magic, e)
+		}
+		cookieOffset := 0
+		switch kind {
+		case 1, 2:
+			cookieOffset = 144
+		case 3, 5, 6:
+			cookieOffset = 152
+		case 9:
+			cookieOffset = 160
+		}
+		if cookieOffset != 0 {
+			max := append([]byte(nil), raw...)
+			be.PutUint64(max[cookieOffset:], ^uint64(0))
+			if _, e = profileUDPDecode(r, max, row.Rights, !row.FromGo); e != nil {
+				t.Fatal("opaque kernel cookie MAX is not counter wrap", row.Magic, e)
+			}
+			clear(max[cookieOffset : cookieOffset+8])
+			if _, e = profileUDPDecode(r, max, row.Rights, !row.FromGo); e == nil {
+				t.Fatal("zero cookie")
+			}
+		}
+		if kind == 5 {
+			hash := profileUDPFingerprint(r, raw, decode(v.Payload))
+			if !bytes.Equal(hash[:], decode(v.Fingerprint)) || !bytes.Equal(hash[:], raw[208:240]) {
+				t.Fatal("whole datagram Rust fingerprint")
+			}
+			if u16(raw, 164) != 32002 || u16(raw, 166) != 49152 || u32(raw, 200) != uint32(len(decode(v.Payload))) {
+				t.Fatal("initiator/relay/length mismatch")
+			}
+			bad := append([]byte(nil), raw...)
+			clear(bad[208:240])
+			if _, e = profileUDPDecode(r, bad, 0, true); e == nil {
+				t.Fatal("zero fingerprint")
+			}
+			bad = append([]byte(nil), raw...)
+			bad[184] = 126
+			if _, e = profileUDPDecode(r, bad, 0, true); e == nil {
+				t.Fatal("foreign relay endpoint")
+			}
+		}
+	}
+}
+
+func TestProfileUDPv2IndependentSourceVectorsNotRuntimeAuthority(t *testing.T) {
+	var v struct {
+		Authority, RustParity bool
+		Launch                string `json:"launchHex"`
+		Bootstrap             string `json:"bootstrapHex"`
+		Ack                   string `json:"ackHex"`
+		Records               []struct {
+			Magic, Wire string
+			Rights      int
+			Issuer      bool
+			WireHex     string `json:"wireHex"`
+		}
+	}
+	if e := json.Unmarshal(udpSourceVectors, &v); e != nil {
+		t.Fatal(e)
+	}
+	if v.Authority || v.RustParity || len(v.Records) != 10 {
+		t.Fatal("source vectors claimed readiness")
+	}
+	decode := func(s string) []byte {
+		b, e := hex.DecodeString(s)
+		if e != nil {
+			t.Fatal(e)
+		}
+		return b
+	}
+	r, e := decodeProfileLaunch(decode(v.Launch))
+	if e != nil {
+		t.Fatal(e)
+	}
+	bootstrap, e := profileProofBootstrapV2(r)
+	if e != nil || !bytes.Equal(bootstrap[:], decode(v.Bootstrap)) {
+		t.Fatal("PF002 Python parity", e)
+	}
+	ack := profileProofAck(bootstrap)
+	if !bytes.Equal(ack[:], decode(v.Ack)) {
+		t.Fatal("PFA02 Python parity")
+	}
+	for i, row := range v.Records {
+		raw := decode(row.WireHex)
+		kind, e := profileUDPDecode(r, raw, row.Rights, row.Issuer)
+		if e != nil || kind != i {
+			t.Fatal(row.Magic, e)
+		}
+		encoded, n, e := profileUDPEncode(r, kind, raw[128:])
+		if e != nil || !bytes.Equal(encoded[:n], raw) {
+			t.Fatal("source bytes mismatch", row.Magic, e)
+		}
+	}
+}
+
+type udpReceiveFake struct {
+	raw                   []byte
+	got                   profileUDPReceiveResult
+	reads, closes, joins  atomic.Int32
+	closeError, joinError error
+	started               chan struct{}
+	block                 chan struct{}
+	closed                chan struct{}
+	ignoreCancel          bool
+}
+
+func (f *udpReceiveFake) Receive(ctx context.Context, b []byte) (profileUDPReceiveResult, error) {
+	f.reads.Add(1)
+	if f.started != nil {
+		close(f.started)
+	}
+	if f.block != nil {
+		if f.ignoreCancel {
+			<-f.block
+		} else {
+			select {
+			case <-f.block:
+			case <-ctx.Done():
+				return profileUDPReceiveResult{}, ctx.Err()
+			}
+		}
+	}
+	copy(b, f.raw)
+	return f.got, nil
+}
+func (f *udpReceiveFake) Close() error {
+	f.closes.Add(1)
+	if f.closed != nil {
+		close(f.closed)
+	}
+	return f.closeError
+}
+func (f *udpReceiveFake) Join() error { f.joins.Add(1); return f.joinError }
+
+func udpStateFixture(t *testing.T) (*flowFixture, *profileUDPAssociation, *udpReceiveFake) {
+	t.Helper()
+	f := newFlowFixture(t, 2)
+	// Явный fake consumed bootstrap; production OS gate PF002 остаётся closed.
+	f.p.proofs.version = 2
+	f.p.proofs.launch = f.p.admission.launch
+	if e := profileInitUDPBudget(f.p); e != nil {
+		t.Fatal(e)
+	}
+	raw := []byte{0, 0, 0, 1, 198, 51, 100, 7, 0, 53, 0xaa, 0xbb}
+	tuple := fakeFlowTuple(17)
+	be.PutUint16(tuple[6:], 49152)
+	receiver := &udpReceiveFake{raw: raw, got: profileUDPReceiveResult{n: len(raw), tuple: tuple, cookie: 3, queueBytes: 65536, bound: profileDestinationValue{family: 4, network: 17, port: 49152, address: "127.0.0.1"}}}
+	r := f.p.admission.launch
+	delivery := udpDelivery(t, r, 1, 3, 2)
+	a, e := profileNewUDPAssociation(f.c, r, f.p.ctx, delivery, func() (profileUDPReceiver, error) { return receiver, nil })
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { a.CloseAndJoin() })
+	return f, a, receiver
+}
+func udpDelivery(t *testing.T, r profileLaunch, id, cookie, control uint64, operation ...uint64) []byte {
+	t.Helper()
+	var tail [64]byte
+	be.PutUint64(tail[:], 1)
+	if len(operation) > 0 {
+		be.PutUint64(tail[:], operation[0])
+	}
+	be.PutUint64(tail[8:], control)
+	be.PutUint64(tail[16:], id)
+	be.PutUint64(tail[24:], cookie)
+	tail[32], tail[33] = 4, 17
+	be.PutUint16(tail[36:], 49152)
+	copy(tail[40:], []byte{127, 0, 0, 1})
+	b, n, e := profileUDPEncode(r, 3, tail[:])
+	if e != nil {
+		t.Fatal(e)
+	}
+	return b[:n]
+}
+func udpPermit(t *testing.T, a *profileUDPAssociation, receiver *udpReceiveFake, packet, permit uint64) []byte {
+	t.Helper()
+	tail := make([]byte, 128)
+	be.PutUint64(tail, a.id)
+	be.PutUint64(tail[8:], packet)
+	be.PutUint64(tail[16:], permit)
+	be.PutUint64(tail[24:], a.cookie)
+	copy(tail[32:], receiver.got.tuple[:])
+	be.PutUint32(tail[72:], uint32(len(receiver.raw)))
+	be.PutUint16(tail[76:], 10)
+	be.PutUint64(tail[112:], uint64(time.Second))
+	tail[80] = 1 // placeholder DATA; ниже заменяется hash actual bytes.
+	b, n, e := profileUDPEncode(a.launch, 5, tail)
+	if e != nil {
+		t.Fatal(e)
+	}
+	hash := profileUDPFingerprint(a.launch, b[:n], receiver.raw)
+	copy(b[208:240], hash[:])
+	return b[:n]
+}
+func udpMatch(t *testing.T, a *profileUDPAssociation, status byte) []byte {
+	t.Helper()
+	tail := make([]byte, 64)
+	be.PutUint64(tail, a.id)
+	be.PutUint64(tail[8:], a.lastPacket)
+	be.PutUint64(tail[16:], a.lastPermit)
+	be.PutUint64(tail[24:], a.openSequence)
+	tail[32] = status
+	if status == 1 {
+		be.PutUint64(tail[40:], uint64(time.Second))
+	}
+	b, n, e := profileUDPEncode(a.launch, 7, tail)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return b[:n]
+}
+
+func TestProfileUDPv2ExclusivePermitMatchDoesNotGrantOrReleasePayload(t *testing.T) {
+	f, a, receiver := udpStateFixture(t)
+	if e := a.ConsumePermit(); e == nil || receiver.reads.Load() != 0 {
+		t.Fatal("read without permit")
+	}
+	if e := a.BeginPeek(f.now.Add(time.Second)); e != nil {
+		t.Fatal(e)
+	}
+	b := udpPermit(t, a, receiver, 1, 1)
+	if e := a.Permit(b); e != nil {
+		t.Fatal(e)
+	}
+	if e := a.ConsumePermit(); e != nil {
+		t.Fatal(e)
+	}
+	if e := a.ConsumePermit(); e == nil || receiver.reads.Load() != 1 {
+		t.Fatal("second consuming reader")
+	}
+	consumed, e := a.Consumed(4)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if kind, e := profileUDPDecode(a.launch, consumed[:], 0, false); e != nil || kind != 6 {
+		t.Fatal("consumed schema", e)
+	}
+	if _, e = a.Consumed(5); e == nil {
+		t.Fatal("consumed receipt reused")
+	}
+	if e = a.Match(udpMatch(t, a, 1)); e != nil {
+		t.Fatal(e)
+	}
+	if e = a.BeginPeek(f.now.Add(time.Second)); e == nil {
+		t.Fatal("new permit while payload waiting GRANT")
+	}
+	if e = a.RetirePayload(); e == nil || a.length != len(receiver.raw) {
+		t.Fatal("Matched treated as grant or terminal denial")
+	}
+	if a.original.address != "198.51.100.7" || a.original.port != 53 || a.original.network != 17 {
+		t.Fatal("original parsed from wrong bytes")
+	}
+	if f.c.highestFlow != 0 || f.c.highestGrant != 0 {
+		t.Fatal("control/Matched promoted to user authority")
+	}
+}
+func TestProfileUDPv2ActualReadMustMatchEveryKernelAndPacketField(t *testing.T) {
+	for _, mutation := range []string{"peer", "flags", "cookie", "bound", "length", "payload", "header", "overflow", "rcvbuf", "gro"} {
+		t.Run(mutation, func(t *testing.T) {
+			f, a, r := udpStateFixture(t)
+			a.BeginPeek(f.now.Add(time.Second))
+			permit := udpPermit(t, a, r, 1, 1)
+			switch mutation {
+			case "peer":
+				r.got.tuple[8] ^= 1
+			case "flags":
+				r.got.flags = 1
+			case "cookie":
+				r.got.cookie++
+			case "bound":
+				r.got.bound.port++
+			case "length":
+				r.got.n--
+			case "payload":
+				r.raw[len(r.raw)-1] ^= 1
+			case "header":
+				r.raw[2] = 1
+			case "overflow":
+				r.got.overflow = 1
+			case "rcvbuf":
+				r.got.queueBytes = 128*1024 + 1
+			case "gro":
+				r.got.gro = true
+			}
+			if e := a.Permit(permit); e != nil {
+				t.Fatal(e)
+			}
+			if e := a.ConsumePermit(); e == nil || a.length != 0 {
+				t.Fatal("mismatched consumed packet accepted")
+			}
+			if e := a.CloseAndJoin(); e == nil || a.phase != profileUDPUnknown || !a.credit {
+				t.Fatal("mismatch lost Unknown custody")
+			}
+		})
+	}
+}
+func TestProfileUDPv2DeniedPayloadMustRetireBeforeNextPermit(t *testing.T) {
+	f, a, r := udpStateFixture(t)
