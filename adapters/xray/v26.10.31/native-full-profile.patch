+func TestProfileDNSNumericCancelPublicationFenceAndKnownCleanup(t *testing.T) {
+	n := numericPublished(t, 1, 6)
+	n.launch(t, n.source, n.target)
+	op := n.dnsTo42(t)
+	c := n.wire.f.c
+	old := c.write
+	c.write = func(kind uint16, object uint64, b []byte) (uint64, error) {
+		seq, err := old(kind, object, b)
+		if kind == 42 {
+			op.dnsNumeric.cancel()
+		}
+		return seq, err
+	}
+	if err := c.dispatch(op); err != nil {
+		t.Fatal(err)
+	}
+	result := n.result(t)
+	if result.err == nil {
+		t.Fatal("cancel inside successful send published")
+	}
+	if !op.receipt.numericOnly || !op.dnsNumeric.attempted {
+		t.Fatal("sent phase not retained")
+	}
+	reply, _ := numericGolden(t, 1, op.receipt.id)
+	reply.reply = op.sequence
+	if err := c.accept(reply); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.tick(); err != nil {
+		t.Fatal(err)
+	}
+	holder := op.dnsNumeric
+	if holder.closeSequence == 0 || holder.released {
+		t.Fatal("missing own durable grant retirement")
+	}
+	if holder.waiter.owner.cleanupSequence != 0 {
+		t.Fatal("waiter retired before user grant ACK")
+	}
+	ack := profilePacket{kind: 34, reply: holder.closeSequence, body: make([]byte, 12)}
+	ack.body[0], ack.body[1] = 3, 1
+	be.PutUint64(ack.body[4:], holder.grant.id)
+	if err := c.accept(ack); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.tick(); err != nil {
+		t.Fatal(err)
+	}
+	if !holder.released {
+		t.Fatal("known cleanup not released")
+	}
+	before := c.operations
+	if err := c.tick(); err != nil {
+		t.Fatal(err)
+	}
+	if c.operations != before {
+		t.Fatal("numeric credits returned twice")
+	}
+}
