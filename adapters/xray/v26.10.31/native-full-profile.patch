+package nativehooks
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"io"
+	"os"
+	"sort"
+	"strings"
+	"unicode/utf8"
+)
+
+// Streaming protobuf verifier: не вызывает proto.Unmarshal с attacker counts.
+// Суммарный input ограничен asset budget; depth ровно четыре уровня schema.
+type profileDATReader struct {
+	br         *bufio.Reader
+	pos, end   uint64
+	categories [][32]byte
+	wanted     [16]string
+	found      [16]bool
+	kind       byte
+}
+
+func (r *profileDATReader) byte() (byte, error) {
+	if r.pos >= r.end {
+		return 0, io.ErrUnexpectedEOF
+	}
+	b, e := r.br.ReadByte()
+	if e == nil {
+		r.pos++
+	}
+	return b, e
+}
+func (r *profileDATReader) varint() (uint64, error) {
+	var v uint64
+	for i := 0; i < 10; i++ {
+		b, e := r.byte()
+		if e != nil || i == 9 && b > 1 {
+			return 0, errProfile
+		}
+		v |= uint64(b&127) << uint(7*i)
+		if b < 128 {
+			if i > 0 && b == 0 {
+				return 0, errProfile
+			}
+			return v, nil
+		}
+	}
+	return 0, errProfile
+}
+func (r *profileDATReader) text(n uint64, keep bool) (string, error) {
+	if n == 0 || n > r.end-r.pos || keep && n > 160 {
+		return "", errProfile
+	}
+	var held [160]byte
+	var runeBytes [4]byte
+	used := 0
+	for i := uint64(0); i < n; i++ {
+		b, e := r.byte()
+		if e != nil {
+			return "", errProfile
+		}
+		if keep {
+			held[i] = b
+		}
+		runeBytes[used] = b
+		used++
+		if utf8.FullRune(runeBytes[:used]) {
+			_, size := utf8.DecodeRune(runeBytes[:used])
+			if size == 1 && runeBytes[0] >= 128 {
+				return "", errProfile
+			}
+			used = 0
+		} else if used == 4 {
+			return "", errProfile
+		}
+	}
+	if used != 0 {
+		return "", errProfile
+	}
+	if keep {
+		return string(held[:n]), nil
+	}
+	return "", nil
+}
+
+// level: list0, entry1, record2, attribute3. Known fields/type only.
+func (r *profileDATReader) message(end uint64, level int) error {
+	if end > r.end || level > 3 {
+		return errProfile
+	}
+	var seen uint8
+	var code string
+	var ipLength uint64
+	var prefix uint64
+	for r.pos < end {
+		tag, e := r.varint()
+		if e != nil {
+			return e
+		}
+		field, wire := tag>>3, tag&7
+		if field == 0 || field > 3 {
+			return errProfile
+		}
+		repeated := level == 0 && field == 1 || level == 1 && field == 2 || level == 2 && r.kind == 2 && field == 3
+		bit := uint8(1 << field)
+		if !repeated && seen&bit != 0 {
+			return errProfile
+		}
+		seen |= bit
+		scalar := level == 1 && r.kind == 1 && field == 3 || level == 2 && r.kind == 1 && field == 2 || level == 2 && r.kind == 2 && field == 1 || level == 3 && (field == 2 || field == 3)
+		if scalar {
+			if wire != 0 {
+				return errProfile
+			}
+			v, e := r.varint()
+			if e != nil {
+				return e
+			}
+			if level == 1 && v > 1 || level == 2 && r.kind == 2 && v > 3 || level == 3 && field == 2 && v > 1 {
+				return errProfile
+			}
+			if level == 2 && r.kind == 1 {
+				prefix = v
+			}
+			continue
+		}
+		if wire != 2 {
+			return errProfile
+		}
+		n, e := r.varint()
+		if e != nil || n > end-r.pos {
+			return errProfile
+		}
+		childEnd := r.pos + n
+		switch {
+		case level == 0 && field == 1, level == 1 && field == 2, level == 2 && r.kind == 2 && field == 3:
+			if e = r.message(childEnd, level+1); e != nil {
+				return e
+			}
+		case level == 1 && field == 1:
+			code, e = r.text(n, true)
+			if e != nil || !profileName([]byte(code), 160) {
+				return errProfile
+			}
+		case level == 2 && r.kind == 1 && field == 1:
+			if n != 4 && n != 16 {
+				return errProfile
+			}
+			ipLength = n
+			var address [16]byte
+			for i := uint64(0); i < n; i++ {
+				v, e := r.byte()
+				if e != nil {
+					return e
+				}
+				address[i] = v
+			}
+			// CIDR unspecified/multicast networks допустимы в DAT; это matcher, не peer.
+		case level == 2 && r.kind == 2 && field == 2, level == 3 && field == 1:
+			if _, e = r.text(n, false); e != nil {
+				return e
+			}
+		default:
+			return errProfile
+		}
+		if r.pos != childEnd {
+			return errProfile
+		}
+	}
+	if r.pos != end {
+		return errProfile
+	}
+	switch level {
+	case 1:
+		if code == "" {
+			return errProfile
+		}
+		canonical := strings.ToUpper(code)
+		hash := sha256.Sum256([]byte(canonical))
+		if len(r.categories) == cap(r.categories) {
+			return errProfile
+		}
+		r.categories = append(r.categories, hash)
+		for i, wanted := range r.wanted {
+			// Native seek сравнивает exact DAT code с upper-case request code;
+			// нормализация самого DAT не должна создавать отсутствующую category.
+			if wanted != "" && wanted == code {
+				r.found[i] = true
+			}
+		}
+	case 2:
+		if r.kind == 1 {
+			if ipLength == 0 || prefix > ipLength*8 {
+				return errProfile
+			}
+		} else if seen&(1<<2) == 0 {
+			return errProfile
+		}
+	case 3:
+		if seen&(1<<1) == 0 || seen&(1<<2) != 0 && seen&(1<<3) != 0 {
+			return errProfile
+		}
+	}
+	return nil
+}
+func verifyProfileDAT(f *os.File, a profileAsset, m *profileCapsule) error {
+	return verifyProfileDATReader(io.NewSectionReader(f, 0, int64(a.size)), a, m)
+}
+func verifyProfileDATReader(input io.Reader, a profileAsset, m *profileCapsule) error {
+	// 65536 category hashes = 2MiB, зарезервированы до parsing, не по wire count.
+	r := profileDATReader{br: bufio.NewReaderSize(input, 32768), end: a.size, categories: make([][32]byte, 0, 65536)}
+	for i, row := range m.rows[5] {
+		c := profileCursor{b: row}
+		kind := c.take(2)
+		category := c.str(160)
+		digest := c.take(32)
+		if bytes.Equal(digest, a.digest[:]) {
+			if r.kind != 0 && r.kind != kind[0] {
+				return errProfile
+			}
+			r.kind = kind[0]
+			r.wanted[i] = strings.ToUpper(strings.SplitN(string(category), "@", 2)[0])
+		}
+	}
+	if r.kind == 0 || r.message(r.end, 0) != nil {
+		return errProfile
+	}
+	sort.Slice(r.categories, func(i, j int) bool { return bytes.Compare(r.categories[i][:], r.categories[j][:]) < 0 })
+	for i := 1; i < len(r.categories); i++ {
+		if r.categories[i] == r.categories[i-1] {
+			return errProfile
+		}
+	}
+	for i, w := range r.wanted {
+		if w != "" && !r.found[i] {
+			return errProfile
+		}
+	}
+	return nil
+}
