+			var tail [32]byte
+			be.PutUint64(tail[:], x.producer.association.id)
+			be.PutUint64(tail[8:], 99)
+			be.PutUint64(tail[16:], x.producer.association.control)
+			b, n, e := profileUDPEncode(x.producer.association.launch, 8, tail[:])
+			if e != nil {
+				t.Fatal(e)
+			}
+			if e = x.actor.receive(func() (profileProofPacket, error) {
+				return profileProofPacket{body: b[:n], credentials: 1, pid: 7}, nil
+			}); e != nil {
+				t.Fatal(e)
+			}
+			if e = x.actor.producerTick(); e != nil {
+				t.Fatal(e)
+			}
+			if x.producer.finished {
+				t.Fatal("KnownClosed before send task joined")
+			}
+			close(release)
+			e = <-done
+			if uncertain {
+				if e == nil || u.result == nil || x.f.p.admission.state != profileUnknown {
+					t.Fatal("uncertain effect lost custody")
+				}
+				<-u.done
+				if !x.producer.controlJoined {
+					controlError := <-x.producer.controlDone
+					x.producer.controlDone <- controlError
+				}
+				if e = x.actor.producerTick(); e == nil {
+					t.Fatal("uncertain cleanup became known")
+				}
+				if x.producer.finished || !u.credit || u.response == nil {
+					t.Fatal("Unknown released response custody")
+				}
+				return
+			}
+			if e != nil {
+				t.Fatal(e)
+			}
+			<-u.done
+			if e = x.f.c.tick(); e != nil {
+				t.Fatal(e)
+			}
+			x.ackCancels(t)
+			if !x.producer.controlJoined {
+				controlError := <-x.producer.controlDone
+				x.producer.controlDone <- controlError
+			}
+			if e = x.actor.producerTick(); e != nil {
+				t.Fatal(e)
+			}
+			if !x.producer.finished || x.receiver.closes.Load() != 1 || x.receiver.joins.Load() != 1 {
+				t.Fatal("joined close failed")
+			}
+			if e = x.control.Close(); e != nil {
+				t.Fatal(e)
+			}
+			if e = x.control.Close(); e != nil {
+				t.Fatal("repeated close changed final result", e)
+			}
+		})
+	}
+}
+
+func TestProfileUDPProducerLatePermitCannotReadAndFailureNotifiesWithoutKnownClose(t *testing.T) {
