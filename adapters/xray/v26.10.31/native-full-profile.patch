+package nativehooks
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	_ "embed"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"testing"
+	"time"
+)
+
+//go:embed profile-launch-vectors.json
+var profileGolden []byte
+
+func TestProfileIndependentGoldenV3(t *testing.T) {
+	var v struct {
+		Local string `json:"local_record_hex"`
+		Body  string `json:"admit_body_hex"`
+		Hash  string `json:"manifest_sha256"`
+	}
+	if e := json.Unmarshal(profileGolden, &v); e != nil {
+		t.Fatal(e)
+	}
+	record, e := hex.DecodeString(v.Local)
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, e := decodeProfileLaunch(record)
+	if e != nil {
+		t.Fatal(e)
+	}
+	body, e := hex.DecodeString(v.Body)
+	if e != nil {
+		t.Fatal(e)
+	}
+	m, e := decodeProfileCapsule(body, r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	generated, binding := syntheticProfileCapsule()
+	if !bytes.Equal(generated, body) || binding.manifest != m.hash || hex.EncodeToString(m.hash[:]) != v.Hash {
+		t.Fatal("independent golden mismatch")
+	}
+}
+
+func TestProfileLaunchRecordModes(t *testing.T) {
+	b := make([]byte, 192)
+	copy(b, "YNKLOC01")
+	be.PutUint16(b[8:], 1)
+	be.PutUint16(b[10:], 192)
+	for _, i := range []int{16, 48, 80, 96, 152} {
+		b[i] = 1
+	}
+	be.PutUint64(b[112:], 1)
+	be.PutUint64(b[120:], 1)
+	be.PutUint32(b[128:], 42)
+	be.PutUint64(b[136:], 7)
+	if _, err := decodeProfileLaunch(b); err != nil {
+		t.Fatal(err)
+	}
+	b[132] = 1
+	if _, err := decodeProfileLaunch(b); err == nil {
+		t.Fatal("Local принял System worker")
+	}
+	b[132] = 0
+	copy(b, "YNKEXT01")
+	be.PutUint16(b[12:], 1)
+	if _, err := decodeProfileLaunch(b); err == nil {
+		t.Fatal("System без worker")
+	}
+	be.PutUint32(b[132:], 43)
+	be.PutUint64(b[144:], 8)
+	r, err := decodeProfileLaunch(b)
+	if err != nil || r.mode != 2 {
+		t.Fatal("valid System", err)
+	}
+	if !profileSenderValid(r, 42, 0, 1000) || profileSenderValid(r, 42, 1000, 1000) || profileSenderValid(r, 43, 0, 1000) {
+		t.Fatal("System peer")
+	}
+	r.mode = 1
+	if !profileSenderValid(r, 42, 1000, 1000) || profileSenderValid(r, 42, 0, 1000) {
+		t.Fatal("Local peer")
+	}
+}
