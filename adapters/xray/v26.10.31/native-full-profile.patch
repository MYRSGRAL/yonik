+func TestProfileUDPProducerActualRuntimeAndGuardedDownstreamCaller(t *testing.T) {
+	for _, early := range []bool{true, false} {
+		t.Run(map[bool]string{true: "runtime-before-match", false: "match-before-runtime"}[early], func(t *testing.T) {
+			x := newUDPProducerFixture(t, 32002)
+			op := x.consume(t, early)
+			if e := x.f.c.accept(x.f.grantReply(op, 2)); e != nil {
+				t.Fatal(e)
+			}
+			if got := <-x.forwarded; !bytes.Equal(got, []byte{0xaa, 0xbb}) {
+				t.Fatal("wrong request", got)
+			}
+			if got := <-x.replies; !bytes.Equal(got, []byte{0, 0, 0, 1, 198, 51, 100, 7, 0, 53, 'a', 'n', 's', 'w', 'e', 'r'}) {
+				t.Fatal("wrong response frame", got)
+			}
+			if e := x.actor.producerTick(); e != nil {
+				t.Fatal(e)
+			}
+			if x.producer.current != nil || x.producer.association.phase != profileUDPBound || x.producer.flows[0].response == nil {
+				t.Fatal("response ownership released with request")
+			}
+			x.finishFlow(t)
+			close(x.controlEOF)
+			e := <-x.producer.controlDone
+			x.producer.controlDone <- e
+			var tail [32]byte
+			be.PutUint64(tail[:], x.producer.association.id)
+			be.PutUint64(tail[8:], 99)
+			be.PutUint64(tail[16:], x.producer.association.control)
+			b, n, e := profileUDPEncode(x.producer.association.launch, 8, tail[:])
+			if e != nil {
+				t.Fatal(e)
+			}
+			packet := profileProofPacket{body: b[:n], credentials: 1, pid: 7}
+			if e = x.actor.receive(func() (profileProofPacket, error) { return packet, nil }); e != nil {
+				t.Fatal(e)
+			}
+			if e = x.actor.producerTick(); e != nil {
+				t.Fatal(e)
+			}
+			if !x.producer.finished || x.receiver.closes.Load() != 1 || x.receiver.joins.Load() != 1 || x.producer.request.err != nil || string(x.proofs[len(x.proofs)-1][:8]) != "YNKUCR01" {
+				t.Fatal("missing joined KnownClosed", x.producer.finished, x.proofs)
+			}
+		})
+	}
+}
