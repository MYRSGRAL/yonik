+
+func TestProfileR39FD47AdmissionCannotKillACKReader(t *testing.T) {
+	f, ctx, target := dnsBundleFixture(t, 1)
+	b, op := dnsAcquirePure(t, f, ctx)
+	if err := f.c.accept(dnsBundleReply(op, 41, 1)); err != nil {
+		t.Fatal(err)
+	}
+	// 47 actual/owned FD до нового owner; RX должен быть зарезервирован отдельно.
+	f.c.udpBudget = &profileUDPBudget{fdSlots: 46}
+	f.p.udpActor = &profileUDPActor{runtime: f.p}
+	h := dnsDirectStartBundle(t, f, b, target, nil, nil)
+	select {
+	case admitted := <-f.p.flowQueue:
+		if err := f.c.dispatch(admitted); err != nil {
+			t.Fatal(err)
+		}
+		release, err := f.p.reserveUDPInput()
+		if err != nil {
+			f.p.cancel()
+			f.c.revoke()
+			t.Fatalf("admitted owner starved its ACK RX and revoked neighbor: %v", err)
+		}
+		release(true)
+		t.Fatal("47 FD owner admitted despite permanently required scratch16+owner2")
+	case got := <-h.done:
+		if got.err == nil {
+			t.Fatal("overflow admission succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("no admission result")
+	}
+	// После локального отказа тот же receive path читает cancel/retirement.
+	for i := 0; i < 2; i++ {
+		release, err := f.p.reserveUDPInput()
+		if err != nil {
+			t.Fatal("cleanup ACK cannot be read", err)
+		}
+		release(true)
+	}
+	if f.p.ctx.Err() != nil || ProfileDNSBundleGuard(dnsUse(b), "a", target, false) != nil {
+		t.Fatal("local rejection killed neighbor")
+	}
+}
+
+func TestProfileR39SharedAdmissionPendingIncludesRX(t *testing.T) {
+	for _, owner := range []string{"flow", "service", "bundle", "task"} {
+		for _, delta := range []int{0, 1} {
+			t.Run(owner+strconv.Itoa(delta), func(t *testing.T) {
+				f, ctx, _ := dnsBundleFixture(t, 1)
+				e := profileDNSExchangeFrom(ctx)
+				cost := 1
+				if owner == "bundle" {
+					cost = 3
+				}
+				f.c.operations = 63 - cost + delta
+				before := f.c.buffered
+				var err error
+				switch owner {
+				case "flow":
+					_, _, err = f.c.open(context.Background(), 0, 2, fakeFlowTuple(6), profileDestinationValue{family: 3, network: 6, address: "next.invalid", port: 443}, nil)
+				case "service":
+					_, _, err = f.c.authorizeDNS(ctx, e.query.receipt, 0, e.root.query)
+				case "bundle":
+					path, targets, count, chooseError := profileDNSChosenPath(&f.c.manifest, "a", e.target, false, nil)
+					if chooseError != nil {
+						t.Fatal(chooseError)
+					}
+					_, _, err = f.c.dnsAcquire(e, path, targets, count, nil)
+				case "task":
+					_, err = ProfileDNSBeginTask(ctx)
+				}
+				if delta == 0 && err != nil {
+					t.Fatal("at bound rejected", err)
+				}
+				if delta == 1 && (err == nil || f.c.buffered != before) {
+					t.Fatal("RX pending spent by " + owner)
+				}
+			})
+		}
+	}
+}
+func TestProfileR39PhysicalPoolSharesPermanentRXFD(t *testing.T) {
+	f := newFlowFixture(t, 1)
+	r := f.admittedReceipt(t, "pool.invalid")
+	g := f.granted(t, r)
+	ctx := context.WithValue(context.WithValue(g.ctx, profileContextKey{}, f.p), profileGrantKey{}, g)
+	dest := xnet.TCPDestination(xnet.ParseAddress(g.effective.address), xnet.Port(g.effective.port))
+	f.c.udpBudget = &profileUDPBudget{fdSlots: 46}
+	calls := 0
+	conn, err := ProfileDialPhysical(ctx, dest, func(context.Context) (net.Conn, error) { calls++; return fakeTCPFlowConn(), nil })
+	if err != nil || calls != 1 || f.c.profileFDUsed() != 64 {
+		t.Fatal("pool boundary", err, calls, f.c.profileFDUsed())
+	}
+	lease, err := f.p.reserveDNSInput()
+	if err != nil {
+		t.Fatal("live pool starved RX", err)
+	}
+	lease(true)
+	if _, err = ProfileDialPhysical(ctx, dest, func(context.Context) (net.Conn, error) { calls++; return nil, errProfile }); err == nil || calls != 1 {
+		t.Fatal("pool spent RX FD")
+	}
+	if err = conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if f.c.physicalFDs != 0 || f.c.profileFDUsed() != 63 || f.c.dnsFDUsed != 16 || f.p.ctx.Err() != nil {
+		t.Fatal("pool cleanup returned scratch/double credit")
+	}
+}
+
+func r39ReadACK(t *testing.T, h *dnsDirectHarness, packet profilePacket) {
+	t.Helper()
+	beforeFD, beforePending, beforeMemory := h.f.c.profileFDUsed(), h.f.c.profilePendingUsed(), h.f.c.buffered
+	release, err := h.f.p.reserveUDPInput()
+	if err != nil {
+		h.f.p.cancel()
+		h.f.c.revoke()
+		t.Fatal("receive budget exhausted after admission", err)
+	}
+	// Injected runtime read доставляет authenticated decoded ACK в реальный actor.
+	if err = h.f.c.accept(packet); err != nil {
+		release(false)
+		t.Fatal(err)
+	}
+	release(true)
+	release(true)
+	if beforeFD != h.f.c.profileFDUsed() || beforePending != h.f.c.profilePendingUsed() || beforeMemory != h.f.c.buffered {
+		t.Fatal("RX double debit/return")
+	}
+}
+func TestProfileR39OwnerBoundaryACKAndRetirement(t *testing.T) {
+	for _, kind := range []string{"fd", "pending", "memory"} {
+		for _, delta := range []int{-1, 0, 1} {
+			t.Run(kind+strconv.Itoa(delta), func(t *testing.T) {
+				f, ctx, target := dnsBundleFixture(t, 1)
+				b, op := dnsAcquirePure(t, f, ctx)
+				if err := f.c.accept(dnsBundleReply(op, 41, 1)); err != nil {
+					t.Fatal(err)
+				}
+				f.c.udpBudget = &profileUDPBudget{fdSlots: 1}
+				f.p.udpActor = &profileUDPActor{runtime: f.p}
+				switch kind {
+				case "fd":
+					f.c.udpBudget.fdSlots = 45 + delta // runtime1 + scratch16 + owner2 + foreign45 =64.
+				case "pending":
+					f.c.operations = 51 + delta // scratch1 + owner12 + foreign51 =64.
+				case "memory":
+					f.c.buffered = uint64(int64(f.c.manifest.caps[4]) - int64(f.c.manifest.memoryCredit) - profileDNSDirectCredit + int64(delta))
+				}
+				h := dnsDirectStartBundle(t, f, b, target, nil, nil)
+				if delta > 0 {
+					got := <-h.done
+					if got.err == nil || got.conn != nil {
+						t.Fatal("over-bound owner admitted")
+					}
+					select {
+					case <-h.factory:
+						t.Fatal("effect after local denial")
+					default:
+					}
+					for i := 0; i < 2; i++ {
+						release, err := f.p.reserveUDPInput()
+						if err != nil {
+							t.Fatal(err)
+						}
+						release(true)
+					}
+					if f.p.ctx.Err() != nil || ProfileDNSBundleGuard(dnsUse(b), "a", target, false) != nil {
+						t.Fatal("local denial revoked neighbor")
+					}
+					return
+				}
+				exchange := h.next(t, 35)
+				r39ReadACK(t, h, *dnsDirectReply(exchange))
+				physical := h.next(t, 35)
+				r39ReadACK(t, h, *dnsDirectReply(physical))
+				proof := h.next(t, 52)
+				<-h.proof
+				r39ReadACK(t, h, *dnsDirectReply(proof))
+				logical := h.next(t, 38)
+				r39ReadACK(t, h, *dnsDirectReply(logical))
+				got := <-h.done
+				if got.err != nil {
+					t.Fatal(got.err)
+				}
+				if err := got.conn.Close(); err != nil {
+					t.Fatal(err)
+				}
+				owner := logical.dnsDirect.owner
+				for step := 0; step < 5; step++ {
+					if err := f.c.tick(); err != nil {
+						t.Fatal(err)
+					}
+					cleanup := owner.requests[owner.used-1]
+					packet := dnsCancelAck(cleanup.sequence, u64(cleanup.body, 8))
+					if cleanup.kind == 45 {
+						body := make([]byte, 40)
+						be.PutUint16(body, 2)
+						body[2], body[3], body[28] = 1, cleanup.body[2], 1
+						be.PutUint64(body[8:], u64(cleanup.body, 8))
+						be.PutUint64(body[16:], u64(cleanup.body, 16))
+						be.PutUint64(body[32:], cleanup.sequence)
+						packet = profilePacket{kind: 46, reply: cleanup.sequence, body: body}
+					}
+					r39ReadACK(t, h, packet)
+				}
+				if err := f.c.tick(); err != nil {
+					t.Fatal(err)
+				}
+				if !owner.released || f.c.dnsFDUsed != profileRXFD || f.p.ctx.Err() != nil {
+					t.Fatal("cleanup lost permanent scratch or neighbor")
+				}
+				if err := got.conn.Close(); err != nil {
+					t.Fatal(err)
+				}
+			})
+		}
+	}
+}
+func TestProfileR39RuntimeProofLeaseExclusiveAndUnknownSticky(t *testing.T) {
+	f, a, accepted := udpActorFixture(t)
+	r, err := a.submit(f.p.ctx, accepted)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = a.tick(); err != nil {
+		t.Fatal(err)
+	}
+	fd, pending, memory := f.c.profileFDUsed(), f.c.profilePendingUsed(), f.c.buffered
+	lease, err := f.p.reserveUDPInput()
+	if err != nil {
+		t.Fatal(err)
+	}
+	called := false
+	if err = a.receive(func() (profileProofPacket, error) { called = true; return udpActorPacket(t, a, r, false, nil), nil }); err == nil || called {
+		t.Fatal("parallel runtime/proof read entered shared scratch")
+	}
+	lease(true)
+	lease(true)
+	if err = a.receive(func() (profileProofPacket, error) {
+		lease(true)
+		lease(false)
+		if !f.c.rxLeased || f.c.dnsScratchUnknown {
+			t.Fatal("stale release changed current lease")
+		}
+		return udpActorPacket(t, a, r, false, nil), nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if f.c.profileFDUsed() != fd || f.c.profilePendingUsed() != pending-1 || f.c.buffered != memory {
+		t.Fatal("proof reader debited scratch twice")
+	}
+	lease, err = f.p.reserveUDPInput()
+	if err != nil {
+		t.Fatal(err)
+	}
+	lease(false)
+	lease(true)
+	if _, err = f.p.reserveUDPInput(); err == nil || !f.c.dnsScratchUnknown || !f.c.rxLeased {
+		t.Fatal("Unknown released/reacquired scratch")
+	}
+	if f.c.dnsCleanupResult() == nil {
+		t.Fatal("Unknown became KnownClosed")
+	}
+}
+func TestProfileR39InitPrecedesOwnersAndIsIdempotent(t *testing.T) {
+	f := newFlowFixture(t, 1)
+	fd, pending, memory := f.c.profileFDUsed(), f.c.profilePendingUsed(), f.c.buffered
+	if fd != 17 || pending != 1 || memory != profileRXMemory {
+		t.Fatal("missing pre-admission scratch")
+	}
+	f.c.initRXBudget()
+	if f.c.profileFDUsed() != fd || f.c.profilePendingUsed() != pending || f.c.buffered != memory {
+		t.Fatal("init double debit")
+	}
+	for _, kind := range []string{"pending", "memory"} {
+		m := f.c.manifest
+		if kind == "pending" {
+			m.caps[3] = 0
+		} else {
+			m.caps[4] = uint32(m.memoryCredit + profileRXMemory - 1)
+		}
+		c := newProfileFlowControl(m, 1, f.c.clock, f.c.write, f.c.alive)
+		if c.live() || c.rxReserved || c.buffered != 0 {
+			t.Fatal("undersized manifest activated flow control")
+		}
+	}
+}
diff --git a/common/yonikbroker/profile_rx_budget_linux.go b/common/yonikbroker/profile_rx_budget_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_rx_budget_linux.go
@@ -0,0 +1,57 @@
+//go:build linux
+
+package nativehooks
+
+import "sync"
+
+const profileRXFD = 16
+const profileRXMemory = 66048
+
+// Один monitor последовательно читает runtime/proof; payload AF_INET readers
+// имеют собственные association credits и не принимают SCM_RIGHTS.
+// Pending/RX bytes/FD удерживаются с constructor до окончания runtime custody.
+func (c *profileFlowControl) initRXBudget() {
+	if c.rxReserved || c.manifest.caps[3] < 1 || c.manifest.memoryCredit+profileRXMemory > uint64(c.manifest.caps[4]) {
+		return
+	}
+	c.rxReserved = true
+	c.dnsFDUsed += profileRXFD
+	c.buffered += profileRXMemory
+}
+func (c *profileFlowControl) profilePendingUsed() int {
+	used := c.operations + c.dnsTasksActive
+	if c.rxReserved {
+		used++
+	}
+	if c.udpBudget != nil {
+		used += c.udpBudget.proofPending
+	}
+	return used
+}
+
+// Lease не возвращает постоянные credits admission owners. Ошибка cleanup
+// оставляет lease/custody Unknown; repeated release не меняет final result.
+func (p *ProfileRuntime) leaseProfileRX() (func(bool), error) {
+	c := p.flow
+	if c == nil {
+		return nil, errProfile
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.rxReserved || c.rxLeased || c.dnsScratchUnknown || !c.live() {
+		return nil, errProfile
+	}
+	c.rxLeased = true
+	var once sync.Once
+	return func(clean bool) {
+		once.Do(func() {
+			c.mu.Lock()
+			defer c.mu.Unlock()
+			if clean {
+				c.rxLeased = false
+			} else {
+				c.dnsScratchUnknown = true
+			}
+		})
+	}, nil
+}
diff --git a/common/yonikbroker/profile_dns_rrset_linux.go b/common/yonikbroker/profile_dns_rrset_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_dns_rrset_linux.go
@@ -0,0 +1,935 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"bytes"
+	"context"
+	xnet "github.com/xtls/xray-core/common/net"
+	"golang.org/x/net/dns/dnsmessage"
+	"net"
+	"net/netip"
+	"sort"
+	"time"
+)
+
+// DATA-only opaque handle. Publisher/root/transport lifetime не является
+// authority cache waiter. Все mutable fields защищены flow.mu.
+type ProfileDNSProducerData struct {
+	runtime         *ProfileRuntime
+	owner           *profileDNSResultOwner
+	exchange        *profileDNSExchange
+	request         [512]byte
+	requestLen      int
+	members         [256]netip.Addr
+	count           int
+	ttl             uint32
+	id              uint64
+	epoch           uint64
+	expires         time.Time
+	closed, unknown bool
+}
+type profileDNSWaiter struct {
+	numeric                       *profileNumeric
+	owner                         *profileDNSResultOwner
+	data                          *ProfileDNSProducerData
+	bundle                        *profileDNSBundle
+	reservation, id               uint64
+	reservationDeadline, deadline time.Time
+}
+
+const profileDNSResultPending = 6
+const profileDNSResultCredit = 64 * 1024
+
+type profileDNSResultOwner struct {
+	ctx                       context.Context
+	query                     *profileDNSQuery
+	data                      *ProfileDNSProducerData
+	waiter                    *profileDNSWaiter
+	transport                 *profileDNSDirect
+	requests                  [2]*profileOperation
+	used                      int
+	closed, unknown, released bool
+	cleanupDeadline           time.Time
+	cleanupSequence           uint64
+	cleanupTarget             byte
+	cleanupID                 uint64
+	cleanupAck                bool
+	stage                     int
+}
+type profileDNSResultRPC struct {
+	owner          *profileDNSResultOwner
+	expected       uint16
+	received       bool
+	cancelSequence uint64
+	cancelAck      bool
+}
+
+func (c *profileFlowControl) dnsResultNew(ctx context.Context, e *profileDNSExchange) (*profileDNSResultOwner, error) {
+	if ctx == nil || ctx.Err() != nil || profileDNSExchangeFrom(ctx) != e || profileQueryFrom(ctx) != e.query || profileReceiptFrom(ctx) != e.query.receipt || !c.dnsRootLive(e) || c.dnsResultUsed >= len(c.dnsResults) {
+		return nil, errProfile
+	}
+	if c.profilePendingUsed()+profileDNSResultPending > min(64, int(c.manifest.caps[3])) || c.buffered+c.manifest.memoryCredit+profileDNSResultCredit > uint64(c.manifest.caps[4]) || !c.dnsReserveHistory(profileDNSResultPending) {
+		return nil, errProfileFlowBusy
+	}
+	c.operations += profileDNSResultPending
+	c.buffered += profileDNSResultCredit
+	e.query.refs++
+	o := &profileDNSResultOwner{ctx: ctx, query: e.query, cleanupDeadline: c.sessionDeadline}
+	c.dnsResults[c.dnsResultUsed] = o
+	c.dnsResultUsed++
+	return o, nil
+}
+func (c *profileFlowControl) dnsResultRequest(o *profileDNSResultOwner, kind, expected uint16, body []byte) (*profileOperation, error) {
+	if o.closed || o.unknown || o.used == len(o.requests) || !profileDNSV2Body(kind, body) {
+		return nil, errProfile
+	}
+	op := &profileOperation{ctx: o.ctx, kind: kind, body: body, done: make(chan struct{}), dnsResult: &profileDNSResultRPC{owner: o, expected: expected}}
+	o.requests[o.used] = op
+	o.used++
+	return op, nil
+}
+func (c *profileFlowControl) dnsResultLive(o *profileDNSResultOwner) bool {
+	if o.closed || o.unknown || o.ctx.Err() != nil || !o.query.liveLocked() {
+		return false
+	}
+	if o.waiter != nil {
+		w := o.waiter
+		return c.dnsBundleLive(w.bundle) && c.dnsDataLive(w.data) && (w.reservation == 0 || c.clock().Before(w.reservationDeadline)) && (w.id == 0 || c.clock().Before(w.deadline))
+	}
+	return o.transport != nil && c.dnsDirectLive(o.transport)
+}
+func (c *profileFlowControl) dnsDataLive(d *ProfileDNSProducerData) bool {
+	return d != nil && d.runtime != nil && d.runtime.flow == c && d.owner != nil && d.owner.transport != nil && d.id != 0 && !d.closed && !d.unknown && c.live() && d.epoch == d.runtime.admission.launch.epoch && c.clock().Before(d.expires) && !d.owner.unknown && !d.owner.transport.unknown && !d.owner.transport.bundle.unknown
+}
+
+// Только captured actual DirectSocket transcript, не app-supplied IPRecord.
+// raw сравнивается с полным ответом, прочитанным guarded facade этого exchange.
+func ProfileDNSPublish(ctx context.Context, raw []byte) (*ProfileDNSProducerData, error) {
+	e := profileDNSExchangeFrom(ctx)
+	p := profileRuntime(ctx)
+	if e == nil || p == nil || e.query.runtime != p || ctx.Err() != nil {
+		return nil, ErrProfileUnsupported
+	}
+	c := p.flow
+	c.mu.Lock()
+	var t *profileDNSDirect
+	for _, v := range c.dnsDirect[:c.dnsDirectUsed] {
+		if v.bundle.exchange == e {
+			t = v
+			break
+		}
+	}
+	if t == nil || !c.dnsDirectLive(t) || t.revision != 1 || t.proof == 0 || t.publishing || c.manifest.rows[4][e.root.resolver][0] != 1 || !zero(c.manifest.rows[4][e.root.resolver][4:36]) {
+		c.mu.Unlock()
+		return nil, ErrProfileUnsupported
+	}
+	t.wireMu.Lock()
+	response := t.wireResponse[:t.wireRead]
+	if t.destination.network == 6 && len(response) >= 2 {
+		response = response[2:]
+	}
+	valid := !t.wireBad && t.wireComplete() && t.wireSent == t.wireRequestLength() && bytes.Equal(response, raw)
+	if !valid {
+		t.wireMu.Unlock()
+		c.mu.Unlock()
+		return nil, errProfile
+	}
+	o, err := c.dnsResultNew(ctx, e)
+	if err != nil {
+		t.wireMu.Unlock()
+		c.mu.Unlock()
+		return nil, err
+	}
+	o.transport = t
+	d := &ProfileDNSProducerData{runtime: p, owner: o, exchange: e, epoch: t.epoch}
+	o.data = d
+	d.requestLen = copy(d.request[:], e.request)
+	// Fixed bounded transcript/parser storage уже prepaid owner credit.
+	err = profileDNSParseData(d, e.request, response)
+	if err != nil {
+		o.closed = true
+		t.wireMu.Unlock()
+		c.mu.Unlock()
+		return nil, err
+	}
+	d.expires = t.started.Add(time.Duration(d.ttl) * time.Second)
+	if c.sessionDeadline.Before(d.expires) {
+		d.expires = c.sessionDeadline
+	}
+	body := make([]byte, 144+len(e.root.query)+len(e.request)+len(response))
+	be.PutUint16(body, 2)
+	be.PutUint16(body[4:], e.root.resolver)
+	be.PutUint16(body[6:], u16(c.manifest.rows[8][t.bundle.path[0].scope], 0))
+	be.PutUint16(body[8:], 65535)
+	be.PutUint16(body[10:], e.qtype)
+	for _, v := range []struct {
+		at int
+		n  uint64
+	}{{12, e.id}, {20, e.root.id}, {28, t.exchange}, {36, t.epoch}, {120, t.proof}, {128, t.revision}} {
+		be.PutUint64(body[v.at:], v.n)
+	}
+	be.PutUint16(body[108:], uint16(len(e.root.query)))
+	be.PutUint16(body[110:], uint16(len(e.request)))
+	be.PutUint32(body[112:], uint32(len(response)))
+	body[136], body[137], body[142] = 1, 1, t.destination.network
+	be.PutUint16(body[140:], 65535)
+	at := 144
+	at += copy(body[at:], e.root.query)
+	at += copy(body[at:], e.request)
+	copy(body[at:], response)
+	t.wireMu.Unlock()
+	op, err := c.dnsResultRequest(o, 40, 41, body)
+	if err == nil {
+		t.publishing = true
+	}
+	c.mu.Unlock()
+	if err == nil {
+		err = p.flowRPC(op)
+	}
+	t.publishOnce.Do(func() { close(t.publishDone) })
+	if err != nil {
+		c.mu.Lock()
+		o.closed = true
+		c.mu.Unlock()
+		return nil, err
+	}
+	return d, nil
+}
+
+// Никаких cached grants: caller обязан получить новый exchange/root и actual
+// native chooser bundle прежде чем передать его сюда, включая publisher waiter.
+func ProfileDNSBindWaiter(ctx context.Context, d *ProfileDNSProducerData) error {
+	e := profileDNSExchangeFrom(ctx)
+	p := profileRuntime(ctx)
+	if e == nil || p == nil || d == nil || d.runtime != p {
+		return ErrProfileUnsupported
+	}
+	c := p.flow
+	c.mu.Lock()
+	b := e.bundle
+	if !c.dnsDataLive(d) || !c.dnsBundleLive(b) || e == d.exchange || b == d.exchange.bundle || e.query != profileQueryFrom(ctx) || e.query.receipt != profileReceiptFrom(ctx) || e.root.id == d.exchange.root.id || e.id == d.exchange.id || e.qtype != d.exchange.qtype || e.options != d.exchange.options || e.payload != d.exchange.payload || e.root.resolver != d.exchange.root.resolver || e.root.query != d.exchange.root.query || e.original != e.query.original || b.count != d.exchange.bundle.count || b.path != d.exchange.bundle.path || b.targets != d.exchange.bundle.targets {
+		c.mu.Unlock()
+		return errProfile
+	}
+	for _, old := range c.dnsResults[:c.dnsResultUsed] {
+		if old.waiter != nil && old.waiter.bundle == b {
+			c.mu.Unlock()
+			return errProfile
+		}
+	}
+	o, err := c.dnsResultNew(ctx, e)
+	if err != nil {
+		c.mu.Unlock()
+		return err
+	}
+	w := &profileDNSWaiter{owner: o, data: d, bundle: b, deadline: b.deadline}
+	o.waiter = w
+	body := c.dnsWaiterReserveBody(w)
+	op, err := c.dnsResultRequest(o, 35, 36, body)
+	c.mu.Unlock()
+	if err == nil {
+		err = p.flowRPC(op)
+	}
+	if err != nil {
+		c.mu.Lock()
+		o.closed = true
+		c.mu.Unlock()
+		return err
+	}
+	c.mu.Lock()
+	if !c.dnsResultLive(o) || !c.clock().Before(w.reservationDeadline) {
+		o.closed = true
+		c.mu.Unlock()
+		return errProfile
+	}
+	body = make([]byte, 64)
+	be.PutUint16(body, 2)
+	for _, v := range []struct {
+		at int
+		n  uint64
+	}{{8, w.reservation}, {16, d.id}, {24, e.root.id}, {32, e.id}, {40, e.query.receipt.id}, {48, e.query.receipt.revision}, {56, uint64(w.reservationDeadline.Sub(c.clock()))}} {
+		be.PutUint64(body[v.at:], v.n)
+	}
+	op, err = c.dnsResultRequest(o, 53, 54, body)
+	c.mu.Unlock()
+	if err == nil {
+		err = p.flowRPC(op)
+	}
+	if err != nil {
+		c.mu.Lock()
+		o.closed = true
+		c.mu.Unlock()
+	}
+	return err
+}
+func (c *profileFlowControl) dnsWaiterReserveBody(w *profileDNSWaiter) []byte {
+	e := w.bundle.exchange
+	b := w.bundle
+	base := c.dnsBody(e.root)
+	row := c.manifest.rows[8][b.path[0].scope]
+	body := make([]byte, 96+len(e.original)+len(e.root.query)+len(base))
+	be.PutUint16(body, 2)
+	body[2] = 3
+	for _, v := range []struct {
+		at int
+		n  uint64
+	}{{8, e.id}, {16, b.id}, {24, e.root.id}, {32, e.query.receipt.id}, {40, e.query.receipt.revision}, {48, e.query.runtime.admission.launch.epoch}, {56, uint64(b.deadline.Sub(c.clock()))}} {
+		be.PutUint64(body[v.at:], v.n)
+	}
+	for _, v := range []struct {
+		at int
+		n  uint16
+	}{{64, e.root.resolver}, {66, u16(row, 0)}, {68, 65535}, {70, b.path[0].scope}, {72, e.qtype}, {80, uint16(len(e.original))}, {82, uint16(len(e.root.query))}, {84, uint16(len(base))}, {88, e.options}, {90, e.payload}} {
+		be.PutUint16(body[v.at:], v.n)
+	}
+	body[74], body[75], body[76], body[77], body[78], body[79] = 1, 1, e.target.network, 3, 1, b.path[0].branch
+	at := 96
+	at += copy(body[at:], e.original)
+	at += copy(body[at:], e.root.query)
+	copy(body[at:], base)
+	return body
+}
+func (c *profileFlowControl) dnsResultDispatch(op *profileOperation) error {
+	o := op.dnsResult.owner
+	if op.submitted || op.completed {
+		return nil
+	}
+	if !c.dnsResultLive(o) {
+		o.closed = true
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	op.sent = c.clock()
+	op.deadline = o.query.runtime.flow.sessionDeadline
+	var until time.Time
+	if o.waiter != nil {
+		until = o.waiter.bundle.deadline
+		if op.kind == 53 && o.waiter.reservationDeadline.Before(until) {
+			until = o.waiter.reservationDeadline
+		}
+	} else {
+		until = o.transport.deadline
+	}
+	if until.Before(op.deadline) {
+		op.deadline = until
+	}
+	if !op.sent.Before(op.deadline) {
+		o.closed = true
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	if op.kind == 35 || op.kind == 53 {
+		be.PutUint64(op.body[56:], uint64(op.deadline.Sub(op.sent)))
+	}
+	seq, err := c.write(op.kind, 0, op.body)
+	op.sequence = seq
+	op.submitted = true
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	if err != nil || !profileDNSV2ID(seq) {
+		o.unknown = true
+		c.dnsNotify(op, errProfile)
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) dnsResultAccept(f profilePacket) (bool, error) {
+	if f.object != 0 || !profileDNSV2Body(f.kind, f.body) {
+		return true, errProfile
+	}
+	for _, o := range c.dnsResults[:c.dnsResultUsed] {
+		if f.kind == 48 && f.reply != 0 && f.reply == o.cleanupSequence {
+			if o.cleanupAck || f.body[2] != 1 || u64(f.body, 8) != o.cleanupID || !c.clock().Before(o.cleanupDeadline) {
+				o.unknown = true
+				return true, errProfile
+			}
+			o.cleanupAck = true
+			return true, nil
+		}
+		for _, op := range o.requests[:o.used] {
+			r := op.dnsResult
+			if f.kind == 48 && r.cancelSequence != 0 && f.reply == r.cancelSequence {
+				if r.cancelAck || f.body[2] != 1 || u64(f.body, 8) != op.sequence || !c.clock().Before(o.cleanupDeadline) {
+					o.unknown = true
+					return true, errProfile
+				}
+				r.cancelAck = true
+				return true, nil
+			}
+			if !op.submitted || f.reply != op.sequence || f.kind != r.expected {
+				continue
+			}
+			if r.received || r.cancelAck {
+				o.unknown = true
+				return true, errProfile
+			}
+			r.received = true
+			// ACK завершает single writer use payload. Replay/cancel сохраняют
+			// typed IDs/bindings/tombstones, а не полный Publish transcript.
+			op.body = nil
+			if f.body[2] != 1 {
+				o.closed = true
+				if f.body[2] == 3 {
+					o.unknown = true
+				}
+				c.dnsNotify(op, errProfile)
+				return true, nil
+			}
+			b := f.body
+			valid := true
+			remaining := uint64(0)
+			switch f.kind {
+			case 41:
+				d := o.data
+				d.id = u64(b, 8)
+				remaining = u64(b, 32)
+				valid = !c.hostsProducerUsed(d.id) && u64(b, 16) == o.transport.exchange && u64(b, 24) == d.epoch && int(u16(b, 40)) == d.count
+				until := op.sent.Add(time.Duration(remaining))
+				if until.Before(d.expires) {
+					d.expires = until
+				}
+				valid = valid && remaining <= uint64(time.Duration(^uint32(0))*time.Second) && c.clock().Before(d.expires)
+			case 36:
+				w := o.waiter
+				e := w.bundle.exchange
+				w.reservation = u64(b, 8)
+				remaining = u64(b, 48)
+				valid = !c.hostsReservationUsed(w.reservation) && u64(b, 16) == e.id && u64(b, 24) == w.bundle.id && u64(b, 32) == 0 && u64(b, 40) == w.data.epoch && u16(b, 56) == 0 && u16(b, 58) == 1 && b[60] == 3
+				w.reservationDeadline = op.sent.Add(time.Duration(remaining))
+				if op.deadline.Before(w.reservationDeadline) {
+					w.reservationDeadline = op.deadline
+				}
+			case 54:
+				w := o.waiter
+				e := w.bundle.exchange
+				w.id = u64(b, 8)
+				remaining = u64(b, 48)
+				valid = u64(b, 16) == w.data.id && u64(b, 24) == w.reservation && u64(b, 32) == e.id && u64(b, 40) == w.data.epoch && int(u16(b, 56)) == w.data.count && b[58] == 1 && b[59] == 1
+				w.deadline = op.sent.Add(time.Duration(remaining))
+				for _, d := range []time.Time{op.deadline, w.reservationDeadline, w.data.expires} {
+					if d.Before(w.deadline) {
+						w.deadline = d
+					}
+				}
+			}
+			if f.kind != 41 && remaining > uint64(op.deadline.Sub(op.sent)) {
+				valid = false
+			}
+			for _, other := range c.dnsResults[:c.dnsResultUsed] {
+				if other == o {
+					continue
+				}
+				if f.kind == 41 && other.data != nil && other.data.id == o.data.id || f.kind == 36 && other.waiter != nil && other.waiter.reservation == o.waiter.reservation || f.kind == 54 && other.waiter != nil && other.waiter.id == o.waiter.id {
+					valid = false
+				}
+			}
+			if !valid {
+				o.unknown = true
+				o.closed = true
+				c.dnsNotify(op, errProfile)
+				return true, errProfile
+			}
+			if !c.dnsResultLive(o) || !c.clock().Before(op.deadline) || f.kind == 54 && !c.clock().Before(o.waiter.deadline) {
+				o.closed = true
+				c.dnsNotify(op, errProfile)
+				return true, nil
+			}
+			if f.kind == 54 {
+				q := o.query
+				slot := -1
+				for i, w := range q.waiters {
+					if w == nil {
+						slot = i
+						break
+					}
+				}
+				if slot < 0 {
+					o.closed = true
+					c.dnsNotify(op, errProfile)
+					return true, nil
+				}
+				q.waiters[slot] = o.waiter
+				for _, ip := range o.waiter.data.members[:o.waiter.data.count] {
+					if q.count == len(q.ips) {
+						o.closed = true
+						c.dnsNotify(op, errProfile)
+						return true, nil
+					}
+					q.ips[q.count] = ip
+					q.count++
+				}
+				sort.Slice(q.ips[:q.count], func(i, j int) bool { return q.ips[i].Compare(q.ips[j]) < 0 })
+				q.ready = true
+			}
+			c.dnsNotify(op, nil)
+			return true, nil
+		}
+	}
+	return false, nil
+}
+func (c *profileFlowControl) dnsWaiterLive(w *profileDNSWaiter) bool {
+	return w != nil && w.id != 0 && c.dnsResultLive(w.owner) && c.clock().Before(w.deadline) && c.clock().Before(w.reservationDeadline)
+}
+
+// Cache читает копию DATA. Ни ID, ни числовая expiry наружу не экспортируются.
+func ProfileDNSDataValid(ctx context.Context, d *ProfileDNSProducerData) bool {
+	p := profileRuntime(ctx)
+	if p == nil || d == nil || d.runtime != p {
+		return false
+	}
+	p.flow.mu.Lock()
+	defer p.flow.mu.Unlock()
+	return p.flow.dnsDataLive(d)
+}
