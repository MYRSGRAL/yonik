+			}
+			<-x.forwarded
+			u := x.producer.flows[0]
+			before := x.f.c.buffered
+			finish, e := ProfileBeginLogicalTask(u.grantContext)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if x.f.c.buffered != before+4096 {
+				t.Fatal("task credit missing")
+			}
+			u.cancel()
+			<-x.flowDone
+			select {
+			case <-u.done:
+				t.Fatal("task not joined before completion")
+			default:
+			}
+			var cleanup error
+			if failed {
+				cleanup = errors.New("unknown task cleanup")
+			}
+			finish(cleanup)
+			finish(nil)
+			<-u.done
+			if failed {
+				if u.result == nil || x.f.c.buffered < before+4096 {
+					t.Fatal("Unknown task lost custody")
+				}
+			} else if u.result != nil {
+				t.Fatal(u.result)
+			}
+			if _, e = ProfileBeginLogicalTask(u.grantContext); e == nil {
+				t.Fatal("closed flow registered new task")
+			}
+		})
+	}
+}
