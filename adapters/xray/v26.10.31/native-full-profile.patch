+func ProfileDNSCacheRecord(ctx context.Context, d *ProfileDNSProducerData, ips []net.IP) (time.Time, error) {
+	p := profileRuntime(ctx)
+	if p == nil || d == nil || d.runtime != p || profileDNSExchangeFrom(ctx) != d.exchange {
+		return time.Time{}, errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.dnsDataLive(d) || len(ips) == 0 || len(ips) > 256 {
+		return time.Time{}, errProfile
+	}
+	at := 0
+	for _, v := range ips {
+		ip, ok := netip.AddrFromSlice(v)
+		if !ok {
+			return time.Time{}, errProfile
+		}
+		found := false
+		for _, member := range d.members[:at] {
+			if ip.Unmap() == member {
+				found = true
+				break
+			}
+		}
+		if !found {
+			if at == d.count || ip.Unmap() != d.members[at] {
+				return time.Time{}, errProfile
+			}
+			at++
+		}
+	}
+	if at != d.count {
+		return time.Time{}, errProfile
+	}
+	return d.expires, nil
+}
+func ProfileDNSDataRequest(ctx context.Context, d *ProfileDNSProducerData) ([]byte, xnet.Destination, error) {
+	if !ProfileDNSDataValid(ctx, d) {
+		return nil, xnet.Destination{}, errProfile
+	}
+	q := profileQueryFrom(ctx)
+	if q == nil || q.name != d.exchange.root.query || ctx.Err() != nil || profileReceiptFrom(ctx) != q.receipt || q.runtime != d.runtime {
+		return nil, xnet.Destination{}, errProfile
+	}
+	t := d.exchange.target
+	network := xnet.Network_TCP
+	if t.network == 17 {
+		network = xnet.Network_UDP
+	}
+	return append([]byte(nil), d.request[:d.requestLen]...), xnet.Destination{Network: network, Address: xnet.ParseAddress(t.address), Port: xnet.Port(t.port)}, nil
+}
+func ProfileDNSDataAnswer(ctx context.Context, d *ProfileDNSProducerData) ([]net.IP, uint32, error) {
+	p := profileRuntime(ctx)
+	if p == nil || d == nil || d.runtime != p {
+		return nil, 0, errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	q := profileQueryFrom(ctx)
+	if q == nil || q.runtime != p || profileReceiptFrom(ctx) != q.receipt || ctx.Err() != nil || !q.liveLocked() || !c.dnsDataLive(d) {
+		return nil, 0, errProfile
+	}
+	for _, w := range q.waiters {
+		if w != nil && w.data == d && c.dnsWaiterLive(w) {
+			ips := make([]net.IP, d.count)
+			for i, ip := range d.members[:d.count] {
+				ips[i] = append(net.IP(nil), ip.AsSlice()...)
+			}
+			ttl := uint32(d.expires.Sub(c.clock()) / time.Second)
+			if ttl == 0 {
+				return nil, 0, errProfile
+			}
+			return ips, ttl, nil
+		}
+	}
+	return nil, 0, errProfile
+}
