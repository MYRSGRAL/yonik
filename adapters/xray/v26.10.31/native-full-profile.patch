+func PacketConnForTransport(ctx context.Context, conn net.Conn) (net.PacketConn, net.Addr, error) {
+	if pkt, addr, e := hooks.ProfilePacketCapability(conn); e == nil {
+		return pkt, addr, nil
+	}
