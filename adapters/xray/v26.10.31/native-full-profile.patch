+//go:embed profile-launch-vectors.json
+var profileGolden []byte
+
+func TestProfileIndependentGoldenV3(t *testing.T) {
+	var v struct {
+		Local string `json:"local_record_hex"`
+		Body  string `json:"admit_body_hex"`
+		Hash  string `json:"manifest_sha256"`
+	}
+	if e := json.Unmarshal(profileGolden, &v); e != nil {
+		t.Fatal(e)
+	}
+	record, e := hex.DecodeString(v.Local)
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, e := decodeProfileLaunch(record)
+	if e != nil {
+		t.Fatal(e)
+	}
+	body, e := hex.DecodeString(v.Body)
+	if e != nil {
+		t.Fatal(e)
+	}
+	m, e := decodeProfileCapsule(body, r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	generated, binding := syntheticProfileCapsule()
+	if !bytes.Equal(generated, body) || binding.manifest != m.hash || hex.EncodeToString(m.hash[:]) != v.Hash {
+		t.Fatal("independent golden mismatch")
+	}
+}
+
+func TestProfileLaunchRecordModes(t *testing.T) {
+	b := make([]byte, 192)
+	copy(b, "YNKLOC01")
+	be.PutUint16(b[8:], 1)
+	be.PutUint16(b[10:], 192)
+	for _, i := range []int{16, 48, 80, 96, 152} {
+		b[i] = 1
+	}
+	be.PutUint64(b[112:], 1)
+	be.PutUint64(b[120:], 1)
+	be.PutUint32(b[128:], 42)
+	be.PutUint64(b[136:], 7)
+	if _, err := decodeProfileLaunch(b); err != nil {
+		t.Fatal(err)
+	}
+	b[132] = 1
+	if _, err := decodeProfileLaunch(b); err == nil {
+		t.Fatal("Local принял System worker")
+	}
+	b[132] = 0
+	copy(b, "YNKEXT01")
+	be.PutUint16(b[12:], 1)
+	if _, err := decodeProfileLaunch(b); err == nil {
+		t.Fatal("System без worker")
+	}
+	be.PutUint32(b[132:], 43)
+	be.PutUint64(b[144:], 8)
+	r, err := decodeProfileLaunch(b)
+	if err != nil || r.mode != 2 {
+		t.Fatal("valid System", err)
+	}
+	if !profileSenderValid(r, 42, 0, 1000) || profileSenderValid(r, 42, 1000, 1000) || profileSenderValid(r, 43, 0, 1000) {
+		t.Fatal("System peer")
+	}
+	r.mode = 1
+	if !profileSenderValid(r, 42, 1000, 1000) || profileSenderValid(r, 42, 0, 1000) {
+		t.Fatal("Local peer")
+	}
+}
+
+func syntheticProfileCapsule() ([]byte, profileLaunch) {
+	r := profileLaunch{mode: 1, generation: 1, epoch: 1}
+	r.digest = sha256.Sum256([]byte("config"))
+	r.nonce[0] = 1
+	r.session[0] = 1
+	r.invocation[0] = 2
+	var rows [11][][]byte
+	subject := []byte{0, 1, 'a', 5, 0, 0, 0, 0, 0, 0, 1}
+	rows[0] = [][]byte{subject}
+	stream := make([]byte, 36)
+	stream[0] = 1
+	stream[4] = 1
+	rows[3] = [][]byte{stream}
+	ingress := []byte{2, 3, 0x12, 0x34, 0, 1, 'i'}
+	rows[6] = [][]byte{ingress}
+	for i, network := range []byte{6, 17} {
+		s := make([]byte, 24)
+		s[2] = network
+		s[3] = 1
+		s[4] = network
+		s[5] = network
+		for j := 8; j < 20; j++ {
+			s[j] = 255
+		}
+		if i == 0 {
+			be.PutUint16(s[12:], 0)
+		}
+		s[20] = 3
+		rows[8] = append(rows[8], s)
+	}
+	b := make([]byte, 128)
+	be.PutUint64(b[64:], 1)
+	be.PutUint32(b[72:], 60000)
+	b[76] = 1
+	be.PutUint16(b[78:], 3)
+	be.PutUint64(b[80:], 1)
+	for i, v := range profileMaxCaps {
+		be.PutUint32(b[88+i*4:], v)
+	}
+	be.PutUint16(b[120:], 11)
+	for i, table := range rows {
+		var encoded []byte
+		for _, row := range table {
+			p := make([]byte, 4)
+			be.PutUint16(p, uint16(len(row)))
+			encoded = append(encoded, p...)
+			encoded = append(encoded, row...)
+		}
+		prefix := make([]byte, 8)
+		be.PutUint16(prefix, uint16(i+1))
+		be.PutUint16(prefix[2:], uint16(len(table)))
+		be.PutUint32(prefix[4:], uint32(len(encoded)))
+		b = append(b, prefix...)
+		b = append(b, encoded...)
+	}
+	rehashProfileCapsule(b, &r)
+	return b, r
+}
+func rehashProfileCapsule(b []byte, r *profileLaunch) {
+	h := sha256.New()
+	h.Write([]byte("YNKCAP-MANIFEST-v1\x00"))
+	h.Write(r.digest[:])
+	h.Write(b[76:78])
+	h.Write(b[80:120])
+	h.Write(b[128:])
+	copy(r.manifest[:], h.Sum(nil))
+	copy(b, r.manifest[:])
+}
+
+type fakeProfileAdmission struct {
+	r        profileLaunch
+	body     []byte
+	events   []string
+	failACK  bool
+	failRead bool
+}
+
+func (f *fakeProfileAdmission) send(kind uint16, reply uint64, b []byte) error {
+	if kind == 1 {
+		if reply != 0 || len(b) != 40 || !bytes.Equal(b[:32], f.r.nonce[:]) || b[32] != f.r.mode {
+			return errProfile
+		}
+		f.events = append(f.events, "HELLO")
+		return nil
+	}
+	if kind != 3 || reply != 1 || len(b) != 48 || !bytes.Equal(b[:32], f.r.manifest[:]) || u64(b, 32) != 1 || b[40] != 1 || !zero(b[41:]) {
+		return errProfile
+	}
+	f.events = append(f.events, "ACK")
+	if f.failACK {
+		return io.ErrClosedPipe
+	}
+	return nil
+}
+func (f *fakeProfileAdmission) receive(time.Time) ([]byte, error) {
+	f.events = append(f.events, "ADMIT")
+	if f.failRead {
+		return nil, io.EOF
+	}
+	return f.r.packet(2, 1, 1, f.body), nil
+}
+
+func TestProfileAdmissionBootOrderAndFences(t *testing.T) {
+	for _, fault := range []string{"", "assets", "EOF", "ACK", "expired", "digest"} {
+		t.Run(fault, func(t *testing.T) {
+			body, r := syntheticProfileCapsule()
+			f := &fakeProfileAdmission{r: r, body: body, failRead: fault == "EOF", failACK: fault == "ACK"}
+			now := time.Now()
+			clock := func() time.Time { return now }
+			raw := []byte("config")
+			if fault == "digest" {
+				raw = []byte("changed")
+			}
+			a, err := admitProfile(r, raw, f, func(*profileCapsule) error {
+				f.events = append(f.events, "ASSETS")
+				if fault == "assets" {
+					return errProfile
+				}
+				if fault == "expired" {
+					now = now.Add(time.Minute)
+				}
+				return nil
+			}, clock)
+			if fault != "" {
+				if err == nil {
+					t.Fatal("принят fault", fault)
+				}
+				for _, event := range f.events {
+					if event == "ACK" && (fault == "assets" || fault == "expired") {
+						t.Fatal("ACK до proofs")
+					}
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = profileBoot(r, raw, &a, func(*profileAdmission) error { f.events = append(f.events, "NEW", "START"); return nil }); err != nil {
+				t.Fatal(err)
+			}
+			if got := stringsJoin(f.events); got != "HELLO ADMIT ASSETS ACK NEW START" {
+				t.Fatal(got)
+			}
+			a.state = profileRevoked
+			if profileBoot(r, raw, &a, func(*profileAdmission) error { t.Fatal("factory после revoke"); return nil }) == nil {
+				t.Fatal("revoke")
+			}
+		})
+	}
+}
+func stringsJoin(v []string) string {
+	var b bytes.Buffer
+	for i, s := range v {
+		if i > 0 {
+			b.WriteByte(' ')
+		}
+		b.WriteString(s)
+	}
+	return b.String()
+}
