+func TestProfileDNSCodec4RefreshReplayAndUnknownStayPrivate(t *testing.T) {
+	f, ctx, s := dnsContext4Fixture(t, true)
+	x, op, err := f.c.dnsContext4Acquire(ctx, s, nil)
+	if err != nil || f.c.dispatch(op) != nil || f.c.accept(dnsBundleReply(op, 702, 1)) != nil {
+		t.Fatal("initial", err)
+	}
+	old := x.deadline
+	f.now = f.now.Add(time.Millisecond)
+	_, renew, err := f.c.dnsContext4Acquire(ctx, s, x)
+	if err != nil || f.c.dispatch(renew) != nil {
+		t.Fatal("renew", err)
+	}
+	if !x.deadline.Equal(old) || u64(renew.body, 32) != 702 || u64(renew.body, 64) != 1 {
+		t.Fatal("pending renewal changed authority")
+	}
+	if f.c.accept(dnsBundleReply(renew, 702, 2)) != nil || x.revision != 2 || x.deadline.After(s.deadline) {
+		t.Fatal("exact renewal")
+	}
+	if f.c.accept(dnsBundleReply(renew, 702, 2)) == nil || !x.unknown || !x.closed {
+		t.Fatal("replay revived context")
+	}
+	if _, _, err = f.c.dnsContext4Acquire(ctx, s, x); err == nil {
+		t.Fatal("Unknown renewed")
+	}
+	if f.c.dnsTick() != nil || x.released {
+		t.Fatal("Unknown lost custody")
+	}
+	neighbor := *s
+	neighbor.query++
+	y, pending, err := f.c.dnsContext4Acquire(ctx, &neighbor, nil)
+	if err != nil || f.c.dispatch(pending) != nil || f.c.accept(dnsBundleReply(pending, 703, 1)) != nil || !f.c.dnsContext4Live(y) {
+		t.Fatal("neighbor killed", err)
+	}
+	if f.p.ctx.Err() != nil {
+		t.Fatal("local lifecycle canceled session")
+	}
+	f.now = y.deadline
+	if _, _, err = f.c.dnsContext4Acquire(ctx, &neighbor, y); err == nil {
+		t.Fatal("expired context resurrected")
+	}
+}
