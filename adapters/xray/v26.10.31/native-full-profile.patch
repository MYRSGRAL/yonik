+func TestProfileDATStreamingGrammarAndCategory(t *testing.T) {
+	data := []byte{10, 14, 10, 2, 'Z', 'Z', 18, 8, 10, 4, 1, 2, 3, 0, 16, 24}
+	hash := sha256.Sum256(data)
+	row := []byte{1, 0, 0, 2, 'z', 'z'}
+	row = append(row, hash[:]...)
+	size := make([]byte, 8)
+	be.PutUint64(size, uint64(len(data)))
+	row = append(row, size...)
+	m := profileCapsule{}
+	m.rows[5] = [][]byte{row}
+	a := profileAsset{digest: hash, size: uint64(len(data))}
+	if e := verifyProfileDATReader(bytes.NewReader(data), a, &m); e != nil {
+		t.Fatal(e)
+	}
+	lower := append([]byte(nil), data...)
+	lower[4] = 'z'
+	lower[5] = 'z'
+	if verifyProfileDATReader(bytes.NewReader(lower), a, &m) == nil {
+		t.Fatal("native exact code mismatch")
+	}
+	for _, offset := range []int{0, 1, 2, 3, 6, 7, 8, 9, 15} {
+		bad := append([]byte(nil), data...)
+		bad[offset] ^= 255
+		if verifyProfileDATReader(bytes.NewReader(bad), a, &m) == nil {
+			t.Fatal("accepted DAT mutation", offset)
+		}
+	}
+	m.rows[5][0][4] = 'a'
+	if verifyProfileDATReader(bytes.NewReader(data), a, &m) == nil {
+		t.Fatal("missing category")
+	}
+}
