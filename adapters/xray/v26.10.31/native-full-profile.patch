+func TestYonikDNSActualTCPCallerChecksQuestionBeforeCache(t *testing.T) {
+	for _, mode := range []string{"exact-no-authority", "legacy", "wrong-question", "partial", "cancel-before-dial"} {
+		t.Run(mode, func(t *testing.T) {
+			name := dnsmessage.MustNewName("Original.INVALID.")
+			q := dnsmessage.Question{Name: name, Class: dnsmessage.ClassINET, Type: dnsmessage.TypeA}
+			req := &dnsRequest{owned: true, reqType: q.Type, domain: name.String(), msg: &dnsmessage.Message{Header: dnsmessage.Header{ID: 7}, Questions: []dnsmessage.Question{q}}}
+			if mode == "legacy" {
+				req.owned = false
+			}
+			m := dnsmessage.Message{Header: dnsmessage.Header{ID: 7, Response: true}, Questions: []dnsmessage.Question{q}, Answers: []dnsmessage.Resource{{Header: dnsmessage.ResourceHeader{Name: name, Class: dnsmessage.ClassINET, Type: dnsmessage.TypeA, TTL: 60}, Body: &dnsmessage.AResource{A: [4]byte{192, 0, 2, 1}}}}}
+			if mode == "wrong-question" {
+				m.Questions[0].Name = dnsmessage.MustNewName("foreign.invalid.")
+			}
+			raw, e := m.Pack()
+			if e != nil {
+				t.Fatal(e)
+			}
+			frame := make([]byte, 2, len(raw)+2)
+			binary.BigEndian.PutUint16(frame, uint16(len(raw)))
+			frame = append(frame, raw...)
+			if mode == "partial" {
+				frame = frame[:len(frame)-1]
+			}
+			conn := &ownedDNSFakeTCP{read: bytes.NewReader(frame)}
+			calls := 0
+			c := NewCacheController("fake", true, false, 0)
+			s := &TCPNameServer{cacheController: c, dial: func(context.Context) (stdnet.Conn, error) { calls++; return conn, nil }}
+			sub, _ := c.registerSubscribers(req.domain, fdns.IPOption{IPv4Enable: true})
+			defer sub.Close()
+			errCh := make(chan error, 1)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if mode == "cancel-before-dial" {
+				cancel()
+			}
+			s.exchangeQuery(ctx, req, time.Now().Add(time.Second), errCh)
+			select {
+			case <-sub.Wait():
+				if mode != "legacy" {
+					t.Fatal("непроверенный TCP ответ опубликован")
+				}
+			default:
+				if mode == "legacy" {
+					t.Fatal("legacy TCP response потерян")
+				}
+			}
+			if mode == "cancel-before-dial" {
+				if calls != 0 || conn.written.Len() != 0 {
+					t.Fatal("cancel запустил factory")
+				}
+			} else if calls != 1 || conn.closed != 1 {
+				t.Fatal("fake logical resource не завершён")
+			}
+		})
+	}
+}
