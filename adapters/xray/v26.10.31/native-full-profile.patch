+			uploadConn = h1UploadConn
+		} else {
+			h1UploadConn = uploadConn.(*H1Conn)
+
+			// TODO: Replace 0 here with a config value later
+			// Or add some other condition for optimization purposes
+			if h1UploadConn.UnreadedResponsesCount > 0 {
+				resp, err := http.ReadResponse(h1UploadConn.RespBufReader, req)
+				if err != nil {
+					c.closed.Store(true)
+					return fmt.Errorf("error while reading response: %s", err.Error())
+				}
+				io.Copy(io.Discard, resp.Body)
+				defer resp.Body.Close()
+				if resp.StatusCode != 200 {
+					return fmt.Errorf("got non-200 error response code: %d", resp.StatusCode)
+				}
+			}
+		}
+
+		_, err := h1UploadConn.Write(requestBuff.Bytes())
+		// if the write failed, we try another connection from
+		// the pool, until the write on a new connection fails.
+		// failed writes to a pooled connection are normal when
+		// the connection has been closed in the meantime.
+		if err == nil {
+			break
+		} else if newConnection {
+			return err
+		}
+	}
+
+	c.uploadRawPool.Put(uploadConn)
+
+	return nil
+}
+
+// H1 checkout эксклюзивен: отмена закрывает только этот socket, не client/pool.
+// Stop и join callback завершаются до возврата socket следующему consumer.
+func (c *DefaultDialerClient) postProfileH1Packet(ctx context.Context, req *http.Request, gate func(context.Context) error) (err error) {
+	if err = gate(ctx); err != nil {
+		return err
+	}
+	var request bytes.Buffer
+	if err = req.Write(&request); err != nil {
+		return err
+	}
+	value := c.uploadRawPool.Get()
+	var conn *H1Conn
+	if value == nil {
+		var raw net.Conn
+		raw, err = c.dialUploadConn(ctx)
+		if err != nil {
+			return err
+		}
+		conn = NewH1Conn(raw)
+	} else {
+		conn = value.(*H1Conn)
+	}
+	var closeOnce sync.Once
+	var closeError error
+	closeConn := func() { closeOnce.Do(func() { closeError = conn.Close() }) }
+	cancelled := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() { closeConn(); close(cancelled) })
+	reusable := false
+	defer func() {
+		stopped := stop()
+		if !stopped {
+			<-cancelled
+		}
+		if err == nil && (!stopped || ctx.Err() != nil) {
+			err = ctx.Err()
+			if err == nil {
+				err = errors.New("H1 logical operation cancelled")
+			}
+		}
+		if err == nil && reusable {
+			err = gate(ctx)
+		}
+		if err == nil && reusable {
+			err = conn.SetDeadline(time.Time{})
+		}
+		if err == nil && reusable && ctx.Err() == nil {
+			c.uploadRawPool.Put(conn)
+			return
+		}
+		closeConn()
+		if err == nil {
+			err = ctx.Err()
+			if err == nil {
+				err = errors.New("H1 operation unconfirmed")
+			}
+		}
+		if closeError != nil {
+			err = fmt.Errorf("%w; H1 cleanup: %v", err, closeError)
+		}
+	}()
+	deadline, _ := ctx.Deadline()
+	if err = conn.SetDeadline(deadline); err != nil {
+		return err
+	}
+	readResponse := func() error {
+		resp, e := http.ReadResponse(conn.RespBufReader, req)
+		if e != nil {
+			return e
+		}
+		if e = gate(ctx); e != nil {
+			closeConn()
+			resp.Body.Close()
+			return e
+		}
+		_, copyError := io.Copy(io.Discard, resp.Body)
+		closeBodyError := resp.Body.Close()
+		if copyError != nil {
+			return copyError
+		}
+		if closeBodyError != nil {
+			return closeBodyError
+		}
+		if resp.StatusCode != http.StatusOK {
+			return fmt.Errorf("H1 status %d", resp.StatusCode)
+		}
+		return gate(ctx)
+	}
+	if conn.UnreadedResponsesCount < 0 {
+		return errors.New("H1 response ledger invalid")
+	}
+	for conn.UnreadedResponsesCount > 0 {
+		if err = readResponse(); err != nil {
+			return err
+		}
+		conn.UnreadedResponsesCount--
+	}
+	// Повторный logical gate после любого blocked response и прямо перед payload.
+	if err = gate(ctx); err != nil {
+		return err
+	}
+	var written int
+	written, err = conn.Write(request.Bytes())
+	if err != nil {
+		return err
+	}
+	if written != request.Len() {
+		return io.ErrShortWrite
+	}
+	conn.UnreadedResponsesCount++
+	// Частичный/неподтверждённый request нельзя вернуть или повторить в другом H1.
+	if err = readResponse(); err != nil {
+		return err
+	}
+	conn.UnreadedResponsesCount--
+	reusable = true
+	return nil
+}
