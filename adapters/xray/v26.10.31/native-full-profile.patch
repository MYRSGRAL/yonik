+			switch field {
+			case "protocol":
+				settings.ProtocolName = "grpc"
+			case "security":
+				settings.SecurityType = "tls"
+			case "security-data":
+				settings.SecuritySettings = struct{}{}
+			case "mask":
+				settings.FinalMask = new(finalmask.FinalMask)
+			case "socket":
+				settings.SocketSettings = &SocketConfig{}
+			case "destination":
+				settings.Destination = &xnet.Destination{}
+			case "download":
+				settings.DownloadSettings = &MemoryStreamConfig{}
+			case "quic":
+				settings.QuicParams = &QuicParams{}
+			case "active-protocol":
+				active := dynamicpb.NewMessage(empty.Descriptor())
+				active.Set(active.Descriptor().Fields().Get(0), protoreflect.ValueOfBool(true))
+				settings.ProtocolSettings = active
+			case "unknown-protocol":
+				settings.ProtocolSettings = &SocketConfig{}
+			case "nil-protocol":
+				settings.ProtocolSettings = (*dynamicpb.Message)(nil)
+			}
+			if profileDNSRawSettings(&settings) {
+				t.Fatal("unproved transport wrapper accepted")
+			}
+		})
+	}
+}
