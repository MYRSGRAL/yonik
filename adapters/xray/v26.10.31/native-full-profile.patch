@@ -0,0 +1,20 @@
+package localdns
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/xtls/xray-core/features/dns"
+)
+
+func TestYonikCancelledQueryDoesNotResolve(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	// nil resolver выявляет любую попытку продолжить запрос после отмены.
+	c := &Client{}
+	ips, ttl, err := c.LookupIPWithContext(ctx, "synthetic.invalid", dns.IPOption{IPv4Enable: true})
+	if !errors.Is(err, context.Canceled) || len(ips) != 0 || ttl != 0 {
+		t.Fatalf("отменённый запрос: ips=%d ttl=%d err=%v", len(ips), ttl, err)
+	}
+}
