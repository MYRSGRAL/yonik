+	a, b := first.Value(profileGrantKey{}).(*profileGrant), second.Value(profileGrantKey{}).(*profileGrant)
+	if a.receipt == b.receipt || a.next == b.next || a.next.receipt != a.receipt || a.next.scope != 2 {
+		t.Fatal("hop grant shared across source flows")
+	}
+	counts := map[uint64]int{}
+	for _, frame := range f.writes {
+		if frame.kind == 18 {
+			counts[u64(frame.body, 0)]++
+			if frame.body[8] != 1 || u16(frame.body, 10) != u16(f.c.manifest.rows[8][u16(frame.body, 16)], 0) {
+				t.Fatal("AUTHORIZE selectors")
+			}
+		}
+	}
