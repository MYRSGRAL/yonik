+++ b/common/yonikbroker/profile_dns_frontier_linux.go
@@ -0,0 +1,838 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	xnet "github.com/xtls/xray-core/common/net"
+	"strings"
+	"time"
+)
+
+const profileHostsObservationCredit = 32 * 1024
+const profileHostsObservationPending = 6
+
+// ProducerRRset DATA не является WaiterReceipt, grant или transport permission.
+type profileHostsProducerData struct {
+	owner     *profileHostsObservation
+	id, epoch uint64
+	expires   time.Time
+	count     int
+}
+
+type profileHostsSelection struct {
+	row     uint16
+	count   int
+	members [16]uint16
+	key     string
+}
+type profileHostsObservation struct {
+	data                                                    *profileHostsProducerData
+	publish                                                 *profileOperation
+	publishHash                                             [32]byte
+	publishReceived, publishCancelAck, producerCloseAck     bool
+	publishCancelSequence, producerCloseSequence            uint64
+	runtime                                                 *ProfileRuntime
+	ctx                                                     context.Context
+	cancel                                                  context.CancelFunc
+	root                                                    *profileGrant
+	frontier                                                profileDNSFrontier
+	snapshot                                                *profileSnapshot
+	selection                                               profileHostsSelection
+	context                                                 *profileDNSContext4
+	pending                                                 *profileOperation
+	deadline, cleanupDeadline                               time.Time
+	reservation, observation                                uint64
+	bodyHash                                                [32]byte
+	cancelSequence, closeSequence                           uint64
+	replied, cancelAck, closeAck, closed, unknown, released bool
+}
+
+func profileHostsSelect(s *profileSnapshot, name string) (profileHostsSelection, error) {
+	var selected profileHostsSelection
+	if s == nil || len(s.encoded) < 170 || s.order != 1 && s.order != 3 {
+		return selected, ErrProfileUnsupported
+	}
+	key := strings.ToLower(name)
+	if strings.Contains(key, ".") && !strings.HasSuffix(key, ".") {
+		key += "."
+	}
+	c := profileCursor{b: s.encoded[152:]}
+	c.take(10)
+	c.str(253)
+	search := int(c.n16())
+	if search > 6 {
+		return selected, errProfile
+	}
+	for i := 0; i < search; i++ {
+		c.str(253)
+	}
+	peers := int(c.n16())
+	if peers < 1 || peers > 3 {
+		return selected, errProfile
+	}
+	for i := 0; i < peers; i++ {
+		h := c.take(4)
+		if h == nil {
+			return selected, errProfile
+		}
+		n := 4
+		if h[0] == 6 {
+			n = 16
+		} else if h[0] != 4 {
+			return selected, errProfile
+		}
+		c.take(n)
+	}
+	rows := int(c.n16())
+	if rows > 4096 {
+		return selected, errProfile
+	}
+	for row := 0; row < rows; row++ {
+		alias := c.str(253)
+		n := int(c.n16())
+		if n < 1 || n > 16 {
+			return selected, errProfile
+		}
+		for i := 0; i < n; i++ {
+			family := c.take(1)
+			if family == nil {
+				return selected, errProfile
+			}
+			size := 4
+			if family[0] == 6 {
+				size = 16
+			} else if family[0] != 4 {
+				return selected, errProfile
+			}
+			c.take(size)
+		}
+		if c.bad {
+			return selected, errProfile
+		}
+		if string(alias) == key {
+			selected.row = uint16(row)
+			selected.count = n
+			selected.key = key
+			for i := 0; i < n; i++ {
+				selected.members[i] = uint16(i)
+			}
+			return selected, nil
+		}
+	}
+	return selected, ErrProfileUnsupported
+}
+func (c *profileFlowControl) hostsSnapshotLive(p *ProfileRuntime, s *profileSnapshot) bool {
+	if p == nil || !p.dns4CaptureReviewed || !p.dnsV2 || c.manifest.mapping != 4 || s == nil || s != p.snapshot || len(c.manifest.rows[10]) != 1 || len(s.encoded) < 170 {
+		return false
+	}
+	r := c.manifest.rows[10][0]
+	if len(r) != 76 || u32(r, 72)&4 == 0 || int(u32(r, 64)) != len(s.encoded) || !bytes.Equal(r[:32], s.encoded[16:48]) {
+		return false
+	}
+	hash := sha256.Sum256(s.encoded)
+	return bytes.Equal(hash[:], r[32:64])
+}
+func (c *profileFlowControl) hostsParentFrontier(root *profileGrant) (profileDNSFrontier, time.Time, error) {
+	var empty profileDNSFrontier
+	deadline := c.sessionDeadline
+	if root == nil || root.parent != nil {
+		return empty, deadline, errProfile
+	}
+	for g, n := root, 0; g != nil; g, n = g.next, n+1 {
+		if n >= 256 || g.class != 0 && g.class != 1 || g.receipt == nil || !c.grantLive(g) || g.receipt != root.receipt || g.revision != c.manifest.policy || g.receipt.revision != c.manifest.policy || g != root && (g.parent == nil || g.parent.next != g) {
+			return empty, deadline, errProfile
+		}
+		if g.deadline.Before(deadline) {
+			deadline = g.deadline
+		}
+		if c.mode == 2 {
+			if g.ownerKind < 1 || g.ownerKind > 2 || !profileDNSV2ID(g.ownerID) || !c.clock().Before(g.ownerDeadline) {
+				return empty, deadline, errProfile
+			}
+			if g.ownerDeadline.Before(deadline) {
+				deadline = g.ownerDeadline
+			}
+		}
+	}
+	g := root
+	frontier, err := profileDNSFirstHop(&c.manifest, root.scope, root.branch, func(_ string, dst xnet.Destination) (bool, error) {
+		g = g.next
+		if g == nil {
+			return false, errProfile
+		}
+		value, e := profileValue(dst)
+		if e != nil || value != g.effective {
+			return false, errProfile
+		}
+		return g.branch == 1, nil
+	})
+	if err != nil {
+		return empty, deadline, err
+	}
+	g = root
+	for _, hop := range frontier.path[:frontier.count] {
+		if g == nil || g.scope != hop.scope || g.branch != hop.branch {
+			return empty, deadline, errProfile
+		}
+		g = g.next
+	}
+	if g != nil {
+		return empty, deadline, errProfile
+	}
+	if frontier.target.family != 3 {
+		return empty, deadline, ErrProfileUnsupported
+	}
+	return frontier, deadline, nil
+}
+
+// Actual chain caller не получает IP или permission: этот cut заканчивается
+// Hosts Producer DATA. Waiter/Numeric/physical conjunction пока закрыты.
+func profilePrepareHostsObservation(ctx context.Context, root *profileGrant) error {
+	p := profileRuntime(ctx)
+	if p == nil || !p.dns4CaptureReviewed {
+		return ErrProfileUnsupported
+	}
+	c := p.flow
+	c.mu.Lock()
+	for n := 0; root != nil && root.parent != nil; n++ {
+		if n >= 255 || root.parent.next != root {
+			c.mu.Unlock()
+			return errProfile
+		}
+		root = root.parent
+	}
+	frontier, deadline, err := c.hostsParentFrontier(root)
+	if err != nil || !c.hostsSnapshotLive(p, p.snapshot) || ctx.Err() != nil || profileReceiptFrom(ctx) != root.receipt || c.nextDNSQuery >= ^uint64(0)-1 {
+		c.mu.Unlock()
+		return ErrProfileUnsupported
+	}
+	if c.hostsObservationUsed >= len(c.hostsObservations) || c.profilePendingUsed()+profileHostsObservationPending > min(64, int(c.manifest.caps[3])) || c.buffered+c.manifest.memoryCredit+profileHostsObservationCredit > uint64(c.manifest.caps[4]) || !c.dnsReserveHistory(profileHostsObservationPending) {
+		c.mu.Unlock()
+		return errProfileFlowBusy
+	}
+	c.operations += profileHostsObservationPending
+	c.buffered += profileHostsObservationCredit
+	base := context.WithValue(ctx, profileGrantKey{}, root)
+	child, cancel := context.WithCancel(base)
+	h := &profileHostsObservation{runtime: p, ctx: child, cancel: cancel, root: root, frontier: frontier, snapshot: p.snapshot, deadline: deadline, cleanupDeadline: deadline.Add(time.Second)}
+	if c.sessionDeadline.Before(h.cleanupDeadline) {
+		h.cleanupDeadline = c.sessionDeadline
+	}
+	c.hostsObservations[c.hostsObservationUsed] = h
+	c.hostsObservationUsed++
+	h.selection, err = profileHostsSelect(p.snapshot, frontier.target.address)
+	query := c.nextDNSQuery + 1
+	c.mu.Unlock()
+	defer func() { c.mu.Lock(); c.hostsObservationClose(h); c.mu.Unlock() }()
+	if err != nil {
+		return err
+	}
+	source := &profileDNSCapture4{runtime: p, parent: root, frontier: frontier, snapshot: h.snapshot, query: query, epoch: p.admission.launch.epoch, resolver: 65535, hosts: true, deadline: deadline}
+	captured := context.WithValue(child, profileDNSCapture4Key{}, source)
+	metadata, release, err := ProfileDNSAcquirePhysicalContext(captured)
+	if err != nil {
+		return err
+	}
+	defer release()
+	x, _ := metadata.Value(profileDNSContext4Key{}).(*profileDNSContext4)
+	c.mu.Lock()
+	if !c.dnsContext4Live(x) || x.identity.kind != profileDNSHostsRoot || !c.hostsObservationSourceLive(h) {
+		c.mu.Unlock()
+		return errProfile
+	}
+	h.context = x
+	x.hostReferences++
+	if until := x.deadline.Add(time.Second); until.Before(h.cleanupDeadline) {
+		h.cleanupDeadline = until
+	}
+	body := make([]byte, 96+len(frontier.target.address)+8)
+	be.PutUint16(body, 2)
+	body[2] = 3
+	be.PutUint64(body[8:], query)
+	be.PutUint64(body[48:], source.epoch)
+	be.PutUint64(body[56:], uint64(time.Second))
+	for _, field := range [][2]uint16{{64, 65535}, {66, frontier.subject}, {68, frontier.endpoint}, {70, frontier.scope}, {80, uint16(len(frontier.target.address))}, {84, 8}} {
+		be.PutUint16(body[field[0]:], field[1])
+	}
+	body[74], body[75], body[76], body[77], body[78], body[79] = 3, 2, frontier.carrier, 3, 2, frontier.branch
+	copy(body[96:], frontier.target.address)
+	at := 96 + len(frontier.target.address)
+	be.PutUint16(body[at:], 2)
+	be.PutUint16(body[at+2:], frontier.endpoint)
+	be.PutUint16(body[at+4:], frontier.subject)
+	be.PutUint16(body[at+6:], 65535)
+	op := &profileOperation{hostsObservation: h, ctx: child, kind: 35, body: body, done: make(chan struct{})}
+	h.pending = op
+	h.bodyHash = sha256.Sum256(body)
+	c.mu.Unlock()
+	if err = p.flowRPC(op); err != nil {
+		return err
+	}
+	if err = profilePublishHostsObservation(h); err != nil {
+		return err
+	}
+	// DATA ID не WaiterReceipt/BootstrapPhysicalPermission. Numeric/use2 и
+	// conjunction отсутствуют в current physical seam; raw open остаётся закрыт.
+	return ErrProfileUnsupported
+}
+
+func profilePublishHostsObservation(h *profileHostsObservation) error {
+	c := h.runtime.flow
+	c.mu.Lock()
+	if h.publish != nil || !h.replied || h.observation == 0 || h.reservation == 0 || !c.hostsObservationSourceLive(h) || !c.dnsContext4Live(h.context) || h.context.identity.kind != profileDNSHostsRoot {
+		c.mu.Unlock()
+		return errProfile
+	}
+	s := h.selection
+	f := h.frontier
+	if len(s.key) < 1 || len(s.key) > 253 || len(f.target.address) < 1 || len(f.target.address) > 253 || s.count < 1 || s.count > 16 {
+		c.mu.Unlock()
+		return errProfile
+	}
+	tailSize := 128 + len(s.key) + len(f.target.address) + 2*s.count
+	body := make([]byte, 144+tailSize)
+	be.PutUint16(body, 2)
+	be.PutUint16(body[4:], 65535)
+	be.PutUint16(body[6:], f.subject)
+	be.PutUint16(body[8:], f.endpoint)
+	be.PutUint64(body[12:], h.context.source.query)
+	be.PutUint64(body[36:], h.context.source.epoch)
+	row := c.manifest.rows[10][0]
+	copy(body[44:], row[:32])
+	copy(body[76:], row[32:64])
+	body[136], body[137] = 3, 2
+	be.PutUint16(body[140:], f.scope)
+	body[142] = f.carrier
+	tail := body[144:]
+	copy(tail, "DNHOST02")
+	be.PutUint16(tail[8:], 2)
+	be.PutUint16(tail[10:], uint16(tailSize))
+	copy(tail[16:], row[:32])
+	copy(tail[48:], row[32:64])
+	be.PutUint64(tail[80:], h.context.source.epoch)
+	be.PutUint64(tail[88:], h.observation)
+	be.PutUint64(tail[96:], uint64(time.Second))
+	for _, field := range [][2]uint16{{106, s.row}, {108, uint16(s.count)}, {110, uint16(len(s.key))}, {112, uint16(len(f.target.address))}, {114, f.subject}, {116, f.endpoint}, {118, f.scope}, {122, f.target.port}} {
+		be.PutUint16(tail[field[0]:], field[1])
+	}
+	tail[120], tail[121] = f.branch, f.carrier
+	at := 128
+	copy(tail[at:], s.key)
+	at += len(s.key)
+	copy(tail[at:], f.target.address)
+	at += len(f.target.address)
+	for _, member := range s.members[:s.count] {
+		be.PutUint16(tail[at:], member)
+		at += 2
+	}
+	h.data = &profileHostsProducerData{owner: h, epoch: h.context.source.epoch, count: s.count}
+	op := &profileOperation{hostsObservation: h, ctx: h.ctx, kind: 40, body: body, done: make(chan struct{})}
+	h.publish = op
+	h.publishHash = sha256.Sum256(body)
+	c.mu.Unlock()
+	return h.runtime.flowRPC(op)
+}
+func (c *profileFlowControl) hostsPublishDispatch(op *profileOperation) error {
+	h := op.hostsObservation
+	if op.submitted || op.completed {
+		return nil
+	}
+	if op != h.publish || !c.hostsObservationSourceLive(h) || !c.dnsContext4Live(h.context) || h.observation == 0 || h.reservation == 0 || h.publishHash != sha256.Sum256(op.body) || !profileDNSV2Body(40, op.body) {
+		c.hostsObservationClose(h)
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	op.sent = c.clock()
+	op.deadline = h.deadline
+	if h.context.deadline.Before(op.deadline) {
+		op.deadline = h.context.deadline
+	}
+	if d, ok := op.ctx.Deadline(); ok && d.Before(op.deadline) {
+		op.deadline = d
+	}
+	if !op.sent.Before(op.deadline) {
+		c.hostsObservationClose(h)
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	be.PutUint64(op.body[144+96:], uint64(op.deadline.Sub(op.sent)))
+	op.submitted = true
+	seq, err := c.write(40, 0, op.body)
+	op.sequence = seq
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	if err != nil || !profileDNSV2ID(seq) {
+		h.unknown = true
+		c.hostsObservationClose(h)
+		c.dnsNotify(op, errProfile)
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) hostsPublishAccept(f profilePacket) (bool, error) {
+	for _, h := range c.hostsObservations[:c.hostsObservationUsed] {
+		op := h.publish
+		if op != nil && op.submitted && f.kind == 41 && f.reply == op.sequence {
+			if h.publishReceived || h.publishCancelAck || f.object != 0 || !profileDNSV2Body(41, f.body) {
+				h.unknown = true
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, errProfile
+			}
+			h.publishReceived = true
+			b := f.body
+			if b[2] != 1 {
+				if b[2] == 3 {
+					h.unknown = true
+				}
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, nil
+			}
+			d := h.data
+			d.id = u64(b, 8)
+			remaining := u64(b, 32)
+			until := op.sent.Add(time.Duration(remaining))
+			valid := u64(b, 16) == 0 && u64(b, 24) == d.epoch && int(u16(b, 40)) == d.count && remaining <= u64(op.body[144:], 96) && !until.After(h.deadline)
+			for _, other := range c.hostsObservations[:c.hostsObservationUsed] {
+				if other != h && other.data != nil && other.data.id == d.id {
+					valid = false
+				}
+			}
+			for _, other := range c.dnsResults[:c.dnsResultUsed] {
+				if other.data != nil && other.data.id == d.id {
+					valid = false
+				}
+			}
+			if !valid {
+				h.unknown = true
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, errProfile
+			}
+			d.expires = until
+			if !c.hostsProducerDataLive(d) || !c.clock().Before(op.deadline) {
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, nil
+			}
+			c.dnsNotify(op, nil)
+			return true, nil
+		}
+		if f.kind == 48 && f.reply != 0 && (f.reply == h.publishCancelSequence || f.reply == h.producerCloseSequence) {
+			if f.object != 0 || !profileDNSV2Body(48, f.body) || !c.clock().Before(h.cleanupDeadline) {
+				h.unknown = true
+				return true, errProfile
+			}
+			if f.body[2] != 1 {
+				h.unknown = true
+				return true, nil
+			}
+			expected := uint64(0)
+			duplicate := false
+			if f.reply == h.publishCancelSequence {
+				expected = op.sequence
+				duplicate = h.publishCancelAck
+			} else {
+				expected = h.data.id
+				duplicate = h.producerCloseAck
+			}
+			if duplicate || u64(f.body, 8) != expected {
+				h.unknown = true
+				return true, errProfile
+			}
+			if f.reply == h.publishCancelSequence {
+				h.publishCancelAck = true
+			} else {
+				h.producerCloseAck = true
+			}
+			return true, nil
+		}
+	}
+	return false, nil
+}
+func (c *profileFlowControl) hostsObservationSourceLive(h *profileHostsObservation) bool {
+	if h == nil || h.closed || h.unknown || h.ctx.Err() != nil || !c.clock().Before(h.deadline) || !c.hostsSnapshotLive(h.runtime, h.snapshot) {
+		return false
+	}
+	f, _, err := c.hostsParentFrontier(h.root)
+	if err != nil || f != h.frontier {
+		return false
+	}
+	s, err := profileHostsSelect(h.snapshot, f.target.address)
+	return err == nil && s == h.selection
+}
+func (c *profileFlowControl) hostsObservationClose(h *profileHostsObservation) {
+	if !h.closed {
+		h.closed = true
+		h.cancel()
+	}
+}
+func (c *profileFlowControl) hostsObservationDispatch(op *profileOperation) error {
+	if op.kind == 40 {
+		return c.hostsPublishDispatch(op)
+	}
+	h := op.hostsObservation
+	if op.submitted || op.completed {
+		return nil
+	}
+	if !c.hostsObservationSourceLive(h) || !c.dnsContext4Live(h.context) || h.context.identity.kind != profileDNSHostsRoot || sha256.Sum256(op.body) != h.bodyHash || !profileDNSV2Body(35, op.body) {
+		c.hostsObservationClose(h)
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	op.sent = c.clock()
+	op.deadline = h.deadline
+	if h.context.deadline.Before(op.deadline) {
+		op.deadline = h.context.deadline
+	}
+	if d, ok := op.ctx.Deadline(); ok && d.Before(op.deadline) {
+		op.deadline = d
+	}
+	if !op.sent.Before(op.deadline) {
+		c.hostsObservationClose(h)
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	be.PutUint64(op.body[56:], uint64(op.deadline.Sub(op.sent)))
+	op.submitted = true
+	seq, err := c.write(35, 0, op.body)
+	op.sequence = seq
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	if err != nil || !profileDNSV2ID(seq) {
+		h.unknown = true
+		c.hostsObservationClose(h)
+		c.dnsNotify(op, errProfile)
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) hostsObservationAccept(f profilePacket) (bool, error) {
+	if handled, err := c.hostsPublishAccept(f); handled {
+		return true, err
+	}
+	for _, h := range c.hostsObservations[:c.hostsObservationUsed] {
+		op := h.pending
+		if op != nil && op.submitted && f.kind == 36 && f.reply == op.sequence {
+			if h.replied || h.cancelAck || f.object != 0 || !profileDNSV2Body(36, f.body) {
+				h.unknown = true
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, errProfile
+			}
+			h.replied = true
+			b := f.body
+			if b[2] != 1 {
+				if b[2] == 3 {
+					h.unknown = true
+				}
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, nil
+			}
+			h.reservation, h.observation = u64(b, 8), u64(b, 32)
+			valid := u64(b, 16) == h.context.source.query && u64(b, 24) == 0 && u64(b, 40) == h.context.source.epoch && u64(b, 48) <= u64(op.body, 56) && u16(b, 56) == 0 && u16(b, 58) == 1 && b[60] == 3
+			for _, other := range c.hostsObservations[:c.hostsObservationUsed] {
+				if other != h && (other.reservation == h.reservation || other.observation == h.observation) {
+					valid = false
+				}
+			}
+			for _, other := range c.dnsResults[:c.dnsResultUsed] {
+				if other.waiter != nil && other.waiter.reservation == h.reservation {
+					valid = false
+				}
+			}
+			for _, other := range c.dnsDirect[:c.dnsDirectUsed] {
+				if other.exchangeReservation == h.reservation || other.physicalReservation == h.reservation {
+					valid = false
+				}
+			}
+			if !valid {
+				h.unknown = true
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, errProfile
+			}
+			until := op.sent.Add(time.Duration(u64(b, 48)))
+			if !c.hostsObservationSourceLive(h) || !c.dnsContext4Live(h.context) || !c.clock().Before(until) || !c.clock().Before(op.deadline) {
+				c.hostsObservationClose(h)
+				c.dnsNotify(op, errProfile)
+				return true, nil
+			}
+			h.deadline = until
+			if cleanup := until.Add(time.Second); cleanup.Before(h.cleanupDeadline) {
+				h.cleanupDeadline = cleanup
+			}
+			c.dnsNotify(op, nil)
+			return true, nil
+		}
+		if f.kind == 48 && f.reply != 0 && (f.reply == h.cancelSequence || f.reply == h.closeSequence) {
+			if f.object != 0 || !profileDNSV2Body(48, f.body) || !c.clock().Before(h.cleanupDeadline) {
+				h.unknown = true
+				return true, errProfile
+			}
+			if f.body[2] != 1 {
+				h.unknown = true
+				return true, nil
+			}
+			expected := h.reservation
+			if f.reply == h.cancelSequence {
+				expected = op.sequence
+			}
+			if u64(f.body, 8) != expected || f.reply == h.cancelSequence && h.cancelAck || f.reply == h.closeSequence && h.closeAck {
+				h.unknown = true
+				return true, errProfile
+			}
+			if f.reply == h.cancelSequence {
+				h.cancelAck = true
+			} else {
+				h.closeAck = true
+			}
+			return true, nil
+		}
+	}
+	return false, nil
+}
+func (c *profileFlowControl) hostsObservationTick() error {
+	for _, h := range c.hostsObservations[:c.hostsObservationUsed] {
+		if h.released || h.unknown {
+			continue
+		}
+		if !c.hostsObservationSourceLive(h) || h.context != nil && !c.dnsContext4Live(h.context) || h.pending != nil && h.pending.submitted && !h.replied && !c.clock().Before(h.pending.deadline) {
+			c.hostsObservationClose(h)
+		}
+		if op := h.publish; op != nil && op.submitted && !h.publishReceived && !c.clock().Before(op.deadline) {
+			c.hostsObservationClose(h)
+		}
+		if !h.closed {
+			continue
+		}
+		if !c.clock().Before(h.cleanupDeadline) {
+			h.unknown = true
+			continue
+		}
+		if op := h.publish; op != nil && op.submitted && !h.publishReceived {
+			c.dnsNotify(op, errProfile)
+			if h.publishCancelSequence == 0 {
+				seq, err := c.dnsCancel(1, op.sequence)
+				h.publishCancelSequence = seq
+				if err != nil {
+					h.unknown = true
+					return err
+				}
+			}
+			if !h.publishCancelAck || c.clock().Before(op.deadline) {
+				continue
+			}
+			h.publishReceived = true
+		}
+		if h.publishCancelSequence != 0 && !h.publishCancelAck {
+			continue
+		}
+		if h.data != nil && h.data.id != 0 && !h.producerCloseAck {
+			if h.producerCloseSequence == 0 {
+				seq, err := c.dnsCancel(5, h.data.id)
+				h.producerCloseSequence = seq
+				if err != nil {
+					h.unknown = true
+					return err
+				}
+			}
+			continue
+		}
+		op := h.pending
+		if op != nil && op.submitted && !h.replied {
+			c.dnsNotify(op, errProfile)
+			if h.cancelSequence == 0 {
+				seq, err := c.dnsCancel(1, op.sequence)
+				h.cancelSequence = seq
+				if err != nil {
+					h.unknown = true
+					return err
+				}
+			}
+			if !h.cancelAck || c.clock().Before(op.deadline) {
+				continue
+			}
+			h.replied = true
+		}
+		if h.cancelSequence != 0 && !h.cancelAck {
+			continue
+		}
+		if h.reservation != 0 && !h.closeAck {
+			if h.closeSequence == 0 {
+				seq, err := c.dnsCancel(7, h.reservation)
+				h.closeSequence = seq
+				if err != nil {
+					h.unknown = true
+					return err
+				}
+			}
+			continue
+		}
+		h.released = true
+		c.operations -= profileHostsObservationPending
+		// Retained selection/IDs оплачены до effects, eviction/compaction нет.
+		if h.context != nil {
+			h.context.hostReferences--
+			c.dnsContext4Close(h.context)
+		}
+	}
+	return nil
+}
+func (c *profileFlowControl) hostsObservationFloor(floor uint64) uint64 {
+	for _, h := range c.hostsObservations[:c.hostsObservationUsed] {
+		if h.released {
+			continue
+		}
+		if op := h.publish; op != nil && op.submitted && !h.publishReceived && op.sequence < floor {
+			floor = op.sequence
+		}
+		if h.publishCancelSequence != 0 && !h.publishCancelAck && h.publishCancelSequence < floor {
+			floor = h.publishCancelSequence
+		}
+		if h.producerCloseSequence != 0 && !h.producerCloseAck && h.producerCloseSequence < floor {
+			floor = h.producerCloseSequence
+		}
+		if op := h.pending; op != nil && op.submitted && !h.replied && op.sequence < floor {
+			floor = op.sequence
+		}
+		if h.cancelSequence != 0 && !h.cancelAck && h.cancelSequence < floor {
+			floor = h.cancelSequence
+		}
+		if h.closeSequence != 0 && !h.closeAck && h.closeSequence < floor {
+			floor = h.closeSequence
+		}
+	}
+	return floor
+}
