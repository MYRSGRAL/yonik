+type dnsDirectFakeConn struct {
+	flowFakeConn
+	mu                          sync.Mutex
+	writes, closes              int
+	closeError                  error
+	closeEntered                chan struct{}
+	closeRelease                chan struct{}
+	readEntered                 chan struct{}
+	readRelease                 chan struct{}
+	writeEntered                chan struct{}
+	writeRelease                chan struct{}
+	readDeadline, writeDeadline time.Time
+}
+
+func (c *dnsDirectFakeConn) SetDeadline(d time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readDeadline, c.writeDeadline = d, d
+	return nil
+}
+func (c *dnsDirectFakeConn) SetReadDeadline(d time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readDeadline = d
+	return nil
+}
+func (c *dnsDirectFakeConn) SetWriteDeadline(d time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.writeDeadline = d
+	return nil
+}
+
+func (c *dnsDirectFakeConn) Read(b []byte) (int, error) {
+	if c.readEntered != nil {
+		close(c.readEntered)
+		<-c.readRelease
+		copy(b, "answer")
+		return 6, nil
+	}
+	return 0, nil
+}
+
+func (c *dnsDirectFakeConn) Write(b []byte) (int, error) {
+	c.mu.Lock()
+	c.writes++
+	c.mu.Unlock()
+	if c.writeEntered != nil {
+		close(c.writeEntered)
+		<-c.writeRelease
+	}
+	return len(b), nil
+}
+func (c *dnsDirectFakeConn) Close() error {
+	c.mu.Lock()
+	c.closes++
+	c.mu.Unlock()
+	if c.closeEntered != nil {
+		close(c.closeEntered)
+		<-c.closeRelease
+	}
+	return c.closeError
+}
