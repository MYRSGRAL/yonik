+				reply.body[1] = 1
+			case "owner":
+				reply.body[40] = 0
+			case "required":
+				reply.body[2] = 0
+			case "flow":
+				be.PutUint64(reply.body[12:], r.id+1)
+			case "revision":
+				be.PutUint64(reply.body[24:], 7)
+			case "late":
+				f.c.abort(op)
+				if e = f.c.tick(); e != nil {
+					t.Fatal(e)
+				}
+			}
+			if e = f.c.accept(reply); e != nil && mutation == "late" {
+				t.Fatal(e)
+			}
+			if f.c.grantLive(g) || g.id != 0 {
+				t.Fatal("wrong/late service grant published")
+			}
+			if !f.c.receiptLive(r) {
+				t.Fatal("service denial отменил original flow")
+			}
+			if e = f.c.accept(reply); e == nil {
+				t.Fatal("conflicting reply accepted")
+			}
+		})
+	}
+}
