+func TestYonikR9MuxGroupShutdownReleasesPickerLockAndRetainsError(t *testing.T) {
+	reader, writer := &r9MuxEndpoint{}, &r9MuxEndpoint{err: r9MuxCleanupError}
+	w, tasks := r9MuxConstruct(t, transport.Link{Reader: reader, Writer: writer}, func(error) {})
+	factory := &r9MuxNeverFactory{}
+	picker := &IncrementalWorkerPicker{Factory: factory, workers: []*ClientWorker{w}}
+	group := &profileWorkers{picker: picker}
+	writer.beforeClose = func() { picker.access.Lock(); picker.access.Unlock() }
+	result := make(chan error, 1)
