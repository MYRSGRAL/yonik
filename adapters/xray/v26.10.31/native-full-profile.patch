@@ -0,0 +1,35 @@
+package outbound
+
+import (
+	"github.com/xtls/xray-core/common/mux"
+	"github.com/xtls/xray-core/common/net"
+	"testing"
+)
+
+func TestYonikProfileActualNativeMuxDecision(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		network    net.Network
+		port       net.Port
+		main, xudp *mux.ClientManager
+		policy     string
+		want       profileMuxChoice
+	}{
+		{"no manager", net.Network_UDP, 53, nil, nil, "", profileMuxNormal},
+		{"disabled", net.Network_TCP, 443, &mux.ClientManager{}, nil, "", profileMuxNormal},
+		{"tcp mux", net.Network_TCP, 443, &mux.ClientManager{Enabled: true}, nil, "", profileMuxTCP},
+		{"udp xudp", net.Network_UDP, 53, &mux.ClientManager{Enabled: true}, &mux.ClientManager{Enabled: true}, "", profileMuxUDP},
+		{"udp disabled xudp", net.Network_UDP, 53, &mux.ClientManager{Enabled: true}, &mux.ClientManager{}, "", profileMuxNormal},
+		{"udp main mux", net.Network_UDP, 53, &mux.ClientManager{Enabled: true}, nil, "", profileMuxTCP},
+		{"udp443 reject", net.Network_UDP, 443, &mux.ClientManager{Enabled: true}, &mux.ClientManager{Enabled: true}, "reject", profileMuxReject},
+		{"udp443 skip", net.Network_UDP, 443, &mux.ClientManager{Enabled: true}, &mux.ClientManager{Enabled: true}, "skip", profileMuxNormal},
+		{"udp443 allow", net.Network_UDP, 443, &mux.ClientManager{Enabled: true}, &mux.ClientManager{Enabled: true}, "allow", profileMuxUDP},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h := &Handler{mux: tc.main, xudp: tc.xudp, udp443: tc.policy}
+			if got := h.profileMuxDecision(net.Destination{Network: tc.network, Port: tc.port}); got != tc.want {
+				t.Fatal(got, tc.want)
+			}
+		})
+	}
+}
