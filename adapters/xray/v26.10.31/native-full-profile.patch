+	}
+	physical, e := pool.SessionContext()
+	if e != nil {
+		t.Fatal(e)
+	}
+	target := xnet.TCPDestination(xnet.ParseAddress("198.51.100.1"), 443)
+	chained, e := ProfileChain(physical, target, "b")
+	if e != nil {
+		t.Fatal(e)
+	}
+	child, release, e := ProfileAuthorizeHandler(chained, "b", target, false)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer release()
+	f.c.mu.Lock()
+	f.c.closeGrant(a.next)
+	f.c.mu.Unlock()
