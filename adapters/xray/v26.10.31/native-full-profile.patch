+func (x *udpProducerFixture) finishFlow(t *testing.T) {
+	t.Helper()
+	u := x.producer.flows[0]
+	u.cancel()
+	close(x.releaseFlow)
+	<-x.flowDone
+	// runFlow завершает owned dispatch task после actual callback return.
+	<-u.done
+	if e := x.f.c.tick(); e != nil {
+		t.Fatal(e)
+	}
+	x.ackCancels(t)
+}
+func (x *udpProducerFixture) ackCancels(t *testing.T) {
+	t.Helper()
+	for _, frame := range x.f.writes {
+		if frame.kind != 32 || x.acked[frame.sequence] {
+			continue
+		}
+		body := make([]byte, 12)
+		body[0] = frame.body[0]
+		body[1] = 1
+		copy(body[4:], frame.body[4:])
+		if e := x.f.c.accept(profilePacket{kind: 34, reply: frame.sequence, body: body}); e != nil {
+			t.Fatal(e)
+		}
+		x.acked[frame.sequence] = true
+	}
+}
