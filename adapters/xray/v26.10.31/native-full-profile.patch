+	r := f.admittedReceipt(t, "connect.invalid")
+	g := f.granted(t, r)
+	id := g.id
+	start := f.now
+	for i := 0; i < 4; i++ {
+		f.now = f.now.Add(800 * time.Millisecond)
+		old := g.deadline
+		if e := f.c.tick(); e != nil {
+			t.Fatal(e)
+		}
+		op := g.refresh
+		if op == nil || op.object != id || !op.submitted || g.deadline != old {
+			t.Fatal("idle CONNECT missing/eager refresh")
+		}
+		if e := f.c.accept(f.grantReply(op, 0)); e != nil || op.err != nil {
+			t.Fatal(e, op.err)
+		}
+	}
+	if !f.c.grantLive(g) || g.receipt.id != r.id || f.now.Sub(start) <= time.Second {
+		t.Fatal("CONNECT did not survive >1s")
+	}
+	f.now = f.now.Add(800 * time.Millisecond)
+	if e := f.c.tick(); e != nil {
+		t.Fatal(e)
+	}
+	op := g.refresh
+	reply := f.grantReply(op, 0)
+	f.c.mu.Lock()
+	f.c.closeReceipt(r)
+	f.c.mu.Unlock()
+	if e := f.c.accept(reply); e != nil {
+		t.Fatal(e)
+	}
+	if op.err == nil || !g.closed || f.c.grantLive(g) {
+		t.Fatal("refresh resurrected closed CONNECT")
+	}
+}
