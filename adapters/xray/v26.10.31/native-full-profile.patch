+	xnet "github.com/xtls/xray-core/common/net"
+	"golang.org/x/sys/unix"
+)
+
+// Transcript + Publish body одновременно retained; credits до factory.
+const profileDNSDirectCredit = 128 * 1024
+const profileDNSDirectPending = 12
+
+// FD принадлежит только этому owner; нет os.File, Fd, File или SyscallConn.
+// Ошибка consuming close сохраняется, числовой FD повторно не закрывается.
+type profileDNSOwnedFD struct {
+	mu       sync.Mutex
+	number   int
+	closed   bool
+	result   error
+	closeRaw func(int) error
+}
+
+func profileDNSOwnFD(number int) *profileDNSOwnedFD {
+	return &profileDNSOwnedFD{number: number, closeRaw: unix.Close}
+}
+
+func (f *profileDNSOwnedFD) withFD(fn func(int) error) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.closed {
+		return net.ErrClosed
+	}
+	return fn(f.number)
+}
+func (f *profileDNSOwnedFD) Close() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !f.closed {
+		f.closed = true
+		if f.closeRaw == nil {
+			f.result = ErrProfileCleanupUnknown
+		} else {
+			f.result = f.closeRaw(f.number)
+		}
+	}
+	return f.result
+}
+
+type profileDNSOwnedAddress struct{ network, address string }
+
+func (a profileDNSOwnedAddress) Network() string { return a.network }
+func (a profileDNSOwnedAddress) String() string  { return a.address }
+
+// Sealed factory product. Production constructor ниже устанавливает только
+// nonblocking syscalls; callbacks здесь — закрытая dependency injection seam.
+// Ни arbitrary net.Conn, ни его Close не становятся consuming/join proof.
+type profileDNSOwnedSocket struct {
+	mu                          sync.Mutex
+	tasks                       sync.WaitGroup
+	once                        sync.Once
+	ctx                         context.Context
+	cancel                      context.CancelFunc
+	closing, prepared           bool
+	readActive, writeActive     bool
+	result                      error
+	fd                          profileProofFD
+	destination                 profileDestinationValue
+	local, remote               net.Addr
+	readDeadline, writeDeadline time.Time
+	readIO, writeIO             func([]byte) (int, error)
+	waitIO                      func(context.Context, bool, time.Time) error
+	closeFD                     func() error
+	gateIO                      func() error
+}
+
+func (s *profileDNSOwnedSocket) LocalAddr() net.Addr  { return s.local }
+func (s *profileDNSOwnedSocket) RemoteAddr() net.Addr { return s.remote }
+func (s *profileDNSOwnedSocket) begin(write bool) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing || s.ctx.Err() != nil {
+		return net.ErrClosed
+	}
+	if write {
+		if s.writeActive {
+			return errProfileFlowBusy
+		}
+		s.writeActive = true
+	} else {
+		if s.readActive {
+			return errProfileFlowBusy
+		}
+		s.readActive = true
+	}
+	s.tasks.Add(1)
+	return nil
+}
+func (s *profileDNSOwnedSocket) end(write bool) {
+	s.mu.Lock()
+	if write {
+		s.writeActive = false
+	} else {
+		s.readActive = false
+	}
+	s.mu.Unlock()
+	s.tasks.Done()
+}
+func (s *profileDNSOwnedSocket) deadline(write bool) (time.Time, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing || s.ctx.Err() != nil {
+		return time.Time{}, net.ErrClosed
+	}
+	deadline := s.readDeadline
+	if write {
+		deadline = s.writeDeadline
+	}
+	if d, ok := s.ctx.Deadline(); ok && (deadline.IsZero() || d.Before(deadline)) {
+		deadline = d
+	}
+	if !deadline.IsZero() && !time.Now().Before(deadline) {
+		return deadline, context.DeadlineExceeded
+	}
+	return deadline, nil
+}
+func (s *profileDNSOwnedSocket) operate(b []byte, write bool) (int, error) {
+	if err := s.begin(write); err != nil {
+		return 0, err
+	}
+	defer s.end(write)
+	for {
+		deadline, err := s.deadline(write)
+		if err != nil {
+			return 0, err
+		}
+		if len(b) == 0 {
+			return 0, nil
+		}
+		if s.gateIO != nil {
+			if err := s.gateIO(); err != nil {
+				return 0, err
+			}
+		}
+		var n int
+		if write {
+			n, err = s.writeIO(b)
+		} else {
+			n, err = s.readIO(b)
+		}
+		if n < 0 {
+			n = 0
+		}
+		if n > len(b) {
+			return 0, errProfile
+		}
+		if n > 0 {
+			if write && n != len(b) && err == nil {
+				err = io.ErrShortWrite
+			}
+			return n, err
+		}
+		if err == unix.EINTR {
+			continue
+		}
+		if err == unix.EAGAIN || err == unix.EWOULDBLOCK {
+			if err = s.waitIO(s.ctx, write, deadline); err != nil {
+				return 0, err
+			}
+			continue
+		}
+		if !write && err == nil {
+			err = io.EOF
+		}
+		return n, err
+	}
+}
+func (s *profileDNSOwnedSocket) Read(b []byte) (int, error)  { return s.operate(b, false) }
+func (s *profileDNSOwnedSocket) Write(b []byte) (int, error) { return s.operate(b, true) }
+func (s *profileDNSOwnedSocket) SetDeadline(d time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing {
+		return net.ErrClosed
+	}
+	s.readDeadline, s.writeDeadline = d, d
+	return nil
+}
+func (s *profileDNSOwnedSocket) SetReadDeadline(d time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing {
+		return net.ErrClosed
+	}
+	s.readDeadline = d
+	return nil
+}
+func (s *profileDNSOwnedSocket) SetWriteDeadline(d time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing {
+		return net.ErrClosed
+	}
+	s.writeDeadline = d
+	return nil
+}
+func (s *profileDNSOwnedSocket) Close() error {
+	s.once.Do(func() {
+		s.mu.Lock()
+		s.closing = true
+		if s.cancel != nil {
+			s.cancel()
+		}
+		s.mu.Unlock()
+		// Default syscalls nonblocking, poll slices≤20ms. Нет hidden Conn owners;
+		// все active operations завершаются до единственного consuming raw close.
+		s.tasks.Wait()
+		if s.closeFD == nil {
+			s.result = ErrProfileCleanupUnknown
+		} else {
+			s.result = s.closeFD()
+		}
+	})
+	return s.result
+}
+func profileDNSWaitOwned(fd profileProofFD, ctx context.Context, write bool, deadline time.Time) error {
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	wait := 20 * time.Millisecond
+	if d, ok := ctx.Deadline(); ok && (deadline.IsZero() || d.Before(deadline)) {
+		deadline = d
+	}
+	if !deadline.IsZero() {
+		left := time.Until(deadline)
+		if left <= 0 {
+			return context.DeadlineExceeded
+		}
+		if left < wait {
+			wait = left
+		}
+	}
+	return fd.withFD(func(n int) error {
+		event := int16(unix.POLLIN)
+		if write {
+			event = unix.POLLOUT
+		}
+		fds := [1]unix.PollFd{{Fd: int32(n), Events: event}}
+		_, err := unix.Poll(fds[:], int((wait+time.Millisecond-1)/time.Millisecond))
+		if err == unix.EINTR {
+			return nil
+		}
+		if err != nil || fds[0].Revents&unix.POLLNVAL != 0 {
+			return errors.Join(errProfile, err)
+		}
+		return nil
+	})
+}
+
+// Exhaustive native factory: numeric IPv4/IPv6, TCP/connected UDP only.
+// Socket возвращается с custody даже при setup/connect error; нет Dialer
+// goroutines, RawConn/File aliases, external controllers или crypto wrappers.
+func profileDNSCreateOwnedSocket(ctx context.Context, want profileDestinationValue) (*profileDNSOwnedSocket, error) {
+	t, _ := ctx.Value(profileDNSFactoryKey{}).(*profileDNSDirect)
+	if t == nil || want != t.destination || !ProfileDNSDirectFactory(ctx) {
+		return nil, errProfile
+	}
+	ip, err := netip.ParseAddr(want.address)
+	if err != nil || !want.valid() || ip.IsLoopback() || want.family == 3 {
+		return nil, ErrProfileUnsupported
+	}
+	domain := unix.AF_INET
+	var peer unix.Sockaddr
+	if want.family == 4 {
+		peer = &unix.SockaddrInet4{Port: int(want.port), Addr: ip.As4()}
+	} else if want.family == 6 {
+		domain = unix.AF_INET6
+		peer = &unix.SockaddrInet6{Port: int(want.port), Addr: ip.As16()}
+	} else {
+		return nil, ErrProfileUnsupported
+	}
+	typ, protocol := unix.SOCK_STREAM, unix.IPPROTO_TCP
+	network := "tcp"
+	if want.network == 17 {
+		typ, protocol, network = unix.SOCK_DGRAM, unix.IPPROTO_UDP, "udp"
+	} else if want.network != 6 {
+		return nil, ErrProfileUnsupported
+	}
+	n, err := unix.Socket(domain, typ|unix.SOCK_CLOEXEC|unix.SOCK_NONBLOCK, protocol)
+	if n < 0 {
+		return nil, errors.Join(errProfile, err)
+	}
+	fd := profileDNSOwnFD(n)
+	life, cancel := context.WithCancel(t.ctx)
+	s := &profileDNSOwnedSocket{ctx: life, cancel: cancel, fd: fd, destination: want, remote: profileDNSOwnedAddress{network, net.JoinHostPort(want.address, strconv.Itoa(int(want.port)))}, closeFD: fd.Close}
+	s.gateIO = func() error {
+		c := t.bundle.exchange.query.runtime.flow
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		if !c.dnsDirectLive(t) {
+			return errProfile
+		}
+		return nil
+	}
+	s.waitIO = func(c context.Context, w bool, d time.Time) error { return profileDNSWaitOwned(fd, c, w, d) }
+	s.readIO = func(b []byte) (size int, result error) {
+		result = fd.withFD(func(number int) error {
+			flags := unix.MSG_DONTWAIT
+			if want.network == 17 {
+				flags |= unix.MSG_TRUNC
+			}
+			size, _, result = unix.Recvfrom(number, b, flags)
+			return result
+		})
+		return
+	}
+	s.writeIO = func(b []byte) (size int, result error) {
+		result = fd.withFD(func(number int) error {
+			size, result = unix.SendmsgN(number, b, nil, nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+			return result
+		})
+		return
+	}
+	if err != nil {
+		return s, err
+	}
+	if domain == unix.AF_INET6 {
+		if err = unix.SetsockoptInt(n, unix.IPPROTO_IPV6, unix.IPV6_V6ONLY, 1); err != nil {
+			return s, err
+		}
+	}
+	if want.network == 6 {
+		// Прежние DefaultSystemDialer TCP defaults, без external sockopt callbacks.
+		for _, option := range [][3]int{{unix.IPPROTO_TCP, unix.TCP_NODELAY, 1}, {unix.SOL_SOCKET, unix.SO_KEEPALIVE, 1}, {unix.IPPROTO_TCP, unix.TCP_KEEPIDLE, 45}, {unix.IPPROTO_TCP, unix.TCP_KEEPINTVL, 45}} {
+			if err = unix.SetsockoptInt(n, option[0], option[1], option[2]); err != nil {
+				return s, err
+			}
+		}
+	}
+	if !ProfileDNSDirectFactory(ctx) {
+		return s, errProfile
+	}
+	err = unix.Connect(n, peer)
+	if err == unix.EINPROGRESS || err == unix.EALREADY || err == unix.EINTR {
+		for {
+			if err = s.waitIO(ctx, true, time.Time{}); err != nil {
+				return s, err
+			}
+			code, e := unix.GetsockoptInt(n, unix.SOL_SOCKET, unix.SO_ERROR)
+			if e != nil {
+				return s, e
+			}
+			if unix.Errno(code) == unix.EINPROGRESS || unix.Errno(code) == unix.EALREADY {
+				continue
+			}
+			if code != 0 {
+				return s, unix.Errno(code)
+			}
+			if _, err = unix.Getpeername(n); err == unix.ENOTCONN {
+				continue
+			}
+			break
+		}
+	}
+	if err != nil {
+		return s, err
+	}
+	local, err := unix.Getsockname(n)
+	if err != nil {
+		return s, err
+	}
+	address, err := profileSockaddrValue(local)
+	if err != nil {
+		return s, err
+	}
+	s.local = profileDNSOwnedAddress{network, net.JoinHostPort(address.address, strconv.Itoa(int(address.port)))}
+	return s, nil
+}
+
+type profileDNSDirectIO struct {
+	create    func(context.Context, profileDestinationValue) (*profileDNSOwnedSocket, error)
+	duplicate func(*profileDNSOwnedSocket, profileDestinationValue) (profileProofFD, error)
+	send      func([]byte, profileProofFD) error
+}
+type profileDNSDirectRPC struct {
+	owner               *profileDNSDirect
+	physical            bool
+	expected            uint16
+	request             *profileOperation
+	cancelSequence      uint64
+	cancelAck, received bool
+	cleanup             bool
+}
+type profileDNSDirect struct {
+	wireMu                                                              sync.Mutex
+	wireRequest                                                         [514]byte
+	wireResponse                                                        [32770]byte
+	wireSent, wireRead                                                  int
+	wireBad, publishing                                                 bool
+	started                                                             time.Time
+	publishDone                                                         chan struct{}
+	publishOnce                                                         sync.Once
+	bundle                                                              *profileDNSBundle
+	ctx                                                                 context.Context
+	cancel                                                              context.CancelFunc
+	destination                                                         profileDestinationValue
+	requests                                                            [12]*profileOperation
+	used                                                                int
+	exchangeReservation, exchange, physicalReservation, resource, proof uint64
+	revision                                                            uint64
+	epoch                                                               uint64
+	deadline                                                            time.Time
+	cleanupDeadline                                                     time.Time
+	conn                                                                *profileDNSOwnedSocket
+	duplicate                                                           profileProofFD
+	factory, closed, localDone, unknown, released                       bool
+	localError                                                          error
+	io                                                                  profileDNSDirectIO
+}
+type profileDNSFactoryKey struct{}
+
+func ProfileDNSDirectRequired(ctx context.Context) bool { return profileDNSExchangeFrom(ctx) != nil }
+
+// Никакого caller-supplied Conn/factory. Raw resource создаётся только private
+// consuming factory, после reservations; injected IO используется pure tests.
+func ProfileDialDNSDirect(ctx context.Context, target xnet.Destination) (net.Conn, error) {
+	return profileDNSDialDirect(ctx, target)
+}
+
+func ProfileDNSDirectFactory(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	t, _ := ctx.Value(profileDNSFactoryKey{}).(*profileDNSDirect)
+	return t != nil && ProfilePhysicalGate(ctx) == nil
+}
+
+// Только terminal DirectSocket без mux, bootstrap, domain и loopback stub.
+// Проверка не создаёт resource authority; runner получает отдельный private key.
+func profileDNSDirectShape(ctx context.Context, target xnet.Destination) (*profileDNSBundle, error) {
+	if ctx == nil {
+		return nil, ErrProfileUnsupported
+	}
+	p := profileRuntime(ctx)
+	use, ok := ctx.Value(profileDNSBundleKey{}).(profileDNSBundleUse)
+	value, err := profileValue(target)
+	if p == nil || !ok || use.bundle == nil || err != nil || value.family == 3 {
+		return nil, ErrProfileUnsupported
+	}
+	b := use.bundle
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.dnsBundleLive(b) || profileDNSExchangeFrom(ctx) != b.exchange || profileQueryFrom(ctx) != b.exchange.query || profileReceiptFrom(ctx) != b.exchange.query.receipt || ctx.Err() != nil || b.count != 1 || use.index != 0 || b.path[0].branch != 0 || value != b.exchange.target || value != b.targets[0] {
+		return nil, ErrProfileUnsupported
+	}
+	row := c.manifest.rows[8][b.path[0].scope]
+	ip, e := netip.ParseAddr(value.address)
+	if e != nil || ip.IsLoopback() || len(row) != 24 || row[20] != 3 || row[2] != value.network || row[4] != value.network || row[5] != value.network {
+		return nil, ErrProfileUnsupported
+	}
+	return b, nil
+}
+
+func (c *profileFlowControl) dnsDirectLive(t *profileDNSDirect) bool {
+	return t != nil && !t.closed && !t.unknown && t.ctx.Err() == nil && c.dnsBundleLive(t.bundle) && t.epoch == t.bundle.exchange.query.runtime.admission.launch.epoch && c.clock().Before(t.deadline)
+}
+func (c *profileFlowControl) dnsDirectNew(ctx context.Context, b *profileDNSBundle, io profileDNSDirectIO) (*profileDNSDirect, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, other := range c.dnsDirect[:c.dnsDirectUsed] {
+		if other.bundle.exchange == b.exchange {
+			return nil, ErrProfileUnsupported
+		}
+	}
+	pending := c.profilePendingUsed() + profileDNSDirectPending
+	fds := c.profileFDUsed() + 2
+	if !c.dnsBundleLive(b) || ctx.Err() != nil || io.create == nil || io.duplicate == nil || io.send == nil || c.dnsDirectUsed >= len(c.dnsDirect) || pending > min(int(c.manifest.caps[3]), 64) || fds > 64 || c.buffered+c.manifest.memoryCredit+profileDNSDirectCredit > uint64(c.manifest.caps[4]) || !c.dnsReserveHistory(profileDNSDirectPending) {
+		return nil, errProfileFlowBusy
+	}
+	// Сначала общие credits и retained slot, затем contexts/body/factory.
+	c.operations += profileDNSDirectPending
+	c.dnsFDUsed += 2
+	c.buffered += profileDNSDirectCredit
+	child, cancel := context.WithDeadline(ctx, b.deadline)
+	cleanupDeadline := b.deadline.Add(time.Second)
+	if c.sessionDeadline.Before(cleanupDeadline) {
+		cleanupDeadline = c.sessionDeadline
+	}
+	t := &profileDNSDirect{bundle: b, ctx: child, cancel: cancel, destination: b.exchange.target, deadline: b.deadline, cleanupDeadline: cleanupDeadline, io: io, epoch: b.exchange.query.runtime.admission.launch.epoch}
+	t.started = c.clock()
+	t.publishDone = make(chan struct{})
+	request := b.exchange.request
+	if len(request) < 12 || len(request) > 512 {
+		t.wireBad = true
+	} else if t.destination.network == 6 {
+		be.PutUint16(t.wireRequest[:], uint16(len(request)))
+		copy(t.wireRequest[2:], request)
+	} else {
+		copy(t.wireRequest[:], request)
+	}
+	b.exchange.query.refs++
+	c.dnsDirect[c.dnsDirectUsed] = t
+	c.dnsDirectUsed++
+	return t, nil
+}
+func (c *profileFlowControl) dnsDirectRequest(t *profileDNSDirect, kind, expected uint16, body []byte, physical bool) (*profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.dnsDirectLive(t) || t.used >= len(t.requests) || !profileDNSV2Body(kind, body) {
+		return nil, errProfile
+	}
+	r := &profileDNSDirectRPC{owner: t, physical: physical, expected: expected}
+	op := &profileOperation{ctx: t.ctx, kind: kind, body: body, done: make(chan struct{}), dnsDirect: r}
+	t.requests[t.used] = op
+	t.used++
+	return op, nil
+}
+func (c *profileFlowControl) dnsDirectReserve(t *profileDNSDirect, physical bool) (*profileOperation, error) {
+	e := t.bundle.exchange
+	c.mu.Lock()
+	if !c.dnsDirectLive(t) {
+		c.mu.Unlock()
+		return nil, errProfile
+	}
+	base := c.dnsBody(e.root)
+	row := c.manifest.rows[8][t.bundle.path[0].scope]
+	body := make([]byte, 96+len(e.original)+len(e.root.query)+len(base))
+	be.PutUint16(body, 2)
+	body[2] = 1
+	if physical {
+		body[2] = 2
+	}
+	for _, v := range []struct {
+		at    int
+		value uint64
+	}{{8, e.id}, {16, t.bundle.id}, {24, e.root.id}, {32, e.query.receipt.id}, {40, e.query.receipt.revision}, {48, e.query.runtime.admission.launch.epoch}, {56, uint64(t.deadline.Sub(c.clock()))}} {
+		be.PutUint64(body[v.at:], v.value)
+	}
+	for _, v := range []struct {
+		at    int
+		value uint16
+	}{{64, e.root.resolver}, {66, u16(row, 0)}, {68, 65535}, {70, t.bundle.path[0].scope}, {72, e.qtype}, {80, uint16(len(e.original))}, {82, uint16(len(e.root.query))}, {84, uint16(len(base))}} {
+		be.PutUint16(body[v.at:], v.value)
+	}
+	body[74], body[75], body[76], body[77], body[78] = 1, 1, t.destination.network, 3, 1
+	if physical {
+		be.PutUint64(body[88:], t.exchangeReservation)
+	} else {
+		be.PutUint16(body[88:], e.options)
+		be.PutUint16(body[90:], e.payload)
+	}
+	at := 96
+	at += copy(body[at:], e.original)
+	at += copy(body[at:], e.root.query)
+	copy(body[at:], base)
+	c.mu.Unlock()
+	return c.dnsDirectRequest(t, 35, 36, body, physical)
+}
+func (c *profileFlowControl) dnsDirectDispatch(op *profileOperation) error {
+	t := op.dnsDirect.owner
+	if op.completed || op.submitted {
+		return nil
+	}
+	if !op.dnsDirect.cleanup && !c.dnsDirectLive(t) {
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	op.sent = c.clock()
+	op.deadline = t.deadline
+	if op.dnsDirect.cleanup {
+		op.deadline = op.sent.Add(time.Second)
+		if t.cleanupDeadline.Before(op.deadline) {
+			op.deadline = t.cleanupDeadline
+		}
+	}
+	if !op.dnsDirect.cleanup && t.bundle.deadline.Before(op.deadline) {
+		op.deadline = t.bundle.deadline
+	}
+	if !op.sent.Before(op.deadline) {
+		if op.dnsDirect.cleanup {
+			t.unknown = true
+		}
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	remaining := uint64(op.deadline.Sub(op.sent))
+	if op.kind == 35 {
+		be.PutUint64(op.body[56:], remaining)
+	}
+	if op.kind == 38 {
+		be.PutUint64(op.body[56:], remaining)
+	}
+	if op.kind == 52 {
+		// Тот же Physical Reserve sequence, без второго runtime pending slot.
+		op.sequence = op.dnsDirect.request.sequence
+		op.sent = op.dnsDirect.request.sent
+		op.deadline = op.dnsDirect.request.deadline
+		op.submitted = true
+		if t.duplicate == nil || !profileDNSV2Envelope(t.bundle.exchange.query.runtime.admission.launch, op.body, false, 1, 1, 0) {
+			t.unknown = true
+			c.dnsNotify(op, errProfile)
+			return errProfile
+		}
+		err := t.io.send(op.body, t.duplicate)
+		if err != nil {
+			t.unknown = true
+			c.dnsNotify(op, err)
+			return err
+		}
+		return nil
+	}
+	seq, err := c.write(op.kind, 0, op.body)
+	op.sequence, op.submitted = seq, true
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	if err != nil || !profileDNSV2ID(seq) {
+		t.unknown = true
+		c.dnsNotify(op, errProfile)
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) dnsDirectAccept(f profilePacket) (bool, error) {
+	if f.object != 0 || !profileDNSV2Body(f.kind, f.body) {
+		return true, errProfile
+	}
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		for _, op := range t.requests[:t.used] {
+			r := op.dnsDirect
+			if f.reply == r.cancelSequence && r.cancelSequence != 0 && f.kind == 48 {
+				if r.cancelAck || f.body[2] != 1 || u64(f.body, 8) != op.sequence || !c.clock().Before(t.cleanupDeadline) {
+					t.unknown = true
+					return true, errProfile
+				}
+				r.cancelAck = true
+				return true, nil
+			}
+			if !op.submitted || f.reply != op.sequence || f.kind != r.expected {
+				continue
+			}
+			if r.received {
+				t.unknown = true
+				return true, errProfile
+			}
+			r.received = true
+			if f.object != 0 || !profileDNSV2Body(f.kind, f.body) || f.body[2] != 1 {
+				t.closed = true
+				t.cancel()
+				t.unknown = true
+				c.dnsNotify(op, errProfile)
+				return true, nil
+			}
+			b := f.body
+			e := t.bundle.exchange
+			// Parse IDs даже после cancellation: late Allow удерживается для cleanup,
+			// но не возобновляет consumer и не публикует соединение.
+			valid := true
+			switch f.kind {
+			case 36:
+				valid = !c.hostsReservationUsed(u64(b, 8)) && u64(b, 16) == e.id && u64(b, 24) == t.bundle.id && u64(b, 40) == e.query.runtime.admission.launch.epoch && b[60] == op.body[2]
+				if r.physical {
+					valid = valid && u64(b, 32) == t.exchangeReservation && u16(b, 56) >= 2
+					t.physicalReservation = u64(b, 8)
+				} else {
+					valid = valid && u16(b, 56) == 0
+					t.exchangeReservation, t.exchange = u64(b, 8), u64(b, 32)
+				}
+			case 37:
+				valid = u64(b, 8) == t.physicalReservation && u64(b, 24) == e.id && u64(b, 32) == t.bundle.id && u64(b, 40) == e.query.runtime.admission.launch.epoch
+				t.resource = u64(b, 16)
+			case 39:
+				valid = u64(b, 8) == t.exchange && u64(b, 24) == e.id && u64(b, 32) == t.bundle.id && u64(b, 40) == 1 && u16(b, 56) == 1 && b[58] == 1
+				t.proof, t.revision = u64(b, 16), u64(b, 40)
+			case 46:
+				valid = b[3] == op.body[2] && u64(b, 8) == u64(op.body, 8) && u64(b, 16) == u64(op.body, 16)
+			case 48:
+				valid = u64(b, 8) == u64(op.body, 8)
+			}
+			if f.kind != 46 && f.kind != 48 {
+				for _, other := range c.dnsDirect[:c.dnsDirectUsed] {
+					if other == t {
+						continue
+					}
+					if f.kind == 36 && (u64(b, 8) == other.exchangeReservation || u64(b, 8) == other.physicalReservation) || f.kind == 36 && !r.physical && u64(b, 32) == other.exchange || f.kind == 37 && u64(b, 16) == other.resource || f.kind == 39 && u64(b, 16) == other.proof {
+						valid = false
+					}
+				}
+				if f.kind == 36 && r.physical && t.physicalReservation == t.exchangeReservation {
+					valid = false
+				}
+				remaining := u64(b, 48)
+				deadline := op.sent.Add(time.Duration(remaining))
+				if remaining == 0 || remaining > uint64(op.deadline.Sub(op.sent)) {
+					valid = false
+				}
+				if deadline.Before(t.deadline) {
+					t.deadline = deadline
+				}
+				if f.kind == 37 {
+					until := t.deadline.Add(time.Second)
+					if until.Before(t.cleanupDeadline) {
+						t.cleanupDeadline = until
+					}
+				}
+			} else if !c.clock().Before(op.deadline) || !c.clock().Before(t.cleanupDeadline) {
+				valid = false
+			}
+			if !valid {
+				t.unknown = true
+				t.closed = true
+				t.cancel()
+				c.dnsNotify(op, errProfile)
+				return true, errProfile
+			}
+			if f.kind != 46 && f.kind != 48 && !c.dnsDirectLive(t) {
+				c.dnsNotify(op, errProfile)
+			} else {
+				c.dnsNotify(op, nil)
+			}
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func (c *profileFlowControl) dnsDirectPhysical(t *profileDNSDirect, request *profileOperation) (*profileOperation, error) {
+	c.mu.Lock()
+	if !c.dnsDirectLive(t) || t.physicalReservation == 0 || t.duplicate == nil {
+		c.mu.Unlock()
+		return nil, errProfile
+	}
+	r := t.bundle.exchange.query.runtime.admission.launch
+	body := make([]byte, 192)
+	copy(body, "DNSPHY02")
+	be.PutUint16(body[8:], 2)
+	be.PutUint16(body[10:], 192)
+	copy(body[16:], r.digest[:])
+	copy(body[48:], r.session[:])
+	copy(body[64:], r.invocation[:])
+	be.PutUint64(body[80:], r.generation)
+	be.PutUint64(body[88:], r.epoch)
+	copy(body[96:], r.nonce[:])
+	be.PutUint64(body[128:], t.exchangeReservation)
+	be.PutUint64(body[136:], t.bundle.queryID)
+	be.PutUint64(body[144:], t.bundle.id)
+	be.PutUint64(body[152:], t.physicalReservation)
+	be.PutUint16(body[160:], t.bundle.resolver)
+	be.PutUint16(body[162:], t.bundle.path[0].scope)
+	body[164], body[165], body[166] = t.destination.network, 1, r.mode
+	if body[164] == 17 {
+		body[165] = 2
+	}
+	ip, _ := netip.ParseAddr(t.destination.address)
+	address := ip.AsSlice()
+	body[168], body[169], body[172] = t.destination.family, t.destination.network, byte(len(address))
+	be.PutUint16(body[170:], t.destination.port)
+	copy(body[175:], address)
+	c.mu.Unlock()
+	op, err := c.dnsDirectRequest(t, 52, 37, body, true)
+	if err == nil {
+		op.dnsDirect.request = request
+	}
+	return op, err
+}
+func (c *profileFlowControl) dnsDirectLogical(t *profileDNSDirect) (*profileOperation, error) {
+	c.mu.Lock()
+	body := make([]byte, 72)
+	be.PutUint16(body, 2)
+	body[2] = 1
+	be.PutUint16(body[4:], 1)
+	for _, v := range []struct {
+		at    int
+		value uint64
+	}{{8, t.exchangeReservation}, {16, t.bundle.queryID}, {24, t.bundle.id}, {32, t.exchange}, {48, 1}, {56, uint64(t.deadline.Sub(c.clock()))}, {64, t.resource}} {
+		be.PutUint64(body[v.at:], v.value)
+	}
+	c.mu.Unlock()
+	return c.dnsDirectRequest(t, 38, 39, body, false)
+}
+
+// DirectSocket production caller: только private bundle → authenticated
+// reservation → raw FD proof → LogicalAck. Runner никогда не получает grant API.
+func profileDNSDialDirect(ctx context.Context, target xnet.Destination) (net.Conn, error) {
+	b, err := profileDNSDirectShape(ctx, target)
+	if err != nil {
+		return nil, err
+	}
+	p := profileRuntime(ctx)
+	io := p.dnsDirectIO
+	if io == nil {
+		if p.proofs == nil || !p.proofs.live() {
+			return nil, ErrProfileUnsupported
+		}
+		source := b.exchange.query.receipt.association
+		if source == nil {
+			return nil, ErrProfileUnsupported
+		}
+		io = &profileDNSDirectIO{create: profileDNSCreateOwnedSocket, duplicate: func(conn *profileDNSOwnedSocket, want profileDestinationValue) (profileProofFD, error) {
+			fd, e := profileDNSDuplicateDirect(conn, want)
+			if e != nil || fd == nil {
+				return fd, errors.Join(errProfile, e)
+			}
+			p.flow.mu.Lock()
+			defer p.flow.mu.Unlock()
+			if source.proof == nil {
+				return fd, ErrProfileUnsupported
+			}
+			return fd, profileKernelSocketNamespace(source.proof, fd)
+		}, send: p.sendDNSPhysical}
+	}
+	c := p.flow
+	t, err := c.dnsDirectNew(ctx, b, *io)
+	if err != nil {
+		return nil, err
+	}
+	// Cancellation перед factory не освобождает slot: factory может вернуть
+	// поздний nonnil resource. Cleanup ждёт завершения именно этого owner.
+	var owned *profileDNSDirectConn
+	defer func() {
+		if err != nil {
+			if owned != nil {
+				_ = owned.Close()
+			} else {
+				c.mu.Lock()
+				t.closed = true
+				t.cancel()
+				t.localDone = true
+				c.mu.Unlock()
+			}
+		}
+	}()
+	reserve, err := c.dnsDirectReserve(t, false)
+	if err != nil {
+		return nil, err
+	}
+	if err = p.flowRPC(reserve); err != nil {
+		return nil, err
+	}
+	physical, err := c.dnsDirectReserve(t, true)
+	if err != nil {
+		return nil, err
+	}
+	if err = p.flowRPC(physical); err != nil {
+		return nil, err
+	}
+	c.mu.Lock()
+	if !c.dnsDirectLive(t) {
+		c.mu.Unlock()
+		err = errProfile
+		return nil, err
+	}
+	t.factory = true
+	factoryDeadline := t.deadline
+	c.mu.Unlock()
+	factoryContext, finishFactory := context.WithDeadline(context.WithValue(t.ctx, profileDNSFactoryKey{}, t), factoryDeadline)
+	conn, factoryError := t.io.create(factoryContext, t.destination)
+	finishFactory()
+	c.mu.Lock()
+	t.conn = conn
+	t.factory = false
+	c.mu.Unlock()
+	owned = &profileDNSDirectConn{socket: conn, owner: t}
+	if factoryError != nil || conn == nil {
+		err = errors.Join(errProfile, factoryError)
+		return nil, err
+	}
+	if conn.ctx == nil || conn.cancel == nil || conn.fd == nil || conn.destination != t.destination || conn.readIO == nil || conn.writeIO == nil || conn.waitIO == nil || conn.closeFD == nil {
+		err = ErrProfileUnsupported
+		return nil, err
+	}
+	c.mu.Lock()
+	live := c.dnsDirectLive(t)
+	c.mu.Unlock()
+	if !live {
+		err = errProfile
+		return nil, err
+	}
+	fd, inspectError := t.io.duplicate(conn, t.destination)
+	c.mu.Lock()
+	t.duplicate = fd
+	c.mu.Unlock()
+	if inspectError != nil || fd == nil {
+		err = errors.Join(errProfile, inspectError)
+		return nil, err
+	}
+	proof, err := c.dnsDirectPhysical(t, physical)
+	if err != nil {
+		return nil, err
+	}
+	if err = p.flowRPC(proof); err != nil {
+		return nil, err
+	}
+	logical, err := c.dnsDirectLogical(t)
+	if err != nil {
+		return nil, err
+	}
+	if err = p.flowRPC(logical); err != nil {
+		return nil, err
+	}
+	if err = owned.gate(); err != nil {
+		return nil, err
+	}
+	context.AfterFunc(t.ctx, func() { _ = owned.Close() })
+	return owned, nil
+}
+
+type profileDNSDirectConn struct {
+	socket                      *profileDNSOwnedSocket
+	owner                       *profileDNSDirect
+	mu                          sync.Mutex
+	closing                     bool
+	readActive, writeActive     bool
+	tasks                       sync.WaitGroup
+	once                        sync.Once
+	result                      error
+	readDeadline, writeDeadline time.Time
+}
+
+func (s *profileDNSDirectConn) LocalAddr() net.Addr  { return s.socket.LocalAddr() }
+func (s *profileDNSDirectConn) RemoteAddr() net.Addr { return s.socket.RemoteAddr() }
+
+func (s *profileDNSDirectConn) gate() error {
+	t := s.owner
+	c := t.bundle.exchange.query.runtime.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.dnsDirectLive(t) || t.proof == 0 || t.revision != 1 || t.resource == 0 {
+		return errProfile
+	}
+	return nil
+}
+func (s *profileDNSDirectConn) begin(write bool) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing || s.gate() != nil {
+		return errProfile
+	}
+	if write {
+		if s.writeActive {
+			return errProfileFlowBusy
+		}
+		s.writeActive = true
+	} else {
+		if s.readActive {
+			return errProfileFlowBusy
+		}
+		s.readActive = true
+	}
+	s.tasks.Add(1)
+	return nil
+}
+func (s *profileDNSDirectConn) end(write bool) {
+	s.mu.Lock()
+	if write {
+		s.writeActive = false
+	} else {
+		s.readActive = false
+	}
+	s.mu.Unlock()
+	s.tasks.Done()
+}
+func (s *profileDNSDirectConn) Read(b []byte) (int, error) {
+	if err := s.begin(false); err != nil {
+		return 0, err
+	}
+	defer s.end(false)
+	if err := s.applyDeadline(false); err != nil {
+		return 0, err
+	}
+	t := s.owner
+	t.wireMu.Lock()
+	if !t.wireBad && t.wireComplete() {
+		t.wireMu.Unlock()
+		// Следующий stream read не закрывает proof до publication ACK.
+		select {
+		case <-t.publishDone:
+			return 0, io.EOF
+		case <-t.ctx.Done():
+			return 0, t.ctx.Err()
+		}
+	}
+	if t.wireBad || t.wireSent != t.wireRequestLength() || len(b) == 0 {
+		t.wireMu.Unlock()
+		return 0, errProfile
+	}
+	limit := len(t.wireResponse) - t.wireRead
+	if t.destination.network == 6 && t.wireRead < 2 {
+		limit = 2 - t.wireRead
+	}
+	if t.destination.network == 6 && t.wireRead >= 2 {
+		limit = int(u16(t.wireResponse[:], 0)) + 2 - t.wireRead
+	}
+	t.wireMu.Unlock()
+	if limit < len(b) {
+		b = b[:limit]
+	}
+	n, err := s.socket.Read(b)
+	t.wireMu.Lock()
+	if n > 0 && n <= len(b) && err == nil {
+		copy(t.wireResponse[t.wireRead:], b[:n])
+		t.wireRead += n
+		if t.destination.network == 6 && t.wireRead >= 2 && (u16(t.wireResponse[:], 0) < 12 || u16(t.wireResponse[:], 0) > 32768) {
+			t.wireBad = true
+		}
+		if t.destination.network == 17 && (n < 12 || n > t.wireUDPLimit()) {
+			t.wireBad = true
+		}
+	} else {
+		t.wireBad = true
+	}
+	bad := t.wireBad
+	t.wireMu.Unlock()
+	if bad {
+		return 0, errProfile
+	}
+	if s.gate() != nil {
+		return 0, errProfile
+	}
+	return n, err
+}
+func (s *profileDNSDirectConn) Write(b []byte) (int, error) {
+	if err := s.begin(true); err != nil {
+		return 0, err
+	}
+	defer s.end(true)
+	if err := s.applyDeadline(true); err != nil {
+		return 0, err
+	}
+	if err := s.gate(); err != nil {
+		return 0, err
+	}
+	t := s.owner
+	t.wireMu.Lock()
+	remaining := t.wireRequestLength() - t.wireSent
+	valid := !t.wireBad && len(b) > 0 && len(b) <= remaining && bytes.Equal(b, t.wireRequest[t.wireSent:t.wireSent+len(b)])
+	if t.destination.network == 17 {
+		valid = valid && len(b) == remaining && t.wireSent == 0
+	}
+	t.wireMu.Unlock()
+	if !valid {
+		return 0, errProfile
+	}
+	n, err := s.socket.Write(b)
+	t.wireMu.Lock()
+	if err != nil || n != len(b) {
+		t.wireBad = true
+	} else {
+		t.wireSent += n
+	}
+	t.wireMu.Unlock()
+	return n, err
+}
+
+func (t *profileDNSDirect) wireRequestLength() int {
+	n := len(t.bundle.exchange.request)
+	if t.destination.network == 6 {
+		n += 2
+	}
+	return n
+}
+func (t *profileDNSDirect) wireUDPLimit() int {
+	if t.bundle.exchange.options&8 != 0 {
+		return int(t.bundle.exchange.payload)
+	}
+	return 512
+}
+func (t *profileDNSDirect) wireComplete() bool {
+	if t.destination.network == 17 {
+		return t.wireRead >= 12
+	}
+	return t.wireRead >= 14 && t.wireRead == int(u16(t.wireResponse[:], 0))+2
+}
+
+func (s *profileDNSDirectConn) boundedDeadline(requested time.Time) time.Time {
+	c := s.owner.bundle.exchange.query.runtime.flow
+	c.mu.Lock()
+	deadline := s.owner.deadline
+	c.mu.Unlock()
+	if !requested.IsZero() && requested.Before(deadline) {
+		return requested
+	}
+	return deadline
+}
+func (s *profileDNSDirectConn) applyDeadline(write bool) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing {
+		return errProfile
+	}
+	if write {
+		return s.socket.SetWriteDeadline(s.boundedDeadline(s.writeDeadline))
+	}
+	return s.socket.SetReadDeadline(s.boundedDeadline(s.readDeadline))
+}
+func (s *profileDNSDirectConn) SetDeadline(deadline time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing {
+		return errProfile
+	}
+	s.readDeadline, s.writeDeadline = deadline, deadline
+	return s.socket.SetDeadline(s.boundedDeadline(deadline))
+}
+func (s *profileDNSDirectConn) SetReadDeadline(deadline time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing {
+		return errProfile
+	}
+	s.readDeadline = deadline
+	return s.socket.SetReadDeadline(s.boundedDeadline(deadline))
+}
+func (s *profileDNSDirectConn) SetWriteDeadline(deadline time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closing {
+		return errProfile
+	}
+	s.writeDeadline = deadline
+	return s.socket.SetWriteDeadline(s.boundedDeadline(deadline))
+}
+func (s *profileDNSDirectConn) Close() error {
+	s.once.Do(func() {
+		s.mu.Lock()
+		s.closing = true
+		s.mu.Unlock()
+		t := s.owner
+		c := t.bundle.exchange.query.runtime.flow
+		c.mu.Lock()
+		t.closed = true
+		t.cancel()
+		c.mu.Unlock()
+		if s.socket != nil {
+			s.result = s.socket.Close()
+		}
+		if t.duplicate != nil {
+			s.result = errors.Join(s.result, t.duplicate.Close())
+		}
+		s.tasks.Wait()
+		c.mu.Lock()
+		t.localError = s.result
+		t.localDone = true
+		if s.result != nil {
+			t.unknown = true
+		}
+		c.mu.Unlock()
+	})
+	return s.result
+}
+
+// Kernel inspection выполняется до wrappers/crypto. Duplicate закрывается
+// вместе с actual connection; peer/netns повторно проверяет issuer независимо.
+func profileDNSDuplicateDirect(conn *profileDNSOwnedSocket, want profileDestinationValue) (profileProofFD, error) {
+	conn.mu.Lock()
+	if conn.prepared || conn.closing || conn.destination != want || conn.fd == nil {
+		conn.mu.Unlock()
+		return nil, errProfile
+	}
+	conn.prepared = true
+	conn.mu.Unlock()
+	var duplicate profileProofFD
+	err := conn.fd.withFD(func(n int) error {
+		owned, e := unix.FcntlInt(uintptr(n), unix.F_DUPFD_CLOEXEC, 3)
+		if e != nil {
+			return e
+		}
+		duplicate = profileDNSOwnFD(owned)
+		return profileDNSInspectDirect(owned, want)
+	})
+	return duplicate, err
+}
+func profileDNSInspectDirect(fd int, want profileDestinationValue) error {
+	typ, err := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_TYPE)
+	expected, protocol := unix.SOCK_STREAM, unix.IPPROTO_TCP
+	if want.network == 17 {
+		expected, protocol = unix.SOCK_DGRAM, unix.IPPROTO_UDP
+	}
+	if err != nil || typ != expected {
+		return errProfile
+	}
+	actualProtocol, err := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_PROTOCOL)
+	if err != nil || actualProtocol != protocol {
+		return errProfile
+	}
+	peer, err := unix.Getpeername(fd)
+	if err != nil {
+		return errProfile
+	}
+	actual, err := profileSockaddrValue(peer)
+	actual.network = want.network
+	if err != nil || actual != want {
+		return errProfile
+	}
+	namespace, err := unix.GetsockoptUint64(fd, unix.SOL_SOCKET, unix.SO_NETNS_COOKIE)
+	if err != nil || namespace == 0 {
+		return errProfile
+	}
+	flags, err := unix.FcntlInt(uintptr(fd), unix.F_GETFL, 0)
+	if err != nil || flags&unix.O_NONBLOCK == 0 {
+		return errProfile
+	}
+	return nil
+}
+func (p *ProfileRuntime) sendDNSPhysical(body []byte, fd profileProofFD) error {
+	if p.proofs == nil || !p.proofs.live() || !profileDNSV2Envelope(p.admission.launch, body, false, 1, 1, 0) {
+		return errProfile
+	}
+	return p.proofs.fd.withFD(func(channel int) error {
+		return fd.withFD(func(socket int) error {
+			if p.peerAlive() != nil {
+				return errProfile
+			}
+			n, err := unix.SendmsgN(channel, body, unix.UnixRights(socket), nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+			if err != nil || n != len(body) {
+				return errors.Join(errProfile, err)
+			}
+			return nil
+		})
+	})
+}
+
+// Ровно один runtime/proof reader использует общий bounded scratch до recvmsg.
+// Unexpected rights закрываются existing rejectRights; failed close сохраняет
+// scratch custody и не освобождает FD/pending/memory credits.
+func (p *ProfileRuntime) reserveDNSInput() (func(bool), error) {
+	return p.leaseProfileRX()
+}
+
+// Под c.mu: physical factories, retained accepted duplicates, DNS и UDP
+// используют один FD bound. UDP accepted duplicate уже включён в fdSlots.
+func (c *profileFlowControl) profileFDUsed() int {
+	used := c.dnsFDUsed + c.physicalFDs + 1
+	if c.udpBudget != nil {
+		used += c.udpBudget.fdSlots
+	}
+	for _, a := range c.accepted {
+		if a != nil && a.proofCredit && !a.udpFDCredit {
+			used++
+		}
+	}
+	return used
+}
+
+func profileDNSDirectLogicalGate(ctx context.Context) error {
+	p := profileRuntime(ctx)
+	use, ok := ctx.Value(profileDNSBundleKey{}).(profileDNSBundleUse)
+	if p == nil || !ok || use.bundle == nil || ctx.Err() != nil || profileDNSExchangeFrom(ctx) != use.bundle.exchange || profileQueryFrom(ctx) != use.bundle.exchange.query || profileReceiptFrom(ctx) != use.bundle.exchange.query.receipt {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		if t.bundle == use.bundle && c.dnsDirectLive(t) && t.proof != 0 && t.revision == 1 {
+			return nil
+		}
+	}
+	return errProfile
+}
+func (c *profileFlowControl) dnsDirectCleanupRequest(t *profileDNSDirect, kind uint16, target byte, id, revision uint64) error {
+	if id == 0 {
+		return nil
+	}
+	for _, op := range t.requests[:t.used] {
+		if op.dnsDirect.cleanup && op.kind == kind && op.body[2] == target && u64(op.body, 8) == id {
+			if !op.dnsDirect.received {
+				return errProfileProofBusy
+			}
+			return nil
+		}
+	}
+	if t.used >= len(t.requests) {
+		t.unknown = true
+		return errProfile
+	}
+	body := make([]byte, 24)
+	be.PutUint16(body, 2)
+	body[2] = target
+	be.PutUint64(body[8:], id)
+	expected := uint16(48)
+	if kind == 45 {
+		expected = 46
+		be.PutUint64(body[16:], revision)
+	}
+	op := &profileOperation{ctx: t.ctx, kind: kind, body: body, done: make(chan struct{}), dnsDirect: &profileDNSDirectRPC{owner: t, expected: expected, cleanup: true}}
+	t.requests[t.used] = op
+	t.used++
+	if err := c.dnsDirectDispatch(op); err != nil {
+		return err
+	}
+	return errProfileProofBusy
+}
+func (c *profileFlowControl) dnsDirectTick() error {
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		if t.released {
+			continue
+		}
+		if !c.dnsDirectLive(t) {
+			t.closed = true
+			t.cancel()
+		}
+		if !t.closed || t.unknown {
+			continue
+		}
+		pending := false
+		for _, op := range t.requests[:t.used] {
+			r := op.dnsDirect
+			if r.received {
+				continue
+			}
+			if r.cleanup {
+				if !c.clock().Before(op.deadline) {
+					t.unknown = true
+				}
+				pending = true
+				continue
+			}
+			c.dnsNotify(op, errProfile)
+			if !op.submitted {
+				r.received = true
+				continue
+			}
+			if r.cancelSequence == 0 {
+				seq, err := c.dnsCancel(1, op.sequence)
+				if err != nil {
+					t.unknown = true
+					return err
+				}
+				r.cancelSequence = seq
+			}
+			// Known request cancel не является разрешением принять late Allow.
+			// Сохраняем tombstone до исходного deadline без ID reuse.
+			if r.cancelAck && !c.clock().Before(op.deadline) {
+				r.received = true
+			} else {
+				pending = true
+			}
+			if !c.clock().Before(op.deadline.Add(time.Second)) && !r.cancelAck {
+				t.unknown = true
+			}
+		}
+		if pending || t.unknown || !t.localDone || t.factory || !c.dnsPublicationSettled(t) {
+			continue
+		}
+		if t.localError != nil {
+			t.unknown = true
+			continue
+		}
+		for _, ref := range []struct {
+			kind         uint16
+			target       byte
+			id, revision uint64
+		}{{45, 4, t.proof, t.revision}, {45, 3, t.resource, 0}, {47, 7, t.physicalReservation, 0}, {47, 7, t.exchangeReservation, 0}, {47, 2, t.exchange, 0}} {
+			err := c.dnsDirectCleanupRequest(t, ref.kind, ref.target, ref.id, ref.revision)
+			if err == errProfileProofBusy {
+				pending = true
+				break
+			}
+			if err != nil {
+				t.unknown = true
+				return err
+			}
+		}
+		if pending || t.unknown {
+			continue
+		}
+		t.released = true
+		c.operations -= profileDNSDirectPending
+		c.dnsFDUsed -= 2
+		// Retained IDs/request bytes остаются в оплаченной history до session end.
+		c.buffered -= profileDNSDirectCredit / 2
+		t.bundle.exchange.query.refs--
+		t.bundle.exchange.query.releaseLocked()
+	}
+	return nil
+}
+
+func (c *profileFlowControl) dnsDirectReleasedForBundle(b *profileDNSBundle) bool {
+	for _, o := range c.dnsResults[:c.dnsResultUsed] {
+		if o.waiter != nil && o.waiter.bundle == b && !o.released {
+			return false
+		}
+	}
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		if t.bundle == b && !t.released {
+			return false
+		}
+	}
+	return true
+}
+func (c *profileFlowControl) dnsDirectBundleCleanupWindow(b *profileDNSBundle) (time.Time, bool) {
+	var until time.Time
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		if t.bundle == b && (until.IsZero() || t.cleanupDeadline.Before(until)) {
+			until = t.cleanupDeadline
+		}
+	}
+	return until, !until.IsZero()
+}
