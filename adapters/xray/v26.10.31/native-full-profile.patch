+func TestProfileDNSNumericTwoPrivateWaitersDoNotShareUserGrant(t *testing.T) {
+	n := numericPublished(t, 1, 6)
+	n.launch(t, n.source, n.target)
+	op := n.dnsTo42(t)
+	n.ack(t, op)
+	first := n.result(t)
+	if first.err != nil {
+		t.Fatal(first.err)
+	}
+	f := n.wire.f
+	r := f.admittedReceipt(t, "Original.INVALID")
+	source := context.WithValue(context.WithValue(f.p.ctx, profileContextKey{}, f.p), profileReceiptKey{}, r)
+	source, err := ProfileSelectRoute(source, "a", n.target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n.launch(t, source, n.target)
+	op = n.dnsTo42(t)
+	n.ack(t, op)
+	second := n.result(t)
+	if second.err != nil {
+		t.Fatal(second.err)
+	}
+	defer second.release()
+	g1, _ := first.ctx.Value(profileGrantKey{}).(*profileGrant)
+	g2, _ := second.ctx.Value(profileGrantKey{}).(*profileGrant)
+	if g1 == g2 || g1.receipt == g2.receipt || g1.numeric.waiter == g2.numeric.waiter {
+		t.Fatal("borrowed neighbor authority")
+	}
+	foreign := context.WithValue(first.ctx, profileReceiptKey{}, g2.receipt)
+	if ProfileCheckDial(foreign, first.target, false) == nil {
+		t.Fatal("foreign private receipt accepted")
+	}
+	pool1, err := ProfileTransportPool(first.ctx, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool2, err := ProfileTransportPool(second.ctx, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pool1 == pool2 {
+		t.Fatal("numeric physical identity shared sources")
+	}
+	first.release()
+	if ProfileLogicalGate(first.ctx) == nil || ProfileLogicalGate(second.ctx) != nil {
+		t.Fatal("cancel killed neighbor or revived old grant")
+	}
+}
