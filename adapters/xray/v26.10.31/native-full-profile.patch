+	for _, fault := range []string{"sourcegate", "role", "mapping", "parent", "peer", "path", "query", "credits", "memory", "history", "id-cap", "late", "cancel", "unknown", "wrong-root", "wrong-epoch", "wrong-count", "wrong-revision", "lease"} {
