diff --git a/common/yonikbroker/profile_launch.go b/common/yonikbroker/profile_launch.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_launch.go
@@ -0,0 +1,238 @@
+package nativehooks
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"errors"
+	"time"
+)
+
+const profileFrameLimit = 65536
+const profileFlowFixedCredit = 5 * 1024 * 1024
+
+var errProfile = errors.New("full-profile admission denied")
+var ErrProfileUnsupported = errors.New("full-profile operation unsupported")
+
+// Эти типы закрыты: JSON, tag и context не могут создать admission.
+type profileLaunch struct {
+	mode                    byte
+	nonce, digest, manifest [32]byte
+	session, invocation     [16]byte
+	generation, epoch       uint64
+	hostPID, workerPID      uint32
+	hostStart, workerStart  uint64
+}
+
+func profileSenderValid(r profileLaunch, pid int32, uid, localUID uint32) bool {
+	if r.mode != 1 && r.mode != 2 {
+		return false
+	}
+	expected := localUID
+	if r.mode == 2 {
+		expected = 0
+	}
+	return pid > 0 && uint32(pid) == r.hostPID && uid == expected
+}
+
+func decodeProfileLaunch(b []byte) (r profileLaunch, err error) {
+	if len(b) != 192 || u16(b, 8) != 1 || u16(b, 10) != 192 || !zero(b[14:16]) || !zero(b[184:]) {
+		return r, errProfile
+	}
+	switch string(b[:8]) {
+	case "YNKLOC01":
+		r.mode = 1
+		if u16(b, 12) != 0 || u32(b, 132) != 0 || u64(b, 144) != 0 {
+			return r, errProfile
+		}
+	case "YNKEXT01":
+		r.mode = 2
+		if u16(b, 12) != 1 || u32(b, 132) == 0 || u64(b, 144) == 0 {
+			return r, errProfile
+		}
+	default:
+		return r, errProfile
+	}
+	copy(r.nonce[:], b[16:48])
+	copy(r.digest[:], b[48:80])
+	copy(r.session[:], b[80:96])
+	copy(r.invocation[:], b[96:112])
+	copy(r.manifest[:], b[152:184])
+	r.generation = u64(b, 112)
+	r.epoch = u64(b, 120)
+	r.hostPID = u32(b, 128)
+	r.workerPID = u32(b, 132)
+	r.hostStart = u64(b, 136)
+	r.workerStart = u64(b, 144)
+	if zero(r.nonce[:]) || zero(r.digest[:]) || zero(r.session[:]) || zero(r.invocation[:]) || zero(r.manifest[:]) || r.generation == 0 || r.epoch == 0 || r.hostPID == 0 || r.hostStart == 0 {
+		return profileLaunch{}, errProfile
+	}
+	return r, nil
+}
+
+type profilePacket struct {
+	kind                    uint16
+	sequence, reply, object uint64
+	body                    []byte
+}
+
+func (r profileLaunch) decodePacket(b []byte, expected uint64) (p profilePacket, err error) {
+	if expected == 0 || len(b) < 128 || len(b) > profileFrameLimit || string(b[:8]) != "YNKCAP01" || u16(b, 8) != 1 || int(u32(b, 12)) != len(b) || u64(b, 16) != expected || !bytes.Equal(b[32:48], r.session[:]) || !bytes.Equal(b[48:64], r.invocation[:]) || !bytes.Equal(b[64:96], r.digest[:]) || u64(b, 96) != r.generation || u64(b, 104) != r.epoch || !zero(b[120:128]) {
+		return p, errProfile
+	}
+	p = profilePacket{u16(b, 10), expected, u64(b, 24), u64(b, 112), b[128:]}
+	return p, nil
+}
+func (r profileLaunch) packet(kind uint16, seq, reply uint64, body []byte) []byte {
+	b := make([]byte, 128+len(body))
+	copy(b, "YNKCAP01")
+	be.PutUint16(b[8:], 1)
+	be.PutUint16(b[10:], kind)
+	be.PutUint32(b[12:], uint32(len(b)))
+	be.PutUint64(b[16:], seq)
+	be.PutUint64(b[24:], reply)
+	copy(b[32:], r.session[:])
+	copy(b[48:], r.invocation[:])
+	copy(b[64:], r.digest[:])
+	be.PutUint64(b[96:], r.generation)
+	be.PutUint64(b[104:], r.epoch)
+	copy(b[128:], body)
+	return b
+}
+
+type profileState byte
+
+const (
+	profileAwait profileState = iota
+	profileAdmitting
+	profileAdmitted
+	profileRevoked
+	profileClosed
+	profileUnknown
+)
+
+type profileAdmission struct {
+	launch   profileLaunch
+	capsule  profileCapsule
+	state    profileState
+	deadline time.Time
+}
+
+type profileAdmissionChannel interface {
+	send(uint16, uint64, []byte) error
+	receive(time.Time) ([]byte, error)
+}
+
+func admitProfile(r profileLaunch, config []byte, ch profileAdmissionChannel, verify func(*profileCapsule) error, now func() time.Time) (a profileAdmission, err error) {
+	return admitProfileUntil(r, config, ch, verify, now, time.Time{})
+}
+func admitProfileUntil(r profileLaunch, config []byte, ch profileAdmissionChannel, verify func(*profileCapsule) error, now func() time.Time, initial time.Time) (a profileAdmission, err error) {
+	a.launch = r
+	if sha256.Sum256(config) != r.digest || ch == nil || verify == nil || now == nil {
+		return a, errProfile
+	}
+	a.state = profileAdmitting
+	sent := now()
+	deadline := sent.Add(time.Second)
+	if !initial.IsZero() && initial.Before(deadline) {
+		deadline = initial
+	}
+	if !now().Before(deadline) {
+		return a, errProfile
+	}
+	hello := make([]byte, 40)
+	copy(hello, r.nonce[:])
+	hello[32] = r.mode
+	if ch.send(1, 0, hello) != nil {
+		return a, errProfile
+	}
+	raw, e := ch.receive(deadline)
+	if e != nil {
+		return a, errProfile
+	}
+	if !now().Before(deadline) {
+		return a, errProfile
+	}
+	frame, e := r.decodePacket(raw, 1)
+	if e != nil || frame.kind != 2 || frame.reply != 1 || frame.object != 0 {
+		return a, errProfile
+	}
+	capsule, e := decodeProfileCapsule(frame.body, r)
+	if e != nil {
+		return a, errProfile
+	}
+	a.capsule = capsule
+	a.deadline = sent.Add(time.Duration(capsule.lease) * time.Millisecond)
+	if verify(&a.capsule) != nil || !now().Before(deadline) || !now().Before(a.deadline) {
+		return a, errProfile
+	}
+	ack := make([]byte, 48)
+	copy(ack, capsule.hash[:])
+	be.PutUint64(ack[32:], capsule.admission)
+	ack[40] = 1
+	if ch.send(3, 1, ack) != nil || !now().Before(a.deadline) {
+		return a, errProfile
+	}
+	a.state = profileAdmitted
+	return a, nil
+}
+
+// profileBoot — общий gate production main и pure boot-order tests.
+// Callback не вызывается ни при отсутствии proof, ни при несовпадении exact bytes.
+func profileBoot(r profileLaunch, config []byte, a *profileAdmission, create func(*profileAdmission) error) error {
+	if sha256.Sum256(config) != r.digest || a == nil || a.launch != r || a.state != profileAdmitted || !time.Now().Before(a.deadline) {
+		return errProfile
+	}
+	return create(a)
+}
+
+type profileContextKey struct{}
+
+func renewProfile(a profileAdmission, ch profileAdmissionChannel, request, expected uint64, now func() time.Time) (profileAdmission, error) {
+	if a.state != profileAdmitted || !now().Before(a.deadline) {
+		return a, errProfile
+	}
+	sent := now()
+	body := make([]byte, 40)
+	be.PutUint64(body, a.capsule.admission)
+	copy(body[8:], a.capsule.hash[:])
+	if ch.send(21, 0, body) != nil {
+		return a, errProfile
+	}
+	deadline := sent.Add(time.Second)
+	if a.deadline.Before(deadline) {
+		deadline = a.deadline
+	}
+	raw, e := ch.receive(deadline)
+	if e != nil {
+		return a, errProfile
+	}
+	frame, e := a.launch.decodePacket(raw, expected)
+	if e != nil || frame.kind != 2 || frame.reply != request || frame.object != 0 {
+		return a, errProfile
+	}
+	next, e := decodeProfileCapsulePrevious(frame.body, a.launch, a.capsule.hash)
+	if e != nil || next.admission <= a.capsule.admission || !now().Before(deadline) {
+		return a, errProfile
+	}
+	newDeadline := sent.Add(time.Duration(next.lease) * time.Millisecond)
+	if !now().Before(newDeadline) {
+		return a, errProfile
+	}
+	ack := make([]byte, 48)
+	copy(ack, next.hash[:])
+	be.PutUint64(ack[32:], next.admission)
+	ack[40] = 1
+	if ch.send(3, expected, ack) != nil || !now().Before(deadline) || !now().Before(newDeadline) {
+		return a, errProfile
+	}
+	// Immutable manifest/rows остаются теми же; renewal не удерживает новые
+	// backing buffers через будущие logical grants.
+	a.capsule.admission = next.admission
+	a.capsule.lease = next.lease
+	a.deadline = newDeadline
+	return a, nil
+}
+
+// ProfileLaunchRequested — только выбор закрытого launch path, не proof.
+// Даже один повреждённый locator запрещает fallback к legacy.
+func ProfileLaunchRequested() bool { return profileLocatorsPresent() }
diff --git a/common/yonikbroker/profile_launch_linux.go b/common/yonikbroker/profile_launch_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_launch_linux.go
@@ -0,0 +1,685 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/platform/filesystem"
+	"golang.org/x/sys/unix"
+)
+
+var profileLocatorNames = [4]string{"YONIK_PROFILE_CONTROL_FD", "YONIK_PROFILE_LAUNCH_FD", "YONIK_PROFILE_PEER_PIDFD", "YONIK_PROFILE_ASSET_ROOT_FD"}
+
+var errProfileTimeout = errors.New("full-profile channel deadline")
+
+func profileLocatorsPresent() bool {
+	for _, name := range profileLocatorNames {
+		if _, ok := os.LookupEnv(name); ok {
+			return true
+		}
+	}
+	return false
+}
+
+// ProfileRuntime не содержит FlowGrant. Constructor доступен только через
+// потребление sealed record и authenticated channel. Владение FD однократное.
+type ProfileRuntime struct {
+	proofs                      *profileProofChannel
+	proofRejected               [32]profileProofFD
+	duplicateAccepted           func(xnet.Conn, [40]byte) (profileProofFD, error)
+	transports                  *profileTransportState
+	flow                        *profileFlowControl
+	flowQueue                   chan *profileOperation
+	flowFence                   func() bool
+	mu                          sync.Mutex
+	admission                   profileAdmission
+	channel, peer, root, record *os.File
+	assets                      [16]*os.File
+	assetStamps                 [16]unix.Stat_t
+	snapshot                    *profileSnapshot
+	dnsDial                     func(context.Context, string, string) (net.Conn, error)
+	dnsID                       func() uint16
+	ctx                         context.Context
+	cancel                      context.CancelFunc
+	rx, tx                      uint64
+	closed                      bool
+	done                        chan struct{}
+}
+
+func (p *ProfileRuntime) peerAlive() error {
+	b := Bootstrap{ServerPID: p.admission.launch.hostPID, ServerStarttime: p.admission.launch.hostStart}
+	return b.CheckServer(p.peer)
+}
+
+func profileOwnedFile(f *os.File, directory bool) bool {
+	var s unix.Stat_t
+	if unix.Fstat(int(f.Fd()), &s) != nil || s.Mode&0022 != 0 || s.Uid != 0 && s.Uid != uint32(os.Geteuid()) {
+		return false
+	}
+	if directory {
+		return s.Mode&unix.S_IFMT == unix.S_IFDIR
+	}
+	return s.Mode&unix.S_IFMT == unix.S_IFREG && s.Nlink == 1
+}
+func profileSameStamp(a, b unix.Stat_t) bool { a.Atim = b.Atim; return a == b }
+
+// authenticate/receive — единственная OS boundary. Pure tests используют
+// decodePacket/decodeProfileCapsule, не вызывая proc, recvmsg или socketpair.
+func (p *ProfileRuntime) receive(deadline time.Time) ([]byte, error) {
+	for time.Now().Before(deadline) {
+		if p.peerAlive() != nil {
+			return nil, errProfile
+		}
+		fds := []unix.PollFd{{Fd: int32(p.channel.Fd()), Events: unix.POLLIN}, {Fd: int32(p.peer.Fd()), Events: unix.POLLIN}}
+		if p.proofs != nil {
+			fd, e := p.proofPollFD()
+			if e != nil {
+				return nil, e
+			}
+			fds = append(fds, unix.PollFd{Fd: int32(fd), Events: unix.POLLIN})
+		}
+		wait := time.Until(deadline)
+		if wait > 20*time.Millisecond {
+			wait = 20 * time.Millisecond
+		}
+		n, err := unix.Poll(fds, int((wait+time.Millisecond-1)/time.Millisecond))
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil || fds[1].Revents != 0 {
+			return nil, errProfile
+		}
+		if n == 0 {
+			continue
+		}
+		if len(fds) == 3 && fds[2].Revents != 0 {
+			if fds[2].Revents&unix.POLLIN != 0 {
+				p.rejectProofInput()
+			}
+			return nil, errProfile
+		}
+		if fds[0].Revents&unix.POLLIN == 0 {
+			return nil, errProfile
+		}
+		// Fixed bounded RX/ancillary allocation; received rights никогда не принимаются.
+		b := make([]byte, profileFrameLimit)
+		oob := make([]byte, unix.CmsgSpace(16*4)+unix.CmsgSpace(unix.SizeofUcred))
+		size, control, flags, _, err := unix.Recvmsg(int(p.channel.Fd()), b, oob, unix.MSG_DONTWAIT|unix.MSG_CMSG_CLOEXEC)
+		if size < 0 {
+			size = 0
+		}
+		if size > len(b) {
+			size = len(b)
+			flags |= unix.MSG_TRUNC
+		}
+		packet := profileParseAncillary(b[:size], oob[:control], flags, profileAdoptFD)
+		if packet.count != 0 {
+			p.rejectRights(packet)
+			return nil, errProfile
+		}
+		if err != nil || size < 128 || packet.invalid || packet.credentials != 1 || !profileSenderValid(p.admission.launch, packet.pid, packet.uid, uint32(os.Geteuid())) || p.peerAlive() != nil {
+			return nil, errProfile
+		}
+		return b[:size], nil
+	}
+	return nil, errProfileTimeout
+}
+func (p *ProfileRuntime) send(kind uint16, reply uint64, body []byte) error {
+	return p.sendObject(kind, reply, 0, body)
+}
+func (p *ProfileRuntime) sendObject(kind uint16, reply, object uint64, body []byte) error {
+	if p.tx == ^uint64(0) || kind == 16 && p.admission.launch.mode == 2 && p.tx >= ^uint64(0)-1 || p.peerAlive() != nil || kind == 3 && p.admission.state != profileAdmitted && !p.channelClear() {
+		return errProfile
+	}
+	p.tx++
+	b := p.admission.launch.packet(kind, p.tx, reply, body)
+	be.PutUint64(b[112:], object)
+	n, err := unix.SendmsgN(int(p.channel.Fd()), b, nil, nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+	if err != nil || n != len(b) {
+		return errProfile
+	}
+	return nil
+}
+
+func (p *ProfileRuntime) verifyAssets() error {
+	m := &p.admission.capsule
+	for i := 0; i < m.assetCount; i++ {
+		if p.peerAlive() != nil || !p.channelClear() {
+			return errProfile
+		}
+		a := m.assets[i]
+		name := "r-" + hex.EncodeToString(a.digest[:]) + ".dat"
+		if a.dns {
+			name = "dns-" + hex.EncodeToString(a.digest[:]) + ".bin"
+		}
+		fd, err := unix.Openat(int(p.root.Fd()), name, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_NONBLOCK, 0)
+		if err != nil {
+			return errProfile
+		}
+		f := os.NewFile(uintptr(fd), "profile-asset")
+		p.assets[i] = f
+		var before, after unix.Stat_t
+		if !profileOwnedFile(f, false) || unix.Fstat(fd, &before) != nil || before.Size < 0 || uint64(before.Size) != a.size {
+			return errProfile
+		}
+		h := sha256.New()
+		if a.dns {
+			// Только snapshot <=2MiB materializes; DAT хешируется bounded streaming.
+			data, err := io.ReadAll(io.LimitReader(f, int64(a.size)+1))
+			if err != nil || uint64(len(data)) != a.size {
+				return errProfile
+			}
+			h.Write(data)
+			if p.snapshot, err = decodeProfileSnapshot(data, a); err != nil {
+				return errProfile
+			}
+		} else {
+			n, err := io.CopyBuffer(h, io.LimitReader(f, int64(a.size)+1), make([]byte, 32768))
+			if err != nil || uint64(n) != a.size {
+				return errProfile
+			}
+			if verifyProfileDAT(f, a, m) != nil {
+				return errProfile
+			}
+		}
+		var actual [32]byte
+		copy(actual[:], h.Sum(nil))
+		if actual != a.digest || unix.Fstat(fd, &after) != nil || !profileSameStamp(before, after) {
+			return errProfile
+		}
+		p.assetStamps[i] = after
+	}
+	if p.snapshot != nil && !p.snapshot.validatesResolvers(m) {
+		return errProfile
+	}
+	return nil
+}
+
+func openProfileRuntime(config []byte) (p *ProfileRuntime, err error) {
+	p = &ProfileRuntime{done: make(chan struct{})}
+	p.ctx, p.cancel = context.WithCancel(context.Background())
+	success := false
+	defer func(runtime *ProfileRuntime) {
+		if !success {
+			_ = runtime.closeFiles()
+		}
+	}(p)
+	var files [4]*os.File
+	var numbers [4]int
+	for i, name := range profileLocatorNames {
+		raw, ok := os.LookupEnv(name)
+		n, e := strconv.ParseUint(raw, 10, 31)
+		if !ok || e != nil || n < 3 || strconv.FormatUint(n, 10) != raw {
+			return nil, errProfile
+		}
+		numbers[i] = int(n)
+		for j := 0; j < i; j++ {
+			if numbers[j] == numbers[i] {
+				return nil, errProfile
+			}
+		}
+	}
+	// При ошибке после этой точки runtime закрывает все потреблённые FD.
+	for i, n := range numbers {
+		unix.CloseOnExec(n)
+		files[i] = os.NewFile(uintptr(n), "profile-owned")
+	}
+	p.channel, p.record, p.peer, p.root = files[0], files[1], files[2], files[3]
+	for _, entry := range os.Environ() {
+		name, value, _ := strings.Cut(entry, "=")
+		allowed := name == "LANG" && value == "C"
+		for _, locator := range profileLocatorNames {
+			allowed = allowed || name == locator
+		}
+		if !allowed {
+			return nil, errProfile
+		}
+	}
+	seals, e := unix.FcntlInt(p.record.Fd(), unix.F_GET_SEALS, 0)
+	mandatory := unix.F_SEAL_SEAL | unix.F_SEAL_SHRINK | unix.F_SEAL_GROW | unix.F_SEAL_WRITE
+	var s unix.Stat_t
+	if e != nil || seals&mandatory != mandatory || unix.Fstat(int(p.record.Fd()), &s) != nil || s.Mode&unix.S_IFMT != unix.S_IFREG || s.Size != 192 {
+		return nil, errProfile
+	}
+	record := make([]byte, 192)
+	if _, e = p.record.ReadAt(record, 0); e != nil {
+		return nil, errProfile
+	}
+	r, e := decodeProfileLaunch(record)
+	if e != nil || sha256.Sum256(config) != r.digest {
+		return nil, errProfile
+	}
+	p.admission.launch = r
+	if r.mode == 2 {
+		self := Bootstrap{ServerPID: r.workerPID, ServerStarttime: r.workerStart}
+		// pidfd на самого child создаётся только для локальной проверки record binding.
+		// Никакого вызова в pure tests.
+		if uint32(os.Getpid()) != self.ServerPID {
+			return nil, errProfile
+		}
+		fd, e := unix.PidfdOpen(os.Getpid(), 0)
+		if e != nil {
+			return nil, errProfile
+		}
+		f := os.NewFile(uintptr(fd), "profile-self")
+		e = self.CheckServer(f)
+		_ = f.Close()
+		if e != nil {
+			return nil, errProfile
+		}
+	}
+	kind, e := unix.GetsockoptInt(int(p.channel.Fd()), unix.SOL_SOCKET, unix.SO_TYPE)
+	if e != nil || kind != unix.SOCK_SEQPACKET || p.peerAlive() != nil || !profileOwnedFile(p.root, true) {
+		return nil, errProfile
+	}
+	if unix.SetsockoptInt(int(p.channel.Fd()), unix.SOL_SOCKET, unix.SO_PASSCRED, 1) != nil {
+		return nil, errProfile
+	}
+	initialDeadline := time.Now().Add(time.Second)
+	if r.mode == 2 {
+		p.proofs = &profileProofChannel{}
+		if e = p.proofs.bootstrap(r, p, initialDeadline, time.Now); e != nil {
+			return nil, e
+		}
+		p.proofs.peer = p.proofPeerAlive
+		p.proofs.check = p.proofHealth
+		p.proofs.send = p.sendSocketProof
+	}
+	a, e := admitProfileUntil(r, config, p, func(m *profileCapsule) error { p.admission.capsule = *m; return p.verifyAssets() }, time.Now, initialDeadline)
+	if e != nil {
+		return nil, errProfile
+	}
+	p.rx = 1
+	p.admission = a
+	p.flowQueue = make(chan *profileOperation, 64)
+	p.flow = newProfileFlowControl(a.capsule, a.launch.mode, time.Now, func(kind uint16, object uint64, body []byte) (uint64, error) {
+		e := p.sendObject(kind, 0, object, body)
+		return p.tx, e
+	}, func() bool {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		return !p.closed && p.ctx.Err() == nil && p.admission.state == profileAdmitted && time.Now().Before(p.admission.deadline)
+	})
+	p.flow.reply = p.send
+	if p.proofs != nil {
+		p.flow.prepareProof = p.proofs.prepare
+		p.flow.sendProof = p.proofs.sendOpen
+		p.flow.proofAlive = p.proofs.live
+	}
+	p.flow.sessionDeadline = a.deadline
+	p.flowFence = p.fresh
+	profileResolverClosed.Store(true)
+	// Existing native DAT loader получает только retained controlled root.
+	// Никакой provider path или унаследованный XRAY_LOCATION_ASSET не принимается.
+	if os.Setenv("XRAY_LOCATION_ASSET", "/proc/self/fd/"+strconv.Itoa(int(p.root.Fd()))) != nil {
+		return nil, errProfile
+	}
+	rootName := "/proc/self/fd/" + strconv.Itoa(int(p.root.Fd()))
+	manifest := p.admission.capsule
+	filesystem.NewFileReader = func(path string) (io.ReadCloser, error) {
+		index := profileAssetPath(path, rootName, &manifest)
+		if index < 0 || p.ctx.Err() != nil {
+			return nil, errProfile
+		}
+		a := manifest.assets[index]
+		return &profileAssetReader{runtime: p, reader: io.NewSectionReader(p.assets[index], 0, int64(a.size))}, nil
+	}
+	success = true
+	go p.monitor()
+	return p, nil
+}
+
+type profileAssetReader struct {
+	runtime *ProfileRuntime
+	reader  *io.SectionReader
+	closed  bool
+}
+
+func (r *profileAssetReader) Read(b []byte) (int, error) {
+	if r.closed || r.runtime.ctx.Err() != nil {
+		return 0, errProfile
+	}
+	return r.reader.Read(b)
+}
+func (r *profileAssetReader) Close() error { r.closed = true; return nil }
+
+func (p *ProfileRuntime) monitor() {
+	defer close(p.done)
+	defer func() {
+		p.mu.Lock()
+		if !p.closed && p.admission.state != profileUnknown {
+			p.admission.state = profileRevoked
+		}
+		p.cancel()
+		p.mu.Unlock()
+		if p.flow != nil {
+			p.flow.revoke()
+			if e := p.flow.closeAcceptedProofs(); e != nil {
+				p.mu.Lock()
+				p.admission.state = profileUnknown
+				p.mu.Unlock()
+			}
+			if p.proofs != nil {
+				if e := p.proofs.Close(); e != nil {
+					p.mu.Lock()
+					p.admission.state = profileUnknown
+					p.mu.Unlock()
+				}
+			}
+			for {
+				select {
+				case op := <-p.flowQueue:
+					p.flow.mu.Lock()
+					p.flow.finish(op, errProfile)
+					p.flow.mu.Unlock()
+				default:
+					return
+				}
+			}
+		}
+	}()
+	var renewRequest uint64
+	var renewSent, renewDeadline time.Time
+	for {
+		if p.flow != nil {
+			for n := 0; n < 64; n++ {
+				select {
+				case op := <-p.flowQueue:
+					if p.flow.dispatch(op) != nil {
+						return
+					}
+				default:
+					n = 64
+				}
+			}
+			if p.flow.tick() != nil {
+				return
+			}
+		}
+		p.mu.Lock()
+		a := p.admission
+		closed := p.closed
+		p.mu.Unlock()
+		now := time.Now()
+		if closed || p.ctx.Err() != nil || !now.Before(a.deadline) {
+			return
+		}
+		lead := time.Duration(a.capsule.lease) * time.Millisecond / 2
+		if lead > 20*time.Second {
+			lead = 20 * time.Second
+		}
+		if renewRequest == 0 && !now.Before(a.deadline.Add(-lead)) {
+			body := make([]byte, 40)
+			be.PutUint64(body, a.capsule.admission)
+			copy(body[8:], a.capsule.hash[:])
+			renewSent = now
+			renewDeadline = now.Add(time.Second)
+			if a.deadline.Before(renewDeadline) {
+				renewDeadline = a.deadline
+			}
+			if p.send(21, 0, body) != nil {
+				return
+			}
+			renewRequest = p.tx
+		}
+		if renewRequest != 0 && !now.Before(renewDeadline) {
+			return
+		}
+		wait := now.Add(10 * time.Millisecond)
+		if a.deadline.Before(wait) {
+			wait = a.deadline
+		}
+		if renewRequest != 0 && renewDeadline.Before(wait) {
+			wait = renewDeadline
+		}
+		raw, e := p.receive(wait)
+		if e == errProfileTimeout {
+			continue
+		}
+		if e != nil {
+			return
+		}
+		frame, e := a.launch.decodePacket(raw, p.rx+1)
+		if e != nil {
+			return
+		}
+		p.rx++
+		if frame.kind == 33 {
+			if frame.reply != 0 || frame.object != 0 || len(frame.body) != 8 || !zero(frame.body[2:]) {
+				return
+			}
+			p.flow.revoke()
+			p.mu.Lock()
+			if !p.closed && p.admission.state != profileUnknown {
+				p.admission.state = profileRevoked
+			}
+			p.cancel()
+			p.mu.Unlock()
+			ack := make([]byte, 12)
+			ack[0] = 4
+			ack[1] = 3
+			_ = p.send(34, frame.sequence, ack)
+			return
+		}
+		if frame.kind == 2 {
+			if renewRequest == 0 || frame.reply != renewRequest || frame.object != 0 {
+				return
+			}
+			next, e := decodeProfileCapsulePrevious(frame.body, a.launch, a.capsule.hash)
+			now = time.Now()
+			if e != nil || next.admission <= a.capsule.admission || !now.Before(renewDeadline) {
+				return
+			}
+			nextDeadline := renewSent.Add(time.Duration(next.lease) * time.Millisecond)
+			if !now.Before(nextDeadline) {
+				return
+			}
+			ack := make([]byte, 48)
+			copy(ack, next.hash[:])
+			be.PutUint64(ack[32:], next.admission)
+			ack[40] = 1
+			if p.send(3, frame.sequence, ack) != nil || !time.Now().Before(renewDeadline) {
+				return
+			}
+			p.mu.Lock()
+			if p.closed || p.ctx.Err() != nil {
+				p.mu.Unlock()
+				return
+			}
+			p.admission.capsule.admission = next.admission
+			p.admission.capsule.lease = next.lease
+			p.admission.deadline = nextDeadline
+			p.mu.Unlock()
+			renewRequest = 0
+			p.flow.mu.Lock()
+			p.flow.sessionDeadline = nextDeadline
+			p.flow.mu.Unlock()
+			continue
+		}
+		if p.flow == nil || p.flow.accept(frame) != nil {
+			return
+		}
+	}
+}
+func (p *ProfileRuntime) closeFiles() error {
+	if p.cancel != nil {
+		p.cancel()
+	}
+	var first error
+	if p.proofs != nil {
+		first = p.proofs.Close()
+	}
+	if p.flow != nil {
+		if e := p.flow.closeAcceptedProofs(); e != nil && first == nil {
+			first = e
+		}
+	}
+	for _, fd := range p.proofRejected {
+		if fd != nil {
+			if e := fd.Close(); e != nil && first == nil {
+				first = e
+			}
+		}
+	}
+	closeOne := func(f *os.File) {
+		if f != nil {
+			if e := f.Close(); e != nil && first == nil {
+				first = e
+			}
+		}
+	}
+	for _, f := range p.assets {
+		closeOne(f)
+	}
+	closeOne(p.channel)
+	closeOne(p.peer)
+	closeOne(p.root)
+	closeOne(p.record)
+	return first
+}
+func (p *ProfileRuntime) Close() error {
+	if p == nil || p.ctx == nil {
+		return nil
+	}
+	p.mu.Lock()
+	if p.admission.state == profileUnknown {
+		p.mu.Unlock()
+		return errProfile
+	}
+	if p.closed {
+		p.mu.Unlock()
+		return nil
+	}
+	p.closed = true
+	p.admission.state = profileClosed
+	p.cancel()
+	_ = unix.Shutdown(int(p.channel.Fd()), unix.SHUT_RDWR)
+	p.mu.Unlock()
+	<-p.done
+	if err := p.closeTransports(); err != nil {
+		p.mu.Lock()
+		p.admission.state = profileUnknown
+		p.mu.Unlock()
+		return err
+	}
+	err := p.closeFiles()
+	if err != nil {
+		p.mu.Lock()
+		p.admission.state = profileUnknown
+		p.mu.Unlock()
+	}
+	return err
+}
+
+// RevokeUnknown удерживает asset/root/pidfd custody при неподтверждённом
+// feature cleanup. Parent освобождает run только после actual child reap.
+func (p *ProfileRuntime) Revoke()        { p.revoke(false) }
+func (p *ProfileRuntime) RevokeUnknown() { p.revoke(true) }
+func (p *ProfileRuntime) revoke(unknown bool) {
+	if p == nil || p.ctx == nil {
+		return
+	}
+	p.mu.Lock()
+	if p.closed {
+		p.mu.Unlock()
+		return
+	}
+	if unknown {
+		p.admission.state = profileUnknown
+	} else if p.admission.state != profileUnknown {
+		p.admission.state = profileRevoked
+	}
+	p.cancel()
+	_ = unix.Shutdown(int(p.channel.Fd()), unix.SHUT_RDWR)
+	p.mu.Unlock()
+	<-p.done
+	if p.closeTransports() != nil {
+		p.mu.Lock()
+		p.admission.state = profileUnknown
+		p.mu.Unlock()
+	}
+}
+
+// Start повторяет fence непосредственно перед feature Start, сохраняя закрытый
+// runtime до Close. Этот вызов не даёт transport/socket authority.
+func (p *ProfileRuntime) Start(start func() error) error {
+	if p == nil || p.ctx == nil || start == nil {
+		return errProfile
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !p.fresh() {
+		return errProfile
+	}
+	err := start()
+	if err != nil {
+		p.admission.state = profileUnknown
+		p.cancel()
+		_ = unix.Shutdown(int(p.channel.Fd()), unix.SHUT_RDWR)
+	}
+	return err
+}
+func (p *ProfileRuntime) Done() <-chan struct{} { return p.ctx.Done() }
+func (p *ProfileRuntime) fresh() bool {
+	if p.closed || p.ctx.Err() != nil || p.peerAlive() != nil || p.admission.state != profileAdmitted || !time.Now().Before(p.admission.deadline) {
+		return false
+	}
+	if p.admission.launch.mode == 2 && (p.proofs == nil || !p.proofs.live()) {
+		return false
+	}
+	for i, f := range p.assets {
+		if f != nil {
+			var stamp unix.Stat_t
+			if unix.Fstat(int(f.Fd()), &stamp) != nil || !profileSameStamp(stamp, p.assetStamps[i]) {
+				return false
+			}
+		}
+	}
+	return p.channelClear()
+}
+func (p *ProfileRuntime) channelClear() bool {
+	fds := []unix.PollFd{{Fd: int32(p.channel.Fd()), Events: unix.POLLIN}}
+	n, e := unix.Poll(fds, 0)
+	return e == nil && n == 0
+}
+
+// PrepareProfileLaunch вызывается main ДО core.NewWithContext. Check-only
+// категорически не потребляет Run admission и не вызывает factory.
+func PrepareProfileLaunch(config []byte, checkOnly bool, create func(context.Context) error) (*ProfileRuntime, error) {
+	if checkOnly || len(config) == 0 || len(config) > 65536 {
+		return nil, errProfile
+	}
+	p, err := openProfileRuntime(config)
+	if err != nil {
+		return nil, err
+	}
+	p.mu.Lock()
+	if !p.fresh() {
+		err = errProfile
+	} else {
+		err = profileBoot(p.admission.launch, config, &p.admission, func(*profileAdmission) error { return create(context.WithValue(p.ctx, profileContextKey{}, p)) })
+		if err == nil && !p.fresh() {
+			err = errProfile
+		}
+	}
+	p.mu.Unlock()
+	if err != nil {
+		// Constructor мог частично создать features. Их cleanup здесь не доказан;
+		// custody остаётся у child до stop/reap, никаких новых grants нет.
+		p.RevokeUnknown()
+		return p, err
+	}
+	return p, nil
+}
