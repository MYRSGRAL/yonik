+//go:build linux
+
+package nativehooks
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestProfileUDPActorNamespaceBindingBeforeFactoryAndPublication(t *testing.T) {
+	for _, tc := range []struct {
+		name                                                         string
+		control, relay                                               uint64
+		controlError, relayError                                     error
+		missing, missingControl, missingGuard, closeFailure, allowed bool
+	}{
+		{name: "matching", control: 41, relay: 41, allowed: true},
+		{name: "matching-opaque-max", control: ^uint64(0), relay: ^uint64(0), allowed: true},
+		{name: "foreign-netns-same-UAC-cookie", control: 41, relay: 42},
+		{name: "zero-control", relay: 41},
+		{name: "zero-relay", control: 41},
+		{name: "both-zero"},
+		{name: "control-error", control: 41, relay: 41, controlError: errProfile},
+		{name: "relay-error", control: 41, relay: 41, relayError: errProfile},
+		{name: "missing-proof-reader", missing: true},
+		{name: "missing-namespace-guard", missingGuard: true},
+		{name: "missing-actual-control", missingControl: true},
+		{name: "foreign-netns-close-error", control: 41, relay: 42, closeFailure: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f, a, accepted := udpActorFixture(t)
+			control := &proofFakeFD{}
+			accepted.proof = control
+			r, e := a.submit(f.p.ctx, accepted)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if e = a.tick(); e != nil {
+				t.Fatal(e)
+			}
+			if e = a.receive(func() (profileProofPacket, error) { return udpActorPacket(t, a, r, false, nil), nil }); e != nil {
+				t.Fatal(e)
+			}
+			if e = a.tick(); e != nil {
+				t.Fatal(e)
+			}
+			relay := &proofFakeFD{}
+			if tc.closeFailure {
+				relay.result = errProfile
+			}
+			calls, factories := 0, 0
+			read := func(fd profileProofFD) (uint64, error) {
+				calls++
+				switch fd {
+				case control:
+					return tc.control, tc.controlError
+				case relay:
+					return tc.relay, tc.relayError
+				default:
+					t.Fatal("namespace read from a foreign object")
+					return 0, errProfile
+				}
+			}
+			if tc.missing {
+				read = nil
+			}
+			a.namespace = func(actualControl, actualRelay profileProofFD) error {
+				if actualControl != accepted.proof || actualRelay != relay {
+					t.Fatal("actor substituted namespace anchor")
+				}
+				return profileRequireSameSocketNamespace(actualControl, actualRelay, read)
+			}
+			if tc.missingGuard {
+				a.namespace = nil
+			}
+			a.inspect = func(actual profileProofFD, _ []byte) (profileUDPReceiver, error) {
+				factories++
+				return &udpActorOwnedReceiver{profileUDPReceiver: &udpReceiveFake{}, fd: actual}, nil
+			}
+			if tc.missingControl {
+				accepted.proof = nil
+			}
+			e = a.receive(func() (profileProofPacket, error) { return udpActorPacket(t, a, r, true, relay), nil })
+			handle := &ProfileUDPControl{actor: a, request: r}
+			endpoint, endpointError := handle.Endpoint()
+			if tc.allowed {
+				if e != nil || factories != 1 || calls != 2 || r.association == nil || endpointError != nil || endpoint.Port != 49152 {
+					t.Fatal("matching kernel namespace rejected", e, factories, calls)
+				}
+				r.association.CloseAndJoin()
+			} else {
+				if e == nil || factories != 0 || r.association != nil || endpointError == nil || relay.calls != 1 || control.calls != 0 || f.p.admission.state != profileUnknown {
+					t.Fatal("unbound relay reached factory/SOCKS endpoint or lost custody", e, factories, calls)
+				}
+				if tc.closeFailure && (a.rejected[0] != relay || a.fdCredits != 6 || f.c.dnsFDUsed != profileRXFD || !f.c.rxLeased || !f.c.dnsScratchUnknown) {
+					t.Fatal("Unknown FD custody/credit lost")
+				}
+			}
+		})
+	}
+}
+
+func TestProfileUDPNamespaceProofRequiresLiveHandlesAndKernelReader(t *testing.T) {
+	first, second := &proofFakeFD{}, &proofFakeFD{}
+	reader := func(fd profileProofFD) (value uint64, e error) {
+		e = fd.withFD(func(int) error { value = 17; return nil })
+		return
+	}
+	if e := profileRequireSameSocketNamespace(nil, second, reader); e == nil {
+		t.Fatal("missing control proof accepted")
+	}
+	if e := profileRequireSameSocketNamespace(first, nil, reader); e == nil {
+		t.Fatal("missing relay proof accepted")
+	}
+	if e := profileRequireSameSocketNamespace(first, second, nil); e == nil {
+		t.Fatal("missing kernel reader accepted")
+	}
+	first.Close()
+	if e := profileRequireSameSocketNamespace(first, second, reader); e == nil {
+		t.Fatal("closed source handle accepted")
+	}
+	first = &proofFakeFD{}
+	second.Close()
+	if e := profileRequireSameSocketNamespace(first, second, reader); e == nil {
+		t.Fatal("closed delivered handle accepted")
+	}
+	if e := profileRequireSameSocketNamespace(first, second, reader); !errors.Is(e, ErrProfileUnsupported) {
+		t.Fatal("proof error lacks typed closed denial", e)
+	}
+}
diff --git a/common/yonikbroker/profile_udp_os_linux.go b/common/yonikbroker/profile_udp_os_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_udp_os_linux.go
@@ -0,0 +1,360 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"sync"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Kernel namespace обоих retained socket handles; wire cookie/SO_COOKIE и
+// namespace текущей goroutine здесь не являются proof. Linux adc218676eef:
+// sk_getsockopt(SO_NETNS_COOKIE) читает written-once sock_net(sk)->net_cookie.
+func profileRequireSameSocketNamespace(control, relay profileProofFD, read func(profileProofFD) (uint64, error)) error {
+	if control == nil || relay == nil || read == nil {
+		return ErrProfileUnsupported
+	}
+	source, e := read(control)
+	if e != nil || source == 0 {
+		return errors.Join(ErrProfileUnsupported, e)
+	}
+	delivered, e := read(relay)
+	if e != nil || delivered == 0 || delivered != source {
+		return errors.Join(ErrProfileUnsupported, e)
+	}
+	return nil
+}
+func profileKernelSocketNamespace(control, relay profileProofFD) error {
+	return profileRequireSameSocketNamespace(control, relay, func(handle profileProofFD) (value uint64, err error) {
+		err = handle.withFD(func(n int) error {
+			var e error
+			value, e = unix.GetsockoptUint64(n, unix.SOL_SOCKET, unix.SO_NETNS_COOKIE)
+			return e
+		})
+		return
+	})
+}
+
+// Только consuming duplicate; нет Write/FD getter/Peek/child factory API.
+type profileOSUDPReceiver struct {
+	namespace       func() error
+	mu              sync.Mutex
+	fd              profileProofFD
+	bound           profileDestinationValue
+	cookie          uint64
+	closed, reading bool
+	result          error
+	readers         sync.WaitGroup
+}
+
+type profileUDPResponseOps struct {
+	validate func() error
+	wait     func(context.Context) error
+	send     func([]byte, [40]byte) (int, error)
+}
+
+var errProfileUDPResponseUncertain = errors.New("profile UDP response effect unknown")
+var errProfileUDPNamespace = errors.New("profile UDP namespace proof unavailable")
+
+// Retry допустим только для доказанного no-effect EAGAIN sentinel.
+func profileSendUDPResponse(ctx context.Context, frame []byte, tuple [40]byte, gate func() error, ops profileUDPResponseOps) error {
+	if ctx == nil || gate == nil || ops.validate == nil || ops.wait == nil || ops.send == nil || len(frame) > 65507 || !profileUDPv2Tuple(tuple, 17) {
+		return errProfile
+	}
+	for {
+		if e := ctx.Err(); e != nil {
+			return e
+		}
+		if e := gate(); e != nil {
+			return e
+		}
+		if e := ops.validate(); e != nil {
+			return errors.Join(errProfileUDPNamespace, e)
+		}
+		n, e := ops.send(frame, tuple)
+		if e == errProfileProofBusy && n == 0 {
+			if e = ops.wait(ctx); e != nil {
+				return e
+			}
+			continue
+		}
+		if n == 0 && (errors.Is(e, context.Canceled) || errors.Is(e, context.DeadlineExceeded) || e == errProfileProofCancelled) {
+			return e
+		}
+		if e != nil || n != len(frame) {
+			return errors.Join(errProfileUDPResponseUncertain, e)
+		}
+		return nil
+	}
+}
+func (r *profileOSUDPReceiver) sendResponse(ctx context.Context, frame []byte, tuple [40]byte, gate func() error) error {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return errProfile
+	}
+	r.readers.Add(1)
+	r.mu.Unlock()
+	defer r.readers.Done()
+	validate := func() error {
+		if r.namespace == nil || r.namespace() != nil {
+			return ErrProfileUnsupported
+		}
+		return r.fd.withFD(r.inspect)
+	}
+	return profileSendUDPResponse(ctx, frame, tuple, gate, profileUDPResponseOps{
+		validate: validate,
+		wait: func(ctx context.Context) error {
+			return r.fd.withFD(func(n int) error {
+				if ctx.Err() != nil {
+					return ctx.Err()
+				}
+				fds := [1]unix.PollFd{{Fd: int32(n), Events: unix.POLLOUT}}
+				_, e := unix.Poll(fds[:], 20)
+				if e != nil || fds[0].Revents & ^int16(unix.POLLOUT) != 0 {
+					return errProfile
+				}
+				return ctx.Err()
+			})
+		},
+		send: func(b []byte, t [40]byte) (size int, err error) {
+			err = r.fd.withFD(func(n int) error {
+				if e := ctx.Err(); e != nil {
+					return e
+				}
+				if gate() != nil {
+					return errProfileProofCancelled
+				}
+				var address [4]byte
+				copy(address[:], t[8:12])
+				var e error
+				size, e = unix.SendmsgN(n, b, nil, &unix.SockaddrInet4{Addr: address, Port: int(u16(t[:], 4))}, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+				if (e == unix.EAGAIN || e == unix.EWOULDBLOCK) && size <= 0 {
+					size = 0
+					return errProfileProofBusy
+				}
+				return e
+			})
+			return
+		},
+	})
+}
+
+func profileInspectUDP(fd profileProofFD, delivery []byte) (profileUDPReceiver, error) {
+	r := &profileOSUDPReceiver{fd: fd, bound: profileDestinationValue{family: 4, network: 17, address: "127.0.0.1", port: u16(delivery, 164)}, cookie: u64(delivery, 152)}
+	e := fd.withFD(func(n int) error {
+		kind, e := unix.GetsockoptInt(n, unix.SOL_SOCKET, unix.SO_TYPE)
+		if e != nil || kind != unix.SOCK_DGRAM {
+			return errProfile
+		}
+		proto, e := unix.GetsockoptInt(n, unix.SOL_SOCKET, unix.SO_PROTOCOL)
+		if e != nil || proto != unix.IPPROTO_UDP {
+			return errProfile
+		}
+		flags, e := unix.FcntlInt(uintptr(n), unix.F_GETFD, 0)
+		if e != nil || flags&unix.FD_CLOEXEC == 0 {
+			return errProfile
+		}
+		flags, e = unix.FcntlInt(uintptr(n), unix.F_GETFL, 0)
+		if e != nil || flags&unix.O_NONBLOCK == 0 {
+			return errProfile
+		}
+		_, e = unix.Getpeername(n)
+		if e != unix.ENOTCONN {
+			return errProfile
+		}
+		return r.inspect(n)
+	})
+	if e != nil {
+		return nil, e
+	}
+	return r, nil
+}
+func (r *profileOSUDPReceiver) inspect(n int) error {
+	cookie, e := unix.GetsockoptUint64(n, unix.SOL_SOCKET, unix.SO_COOKIE)
+	if e != nil || cookie != r.cookie {
+		return errProfile
+	}
+	sa, e := unix.Getsockname(n)
+	v, ok := sa.(*unix.SockaddrInet4)
+	if e != nil || !ok || v.Addr != [4]byte{127, 0, 0, 1} || v.Port != int(r.bound.port) {
+		return errProfile
+	}
+	queue, e := unix.GetsockoptInt(n, unix.SOL_SOCKET, unix.SO_RCVBUF)
+	if e != nil || queue < 1 || queue > 128*1024 {
+		return errProfile
+	}
+	gro, e := unix.GetsockoptInt(n, unix.IPPROTO_UDP, unix.UDP_GRO)
+	if e != nil || gro != 0 {
+		return errProfile
+	}
+	overflow, e := unix.GetsockoptInt(n, unix.SOL_SOCKET, unix.SO_RXQ_OVFL)
+	if e != nil || overflow != 1 {
+		return errProfile
+	}
+	return nil
+}
+func (r *profileOSUDPReceiver) Receive(ctx context.Context, b []byte) (out profileUDPReceiveResult, err error) {
+	r.mu.Lock()
+	if r.closed || r.reading || ctx == nil || len(b) != 65536 {
+		r.mu.Unlock()
+		return out, errProfile
+	}
+	r.reading = true
+	r.readers.Add(1)
+	r.mu.Unlock()
+	defer func() { r.mu.Lock(); r.reading = false; r.mu.Unlock(); r.readers.Done() }()
+	for ctx.Err() == nil {
+		ready := false
+		err = r.fd.withFD(func(n int) error {
+			if e := r.inspect(n); e != nil {
+				return e
+			}
+			fds := [1]unix.PollFd{{Fd: int32(n), Events: unix.POLLIN}}
+			wait := 20
+			if d, ok := ctx.Deadline(); ok {
+				left := time.Until(d)
+				if left <= 0 {
+					return context.DeadlineExceeded
+				}
+				if left < 20*time.Millisecond {
+					wait = int((left + time.Millisecond - 1) / time.Millisecond)
+				}
+			}
+			count, e := unix.Poll(fds[:], wait)
+			if e == unix.EINTR {
+				return nil
+			}
+			if e != nil || fds[0].Revents & ^int16(unix.POLLIN) != 0 {
+				return errProfile
+			}
+			if count == 0 {
+				return nil
+			}
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			var oob [64]byte
+			size, control, flags, from, e := unix.Recvmsg(n, b, oob[:], unix.MSG_DONTWAIT|unix.MSG_TRUNC)
+			if e == unix.EAGAIN || e == unix.EWOULDBLOCK {
+				return nil
+			}
+			if e != nil || size <= 0 || size > 65507 || flags != 0 {
+				return errProfile
+			}
+			peer, ok := from.(*unix.SockaddrInet4)
+			if !ok || peer.Port <= 0 {
+				return errProfile
+			}
+			out.n = size
+			out.cookie = r.cookie
+			out.bound = r.bound
+			out.tuple[0], out.tuple[1] = 17, 4
+			be.PutUint16(out.tuple[4:], uint16(peer.Port))
+			be.PutUint16(out.tuple[6:], r.bound.port)
+			copy(out.tuple[8:12], peer.Addr[:])
+			copy(out.tuple[24:28], []byte{127, 0, 0, 1})
+			seen := false
+			for rest := oob[:control]; len(rest) > 0; {
+				h, data, next, e := unix.ParseOneSocketControlMessage(rest)
+				if e != nil || seen || h.Level != unix.SOL_SOCKET || h.Type != unix.SO_RXQ_OVFL || len(data) != 4 {
+					return errProfile
+				}
+				out.overflow = binary.NativeEndian.Uint32(data)
+				seen = true
+				rest = next
+			}
+			out.queueBytes, e = unix.GetsockoptInt(n, unix.SOL_SOCKET, unix.SO_RCVBUF)
+			if e != nil {
+				return e
+			}
+			if e = r.inspect(n); e != nil {
+				return e
+			}
+			ready = true
+			return nil
+		})
+		if err != nil || ready {
+			return out, err
+		}
+	}
+	return out, ctx.Err()
+}
+func (r *profileOSUDPReceiver) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if !r.closed {
+		r.closed = true
+		r.result = r.fd.Close()
+	}
+	return r.result
+}
+func (r *profileOSUDPReceiver) Join() error {
+	r.mu.Lock()
+	closed := r.closed
+	r.mu.Unlock()
+	if !closed {
+		return errProfile
+	}
+	r.readers.Wait()
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.result
+}
+
+func (p *ProfileRuntime) sendUDPProof(body []byte, fd profileProofFD) error {
+	return p.proofs.fd.withFD(func(channel int) error {
+		send := func(rights []byte) error {
+			if p.peerAlive() != nil {
+				return errProfile
+			}
+			n, e := unix.SendmsgN(channel, body, rights, nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+			if e == unix.EAGAIN || e == unix.EWOULDBLOCK {
+				return errProfileProofBusy
+			}
+			if e != nil || n != len(body) {
+				return errProfile
+			}
+			return nil
+		}
+		if fd == nil {
+			return send(nil)
+		}
+		return fd.withFD(func(n int) error {
+			actual, e := profileSocketTuple(n)
+			if e != nil || len(body) != 192 || string(body[:8]) != "YNKUCS01" || string(actual[:]) != string(body[148:188]) {
+				return errProfile
+			}
+			return send(unix.UnixRights(n))
+		})
+	})
+}
+func (p *ProfileRuntime) receiveUDPProof() error {
+	return p.udpActor.receive(func() (profileProofPacket, error) {
+		var packet profileProofPacket
+		e := p.proofs.fd.withFD(func(n int) error {
+			var body [256]byte
+			var oob [128]byte
+			// Даже без credentials kernel не может materialize >16 rights.
+			nread, control, flags, _, e := unix.Recvmsg(n, body[:], oob[:unix.CmsgSpace(16*4)], unix.MSG_DONTWAIT|unix.MSG_CMSG_CLOEXEC)
+			if nread < 0 {
+				nread = 0
+			}
+			if nread > len(body) {
+				nread = len(body)
+				flags |= unix.MSG_TRUNC
+			}
+			packet = profileParseAncillary(body[:nread], oob[:control], flags, profileAdoptFD)
+			if e != nil || nread == 0 || p.peerAlive() != nil {
+				return errors.Join(errProfile, e)
+			}
+			return nil
+		})
+		return packet, e
+	})
+}
