new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_transport_linux.go
@@ -0,0 +1,844 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	xnet "github.com/xtls/xray-core/common/net"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type ProfileCloser = io.Closer
+type profilePoolContextKey struct{}
+type profilePathKey struct{}
+type profilePhysicalContextKey struct{}
+
+// Key не credential. Создать usable pool может только live private FlowGrant.
+type ProfilePool struct {
+	state    *profileTransportState
+	key      [32]byte
+	scope    uint16
+	branch   byte
+	endpoint profileDestinationValue
+	values   [2]io.Closer
+}
+type profileTransportState struct {
+	mu            sync.Mutex
+	runtime       *ProfileRuntime
+	pools         [128]*ProfilePool
+	sockets       [128]*profilePhysicalConn
+	objects       [128]*profileResourceCustody
+	objectPending int
+	pending       int
+	closed        bool
+	done          chan struct{}
+	closeError    error
+}
+
+func (s *profileTransportState) live() bool {
+	c := s.runtime.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return !s.closed && s.closeError == nil && s.runtime.ctx.Err() == nil && c.live()
+}
+func (s *profileTransportState) close() {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		<-s.done
+		return
+	}
+	s.closed = true
+	sockets := s.sockets
+	pools := s.pools
+	objects := s.objects
+	s.mu.Unlock()
+	var closeError error
+	for _, c := range sockets {
+		if c != nil {
+			closeError = errors.Join(closeError, c.closeUnderlying())
+		}
+	}
+	for _, p := range pools {
+		if p != nil {
+			for _, v := range p.values {
+				if v != nil {
+					closeError = errors.Join(closeError, v.Close())
+				}
+			}
+		}
+	}
+	for _, entry := range objects {
+		if entry != nil {
+			closeError = errors.Join(closeError, entry.Close())
+		}
+	}
+
+	s.mu.Lock()
+	s.closeError = errors.Join(s.closeError, closeError)
+	s.mu.Unlock()
+	close(s.done)
+}
+func (p *ProfileRuntime) transportState() *profileTransportState {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.transports == nil {
+		p.transports = &profileTransportState{runtime: p, done: make(chan struct{})}
+		s := p.transports
+		context.AfterFunc(p.ctx, s.close)
+	}
+	return p.transports
+}
+
+func (p *ProfileRuntime) closeTransports() error {
+	p.mu.Lock()
+	s := p.transports
+	p.mu.Unlock()
+	if s == nil {
+		return nil
+	}
+	s.close()
+	s.mu.Lock()
+	e := s.closeError
+	s.mu.Unlock()
+	return e
+}
+
+// Reservation владеет custody до factory, включая concurrent shutdown.
+// Callback сообщает окончательный результат cleanup, не освобождает pending
+// или closing entry. Unknown остаётся terminal и не повторяет raw Close.
+type profileResourceCustody struct {
+	state                                       *profileTransportState
+	slot                                        int
+	ready                                       chan struct{}
+	once                                        sync.Once
+	value                                       io.Closer
+	pending, closing, terminal, retireRequested bool
+	retireError, result                         error
+}
+
+func (e *profileResourceCustody) completeLocked(err error) {
+	if e.terminal {
+		return
+	}
+	e.terminal = true
+	e.result = err
+	if err == nil {
+		if e.state.objects[e.slot] == e {
+			e.state.objects[e.slot] = nil
+		}
+	} else if e.state.closeError == nil {
+		e.state.closeError = err
+	}
+}
+func (e *profileResourceCustody) retire(err error) {
+	s := e.state
+	s.mu.Lock()
+	if e.terminal {
+		s.mu.Unlock()
+		return
+	}
+	e.retireRequested = true
+	if err != nil && e.retireError == nil {
+		e.retireError = err
+	}
+	if !e.pending && !e.closing {
+		e.completeLocked(e.retireError)
+	}
+	unknown := e.retireError != nil
+	if unknown && s.closeError == nil {
+		s.closeError = e.retireError
+	}
+	s.mu.Unlock()
+	if unknown {
+		s.runtime.cancel()
+	}
+}
+func (e *profileResourceCustody) Close() error {
+	<-e.ready
+	e.once.Do(func() {
+		s := e.state
+		s.mu.Lock()
+		if e.terminal {
+			s.mu.Unlock()
+			return
+		}
+		e.closing = true
+		value := e.value
+		s.mu.Unlock()
+		var err error
+		if value != nil {
+			err = value.Close()
+		}
+		s.mu.Lock()
+		err = errors.Join(err, e.retireError)
+		e.completeLocked(err)
+		s.mu.Unlock()
+		if err != nil {
+			s.runtime.cancel()
+		}
+	})
+	e.state.mu.Lock()
+	err := e.result
+	e.state.mu.Unlock()
+	return err
+}
+
+// HTTP clients и mux workers разделяют session cap. Reserved slot уже входит
+// в shutdown snapshot; pending factory не может создать невидимый ресурс.
+func (p *ProfilePool) NewResource(create func(context.Context, func(error)) (ProfileCloser, error)) (ProfileCloser, error) {
+	if p == nil || p.state == nil || create == nil {
+		return nil, errProfile
+	}
+	s := p.state
+	s.mu.Lock()
+	count, slot := 0, -1
+	for i, entry := range s.objects {
+		if entry != nil {
+			count++
+		} else if slot < 0 && i < int(s.runtime.flow.manifest.caps[2]) {
+			slot = i
+		}
+	}
+	if !p.registered() || !s.live() || slot < 0 || count >= int(s.runtime.flow.manifest.caps[2]) {
+		s.mu.Unlock()
+		return nil, errProfileFlowBusy
+	}
+	entry := &profileResourceCustody{state: s, slot: slot, ready: make(chan struct{}), pending: true}
+	s.objects[slot] = entry
+	s.objectPending++
+	s.mu.Unlock()
+	ctx, err := p.SessionContext()
+	var value ProfileCloser
+	if err == nil {
+		value, err = create(ctx, entry.retire)
+	}
+	s.mu.Lock()
+	entry.value = value
+	entry.pending = false
+	s.objectPending--
+	reject := err != nil || value == nil || !s.live() || entry.retireRequested
+	// Retire из Close rejected resource не может опередить actual Close result.
+	entry.closing = reject
+	close(entry.ready)
+	s.mu.Unlock()
+	if reject {
+		if err == nil {
+			err = errProfile
+		}
+		cleanup := entry.Close()
+		return nil, errors.Join(err, cleanup)
+	}
+	return value, nil
+}
+
+func ProfileAttachLogical(ctx context.Context, c io.Closer) error {
+	if c == nil {
+		return errProfile
+	}
+	if !ProfileSession(ctx) {
+		return nil
+	}
+	if ProfileLogicalGate(ctx) != nil {
+		c.Close()
+		return errProfile
+	}
+	context.AfterFunc(ctx, func() { c.Close() })
+	return nil
+}
+
+type profileLogicalConn struct {
+	conn net.Conn
+	ctx  context.Context
+	once sync.Once
+	stop func() bool
+	err  error
+}
+
+func ProfileGuardConnection(ctx context.Context, c net.Conn) (net.Conn, error) {
+	if !ProfileSession(ctx) {
+		return c, nil
+	}
+	if c == nil || ProfileLogicalGate(ctx) != nil {
+		if c != nil {
+			c.Close()
+		}
+		return nil, errProfile
+	}
+	if pool, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool); pool != nil {
+		return c, nil
+	}
+	owned := &profileLogicalConn{conn: c, ctx: ctx}
+	owned.stop = context.AfterFunc(ctx, func() { owned.closeUnderlying() })
+	return owned, nil
+}
+func (c *profileLogicalConn) Read(b []byte) (int, error) {
+	if ProfileLogicalGate(c.ctx) != nil {
+		return 0, errProfile
+	}
+	n, e := c.conn.Read(b)
+	if ProfileLogicalGate(c.ctx) != nil {
+		return 0, errProfile
+	}
+	return n, e
+}
+func (c *profileLogicalConn) Write(b []byte) (int, error) {
+	if ProfileLogicalGate(c.ctx) != nil {
+		return 0, errProfile
+	}
+	n, e := c.conn.Write(b)
+	if ProfileLogicalGate(c.ctx) != nil {
+		return 0, errProfile
+	}
+	return n, e
+}
+func (c *profileLogicalConn) closeUnderlying() error {
+	c.once.Do(func() { c.err = c.conn.Close() })
+	return c.err
+}
+func (c *profileLogicalConn) Close() error                       { c.stop(); return c.closeUnderlying() }
+func (c *profileLogicalConn) LocalAddr() net.Addr                { return c.conn.LocalAddr() }
+func (c *profileLogicalConn) RemoteAddr() net.Addr               { return c.conn.RemoteAddr() }
+func (c *profileLogicalConn) SetDeadline(t time.Time) error      { return c.conn.SetDeadline(t) }
+func (c *profileLogicalConn) SetReadDeadline(t time.Time) error  { return c.conn.SetReadDeadline(t) }
+func (c *profileLogicalConn) SetWriteDeadline(t time.Time) error { return c.conn.SetWriteDeadline(t) }
+func profilePoolIdentity(p *ProfileRuntime, g *profileGrant) ([32]byte, profileDestinationValue, error) {
+	var key [32]byte
+	row := p.flow.manifest.rows[8][g.scope]
+	branch := int(g.branch)
+	endpoint := g.effective
+	if row[20+branch] == 2 && !g.prepared {
+		return key, endpoint, ErrProfileUnsupported
+	}
+	if row[20+branch] == 4 {
+		return key, endpoint, errProfile
+	}
+	if row[20+branch] == 1 || row[20+branch] == 2 {
+		c := profileCursor{b: p.flow.manifest.rows[1][u16(row, 8+branch*2)]}
+		h := c.take(8)
+		a := c.take(int(u16(h, 4)))
+		endpoint = profileDestinationValue{family: h[0], network: h[1], port: u16(h, 2), address: string(a)}
+		if h[0] != 3 {
+			ip := net.IP(a)
+			endpoint.address = ip.String()
+		}
+	}
+	endpoint.network = row[5+branch*2]
+	h := sha256.New()
+	h.Write([]byte("YNKCAP-POOL-v1\x00"))
+	r := p.admission.launch
+	h.Write(r.session[:])
+	h.Write(r.invocation[:])
+	h.Write(r.digest[:])
+	h.Write(r.manifest[:])
+	var b [16]byte
+	be.PutUint64(b[:], r.generation)
+	be.PutUint64(b[8:], r.epoch)
+	h.Write(b[:])
+	be.PutUint16(b[:], g.subject)
+	be.PutUint16(b[2:], g.scope)
+	be.PutUint16(b[4:], g.chain)
+	b[6] = g.branch
+	h.Write(b[:7])
+	if g.stream != 65535 {
+		h.Write(p.flow.manifest.rows[3][g.stream])
+	}
+	if path, ok := g.ctx.Value(profilePathKey{}).([32]byte); ok {
+		h.Write(path[:])
+	}
+	h.Write(g.effective.encode())
+	h.Write(endpoint.encode())
+	for hop, depth := g.next, 0; hop != nil; hop, depth = hop.next, depth+1 {
+		if depth >= 255 || hop.receipt != g.receipt || !hop.prepared {
+			return key, endpoint, errProfile
+		}
+		be.PutUint16(b[:], hop.scope)
+		be.PutUint16(b[2:], hop.stream)
+		be.PutUint16(b[4:], hop.chain)
+		b[6] = hop.branch
+		h.Write(b[:7])
+		h.Write(hop.effective.encode())
+	}
+	copy(key[:], h.Sum(nil))
+	return key, endpoint, nil
+}
+func ProfileTransportPool(ctx context.Context, kind byte) (*ProfilePool, error) {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return nil, nil
+	}
+	if existing, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool); existing != nil {
+		if existing.state.runtime != p {
+			return nil, errProfile
+		}
+		g, e := existing.resolve(ctx)
+		if e != nil {
+			return nil, e
+		}
+		if kind != 0 && (g.stream == 65535 || p.flow.manifest.rows[3][g.stream][0] != kind) {
+			return nil, errProfile
+		}
+		if _, e := existing.Context(ctx); e != nil {
+			return nil, e
+		}
+		return existing, nil
+	}
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	if profileEnsureGrant(ctx, g) != nil {
+		return nil, errProfile
+	}
+	if kind != 0 && (g.stream == 65535 || p.flow.manifest.rows[3][g.stream][0] != kind) {
+		return nil, errProfile
+	}
+	key, endpoint, e := profilePoolIdentity(p, g)
+	if e != nil {
+		return nil, e
+	}
+	s := p.transportState()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.live() {
+		return nil, errProfile
+	}
+	slot := -1
+	for i, pool := range s.pools {
+		if pool != nil && pool.key == key {
+			return pool, nil
+		}
+		if pool == nil && slot < 0 && i < int(p.flow.manifest.caps[2]) {
+			slot = i
+		}
+	}
+	if slot < 0 {
+		return nil, errProfileFlowBusy
+	}
+	pool := &ProfilePool{state: s, key: key, scope: g.scope, branch: g.branch, endpoint: endpoint}
+	s.pools[slot] = pool
+	return pool, nil
+}
+func (p *ProfilePool) Key() [32]byte {
+	if p == nil {
+		return [32]byte{}
+	}
+	return p.key
+}
+func (p *ProfilePool) candidate() (*profileGrant, error) {
+	if p == nil || p.state == nil || p.state.runtime == nil {
+		return nil, errProfile
+	}
+	c := p.state.runtime.flow
+	for index := 0; index < len(c.grants); {
+		c.mu.Lock()
+		var chosen *profileGrant
+		for index < len(c.grants) {
+			g := c.grants[index]
+			index++
+			if c.grantLive(g) && g.scope == p.scope && g.branch == p.branch {
+				k, _, e := profilePoolIdentity(p.state.runtime, g)
+				if e == nil && k == p.key {
+					chosen = g
+					break
+				}
+			}
+		}
+		c.mu.Unlock()
+		if chosen == nil {
+			break
+		}
+		// Renewal выполняется без mutex; невалидный bundle не скрывает соседей.
+		if profileEnsureChain(context.WithValue(chosen.ctx, profileContextKey{}, p.state.runtime), chosen) == nil {
+			return chosen, nil
+		}
+	}
+	return nil, errProfile
+}
+func (p *ProfilePool) Context(callback context.Context) (context.Context, error) {
+	if p == nil {
+		return callback, nil
+	}
+	if p.state == nil || p.state.runtime == nil {
+		return nil, errProfile
+	}
+	if other := profileRuntime(callback); other != nil && other != p.state.runtime {
+		return nil, errProfile
+	}
+	if callback != nil {
+		if g, _ := callback.Value(profileGrantKey{}).(*profileGrant); g != nil {
+			if g.receipt == nil && (g.class != 2 || g.purpose != 1) || g.receipt != nil && g.receipt.control != p.state.runtime.flow {
+				return nil, errProfile
+			}
+			key, _, e := profilePoolIdentity(p.state.runtime, g)
+			if e != nil || key != p.key {
+				return nil, errProfile
+			}
+		}
+	}
+	if callback == nil || callback.Err() != nil || !p.state.runtime.flowFresh() {
+		return nil, errProfile
+	}
+	p.state.mu.Lock()
+	live := p.registered() && p.state.live()
+	p.state.mu.Unlock()
+	if !live {
+		return nil, errProfile
+	}
+	if _, e := p.resolve(callback); e != nil {
+		return nil, e
+	}
+	// Callback cancellation/deadline сохраняются; authority берётся из private
+	// pool, а physical ownership не привязывается к первому logical caller.
+	ctx := context.WithValue(callback, profileContextKey{}, p.state.runtime)
+	return context.WithValue(ctx, profilePoolContextKey{}, p), nil
+}
+func (p *ProfilePool) SessionContext() (context.Context, error) {
+	if p == nil || p.state == nil || p.state.runtime == nil {
+		return nil, errProfile
+	}
+	return p.Context(context.WithValue(p.state.runtime.ctx, profilePhysicalContextKey{}, true))
+}
+
+// Explicit logical consumer никогда не подменяется живым соседом из pool.
+func (p *ProfilePool) resolve(ctx context.Context) (*profileGrant, error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, errProfile
+	}
+	physical, _ := ctx.Value(profilePhysicalContextKey{}).(bool)
+	if !physical {
+		if g, _ := ctx.Value(profileGrantKey{}).(*profileGrant); g != nil {
+			if profileEnsureChain(ctx, g) != nil {
+				return nil, errProfile
+			}
+			key, _, e := profilePoolIdentity(p.state.runtime, g)
+			if e != nil || key != p.key {
+				return nil, errProfile
+			}
+			return g, nil
+		}
+	}
+	return p.candidate()
+}
+
+// Вызывается только под state.mu: копия opaque value не становится capability.
+func (p *ProfilePool) registered() bool {
+	for _, pool := range p.state.pools {
+		if pool == p {
+			return true
+		}
+	}
+	return false
+}
+func (p *ProfilePool) LoadOrCreate(slot int, create func(context.Context) (ProfileCloser, error)) (ProfileCloser, error) {
+	if p == nil || slot < 0 || slot >= len(p.values) {
+		return nil, errProfile
+	}
+	ctx, e := p.SessionContext()
+	if e != nil {
+		return nil, e
+	}
+	s := p.state
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.live() {
+		return nil, errProfile
+	}
+	if p.values[slot] != nil {
+		return p.values[slot], nil
+	}
+	v, e := create(ctx)
+	if e != nil {
+		return nil, e
+	}
+	if v == nil {
+		return nil, errProfile
+	}
+	if !s.live() {
+		v.Close()
+		return nil, errProfile
+	}
+	p.values[slot] = v
+	return v, nil
+}
+func ProfileLogicalGate(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil {
+		return errProfile
+	}
+	if !ProfileSession(ctx) {
+		return nil
+	}
+	if pool, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool); pool != nil {
+		_, e := pool.Context(ctx)
+		return e
+	}
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	return profileEnsureChain(ctx, g)
+}
+
+func ProfileCheckTransport(ctx context.Context, kind byte) error {
+	if !ProfileSession(ctx) {
+		return nil
+	}
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	if pool, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool); pool != nil {
+		var e error
+		g, e = pool.resolve(ctx)
+		if e != nil {
+			return e
+		}
+	} else if profileEnsureGrant(ctx, g) != nil {
+		return errProfile
+	}
+	p := profileRuntime(ctx)
+	if g.stream == 65535 || p.flow.manifest.rows[3][g.stream][0] != kind {
+		return errProfile
+	}
+	return nil
+}
+func ProfilePhysicalGate(ctx context.Context) error {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return errProfile
+	}
+	pool, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool)
+	if pool == nil || pool.state.runtime != p || ctx.Err() != nil {
+		return errProfile
+	}
+	_, e := pool.Context(ctx)
+	return e
+}
+func ProfileDialPhysical(ctx context.Context, dest xnet.Destination, runner func(context.Context) (net.Conn, error)) (net.Conn, error) {
+	// До pinned snapshot query/peer proof integration domain нельзя передать
+	// net.Dialer: тот запустит live netgo resolver без service grant.
+	if dest.Address == nil {
+		return nil, errProfile
+	}
+	if dest.Address.Family().IsDomain() {
+		return nil, ErrProfileUnsupported
+	}
+	if ProfileCheckDial(ctx, dest, true) != nil {
+		return nil, errProfile
+	}
+	pool, e := ProfileTransportPool(ctx, 0)
+	if e != nil || pool == nil {
+		return nil, errProfile
+	}
+	s := pool.state
+	s.mu.Lock()
+	count := s.pending
+	for _, entry := range s.objects {
+		if entry != nil {
+			if _, ok := entry.value.(*profileDNSConnection); ok {
+				count++
+			}
+		}
+	}
+	for _, socket := range s.sockets {
+		if socket != nil {
+			count++
+		}
+	}
+	if !s.live() || count >= int(s.runtime.flow.manifest.caps[1]) {
+		s.mu.Unlock()
+		return nil, errProfileFlowBusy
+	}
+	s.pending++
+	s.mu.Unlock()
+	defer func() { s.mu.Lock(); s.pending--; s.mu.Unlock() }()
+	dialCtx, e := pool.Context(ctx)
+	if e != nil {
+		return nil, e
+	}
+	conn, e := runner(dialCtx)
+	if e != nil {
+		if conn != nil {
+			profileCloseRejected(pool, conn)
+		}
+		return nil, e
+	}
+	if conn == nil {
+		return nil, errProfile
+	}
+	if ProfileLogicalGate(ctx) != nil || ProfilePhysicalGate(dialCtx) != nil {
+		profileCloseRejected(pool, conn)
+		return nil, errProfile
+	}
+	s.mu.Lock()
+	if !s.live() {
+		s.mu.Unlock()
+		profileCloseRejected(pool, conn)
+		return nil, errProfile
+	}
+	for i, item := range s.sockets {
+		if item == nil {
+			owned := &profilePhysicalConn{Conn: conn, pool: pool, slot: i}
+			s.sockets[i] = owned
+			s.mu.Unlock()
+			return owned, nil
+		}
+	}
+	s.mu.Unlock()
+	profileCloseRejected(pool, conn)
+	return nil, errProfileFlowBusy
+}
+
+type profilePhysicalConn struct {
+	net.Conn
+	pool       *ProfilePool
+	slot       int
+	once       sync.Once
+	closeError error
+	closed     atomic.Bool
+}
+
+func (c *profilePhysicalConn) closeUnderlying() error {
+	c.closed.Store(true)
+	c.once.Do(func() { c.closeError = c.Conn.Close() })
+	return c.closeError
+}
+func (c *profilePhysicalConn) Close() error {
+	e := c.closeUnderlying()
+	s := c.pool.state
+	s.mu.Lock()
+	if e == nil && c.slot >= 0 && s.sockets[c.slot] == c {
+		s.sockets[c.slot] = nil
+	}
+	if e != nil && s.closeError == nil {
+		s.closeError = e
+	}
+	s.mu.Unlock()
+	if e != nil {
+		s.runtime.cancel()
+	}
+	return e
+}
+
+func profileCloseRejected(pool *ProfilePool, conn net.Conn) {
+	owned := &profilePhysicalConn{Conn: conn, pool: pool, slot: -1}
+	if e := owned.closeUnderlying(); e != nil {
+		s := pool.state
+		s.mu.Lock()
+		if s.closeError == nil {
+			s.closeError = e
+		}
+		for i, c := range s.sockets {
+			if c == nil {
+				owned.slot = i
+				s.sockets[i] = owned
+				break
+			}
+		}
+		s.mu.Unlock()
+		s.runtime.cancel()
+	}
+}
+func (c *profilePhysicalConn) gate() error {
+	s := c.pool.state
+	s.mu.Lock()
+	live := s.live()
+	s.mu.Unlock()
+	if !live {
+		return errProfile
+	}
+	if c.closed.Load() || c.pool.state.runtime.ctx.Err() != nil || !c.pool.state.runtime.flowFresh() {
+		return errProfile
+	}
+	return nil
+}
+func (c *profilePhysicalConn) Read(b []byte) (int, error) {
+	if e := c.gate(); e != nil {
+		return 0, e
+	}
+	n, e := c.Conn.Read(b)
+	if c.gate() != nil {
+		return 0, errProfile
+	}
+	return n, e
+}
+func (c *profilePhysicalConn) Write(b []byte) (int, error) {
+	if e := c.gate(); e != nil {
+		return 0, e
+	}
+	return c.Conn.Write(b)
+}
+
+// Только guarded capability; underlying socket никогда не возвращается.
+func (c *profilePhysicalConn) ProfilePacketConn() (net.PacketConn, net.Addr, error) {
+	raw, ok := c.Conn.(*xnet.PacketConnWrapper)
+	if !ok || c.gate() != nil {
+		return nil, nil, errProfile
+	}
+	return &profilePhysicalPacket{owner: c, packet: raw.PacketConn}, raw.RemoteAddr(), nil
+}
+
+type profilePhysicalPacket struct {
+	owner  *profilePhysicalConn
+	packet net.PacketConn
+}
+
+func (c *profilePhysicalPacket) ReadFrom(b []byte) (int, net.Addr, error) {
+	if e := c.owner.gate(); e != nil {
+		return 0, nil, e
+	}
+	n, a, e := c.packet.ReadFrom(b)
+	if c.owner.gate() != nil {
+		return 0, nil, errProfile
+	}
+	if n > 0 && !c.peer(a) {
+		return 0, nil, errProfile
+	}
+	return n, a, e
+}
+func (c *profilePhysicalPacket) peer(a net.Addr) bool {
+	if a == nil {
+		return false
+	}
+	v, e := profileValue(xnet.DestinationFromAddr(a))
+	return e == nil && v == c.owner.pool.endpoint
+}
+func (c *profilePhysicalPacket) WriteTo(b []byte, a net.Addr) (int, error) {
+	if c.owner.gate() != nil || !c.peer(a) {
+		return 0, errProfile
+	}
+	return c.packet.WriteTo(b, a)
+}
+func (c *profilePhysicalPacket) Close() error                  { return c.owner.Close() }
+func (c *profilePhysicalPacket) LocalAddr() net.Addr           { return c.packet.LocalAddr() }
+func (c *profilePhysicalPacket) SetDeadline(t time.Time) error { return c.packet.SetDeadline(t) }
+func (c *profilePhysicalPacket) SetReadDeadline(t time.Time) error {
+	return c.packet.SetReadDeadline(t)
+}
+func (c *profilePhysicalPacket) SetWriteDeadline(t time.Time) error {
+	return c.packet.SetWriteDeadline(t)
+}
+
+func ProfilePacketCapability(conn net.Conn) (net.PacketConn, net.Addr, error) {
+	if c, ok := conn.(interface {
+		ProfilePacketConn() (net.PacketConn, net.Addr, error)
+	}); ok {
+		return c.ProfilePacketConn()
+	}
+	return nil, nil, errProfile
+}
+
+// FinalMask возвращает собственный PacketConnWrapper над уже guarded socket.
+// Адаптер возвращает новый guarded view, никогда raw underlying packet socket.
+func ProfileGuardPacketView(ctx context.Context, conn net.Conn) (net.PacketConn, net.Addr, error) {
+	raw, ok := conn.(*xnet.PacketConnWrapper)
+	if !ok {
+		return nil, nil, errProfile
+	}
+	pool, e := ProfileTransportPool(ctx, 0)
+	if e != nil || pool == nil {
+		return nil, nil, errProfile
+	}
+	if e = ProfileCheckDial(ctx, xnet.DestinationFromAddr(raw.RemoteAddr()), true); e != nil {
+		return nil, nil, e
+	}
+	owned := &profilePhysicalConn{Conn: conn, pool: pool, slot: -1}
+	return &profilePhysicalPacket{owner: owned, packet: raw.PacketConn}, raw.RemoteAddr(), nil
+}
