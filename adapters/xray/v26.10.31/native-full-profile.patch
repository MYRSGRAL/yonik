+type profileDNSHop struct {
+	scope  uint16
+	branch byte
+}
+
+// Intent — DATA, не permission. Только actual physical leaf, не remote proxy target.
+type profileDNSFrontier struct {
+	subject, scope, endpoint uint16
+	branch, carrier          byte
+	target                   profileDestinationValue
+	path                     [256]profileDNSHop
+	count                    int
+}
+
+func profileDNSFirstHop(m *profileCapsule, scope uint16, branch byte, choose func(string, xnet.Destination) (bool, error)) (profileDNSFrontier, error) {
+	var out profileDNSFrontier
+	var seen [512]bool
+	for out.count < len(out.path) {
+		if int(scope) >= len(m.rows[8]) || int(scope) >= len(seen) || seen[scope] || branch > 1 {
+			return out, errProfile
+		}
+		seen[scope] = true
+		row := m.rows[8][scope]
+		if len(row) != 24 || row[3]&(1<<branch) == 0 {
+			return out, errProfile
+		}
+		out.path[out.count] = profileDNSHop{scope, branch}
+		out.count++
+		action := row[20+int(branch)]
+		carrier := row[5+int(branch)*2]
+		index := u16(row, 8+int(branch)*2)
+		if action == 3 {
+			return out, ErrProfileUnsupported
+		} // Dynamic logical destination требует use1, не bootstrap.
+		if action != 1 && action != 2 {
+			return out, ErrProfileUnsupported
+		}
+		if int(index) >= len(m.rows[1]) {
+			return out, errProfile
+		}
+		target, ok := profileDecodedDestination(m.rows[1][index])
+		if !ok || target.network != carrier {
+			return out, errProfile
+		}
+		if action == 1 {
+			out.subject = u16(row, 0)
+			out.scope = scope
+			out.endpoint = index
+			out.branch = branch
+			out.carrier = carrier
+			out.target = target
+			return out, nil
+		}
+		edgeIndex := u16(row, 16+int(branch)*2)
+		if choose == nil || int(edgeIndex) >= len(m.rows[2]) {
+			return out, ErrProfileUnsupported
+		}
+		edge := m.rows[2][edgeIndex]
+		if len(edge) != 8 || u16(edge, 0) != scope || edge[4] != branch {
+			return out, errProfile
+		}
+		next := u16(edge, 2)
+		if int(next) >= len(m.rows[8]) {
+			return out, errProfile
+		}
+		nextRow := m.rows[8][next]
+		if len(nextRow) != 24 || nextRow[2] != carrier {
+			return out, errProfile
+		}
+		subject := u16(nextRow, 0)
+		if int(subject) >= len(m.rows[0]) {
+			return out, errProfile
+		}
+		cur := profileCursor{b: m.rows[0][subject]}
+		tag := cur.str(160)
+		if cur.bad {
+			return out, errProfile
+		}
+		dst := xnet.Destination{Network: xnet.Network_TCP, Address: xnet.ParseAddress(target.address), Port: xnet.Port(target.port)}
+		if target.network == 17 {
+			dst.Network = xnet.Network_UDP
+		}
+		mux, e := choose(string(tag), dst)
+		if e != nil {
+			return out, e
+		}
+		branch = 0
+		if mux {
+			branch = 1
+		}
+		if edge[5]&(1<<branch) == 0 {
+			return out, errProfile
+		}
+		scope = next
+	}
+	return out, errProfile
+}
