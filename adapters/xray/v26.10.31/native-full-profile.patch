+			return e
+		}
+		x.proofs = append(x.proofs, append([]byte(nil), b...))
+		return nil
+	}
+	r.association.reply = func(ctx context.Context, b []byte, tuple [40]byte, gate func() error) error {
+		if tuple != receiver.got.tuple {
+			t.Error("response selected caller/TCP tuple")
+			return errProfile
+		}
+		if e := gate(); e != nil {
+			return e
+		}
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		x.sends.Add(1)
+		x.replies <- append([]byte(nil), b...)
+		return nil
+	}
+	x.control = &ProfileUDPControl{actor: actor, request: r, cancel: r.cancel, stop: func() bool { return true }}
+	x.producer, e = x.control.startProducer(func(ctx context.Context, target xnet.Destination, link *transport.Link) error {
