+func prepareProfileServer(data []byte, prepare profilePrepare, factory func(context.Context, []byte) (core.Server, error)) (core.Server, *nativehooks.ProfileRuntime, error) {
+	var server core.Server
+	launch, err := prepare(data, false, func(ctx context.Context) error { var e error; server, e = factory(ctx, data); return e })
+	if err != nil {
+		if server != nil {
+			_ = server.Close()
+		}
+		if launch != nil {
+			launch.RevokeUnknown()
+		}
+		return nil, nil, err
+	}
+	return server, launch, nil
+}
+
+type profileServer struct {
+	core.Server
+	launch   *nativehooks.ProfileRuntime
+	once     sync.Once
+	closeErr error
+}
+
+func (s *profileServer) Start() error { return s.launch.Start(s.Server.Start) }
+func (s *profileServer) Close() error {
+	s.once.Do(func() {
+		s.launch.Revoke()
+		b := s.Server.Close()
+		if b != nil {
+			s.launch.RevokeUnknown()
+			s.closeErr = b
+			return
+		}
+		a := s.launch.Close()
+		s.closeErr = a
+		if s.closeErr == nil {
+			s.closeErr = b
+		}
+	})
+	return s.closeErr
+}
