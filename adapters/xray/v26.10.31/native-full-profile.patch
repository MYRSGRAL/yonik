+	m.rows[1] = [][]byte{remote.encode(), physical.encode()}
+	root, leaf := make([]byte, 24), make([]byte, 24)
+	root[2], root[3], root[4], root[5], root[20] = 6, 1, 6, 17, 2
+	be.PutUint16(root[8:], 0)
+	be.PutUint16(root[16:], 0)
+	leaf[2], leaf[3], leaf[4], leaf[5], leaf[20] = 17, 1, 17, 17, 1
+	be.PutUint16(leaf, 1)
+	be.PutUint16(leaf[8:], 1)
+	edge := make([]byte, 8)
+	be.PutUint16(edge[2:], 1)
+	edge[5] = 1
+	m.rows[8] = [][]byte{root, leaf}
+	m.rows[2] = [][]byte{edge}
+	calls := 0
+	choose := func(tag string, dst xnet.Destination) (bool, error) {
+		calls++
+		if tag != "b" || dst.Network != xnet.Network_UDP || dst.Address.String() != remote.address {
+			t.Fatal("native next input/target подменён", tag, dst)
+		}
+		return false, nil
+	}
+	got, e := profileDNSFirstHop(&m, 0, 0, choose)
+	if e != nil || calls != 1 || got.count != 2 || got.endpoint != 1 || got.target.address != physical.address || got.carrier != 17 {
+		t.Fatal("physical frontier неверен", got, e)
+	}
+	leaf[2] = 6
+	if _, e = profileDNSFirstHop(&m, 0, 0, choose); e == nil {
+		t.Fatal("original TCP заменил previous carrier UDP")
+	}
+	leaf[2] = 17
+	if _, e = profileDNSFirstHop(&m, 0, 0, func(string, xnet.Destination) (bool, error) { return true, nil }); e == nil {
+		t.Fatal("native mux outside admitted branch")
+	}
+	leaf[20] = 3
+	if _, e = profileDNSFirstHop(&m, 0, 0, choose); e == nil {
+		t.Fatal("dynamic destination получил bootstrap intent")
+	}
+}
diff --git a/common/yonikbroker/profile_dns_setup_linux.go b/common/yonikbroker/profile_dns_setup_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_dns_setup_linux.go
@@ -0,0 +1,70 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"errors"
+	"golang.org/x/sys/unix"
+	"os"
+	"time"
+)
+
+type profileDNSSetupOps struct {
+	send    func([]byte) error
+	receive func(time.Time) (profileProofPacket, error)
+	reject  func(profileProofPacket) error
+	alive   func() bool
+	now     func() time.Time
+}
+
+// Единственный setup owner до monitor. Descriptor/ACK — не runtime frame.
+func profileDNSSetup(ctx context.Context, r profileLaunch, record []byte, deadline time.Time, localUID uint32, ops profileDNSSetupOps) (result error) {
+	if ctx == nil || ops.send == nil || ops.receive == nil || ops.reject == nil || ops.alive == nil || ops.now == nil {
+		return errProfile
+	}
+	live := func() bool { return ctx.Err() == nil && ops.now().Before(deadline) && ops.alive() }
+	descriptor, e := profileDNSV2Descriptor(record)
+	if e != nil || !live() {
+		return errProfile
+	}
+	launch, e := decodeProfileLaunch(record)
+	if e != nil || launch != r {
+		return errProfile
+	}
+	if e = ops.send(descriptor[:]); e != nil || !live() {
+		return errors.Join(errProfile, e)
+	}
+	packet, e := ops.receive(deadline)
+	defer func() { result = errors.Join(result, ops.reject(packet)) }()
+	if e != nil || !live() || packet.invalid || packet.count != 0 || packet.rightsMessages != 0 || packet.credentials != 1 || !profileSenderValid(r, packet.pid, packet.uid, localUID) || !profileDNSV2Negotiate(r, descriptor[:], packet.body, 0, 0) {
+		return errors.Join(errProfile, e)
+	}
+	return nil
+}
+
+// Вызывается только синхронным launch owner после ADMIT_ACK, до monitor.
+func (p *ProfileRuntime) negotiateDNSV2(record []byte, deadline time.Time) error {
+	if p.admission.state != profileAdmitted || p.admission.capsule.mapping != 4 {
+		return errProfile
+	}
+	if p.admission.deadline.Before(deadline) {
+		deadline = p.admission.deadline
+	}
+	ops := profileDNSSetupOps{now: time.Now, receive: p.receiveBootstrap, reject: p.rejectRights, alive: func() bool { return p.peerAlive() == nil }}
+	ops.send = func(b []byte) error {
+		if p.ctx.Err() != nil || p.peerAlive() != nil {
+			return errProfile
+		}
+		n, e := unix.SendmsgN(int(p.channel.Fd()), b, nil, nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+		if e != nil || n != len(b) {
+			return errors.Join(errProfile, e)
+		}
+		return nil
+	}
+	if e := profileDNSSetup(p.ctx, p.admission.launch, record, deadline, uint32(os.Geteuid()), ops); e != nil {
+		return e
+	}
+	p.dnsV2 = true
+	return nil
+}
