+func ProfileDNSForwardReady(ctx context.Context, tag string, target xnet.Destination, mux bool) error {
+	if err := ProfileDNSBundleGuard(ctx, tag, target, mux); err != nil {
+		return err
+	}
+	_, err := profileDNSDirectShape(ctx, target)
+	return err
+}
+func (c *profileFlowControl) dnsRootLive(e *profileDNSExchange) bool {
+	if e == nil || e.query == nil || e.ctx == nil || e.ctx.Err() != nil || e.query.runtime.flow != c || !e.query.liveLocked() || e.query.receipt == nil {
+		return false
+	}
+	g := e.root
+	return g != nil && g.dnsOwner == e && int(g.resolver) < len(c.manifest.rows[4]) && g.class == 3 && g.receipt == e.query.receipt && g.query == e.query.name && g.effective == e.target && c.grantLive(g) && g.id != 0 && g.revision == g.receipt.revision && (!c.serviceOwnerRequired(g) || c.clock().Before(g.ownerDeadline) && g.ownerKind >= 1 && g.ownerKind <= 2 && g.ownerID != 0)
+}
+func (c *profileFlowControl) dnsBundleLive(b *profileDNSBundle) bool {
+	return b != nil && !b.closed && !b.unknown && b.ctx.Err() == nil && b.id != 0 && b.revision != 0 && c.clock().Before(b.deadline) && c.dnsRootLive(b.exchange) && b.exchange.root.id == b.rootID && b.exchange.root.revision == b.rootRevision && b.exchange.id == b.queryID && b.exchange.original == b.original && b.exchange.qtype == b.qtype && b.exchange.options == b.options && b.exchange.payload == b.payload && b.exchange.root.resolver == b.resolver
+}
+
+func profileDNSChosenPath(m *profileCapsule, tag string, target profileDestinationValue, mux bool, choose func(string, xnet.Destination) (bool, error)) (path [256]profileDNSHop, targets [256]profileDestinationValue, count int, err error) {
+	subject, ok := profileSubject(m, tag)
+	if !ok || !target.valid() {
+		return path, targets, 0, errProfile
+	}
+	row := m.rows[0][subject]
+	if len(row) < 4 {
+		return path, targets, 0, errProfile
+	}
+	offset := len(row) - 4
+	if target.network == 17 {
+		offset += 2
+	}
+	scope := u16(row, offset)
+	branch := byte(0)
+	if mux {
+		branch = 1
+	}
+	var seen [512]bool
+	for count < len(path) {
+		if int(scope) >= len(m.rows[8]) || int(scope) >= len(seen) || seen[scope] {
+			return path, targets, 0, errProfile
+		}
+		seen[scope] = true
+		r := m.rows[8][scope]
+		if len(r) != 24 || r[2] != target.network || r[3]&(1<<branch) == 0 {
+			return path, targets, 0, errProfile
+		}
+		path[count] = profileDNSHop{scope, branch}
+		targets[count] = target
+		count++
+		action := r[20+int(branch)]
+		carrier := r[5+int(branch)*2]
+		if action == 3 {
+			return path, targets, count, nil
+		}
+		if action != 1 && action != 2 {
+			return path, targets, 0, ErrProfileUnsupported
+		}
+		index := u16(r, 8+int(branch)*2)
+		if int(index) >= len(m.rows[1]) {
+			return path, targets, 0, errProfile
+		}
+		var valid bool
+		target, valid = profileDecodedDestination(m.rows[1][index])
+		if !valid || target.network != carrier {
+			return path, targets, 0, errProfile
+		}
+		if action == 1 {
+			return path, targets, count, nil
+		}
+		chain := u16(r, 16+int(branch)*2)
+		if int(chain) >= len(m.rows[2]) || choose == nil {
+			return path, targets, 0, ErrProfileUnsupported
+		}
+		edge := m.rows[2][chain]
+		if len(edge) != 8 || u16(edge, 0) != scope || edge[4] != branch {
+			return path, targets, 0, errProfile
+		}
+		scope = u16(edge, 2)
+		if int(scope) >= len(m.rows[8]) || m.rows[8][scope][2] != carrier {
+			return path, targets, 0, errProfile
+		}
+		next := u16(m.rows[8][scope], 0)
+		if int(next) >= len(m.rows[0]) {
+			return path, targets, 0, errProfile
+		}
+		cur := profileCursor{b: m.rows[0][next]}
+		name := cur.str(160)
+		if cur.bad {
+			return path, targets, 0, errProfile
+		}
+		dst := xnet.Destination{Network: xnet.Network_TCP, Address: xnet.ParseAddress(target.address), Port: xnet.Port(target.port)}
+		if carrier == 17 {
+			dst.Network = xnet.Network_UDP
+		}
+		decision, e := choose(string(name), dst)
+		if e != nil {
+			return path, targets, 0, e
+		}
+		branch = 0
+		if decision {
+			branch = 1
+		}
+		if edge[5]&(1<<branch) == 0 {
+			return path, targets, 0, errProfile
+		}
+	}
+	return path, targets, 0, errProfile
+}
