+func TestYonikProbeRequestKeepsParentDeadlineCancelAndURL(t *testing.T) {
+	parent, cancel := context.WithCancel(context.WithValue(context.Background(), probeContextTestKey{}, "owned-values"))
+	defer cancel()
+	o := &Observer{ctx: parent, config: &Config{ProbeUrl: "http://synthetic.invalid/health?fixed=1"}}
+	called := false
+	result := o.probeWithClient("subject", func(client *http.Client, req *http.Request) (*http.Response, error) {
+		called = true
+		if req.Context().Value(probeContextTestKey{}) != "owned-values" || req.URL.String() != "http://synthetic.invalid/health?fixed=1" {
+			t.Fatal("probe request потерял URL/context")
+		}
+		deadline, ok := req.Context().Deadline()
+		if !ok || time.Until(deadline) > 5*time.Second {
+			t.Fatal("probe request потерял deadline")
+		}
+		if client.CheckRedirect(req, nil) != http.ErrUseLastResponse {
+			t.Fatal("probe follows redirect")
+		}
+		cancel()
+		<-req.Context().Done()
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(""))}, nil
+	})
+	if !called || result.Alive {
+		t.Fatal("late response после cancel отмечен Alive")
+	}
+}
+func TestYonikCancelledProbeDoesNotReachHTTPClient(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	o := &Observer{ctx: ctx, config: &Config{ProbeUrl: "http://synthetic.invalid/health"}}
+	result := o.probeWithClient("subject", func(*http.Client, *http.Request) (*http.Response, error) {
+		t.Fatal("cancelled probe reached HTTP client")
+		return nil, nil
+	})
+	if result.Alive {
+		t.Fatal("cancelled probe Alive")
+	}
+}
