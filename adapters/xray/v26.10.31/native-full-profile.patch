diff --git a/transport/internet/splithttp/yonik_r9_test.go b/transport/internet/splithttp/yonik_r9_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/splithttp/yonik_r9_test.go
@@ -0,0 +1,218 @@
+package splithttp
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type r9H1Conn struct {
+	prefix                     *bytes.Reader
+	reply                      *bytes.Reader
+	entered, release           chan struct{}
+	readOnce                   sync.Once
+	writes, closes, deadlines  atomic.Int32
+	deadline                   time.Time
+	firstDeadline              time.Time
+	interruptRead              bool
+	writeEntered, writeRelease chan struct{}
+	unblockOnce                sync.Once
+	shortWrite                 bool
+}
+
+func (c *r9H1Conn) Read(b []byte) (int, error) {
+	if c.prefix != nil && c.prefix.Len() > 0 {
+		return c.prefix.Read(b)
+	}
+	if c.entered != nil {
+		c.readOnce.Do(func() { close(c.entered) })
+		<-c.release
+		if c.interruptRead {
+			return 0, io.ErrClosedPipe
+		}
+	}
+	return c.reply.Read(b)
+}
+func (c *r9H1Conn) Write(b []byte) (int, error) {
+	c.writes.Add(1)
+	if c.writeEntered != nil {
+		close(c.writeEntered)
+		<-c.writeRelease
+		return 0, io.ErrClosedPipe
+	}
+	if c.shortWrite {
+		return len(b) - 1, nil
+	}
+	return len(b), nil
+}
+func (c *r9H1Conn) Close() error {
+	c.closes.Add(1)
+	c.unblockOnce.Do(func() {
+		if c.interruptRead {
+			close(c.release)
+		}
+		if c.writeRelease != nil {
+			close(c.writeRelease)
+		}
+	})
+	return nil
+}
+func (c *r9H1Conn) LocalAddr() net.Addr  { return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 40000} }
+func (c *r9H1Conn) RemoteAddr() net.Addr { return &net.TCPAddr{IP: net.IPv4(192, 0, 2, 1), Port: 443} }
+func (c *r9H1Conn) SetDeadline(d time.Time) error {
+	if c.deadlines.Add(1) == 1 {
+		c.firstDeadline = d
+	}
+	c.deadline = d
+	return nil
+}
+func (c *r9H1Conn) SetReadDeadline(d time.Time) error  { return c.SetDeadline(d) }
+func (c *r9H1Conn) SetWriteDeadline(d time.Time) error { return c.SetDeadline(d) }
+
+func r9H1Request(t *testing.T) *http.Request {
+	t.Helper()
+	req, e := http.NewRequest("POST", "http://synthetic.invalid/", bytes.NewReader([]byte("new-payload")))
+	if e != nil {
+		t.Fatal(e)
+	}
+	return req
+}
+func r9H1Client(conn *r9H1Conn) (*DefaultDialerClient, *H1Conn) {
+	h1 := NewH1Conn(conn)
+	h1.UnreadedResponsesCount = 1
+	return &DefaultDialerClient{uploadRawPool: &sync.Pool{New: func() any { return h1 }}}, h1
+}
+
+func TestYonikR9H1BlockedResponseCancelNeverWrites(t *testing.T) {
+	for _, phase := range []string{"header", "body"} {
+		t.Run(phase, func(t *testing.T) {
+			raw := &r9H1Conn{reply: bytes.NewReader([]byte("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")), entered: make(chan struct{}), release: make(chan struct{})}
+			if phase == "body" {
+				raw.prefix = bytes.NewReader([]byte("HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n"))
+				raw.reply = bytes.NewReader([]byte("body"))
+			}
+			client, _ := r9H1Client(raw)
+			ctx, cancel := context.WithDeadline(context.Background(), time.Now().Add(time.Minute))
+			defer cancel()
+			result := make(chan error, 1)
+			req := r9H1Request(t)
+			go func() {
+				result <- client.postH1Packet(ctx, req, true, func(ctx context.Context) error { return ctx.Err() })
+			}()
+			<-raw.entered
+			cancel()
+			close(raw.release)
+			err := <-result
+			if raw.writes.Load() != 0 || err == nil {
+				t.Fatalf("R9F1: payload после отмены: writes=%d err=%v", raw.writes.Load(), err)
+			}
+			if raw.closes.Load() != 1 || raw.deadlines.Load() == 0 {
+				t.Fatal("manual I/O не связано с cancel/deadline")
+			}
+			if client.closed.Load() {
+				t.Fatal("отмена consumer закрыла shared client")
+			}
+			client.uploadRawPool.New = nil
+			if client.uploadRawPool.Get() != nil {
+				t.Fatal("неподтверждённый H1 возвращён в pool")
+			}
+		})
+	}
+}
+
+func TestYonikR9H1ConfirmedReuseAndLegacyControl(t *testing.T) {
+	for _, owned := range []bool{false, true} {
+		raw := &r9H1Conn{reply: bytes.NewReader([]byte("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"))}
+		client, h1 := r9H1Client(raw)
+		ctx, cancel := context.WithDeadline(context.Background(), time.Now().Add(time.Minute))
+		if e := client.postH1Packet(ctx, r9H1Request(t), owned, func(ctx context.Context) error { return ctx.Err() }); e != nil {
+			t.Fatal(e)
+		}
+		cancel()
+		if raw.writes.Load() != 1 || raw.closes.Load() != 0 {
+			t.Fatal("успешный H1 потерян")
+		}
+		if owned && (h1.UnreadedResponsesCount != 0 || raw.deadlines.Load() < 2 || !raw.deadline.IsZero()) {
+			t.Fatal("H1 переиспользован до ACK или не снят operation deadline")
+		}
+		if !owned && raw.deadlines.Load() != 0 {
+			t.Fatal("legacy I/O изменён")
+		}
+		deadline, _ := ctx.Deadline()
+		if owned && !raw.firstDeadline.Equal(deadline) {
+			t.Fatal("operation deadline отличается от logical request")
+		}
+	}
+}
+
+var _ net.Conn = (*r9H1Conn)(nil)
+
+func TestYonikR9H1CancellationInterruptsExclusiveManualIO(t *testing.T) {
+	for _, phase := range []string{"read", "write"} {
+		t.Run(phase, func(t *testing.T) {
+			raw := &r9H1Conn{reply: bytes.NewReader(nil)}
+			client, h1 := r9H1Client(raw)
+			var entered chan struct{}
+			if phase == "read" {
+				raw.entered = make(chan struct{})
+				raw.release = make(chan struct{})
+				raw.interruptRead = true
+				entered = raw.entered
+			} else {
+				h1.UnreadedResponsesCount = 0
+				raw.writeEntered = make(chan struct{})
+				raw.writeRelease = make(chan struct{})
+				entered = raw.writeEntered
+			}
+			ctx, cancel := context.WithDeadline(context.Background(), time.Now().Add(time.Minute))
+			defer cancel()
+			result := make(chan error, 1)
+			req := r9H1Request(t)
+			go func() {
+				result <- client.postH1Packet(ctx, req, true, func(ctx context.Context) error { return ctx.Err() })
+			}()
+			<-entered
+			cancel()
+			// Только operation Close может разблокировать fake I/O; test не присылает reply.
+			if e := <-result; e == nil {
+				t.Fatal("cancelled manual I/O подтвердилось")
+			}
+			if raw.closes.Load() != 1 || client.closed.Load() {
+				t.Fatal("отменён весь shared client или Close не единственный")
+			}
+			client.uploadRawPool.New = nil
+			if client.uploadRawPool.Get() != nil {
+				t.Fatal("прерванный H1 вернулся в pool")
+			}
+		})
+	}
+}
+
+func TestYonikR9H1PartialOrUnconfirmedIsNotReused(t *testing.T) {
+	for _, phase := range []string{"short-write", "missing-ack", "bad-status"} {
+		t.Run(phase, func(t *testing.T) {
+			raw := &r9H1Conn{reply: bytes.NewReader(nil), shortWrite: phase == "short-write"}
+			if phase == "bad-status" {
+				raw.reply = bytes.NewReader([]byte("HTTP/1.1 500 Error\r\nContent-Length: 0\r\n\r\n"))
+			}
+			client, h1 := r9H1Client(raw)
+			h1.UnreadedResponsesCount = 0
+			if e := client.postH1Packet(context.Background(), r9H1Request(t), true, func(context.Context) error { return nil }); e == nil {
+				t.Fatal("неподтверждённый write принят")
+			}
+			if raw.writes.Load() != 1 || raw.closes.Load() != 1 || client.closed.Load() {
+				t.Fatal("ambiguous write повторён или отменён shared client")
+			}
+			client.uploadRawPool.New = nil
+			if client.uploadRawPool.Get() != nil {
+				t.Fatal("partial/unconfirmed H1 вернулся в pool")
+			}
+		})
+	}
+}
diff --git a/common/yonikbroker/profile_r9_linux_test.go b/common/yonikbroker/profile_r9_linux_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_r9_linux_test.go
@@ -0,0 +1,275 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+)
+
+var r9CleanupError = errors.New("R9: cleanup Unknown")
+var r9FactoryError = errors.New("R9: factory failed")
+
+type r9Resource struct {
+	retire        func(error)
+	calls         atomic.Int32
+	fail          bool
+	reportSuccess bool
+}
+
+func (r *r9Resource) Close() error {
+	r.calls.Add(1)
+	var result error
+	if r.fail {
+		result = r9CleanupError
+	}
+	if r.retire != nil {
+		reported := result
+		if r.reportSuccess {
+			reported = nil
+		}
+		r.retire(reported)
+		r.retire(nil)
+	}
+	return result
+}
+
+type r9ShutdownBarrier struct{ entered, release chan struct{} }
+
+type r9KnownCleanupReturning struct {
+	retire       func(error)
+	ack, release chan struct{}
+	calls        atomic.Int32
+}
+
+func (r *r9KnownCleanupReturning) Close() error {
+	r.calls.Add(1)
+	r.retire(nil)
+	close(r.ack)
+	<-r.release
+	r.retire(nil)
+	return nil
+}
+
+func TestProfileR9ConcurrentCloseAndSlotReuseKeepsNewCustody(t *testing.T) {
+	f, pool := r9Pool(t)
+	f.c.manifest.caps[2] = 1
+	old := &r9KnownCleanupReturning{ack: make(chan struct{}), release: make(chan struct{})}
+	value, e := pool.NewResource(func(_ context.Context, retire func(error)) (ProfileCloser, error) {
+		old.retire = retire
+		return old, nil
+	})
+	if e != nil {
+		t.Fatal(e)
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- value.Close() }()
+	<-old.ack
+	// Actual cleanup уже подтверждён, но предыдущий Close ещё не вернулся.
+	next := &profilePureClose{}
+	if _, e = pool.NewResource(func(context.Context, func(error)) (ProfileCloser, error) { return next, nil }); e != nil {
+		t.Fatal(e)
+	}
+	close(old.release)
+	if e = <-closed; e != nil {
+		t.Fatal(e)
+	}
+	if r9Retained(pool.state) != 1 {
+		t.Fatal("late callback очистил новую reservation")
+	}
+	f.p.cancel()
+	if e = f.p.closeTransports(); e != nil {
+		t.Fatal(e)
+	}
+	if next.count.Load() != 1 || old.calls.Load() != 1 {
+		t.Fatal("cleanup потерян или повторён после slot reuse")
+	}
+}
+
+func (r *r9ShutdownBarrier) Close() error { close(r.entered); <-r.release; return nil }
+func r9Pool(t *testing.T) (*flowFixture, *ProfilePool) {
+	t.Helper()
+	f := newFlowFixture(t, 1)
+	r := f.admittedReceipt(t, "r9.invalid")
+	g := f.granted(t, r)
+	ctx := context.WithValue(context.WithValue(g.ctx, profileContextKey{}, f.p), profileGrantKey{}, g)
+	pool, e := ProfileTransportPool(ctx, 1)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return f, pool
+}
+func r9Retained(s *profileTransportState) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n := 0
+	for _, v := range s.objects {
+		if v != nil {
+			n++
+		}
+	}
+	return n
+}
+
+func TestProfileR9FactoryRevokeRetainsFailedCleanup(t *testing.T) {
+	f, pool := r9Pool(t)
+	barrier := &r9ShutdownBarrier{entered: make(chan struct{}), release: make(chan struct{})}
+	if _, e := pool.LoadOrCreate(0, func(context.Context) (ProfileCloser, error) { return barrier, nil }); e != nil {
+		t.Fatal(e)
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	result := make(chan error, 1)
+	resource := &r9Resource{fail: true}
+	go func() {
+		value, e := pool.NewResource(func(_ context.Context, retire func(error)) (ProfileCloser, error) {
+			resource.retire = retire
+			close(entered)
+			<-release
+			return resource, nil
+		})
+		if value != nil {
+			result <- errors.New("late resource published")
+			return
+		}
+		result <- e
+	}()
+	<-entered
+	f.p.cancel()
+	<-barrier.entered
+	close(release)
+	e := <-result
+	close(barrier.release)
+	cleanup := f.p.closeTransports()
+	if e == nil || !errors.Is(cleanup, r9CleanupError) || r9Retained(pool.state) != 1 {
+		t.Fatalf("R9F2: custody потеряна: create=%v cleanup=%v retained=%d", e, cleanup, r9Retained(pool.state))
+	}
+	resource.fail = false
+	if !errors.Is(f.p.closeTransports(), r9CleanupError) || resource.calls.Load() != 1 {
+		t.Fatal("повторный Close стёр Unknown или повторил cleanup")
+	}
+}
+
+func TestProfileR9FactoryErrorRetainsNonNilResource(t *testing.T) {
+	f, pool := r9Pool(t)
+	resource := &r9Resource{fail: true, reportSuccess: true}
+	value, e := pool.NewResource(func(_ context.Context, retire func(error)) (ProfileCloser, error) {
+		resource.retire = retire
+		return resource, r9FactoryError
+	})
+	if value != nil || !errors.Is(e, r9FactoryError) {
+		t.Fatal("factory error потерян", value, e)
+	}
+	if r9Retained(pool.state) != 1 || !errors.Is(f.p.closeTransports(), r9CleanupError) {
+		t.Fatal("R9F2: factory error отбросил cleanup custody")
+	}
+	resource.fail = false
+	if !errors.Is(f.p.closeTransports(), r9CleanupError) || resource.calls.Load() != 1 {
+		t.Fatal("Unknown воскрес как KnownClosed")
+	}
+}
+
+func TestProfileR9ActiveRetirementResultIsSticky(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		f, pool := r9Pool(t)
+		resource := &r9Resource{fail: fail}
+		value, e := pool.NewResource(func(_ context.Context, retire func(error)) (ProfileCloser, error) {
+			resource.retire = retire
+			return resource, nil
+		})
+		if e != nil {
+			t.Fatal(e)
+		}
+		closeError := value.Close()
+		resource.retire(nil)
+		if fail {
+			if !errors.Is(closeError, r9CleanupError) || r9Retained(pool.state) != 1 {
+				t.Fatal("Unknown active retirement потерян")
+			}
+		} else if closeError != nil || r9Retained(pool.state) != 0 {
+			t.Fatal("KnownClosed active retirement не освободил slot")
+		}
+		f.p.cancel()
+		cleanup := f.p.closeTransports()
+		if fail && !errors.Is(cleanup, r9CleanupError) {
+			t.Fatal("Unknown сменился KnownClosed")
+		}
+		if !fail && cleanup != nil {
+			t.Fatal(cleanup)
+		}
+		if resource.calls.Load() != 1 {
+			t.Fatal("повторный raw Close после подтверждённого result")
+		}
+	}
+}
+
+func TestProfileR9PendingReservationAndEarlyRetireCannotPublish(t *testing.T) {
+	f, pool := r9Pool(t)
+	f.c.manifest.caps[2] = 1
+	entered, release := make(chan struct{}), make(chan struct{})
+	result := make(chan error, 1)
+	resource := &r9Resource{}
+	go func() {
+		value, e := pool.NewResource(func(_ context.Context, retire func(error)) (ProfileCloser, error) {
+			resource.retire = retire
+			retire(nil)
+			close(entered)
+			<-release
+			return resource, nil
+		})
+		if value != nil {
+			result <- errors.New("early retire published resource")
+			return
+		}
+		result <- e
+	}()
+	<-entered
+	if r9Retained(pool.state) != 1 {
+		t.Fatal("custody не зарезервирована до factory")
+	}
+	calls := 0
+	if _, e := pool.NewResource(func(context.Context, func(error)) (ProfileCloser, error) { calls++; return nil, nil }); e == nil || calls != 0 {
+		t.Fatal("pending reservation не входит в cap")
+	}
+	close(release)
+	if e := <-result; e == nil {
+		t.Fatal("early retire стал authority")
+	}
+	if resource.calls.Load() != 1 || r9Retained(pool.state) != 0 {
+		t.Fatal("подтверждённый cleanup не освободил slot")
+	}
+	pool.state.mu.Lock()
+	pending := pool.state.objectPending
+	pool.state.mu.Unlock()
+	if pending != 0 {
+		t.Fatal("pending reservation leaked")
+	}
+	f.p.cancel()
+	if e := f.p.closeTransports(); e != nil {
+		t.Fatal(e)
+	}
+}
+
+func TestProfileR9SuccessfulRejectedCleanupReleasesOnce(t *testing.T) {
+	f, pool := r9Pool(t)
+	f.c.manifest.caps[2] = 1
+	resource := &r9Resource{}
+	if _, e := pool.NewResource(func(_ context.Context, retire func(error)) (ProfileCloser, error) {
+		resource.retire = retire
+		return resource, r9FactoryError
+	}); !errors.Is(e, r9FactoryError) {
+		t.Fatal(e)
+	}
+	if r9Retained(pool.state) != 0 || resource.calls.Load() != 1 {
+		t.Fatal("успешный cleanup не освободил reservation ровно один раз")
+	}
+	calls := 0
+	if _, e := pool.NewResource(func(context.Context, func(error)) (ProfileCloser, error) { calls++; return &profilePureClose{}, nil }); e != nil || calls != 1 {
+		t.Fatal("reservation не переиспользуется", e, calls)
+	}
+	f.p.cancel()
+	if e := f.p.closeTransports(); e != nil {
+		t.Fatal(e)
+	}
+}
