+}
+
+func profileUDPBinding(r profileLaunch, b []byte) {
+	copy(b[16:48], r.digest[:])
+	copy(b[48:64], r.session[:])
+	copy(b[64:80], r.invocation[:])
+	be.PutUint64(b[80:], r.generation)
+	be.PutUint64(b[88:], r.epoch)
+	copy(b[96:128], r.nonce[:])
+}
+func profileUDPId(v uint64) bool        { return v != 0 && v != ^uint64(0) }
+func profileUDPRemaining(v uint64) bool { return v > 0 && v <= uint64(time.Second) }
+func profileUDPv2Tuple(t [40]byte, network byte) bool {
+	return t[0] == network && t[1] == 4 && profileTupleValid(t) && bytes.Equal(t[24:28], []byte{127, 0, 0, 1}) && !bytes.Equal(t[8:12], []byte{255, 255, 255, 255})
+}
+
+// Borrowed view: до проверки exact length/binding/rights ничего не аллоцируется.
+func profileUDPDecode(r profileLaunch, b []byte, rights int, issuer bool) (int, error) {
+	if len(b) < 128 || len(b) > 256 || r.mode < 1 || r.mode > 2 {
+		return -1, errProfile
+	}
+	kind := -1
+	for i, s := range profileUDPShapes {
+		if string(b[:8]) == s.magic {
+			kind = i
+			break
+		}
+	}
+	if kind < 0 {
+		return -1, errProfile
+	}
+	s := profileUDPShapes[kind]
+	var prefix [128]byte
+	profileUDPBinding(r, prefix[:])
+	if len(b) != s.length || rights != s.rights || issuer != s.issuer || u16(b, 8) != 1 || int(u16(b, 10)) != s.length || int(u16(b, 12)) != rights || !zero(b[14:16]) || !bytes.Equal(b[16:128], prefix[16:]) {
+		return -1, errProfile
+	}
+	id := func(off int) bool { return profileUDPId(u64(b, off)) }
+	nz := func(off int) bool { return u64(b, off) != 0 }
+	valid := false
+	switch kind {
+	case 0:
+		var tuple [40]byte
+		copy(tuple[:], b[148:188])
+		valid = id(128) && id(136) && u16(b, 144) < 4 && b[146] == 3 && b[147] == 0 && profileUDPv2Tuple(tuple, 6) && zero(b[188:])
+	case 1:
+		valid = id(128) && id(136) && nz(144) && profileUDPRemaining(u64(b, 152))
+	case 2, 4:
+		valid = id(128) && id(136) && (kind == 2 && nz(144) || kind == 4 && id(144)) && zero(b[152:])
+	case 3:
+		valid = id(128) && id(136) && id(144) && nz(152) && b[160] == 4 && b[161] == 17 && zero(b[162:164]) && u16(b, 164) > 0 && zero(b[166:168]) && bytes.Equal(b[168:172], []byte{127, 0, 0, 1}) && zero(b[172:])
+	case 5, 6:
+		var tuple [40]byte
+		copy(tuple[:], b[160:200])
+		valid = id(128) && id(136) && id(144) && nz(152) && profileUDPv2Tuple(tuple, 17) && u32(b, 200) > 0 && u32(b, 200) <= 65507 && u16(b, 204) >= 8 && u16(b, 204) <= 260 && uint32(u16(b, 204)) <= u32(b, 200) && u16(b, 206) == 0 && !zero(b[208:240]) && zero(b[248:])
+		if kind == 5 {
+			valid = valid && profileUDPRemaining(u64(b, 240))
+		} else {
+			valid = valid && id(240)
+		}
+	case 7:
+		valid = id(128) && id(136) && id(144) && id(152) && b[160] >= 1 && b[160] <= 3 && zero(b[161:168]) && u64(b, 168) <= uint64(time.Second) && zero(b[176:]) && (b[160] != 1 || u64(b, 168) > 0)
+	case 8:
+		valid = id(128) && id(136) && id(144) && zero(b[154:])
+	case 9:
+		valid = id(128) && id(136) && u64(b, 144) != ^uint64(0) && u32(b, 152) <= 256 && (b[156] == 1 || b[156] == 3) && b[157] <= 1 && u16(b, 158) <= 1 && nz(160) && u64(b, 168) != ^uint64(0) && zero(b[176:])
+		if b[156] == 1 {
+			valid = valid && u32(b, 152) == 0 && b[157] == 1 && u16(b, 158) == 0
+		}
+	}
+	if !valid {
+		return -1, errProfile
+	}
+	return kind, nil
+}
+
+func profileUDPEncode(r profileLaunch, kind int, tail []byte) (out [256]byte, n int, err error) {
+	if kind < 0 || kind >= len(profileUDPShapes) {
+		return out, 0, errProfile
+	}
+	s := profileUDPShapes[kind]
+	if len(tail) != s.length-128 {
+		return out, 0, errProfile
+	}
+	copy(out[:8], s.magic)
+	be.PutUint16(out[8:], 1)
+	be.PutUint16(out[10:], uint16(s.length))
+	be.PutUint16(out[12:], uint16(s.rights))
+	profileUDPBinding(r, out[:])
+	copy(out[128:], tail)
+	_, err = profileUDPDecode(r, out[:s.length], s.rights, s.issuer)
+	if err != nil {
+		return out, 0, err
+	}
+	return out, s.length, nil
+}
+
+func profileUDPSOCKSHeader(b []byte) (profileDestinationValue, int, error) {
+	var v profileDestinationValue
+	v.network = 17
+	if len(b) < 8 || len(b) > 65507 || !zero(b[:3]) {
+		return v, 0, errProfile
+	}
+	n := 0
+	switch b[3] {
+	case 1:
+		v.family = 4
+		n = 4
+	case 4:
+		v.family = 6
+		n = 16
+	case 3:
+		v.family = 3
+		n = int(b[4])
+		if n == 0 || n > 253 || len(b) < n+7 || !profileDomain(b[5:5+n]) {
+			return v, 0, errProfile
+		}
+		v.address = string(b[5 : 5+n])
+		if _, e := netip.ParseAddr(v.address); e == nil {
+			return v, 0, errProfile
+		}
+		v.port = u16(b, 5+n)
+		if !v.valid() {
+			return v, 0, errProfile
+		}
+		return v, n + 7, nil
+	default:
+		return v, 0, errProfile
+	}
+	if len(b) < n+6 {
+		return v, 0, errProfile
+	}
+	if v.family == 4 && bytes.Equal(b[4:8], []byte{255, 255, 255, 255}) {
+		return v, 0, errProfile
+	}
+	v, ok := profileDecodedDestination(append([]byte{v.family, 17, b[4+n], b[5+n], 0, byte(n), 0, 0}, b[4:4+n]...))
+	if !ok {
+		return v, 0, errProfile
+	}
+	return v, n + 6, nil
+}
+func profileUDPFingerprint(r profileLaunch, permit []byte, datagram []byte) [32]byte {
+	h := sha256.New()
+	h.Write([]byte("YNK-UDP-PACKET-v1\x00"))
+	var prefix [128]byte
+	profileUDPBinding(r, prefix[:])
+	h.Write(prefix[16:])
+	h.Write(permit[128:200])
+	h.Write(permit[200:204])
+	h.Write(datagram)
+	var result [32]byte
+	copy(result[:], h.Sum(nil))
+	return result
+}
+
+// Общий retained budget proof + runtime, без compaction/eviction/ID reuse.
+type profileUDPBudget struct {
+	unknown                                                                  func()
+	launch                                                                   profileLaunch
+	used, proofPending, active, associations                                 int
+	lastAssociation, lastPacket, lastPermit, lastControl, nextProofOperation uint64
+	controls                                                                 [256]uint64
+	entries                                                                  [256]profileUDPRetainedOperation
+}
+
+const profileUDPBudgetCredit = 32768
+
+// Вызывается только после consumed trusted PF002 и ADMIT, до flow operations.
+// Production пока НЕ вызывает initializer: negotiated v2 gate закрыт.
+func profileInitUDPBudget(p *ProfileRuntime) error {
+	if p == nil || p.cancel == nil || p.flow == nil || p.proofs == nil || p.proofs.version != 2 || p.admission.launch.mode != 2 || p.proofs.launch != p.admission.launch || !p.proofs.live() || !p.flowFresh() {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.live() || c.udpBudget != nil || c.operations != 0 || c.highestFlow != 0 || c.highestGrant != 0 || c.lastSent != 0 || c.buffered+c.manifest.memoryCredit+profileUDPBudgetCredit > uint64(c.manifest.caps[4]) {
+		return errProfile
+	}
+	c.buffered += profileUDPBudgetCredit
+	c.udpBudget = &profileUDPBudget{launch: p.admission.launch, unknown: func() { p.mu.Lock(); p.admission.state = profileUnknown; p.mu.Unlock(); p.cancel() }}
+	return nil
+}
+
+type profileUDPRetainedOperation struct {
+	namespace                                                                byte // 1 runtime request, 2 proof operation; не wire enum.
+	terminal                                                                 bool // terminal operation, НЕ доказательство resource KnownClosed.
+	operation, runtimeSequence, association, packet, permit, control, cookie uint64
+}
+
+func (c *profileFlowControl) udpReserveLocked() bool {
+	if c.udpBudget == nil || c.udpBudget.used >= int(c.manifest.caps[7]) || c.udpBudget.used >= 256 || c.operations+c.udpBudget.proofPending >= 64 || c.operations+c.udpBudget.proofPending >= int(c.manifest.caps[3]) {
+		return false
+	}
+	if c.udpBudget.nextProofOperation >= ^uint64(0)-1 {
+		return false
+	}
+	c.udpBudget.nextProofOperation++
+	c.udpBudget.entries[c.udpBudget.used] = profileUDPRetainedOperation{namespace: 2, operation: c.udpBudget.nextProofOperation}
+	c.udpBudget.used++
+	c.udpBudget.proofPending++
+	return true
+}
+
+const profileUDPAssociationCredit = 133120
+
+type profileUDPReceiveResult struct {
+	bound      profileDestinationValue
+	n          int
+	tuple      [40]byte
+	cookie     uint64
+	flags      uint16
+	overflow   uint32
+	queueBytes int
+	gro        bool
+}
+
+// Нет FD/Write/Peek/option API. OS adapter обязан быть source-reviewed отдельно.
+type profileUDPReceiver interface {
+	Receive(context.Context, []byte) (profileUDPReceiveResult, error)
+	Close() error
+	Join() error
+}
+type profileUDPPhase byte
+
+const (
+	profileUDPBound profileUDPPhase = iota
+	profileUDPWaiting
+	profileUDPPermitted
+	profileUDPReading
+	profileUDPHeld
+	profileUDPMatched
+	profileUDPDenied
+	profileUDPClosing
+	profileUDPClosed
+	profileUDPUnknown
+)
+
+type profileUDPAssociation struct {
+	mu                                                        sync.Mutex
+	flow                                                      *profileFlowControl
+	launch                                                    profileLaunch
+	ctx                                                       context.Context
+	cancel                                                    context.CancelFunc
+	receiver                                                  profileUDPReceiver
+	phase                                                     profileUDPPhase
+	id, cookie, control, lastPacket, lastPermit, openSequence uint64
+	deadline                                                  time.Time
+	sent                                                      time.Time
+	consumedSent                                              time.Time
+	permit                                                    [256]byte
+	buffers                                                   [2][]byte
+	length, header                                            int
+	original                                                  profileDestinationValue
+	bound                                                     profileDestinationValue
+	readDone                                                  chan struct{}
+	closeDone                                                 chan struct{}
+	result                                                    error
+	flows                                                     int
+	credit                                                    bool
+	operation                                                 bool
+	operationSlot                                             int
+	closeStarted                                              bool
+}
+
+// Caller резервирует shared physical/FD custody ДО factory; этот consumer пока
+// не подключён к OS delivery. Никакой session credential не вызывает factory.
+func profileNewUDPAssociation(c *profileFlowControl, r profileLaunch, ctx context.Context, delivery []byte, factory func() (profileUDPReceiver, error)) (*profileUDPAssociation, error) {
+	if kind, e := profileUDPDecode(r, delivery, 1, true); e != nil || kind != 3 {
+		return nil, errProfile
+	}
+	id, cookie, control := u64(delivery, 144), u64(delivery, 152), u64(delivery, 136)
+	c.mu.Lock()
+	if ctx == nil || ctx.Err() != nil || !c.live() || c.udpBudget == nil || c.udpBudget.active >= 8 || !profileUDPId(id) || id <= c.udpBudget.lastAssociation || cookie == 0 || !profileUDPId(control) || control <= c.udpBudget.lastControl || factory == nil || c.buffered+c.manifest.memoryCredit+profileUDPAssociationCredit > uint64(c.manifest.caps[4]) {
+		c.mu.Unlock()
+		return nil, errProfile
+	}
+	if r != c.udpBudget.launch {
+		c.mu.Unlock()
+		return nil, errProfile
+	}
+	if u64(delivery, 128) != c.udpBudget.nextProofOperation+1 {
+		c.mu.Unlock()
+		return nil, errProfile
+	}
+	for _, old := range c.udpBudget.controls[:c.udpBudget.associations] {
+		if old == control {
+			c.mu.Unlock()
+			return nil, errProfile
+		}
+	}
+	if !c.udpReserveLocked() {
+		c.mu.Unlock()
+		return nil, errProfile
+	}
+	c.udpBudget.controls[c.udpBudget.associations] = control
+	c.udpBudget.associations++
+	c.udpBudget.lastAssociation = id
+	c.udpBudget.lastControl = control
+	creationSlot := c.udpBudget.used - 1
+	entry := &c.udpBudget.entries[creationSlot]
+	entry.association = id
+	entry.control = control
+	entry.cookie = cookie
+	c.udpBudget.active++
+	c.buffered += profileUDPAssociationCredit
+	c.mu.Unlock()
+	child, cancel := context.WithCancel(ctx)
+	a := &profileUDPAssociation{flow: c, launch: r, ctx: child, cancel: cancel, id: id, cookie: cookie, control: control, credit: true, closeDone: make(chan struct{})}
+	a.bound = profileDestinationValue{family: 4, network: 17, port: u16(delivery, 164), address: "127.0.0.1"}
+	a.buffers[0] = make([]byte, 65536)
+	a.buffers[1] = make([]byte, 65536)
+	var e error
+	a.receiver, e = factory()
+	c.mu.Lock()
+	c.udpBudget.proofPending--
+	c.udpBudget.entries[creationSlot].terminal = true
+	live := c.live()
+	c.mu.Unlock()
+	if e != nil || a.receiver == nil || child.Err() != nil || !live {
+		a.CloseAndJoin()
+		return a, errors.Join(errProfile, e, a.result)
+	}
+	return a, nil
+}
+func (a *profileUDPAssociation) BeginPeek(deadline time.Time) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.phase != profileUDPBound || a.ctx.Err() != nil {
+		return errProfile
+	}
+	a.flow.mu.Lock()
+	defer a.flow.mu.Unlock()
+	if !a.flow.live() || !a.flow.clock().Before(deadline) || !a.flow.udpReserveLocked() {
+		return errProfile
+	}
+	a.operation = true
+	a.operationSlot = a.flow.udpBudget.used - 1
+	entry := &a.flow.udpBudget.entries[a.operationSlot]
+	entry.association = a.id
+	entry.control = a.control
+	entry.cookie = a.cookie
+	a.deadline = deadline
+	a.sent = a.flow.clock()
+	limit := a.flow.clock().Add(time.Second)
+	if limit.Before(a.deadline) {
+		a.deadline = limit
+	}
+	if a.flow.sessionDeadline.Before(a.deadline) {
+		a.deadline = a.flow.sessionDeadline
+	}
+	if controlDeadline, ok := a.ctx.Deadline(); ok && controlDeadline.Before(a.deadline) {
+		a.deadline = controlDeadline
+	}
+	if !a.flow.clock().Before(a.deadline) {
+		a.flow.udpBudget.proofPending--
+		a.flow.udpBudget.entries[a.operationSlot].terminal = true
+		a.operation = false
+		return errProfile
+	}
+	a.phase = profileUDPWaiting
+	return nil
+}
+func (a *profileUDPAssociation) Permit(b []byte) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if kind, e := profileUDPDecode(a.launch, b, 0, true); e != nil || kind != 5 || a.phase != profileUDPWaiting || a.ctx.Err() != nil || u64(b, 128) != a.id || u64(b, 152) != a.cookie || u64(b, 136) <= a.lastPacket || u64(b, 144) <= a.lastPermit {
+		return a.rejectLocked()
+	}
+	// remaining отсчитывается от первоначального peek, а не receipt/нового permit.
+	until := a.sent.Add(time.Duration(u64(b, 240)))
+	if until.Before(a.deadline) {
+		a.deadline = until
+	}
+	if !a.flow.clock().Before(a.deadline) {
+		return a.rejectLocked()
+	}
+	a.flow.mu.Lock()
+	if !a.flow.live() || u64(b, 136) <= a.flow.udpBudget.lastPacket || u64(b, 144) <= a.flow.udpBudget.lastPermit {
+		a.flow.mu.Unlock()
+		return a.rejectLocked()
+	}
+	defer a.flow.mu.Unlock()
+	copy(a.permit[:], b)
+	a.lastPacket = u64(b, 136)
+	a.lastPermit = u64(b, 144)
+	a.flow.udpBudget.lastPacket = a.lastPacket
+	a.flow.udpBudget.lastPermit = a.lastPermit
+	entry := &a.flow.udpBudget.entries[a.operationSlot]
+	entry.packet = a.lastPacket
+	entry.permit = a.lastPermit
+	a.phase = profileUDPPermitted
+	return nil
+}
+func (a *profileUDPAssociation) live() bool {
+	a.flow.mu.Lock()
+	defer a.flow.mu.Unlock()
+	return a.flow.live()
+}
+
+// Только под a.mu. Ошибка peer/protocol не разрешает fallback к свежему permit.
+func (a *profileUDPAssociation) rejectLocked() error {
+	if !a.closeStarted {
+		a.result = errProfile
+		a.phase = profileUDPUnknown
+		a.cancel()
+	}
+	a.flow.mu.Lock()
+	a.flow.revoked = true
+	unknown := a.flow.udpBudget.unknown
+	a.flow.mu.Unlock()
+	if unknown != nil {
+		unknown()
+	}
+	return errProfile
+}
+func (a *profileUDPAssociation) ConsumePermit() error {
+	a.mu.Lock()
+	if a.phase != profileUDPPermitted || a.ctx.Err() != nil || !a.flow.clock().Before(a.deadline) || !a.live() {
+		a.mu.Unlock()
+		return errProfile
+	}
+	a.phase = profileUDPReading
+	a.readDone = make(chan struct{})
+	done := a.readDone
+	a.mu.Unlock()
+	defer close(done)
+	ctx, cancel := context.WithDeadline(a.ctx, a.deadline)
+	defer cancel()
+	got, e := a.receiver.Receive(ctx, a.buffers[0][:])
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.phase != profileUDPReading || ctx.Err() != nil || !a.flow.clock().Before(a.deadline) || !a.live() {
+		return errProfile
+	}
+	if e != nil || got.n <= 0 || got.n > 65507 || got.n != int(u32(a.permit[:], 200)) || got.cookie != a.cookie || got.bound != a.bound || got.tuple[1] != 4 || u16(got.tuple[:], 6) != a.bound.port || !bytes.Equal(got.tuple[24:28], []byte{127, 0, 0, 1}) || got.flags != 0 || got.overflow != 0 || got.queueBytes <= 0 || got.queueBytes > 128*1024 || got.gro || !bytes.Equal(got.tuple[:], a.permit[160:200]) {
+		return a.rejectLocked()
+	}
+	v, header, e := profileUDPSOCKSHeader(a.buffers[0][:got.n])
+	fingerprint := profileUDPFingerprint(a.launch, a.permit[:], a.buffers[0][:got.n])
+	if e != nil || header != int(u16(a.permit[:], 204)) || !bytes.Equal(fingerprint[:], a.permit[208:240]) {
+		return a.rejectLocked()
+	}
+	a.original, a.header, a.length = v, header, got.n
+	a.phase = profileUDPHeld
+	return nil
+}
+func (a *profileUDPAssociation) Consumed(openSequence uint64) ([256]byte, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	var out [256]byte
+	if a.phase != profileUDPHeld || a.openSequence != 0 || !profileUDPId(openSequence) || a.ctx.Err() != nil || !a.flow.clock().Before(a.deadline) || !a.live() {
+		return out, errProfile
+	}
+	out = a.permit
+	copy(out[:8], "YNKUCM01")
+	be.PutUint64(out[240:], openSequence)
+	a.openSequence = openSequence
+	a.consumedSent = a.flow.clock()
+	a.flow.mu.Lock()
+	a.flow.udpBudget.entries[a.operationSlot].runtimeSequence = openSequence
+	a.flow.mu.Unlock()
+	return out, nil
+}
+func (a *profileUDPAssociation) Match(b []byte) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if kind, e := profileUDPDecode(a.launch, b, 0, true); e != nil || kind != 7 || a.phase != profileUDPHeld || a.openSequence == 0 || u64(b, 128) != a.id || u64(b, 136) != a.lastPacket || u64(b, 144) != a.lastPermit || u64(b, 152) != a.openSequence || a.ctx.Err() != nil || !a.flow.clock().Before(a.deadline) || !a.live() {
+		return a.rejectLocked()
+	}
+	if b[160] == 2 {
+		a.phase = profileUDPDenied
+		return nil
+	}
+	if b[160] == 3 {
+		return a.rejectLocked()
+	}
+	until := a.consumedSent.Add(time.Duration(u64(b, 168)))
+	if until.Before(a.deadline) {
+		a.deadline = until
+	}
+	if !a.flow.clock().Before(a.deadline) {
+		return a.rejectLocked()
+	}
+	a.phase = profileUDPMatched
+	return nil
+}
+
+// Matched не даёт payload/grant API. Actor bridge должен отдельно доказать
+// private SourceFlow + AUTHORIZE/GRANT и downstream credit; пока forward закрыт.
+func (a *profileUDPAssociation) RetirePayload() error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.phase != profileUDPDenied {
+		return errProfile
+	}
+	clear(a.buffers[0][:])
+	clear(a.buffers[1][:])
+	a.length = 0
+	a.header = 0
+	a.openSequence = 0
+	a.consumedSent = time.Time{}
+	a.flow.mu.Lock()
+	if a.operation {
+		a.flow.udpBudget.proofPending--
+		a.flow.udpBudget.entries[a.operationSlot].terminal = true
+		a.operation = false
+	}
+	a.flow.mu.Unlock()
+	a.phase = profileUDPBound
+	return nil
+}
+func (a *profileUDPAssociation) CloseAndJoin() error {
+	a.mu.Lock()
+	if a.closeStarted {
+		done := a.closeDone
+		a.mu.Unlock()
+		<-done
+		a.mu.Lock()
+		defer a.mu.Unlock()
+		return a.result
+	}
+	a.closeStarted = true
+	prior := a.result
+	a.phase = profileUDPClosing
+	a.cancel()
+	reader := a.readDone
+	a.mu.Unlock()
+	var e error
+	if a.receiver != nil {
+		e = errors.Join(a.receiver.Close(), a.receiver.Join())
+	}
+	if reader != nil {
+		<-reader
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.result = errors.Join(prior, e)
+	clear(a.buffers[0][:])
+	clear(a.buffers[1][:])
+	a.length = 0
+	a.header = 0
+	if a.flows != 0 {
+		a.result = errors.Join(a.result, errProfile)
+	}
+	if a.result != nil {
+		a.phase = profileUDPUnknown
+	} else {
+		a.phase = profileUDPClosed
+	}
+	a.flow.mu.Lock()
+	if a.operation {
+		a.flow.udpBudget.proofPending--
+		a.flow.udpBudget.entries[a.operationSlot].terminal = true
+		a.operation = false
+	}
+	if a.result == nil && a.credit {
+		a.flow.buffered -= profileUDPAssociationCredit
+		a.flow.udpBudget.active--
+		a.credit = false
+	}
+	if a.result != nil {
+		a.flow.revoked = true
+	}
+	unknown := a.flow.udpBudget.unknown
+	a.flow.mu.Unlock()
+	if a.result != nil && unknown != nil {
+		unknown()
+	}
+	if a.result == nil {
+		a.receiver = nil
+		a.buffers = [2][]byte{}
+	}
+	close(a.closeDone)
+	return a.result
+}
+
+// Production caller до native UDP factory. Ни control TCP proof, ни config
+// UdpEnabled не создают association authority. Delivery/actor bridge ещё closed.
+func ProfileSOCKSUDPRequiresPrivateControl(ctx context.Context) bool {
+	p := profileRuntime(ctx)
+	return p != nil && (p.admission.launch.mode == 2 || p.proofs != nil && p.proofs.version == 2)
+}
+func ProfileAdmitSOCKSUDPControl(ctx context.Context) error {
+	p := profileRuntime(ctx)
+	if p == nil || !p.flowFresh() {
+		return errProfile
+	}
+	a, _ := ctx.Value(profileAcceptedKey{}).(*profileAccepted)
+	if a == nil || a.runtime != p || a.provenance != 2 || a.proof == nil || int(a.index) >= len(p.flow.manifest.rows[6]) || p.flow.manifest.rows[6][a.index][0] != 2 {
+		return errProfile
+	}
+	return ErrProfileUnsupported
+}
