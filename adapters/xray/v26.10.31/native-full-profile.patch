+	o := &Observer{ctx: ctx, config: &Config{ProbeUrl: "http://synthetic.invalid/health"}}
+	result := o.probeWithClient("subject", func(*http.Client, *http.Request) (*http.Response, error) {
+		t.Fatal("cancelled probe reached HTTP client")
+		return nil, nil
+	})
+	if result.Alive {
+		t.Fatal("cancelled probe Alive")
+	}
+}
