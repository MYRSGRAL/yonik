+func (c *ownedFlowPacket) ReadFrom(b []byte) (int, net.Addr, error) {
+	if e := hooks.BeforeSocketDial(c.owner.ctx); e != nil {
+		return 0, nil, e
+	}
+	n, a, e := c.packet.ReadFrom(b)
+	if guard := hooks.BeforeSocketDial(c.owner.ctx); guard != nil {
+		return 0, nil, guard
+	}
+	return n, a, e
