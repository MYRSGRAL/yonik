+//go:embed profile-numeric-rust-v3.json
+var profileNumericRustVectors []byte
+
+func numericGolden(t *testing.T, mode byte, flow uint64) (profilePacket, []byte) {
+	t.Helper()
+	var corpus struct {
+		Vectors []struct {
+			System                   bool
+			Flow                     uint64
+			FrameHex, NumericBodyHex string
+		}
+	}
+	if err := json.Unmarshal(profileNumericRustVectors, &corpus); err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range corpus.Vectors {
+		if v.System == (mode == 2) && v.Flow == flow {
+			raw, err := hex.DecodeString(v.FrameHex)
+			if err != nil {
+				t.Fatal(err)
+			}
+			body, err := hex.DecodeString(v.NumericBodyHex)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(raw) != 184 || u16(raw, 10) != 19 || !profileDNSV2Body(42, body) {
+				t.Fatal("Rust vector shape")
+			}
+			launch := profileLaunch{mode: mode, generation: 4, epoch: 5}
+			for i := range launch.session {
+				launch.session[i] = 1
+				launch.invocation[i] = 2
+			}
+			for i := range launch.digest {
+				launch.digest[i] = 3
+			}
+			packet, err := launch.decodePacket(raw, u64(raw, 16))
+			if err != nil {
+				t.Fatal("Rust frame Go decode", err)
+			}
+			packet.body = append([]byte(nil), packet.body...)
+			return packet, body
+		}
+	}
+	t.Fatal("missing Rust encoder vector")
+	return profilePacket{}, nil
+}
+
+type numericResult struct {
+	ctx     context.Context
+	release func()
+	target  xnet.Destination
+	handled bool
+	err     error
+}
+type numericHarness struct {
+	wire   *dnsDirectHarness
+	data   *ProfileDNSProducerData
+	source context.Context
+	target xnet.Destination
+	done   chan numericResult
+}
+
+func numericPublished(t *testing.T, mode, network byte) *numericHarness {
+	t.Helper()
+	h, conn, _, data, published := dnsWirePublishStart(t, network, mode, 1)
+	t.Cleanup(func() { _ = conn.Close() })
+	op := h.next(t, 40)
+	if err := h.f.c.accept(dnsWirePublished(op)); err != nil {
+		t.Fatal(err)
+	}
+	d := <-data
+	if err := <-published; err != nil {
+		t.Fatal(err)
+	}
+	h.f.c.nextDNSQuery = h.b.exchange.id
+	r := h.b.exchange.query.receipt
+	ctx, err := ProfileSelectRoute(h.b.exchange.query.ctx, "a", profileNumericDestination(r.original))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &numericHarness{wire: h, data: d, source: ctx, target: profileNumericDestination(r.original)}
+}
+func (n *numericHarness) launch(t *testing.T, ctx context.Context, target xnet.Destination) {
+	t.Helper()
+	n.done = make(chan numericResult, 1)
+	lookup := func(query context.Context, name string) ([]net.IP, uint32, error) {
+		request, dnsTarget, err := ProfileDNSDataRequest(query, n.data)
+		if err != nil {
+			return nil, 0, err
+		}
+		exchange, release, err := ProfileDNSExchangeContext(query, request, dnsTarget)
+		if err != nil {
+			return nil, 0, err
+		}
+		selected, releasePath, _, err := ProfileDNSPrepareHandler(exchange, "a", dnsTarget, false, nil)
+		if err != nil {
+			release()
+			return nil, 0, err
+		}
+		if err = ProfileDNSBindWaiter(selected, n.data); err != nil {
+			releasePath()
+			release()
+			return nil, 0, err
+		}
+		context.AfterFunc(query, func() { releasePath(); release() })
+		ips, ttl, err := ProfileDNSDataAnswer(selected, n.data)
+		if err != nil {
+			return nil, 0, err
+		}
+		return ProfileFinishDNSAnswer(query, name, ips, ttl)
+	}
+	go func() {
+		ctx, release, dest, handled, err := ProfilePrepareNumericHandler(ctx, "a", target, false, lookup)
+		n.done <- numericResult{ctx, release, dest, handled, err}
+	}()
+}
+func (n *numericHarness) dnsTo42(t *testing.T) *profileOperation {
+	t.Helper()
+	h := n.wire
+	op := h.next(t, 18)
+	if h.f.grantID < h.f.c.highestGrant {
+		h.f.grantID = h.f.c.highestGrant
+	}
+	if err := h.f.c.accept(serviceReply(h.f, op)); err != nil {
+		t.Fatal(err)
+	}
+	op = h.next(t, 55)
+	if err := h.f.c.accept(dnsBundleReply(op, uint64(41+h.f.c.dnsRequestUsed), 1)); err != nil {
+		t.Fatal(err)
+	}
+	op = h.next(t, 35)
+	if op.body[2] != 3 {
+		t.Fatal("not own waiter role")
+	}
+	if err := h.f.c.accept(dnsWireWaiterReply(op)); err != nil {
+		t.Fatal(err)
+	}
+	op = h.next(t, 53)
+	if err := h.f.c.accept(dnsWireWaiterReply(op)); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case op = <-h.f.p.flowQueue:
+		if op.kind != 42 || op.dnsNumeric == nil {
+			t.Fatal("not Numeric42")
+		}
+		return op
+	case result := <-n.done:
+		t.Fatal("caller ended before Numeric42", result.err)
+	case <-time.After(time.Second):
+		t.Fatal("missing Numeric42")
+	}
+	return nil
+}
+func (n *numericHarness) ack(t *testing.T, op *profileOperation) profilePacket {
+	t.Helper()
+	c := n.wire.f.c
+	reply, body := numericGolden(t, c.mode, op.receipt.id)
+	if !bytes.Equal(op.body, body) {
+		t.Fatalf("Go42 differs from Rust encoder\nGo %x\nRust %x", op.body, body)
+	}
+	if err := c.dispatch(op); err != nil {
+		t.Fatal(err)
+	}
+	reply.reply = op.sequence
+	if err := c.accept(reply); err != nil {
+		t.Fatal(err)
+	}
+	return reply
+}
+func (n *numericHarness) result(t *testing.T) numericResult {
+	t.Helper()
+	select {
+	case r := <-n.done:
+		return r
+	case <-time.After(time.Second):
+		t.Fatal("numeric caller not settled")
+	}
+	return numericResult{}
+}
