+func (c *profileFlowControl) dnsReserveHistory(n int) bool {
+	used := c.dnsHistoryUsed + c.dnsTasksUsed + c.operations
+	if c.udpBudget != nil {
+		used = c.udpBudget.used
+	} else {
+		for _, t := range c.tombs {
+			if t.sequence != 0 {
+				used++
+			}
+		}
+	}
+	if used+n > min(int(c.manifest.caps[7]), 256) {
+		return false
+	}
+	if c.udpBudget != nil {
+		for i := 0; i < n; i++ {
+			c.udpBudget.entries[c.udpBudget.used] = profileUDPRetainedOperation{namespace: 10}
+			c.udpBudget.used++
+		}
+	}
+	c.dnsHistoryUsed += n
+	return true
+}
+func (c *profileFlowControl) dnsAcquire(e *profileDNSExchange, path [256]profileDNSHop, targets [256]profileDestinationValue, count int, renew *profileDNSBundle, callers ...context.Context) (*profileDNSBundle, *profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.dnsRootLive(e) || !e.query.runtime.dnsV2 || c.manifest.mapping != 4 || count < 1 || count > 256 || c.dnsRequestUsed >= len(c.dnsRequests) {
+		return nil, nil, errProfile
+	}
+	caller := e.ctx
+	if len(callers) > 0 {
+		caller = callers[0]
+	}
+	if caller == nil || caller.Err() != nil || profileDNSExchangeFrom(caller) != e || profileQueryFrom(caller) != e.query || profileReceiptFrom(caller) != e.query.receipt {
+		return nil, nil, errProfile
+	}
+	if renew == nil && e.bundle != nil {
+		return nil, nil, errProfile
+	}
+	if renew == nil {
+		for _, x := range c.dnsContexts4[:c.dnsContext4Used] {
+			if x.source.query == e.id {
+				return nil, nil, errProfile
+			}
+		}
+	}
+	if renew != nil {
+		if renew.exchange != e || renew.queryID != e.id || renew.original != e.original || renew.qtype != e.qtype || renew.options != e.options || renew.payload != e.payload || renew.resolver != e.root.resolver || !c.dnsBundleLive(renew) || renew.revision >= ^uint64(0)-1 {
+			return nil, nil, errProfile
+		}
+		if renew.pending != nil {
+			return renew, renew.pending, nil
+		}
+		if renew.count != count || renew.path != path || renew.targets != targets {
+			return nil, nil, errProfile
+		}
+	}
+	if !profileDNSV2ID(e.id) || !profileDNSV2Name([]byte(e.original), false) || len(e.original) > 253 || e.qtype != 1 && e.qtype != 28 {
+		return nil, nil, errProfile
+	}
+	addressBytes := func(v profileDestinationValue) int {
+		if v.family == 4 {
+			return 4
+		}
+		if v.family == 6 {
+			return 16
+		}
+		return len(v.address)
+	}
+	baseLen := 20 + 8 + addressBytes(e.root.receipt.original) + 8 + addressBytes(e.root.effective) + 4 + len(e.root.query) + 16
+	bodyLen := 72 + baseLen + len(e.original) + 4*count
+	pending := 2
+	history := 2 + count
+	credit := uint64(profileDNSBundleRenewCredit)
+	if renew == nil {
+		pending = 3
+		history = 3 + count
+		// Bundle, fixed path arrays, body/contexts и retained query/root
+		// metadata оплачены до первого make и issuer effects.
+		credit = profileDNSBundleBaseCredit + uint64(count)*profileDNSBundleHopCredit
+	}
+	total := c.profilePendingUsed() + pending
+	grants := c.dnsHopCredits
+	for _, g := range c.grants {
+		if g != nil {
+			grants++
+		}
+	}
+	if total > min(int(c.manifest.caps[3]), 64) || bodyLen > 2164 || c.buffered+c.manifest.memoryCredit+credit > uint64(c.manifest.caps[4]) || renew == nil && (grants+count > int(c.manifest.caps[0]) || c.dnsExportedUsed >= len(c.dnsExported)) || !c.dnsReserveHistory(history) {
+		return nil, nil, errProfileFlowBusy
+	}
+	c.operations += pending
+	c.buffered += credit
+	base := c.dnsBody(e.root)
+	b := renew
+	if b == nil {
+		ctx, cancel := context.WithCancel(e.ctx)
+		b = &profileDNSBundle{exchange: e, path: path, targets: targets, count: count, ctx: ctx, cancel: cancel, rootID: e.root.id, rootRevision: e.root.revision, queryID: e.id, original: e.original, qtype: e.qtype, options: e.options, payload: e.payload, resolver: e.root.resolver, credit: credit, retained: profileDNSBundleRetainedCredit}
+		b.identity = c.dnsReserveContextIdentity(profileDNSUserRoot)
+		e.bundle = b
+		e.query.refs++
+		c.dnsHopCredits += count
+	} else {
+		b.credit += credit
+		b.retained += credit
+	}
+	body := make([]byte, bodyLen)
+	be.PutUint16(body, 2)
+	be.PutUint64(body[8:], e.root.id)
+	be.PutUint64(body[16:], e.id)
+	be.PutUint64(body[24:], e.query.runtime.admission.launch.epoch)
+	be.PutUint64(body[40:], uint64(time.Second))
+	be.PutUint16(body[48:], uint16(len(base)))
+	be.PutUint16(body[50:], uint16(count))
+	be.PutUint16(body[52:], e.qtype)
+	be.PutUint16(body[54:], e.options)
+	be.PutUint16(body[56:], e.payload)
+	be.PutUint16(body[58:], uint16(len(e.original)))
+	be.PutUint16(body[60:], e.root.resolver)
+	if renew != nil {
+		be.PutUint64(body[32:], b.id)
+		be.PutUint64(body[64:], b.revision)
+	}
+	at := 72
+	copy(body[at:], base)
+	at += len(base)
+	copy(body[at:], e.original)
+	at += len(e.original)
+	for _, hop := range path[:count] {
+		be.PutUint16(body[at:], hop.scope)
+		body[at+2] = hop.branch
+		at += 4
+	}
+	rpc := &profileDNSBundleRPC{bundle: b, renewal: renew != nil, credit: credit}
+	op := &profileOperation{ctx: caller, kind: 55, body: body, done: make(chan struct{}), dns: rpc}
+	b.pending = op
+	c.dnsRequests[c.dnsRequestUsed] = op
+	c.dnsRequestUsed++
+	e.root.pending++
+	return b, op, nil
+}
+func (c *profileFlowControl) dnsNotify(op *profileOperation, e error) {
+	if !op.completed {
+		op.completed = true
+		op.err = e
+		close(op.done)
+	}
+}
+func (c *profileFlowControl) dnsSettle(op *profileOperation) {
+	r := op.dns
+	if r.settled || !r.replied || r.cancelSequence != 0 && !r.cancelAck {
+		return
+	}
+	r.settled = true
+	c.operations -= 2
+	r.bundle.exchange.root.pending--
+	if r.bundle.pending == op {
+		r.bundle.pending = nil
+	}
+}
+func (c *profileFlowControl) dnsRelease(b *profileDNSBundle) {
+	if b.released || b.unknown || !b.closed || b.pending != nil || b.id != 0 && !b.closeAck || !c.dnsDirectReleasedForBundle(b) {
+		return
+	}
+	b.released = true
+	c.operations--
+	c.dnsHopCredits -= b.count
+	b.exchange.query.refs--
+	b.exchange.query.releaseLocked()
+	c.buffered -= b.credit - b.retained
+	b.credit = b.retained
+}
+func (c *profileFlowControl) dnsUnknown(b *profileDNSBundle) {
+	b.unknown = true
+	b.closed = true
+	b.cancel()
+}
+func (c *profileFlowControl) dnsFinish(op *profileOperation, e error) {
+	b := op.dns.bundle
+	c.dnsNotify(op, e)
+	if !op.submitted {
+		b.closed = true
+		b.cancel()
+		op.dns.replied = true
+		c.dnsSettle(op)
+		c.dnsRelease(b)
+	} else {
+		c.dnsUnknown(b)
+	}
+}
+func (c *profileFlowControl) dnsDispatch(op *profileOperation) error {
+	if op.submitted || op.completed {
+		return nil
+	}
+	b := op.dns.bundle
+	if b.closed || op.ctx.Err() != nil || !c.dnsRootLive(b.exchange) {
+		c.dnsFinish(op, errProfile)
+		return nil
+	}
+	op.sent = c.clock()
+	op.deadline = op.sent.Add(time.Second)
+	r := op.dns
+	r.rootDeadline = b.exchange.root.deadline
+	r.ownerDeadline = b.exchange.root.ownerDeadline
+	for _, deadline := range []time.Time{r.rootDeadline, c.sessionDeadline} {
+		if deadline.Before(op.deadline) {
+			op.deadline = deadline
+		}
+	}
+	if c.serviceOwnerRequired(b.exchange.root) && r.ownerDeadline.Before(op.deadline) {
+		op.deadline = r.ownerDeadline
+	}
+	if deadline, ok := op.ctx.Deadline(); ok && deadline.Before(op.deadline) {
+		op.deadline = deadline
+	}
+	r.leaseLimit = op.deadline
+	if r.renewal && b.deadline.Before(op.deadline) {
+		op.deadline = b.deadline
+	}
+	if !op.sent.Before(op.deadline) || !profileDNSV2Body(55, op.body) {
+		c.dnsFinish(op, errProfile)
+		return nil
+	}
+	if c.lastSent >= ^uint64(0)-1 {
+		c.dnsFinish(op, errProfile)
+		return errProfile
+	}
+	// Новый lease ограничен fresh root/session; deadline ожидания renewal ACK
+	// отдельно ограничен старым bundle, чтобы expiry не превращался в resurrection.
+	be.PutUint64(op.body[40:], uint64(r.leaseLimit.Sub(op.sent)))
+	seq, e := c.write(55, 0, op.body)
+	if e != nil {
+		op.submitted = true
+		c.dnsFinish(op, e)
+		return e
+	}
+	op.sequence = seq
+	op.submitted = true
+	if !profileDNSV2ID(seq) {
+		c.dnsUnknown(b)
+		return errProfile
+	}
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	return nil
+}
+func (c *profileFlowControl) dnsCancel(target byte, id uint64) (uint64, error) {
+	if c.lastSent >= ^uint64(0)-1 {
+		return 0, errProfile
+	}
+	body := make([]byte, 24)
+	be.PutUint16(body, 2)
+	body[2] = target
+	be.PutUint64(body[8:], id)
+	seq, e := c.write(47, 0, body)
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	if e != nil || !profileDNSV2ID(seq) {
+		return seq, errors.Join(errProfile, e)
+	}
+	return seq, nil
+}
+func (c *profileFlowControl) dnsClose(b *profileDNSBundle) {
+	if !b.closed {
+		b.closed = true
+		b.cancel()
+	}
+}
+func (c *profileFlowControl) dnsAccept(f profilePacket) error {
+	if f.object != 0 || !profileDNSV2Body(f.kind, f.body) {
+		return errProfile
+	}
+	for _, op := range c.dnsRequests[:c.dnsRequestUsed] {
+		r := op.dns
+		b := r.bundle
+		if f.reply == op.sequence && op.submitted && f.kind == 56 {
+			if r.replied {
+				if f.body[2] == 1 {
+					b.rejectedID = u64(f.body, 8)
+					c.dnsUnknown(b)
+				}
+				return errProfile
+			}
+			r.replied = true
+			data := f.body
+			if data[2] != 1 {
+				c.dnsNotify(op, errProfile)
+				c.dnsClose(b)
+				if data[2] == 3 {
+					c.dnsUnknown(b)
+					return nil
+				}
+				c.dnsSettle(op)
+				c.dnsRelease(b)
+				return nil
+			}
+			id, revision := u64(data, 8), u64(data, 56)
+			if u64(data, 16) != b.rootID || u64(data, 24) != b.queryID || u64(data, 24) != u64(op.body, 16) || u64(data, 32) != b.exchange.query.runtime.admission.launch.epoch || u64(data, 40) > u64(op.body, 40) || int(u16(data, 48)) != b.count || !r.renewal && revision != 1 || r.renewal && (id != b.id || b.revision != u64(op.body, 64) || revision != u64(op.body, 64)+1) {
+				b.rejectedID = id
+				c.dnsUnknown(b)
+				c.dnsNotify(op, errProfile)
+				return errProfile
+			}
+			if !r.renewal {
+				if !c.dnsClaimContextIdentity(b.identity, id) {
+					c.dnsUnknown(b)
+					c.dnsNotify(op, errProfile)
+					return errProfile
+				}
+				b.id = id
+			}
+			deadline := op.sent.Add(time.Duration(u64(data, 40)))
+			if r.leaseLimit.Before(deadline) {
+				deadline = r.leaseLimit
+			}
+			if b.closed || op.ctx.Err() != nil || !c.dnsRootLive(b.exchange) || !c.clock().Before(deadline) || !c.clock().Before(op.deadline) {
+				c.dnsClose(b)
+				c.dnsNotify(op, errProfile)
+				c.dnsSettle(op)
+				return nil
+			}
+			b.id, b.revision, b.deadline = id, revision, deadline
+			b.renewLead = deadline.Sub(op.sent) / 4
+			c.dnsNotify(op, nil)
+			c.dnsSettle(op)
+			return nil
+		}
+		if f.kind == 48 && f.reply != 0 && (f.reply == r.cancelSequence || f.reply == b.closeSequence) {
+			if f.body[2] != 1 {
+				c.dnsUnknown(b)
+				return nil
+			}
+			expected := op.sequence
+			if f.reply == b.closeSequence {
+				expected = b.id
+			}
+			if u64(f.body, 8) != expected {
+				return errProfile
+			}
+			if f.reply == r.cancelSequence {
+				if r.cancelAck {
+					return errProfile
+				}
+				r.cancelAck = true
+				c.dnsSettle(op)
+			} else {
+				if b.closeAck {
+					return errProfile
+				}
+				if until, ok := c.dnsDirectBundleCleanupWindow(b); ok && !c.clock().Before(until) {
+					c.dnsUnknown(b)
+					return errProfile
+				}
+				b.closeAck = true
+			}
+			c.dnsRelease(b)
+			return nil
+		}
+	}
+	return errProfile
+}
+func (c *profileFlowControl) dnsTick() error {
+	if err := c.hostsObservationTick(); err != nil {
+		return err
+	}
+	if err := c.dnsContext4Tick(); err != nil {
+		return err
+	}
+	if err := c.numericTick(); err != nil {
+		return err
+	}
+	if err := c.dnsResultsTick(); err != nil {
+		return err
+	}
+	if err := c.dnsDirectTick(); err != nil {
+		return err
+	}
+	for _, op := range c.dnsRequests[:c.dnsRequestUsed] {
+		r := op.dns
+		b := r.bundle
+		if !c.dnsRootLive(b.exchange) || b.id != 0 && !c.clock().Before(b.deadline) || b.ctx.Err() != nil || !r.replied && op.ctx.Err() != nil {
+			c.dnsClose(b)
+		}
+		if !op.submitted && b.closed {
+			c.dnsFinish(op, errProfile)
+		}
+		if op.submitted && !r.replied && (b.closed || !c.clock().Before(op.deadline)) {
+			c.dnsClose(b)
+			c.dnsNotify(op, errProfile)
+			if r.cancelSequence == 0 {
+				seq, e := c.dnsCancel(1, op.sequence)
+				if e != nil {
+					c.dnsUnknown(b)
+					return e
+				}
+				r.cancelSequence = seq
+			}
+			if !c.clock().Before(op.deadline) {
+				if r.cancelAck {
+					r.replied = true
+					c.dnsSettle(op)
+				} else if !c.clock().Before(op.deadline.Add(time.Second)) {
+					c.dnsUnknown(b)
+				}
+			}
+		}
+		if b.closed && b.id != 0 && !b.closeSent && c.dnsDirectReleasedForBundle(b) {
+			if until, ok := c.dnsDirectBundleCleanupWindow(b); ok && !c.clock().Before(until) {
+				c.dnsUnknown(b)
+				continue
+			}
+			seq, e := c.dnsCancel(8, b.id)
+			if e != nil {
+				c.dnsUnknown(b)
+				return e
+			}
+			b.closeSequence = seq
+			b.closeSent = true
+		}
+		c.dnsRelease(b)
+	}
+	return nil
+}
+
+func (c *profileFlowControl) dnsFloor(floor uint64) uint64 {
+	floor = c.hostsObservationFloor(floor)
+	floor = c.dnsContext4Floor(floor)
+	floor = c.numericFloor(floor)
+	floor = c.dnsResultsFloor(floor)
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		if t.released {
+			continue
+		}
+		for _, op := range t.requests[:t.used] {
+			if op.sequence != 0 && !op.dnsDirect.received && op.sequence < floor {
+				floor = op.sequence
+			}
+			if op.dnsDirect.cancelSequence != 0 && !op.dnsDirect.cancelAck && op.dnsDirect.cancelSequence < floor {
+				floor = op.dnsDirect.cancelSequence
+			}
+		}
+	}
+	for _, op := range c.dnsRequests[:c.dnsRequestUsed] {
+		r := op.dns
+		b := r.bundle
+		for _, ref := range []struct {
+			sequence uint64
+			pending  bool
+		}{{op.sequence, !r.settled}, {r.cancelSequence, !r.cancelAck}, {b.closeSequence, !b.closeAck}} {
+			if ref.pending && ref.sequence != 0 && ref.sequence < floor {
+				floor = ref.sequence
+			}
+		}
+	}
+	return floor
+}
+
+func (c *profileFlowControl) dnsCleanupResult() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, h := range c.hostsObservations[:c.hostsObservationUsed] {
+		if !h.released || h.unknown {
+			return ErrProfileCleanupUnknown
+		}
+	}
+	for _, x := range c.dnsContexts4[:c.dnsContext4Used] {
+		if !x.released || x.unknown {
+			return ErrProfileCleanupUnknown
+		}
+	}
+	for _, n := range c.numerics[:c.numericUsed] {
+		if !n.released || n.unknown || n.rejectedID != 0 {
+			return ErrProfileCleanupUnknown
+		}
+	}
+	for _, o := range c.dnsResults[:c.dnsResultUsed] {
+		if !o.released || o.unknown {
+			return ErrProfileCleanupUnknown
+		}
+	}
+	if c.dnsScratchUnknown || c.rxLeased {
+		return ErrProfileCleanupUnknown
+	}
+	for _, t := range c.dnsDirect[:c.dnsDirectUsed] {
+		if !t.released || t.unknown {
+			return ErrProfileCleanupUnknown
+		}
+	}
+	for _, op := range c.dnsRequests[:c.dnsRequestUsed] {
+		b := op.dns.bundle
+		if b.unknown || b.rejectedID != 0 || op.submitted && !op.dns.settled || b.id != 0 && !b.closeAck {
+			return ErrProfileCleanupUnknown
+		}
+	}
+	return nil
+}
+
+func ProfileDNSPrepareHandler(ctx context.Context, tag string, target xnet.Destination, mux bool, choose func(string, xnet.Destination) (bool, error)) (context.Context, func(), bool, error) {
+	noop := func() {}
+	e := profileDNSExchangeFrom(ctx)
+	if e == nil {
+		return ctx, noop, false, nil
+	}
+	if _, ok := ctx.Value(profileDNSBundleKey{}).(profileDNSBundleUse); ok {
+		return ctx, noop, true, ProfileDNSBundleGuard(ctx, tag, target, mux)
+	}
+	p := profileRuntime(ctx)
+	if p == nil || e.query.runtime != p || profileQueryFrom(ctx) != e.query || profileReceiptFrom(ctx) != e.query.receipt || !p.dnsV2 {
+		return ctx, noop, true, ErrProfileUnsupported
+	}
+	p.flow.mu.Lock()
+	live := p.flow.dnsRootLive(e)
+	p.flow.mu.Unlock()
+	if ctx.Err() != nil || !live {
+		return ctx, noop, true, errProfile
+	}
+	value, err := profileValue(target)
+	if err != nil || value != e.target {
+		return ctx, noop, true, errProfile
+	}
+	path, targets, count, err := profileDNSChosenPath(&p.flow.manifest, tag, value, mux, choose)
+	if err != nil {
+		return ctx, noop, true, err
+	}
+	resolver := p.flow.manifest.rows[4][e.root.resolver]
+	rootSubject, _ := profileSubject(&p.flow.manifest, tag)
+	if u16(resolver, 2) != 65535 && u16(resolver, 2) != rootSubject {
+		return ctx, noop, true, ErrProfileUnsupported
+	}
+	b, op, err := p.flow.dnsAcquire(e, path, targets, count, nil, ctx)
+	if err != nil {
+		return ctx, noop, true, err
+	}
+	if err = p.flowRPC(op); err != nil {
+		return ctx, noop, true, err
+	}
+	// Сохраняем native route/session values caller; lifetime ограничен также
+	// private bundle. Background/WithoutCancel здесь authority не переносят.
+	consumer, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(b.ctx, cancel)
+	next := context.WithValue(consumer, profileDNSBundleKey{}, profileDNSBundleUse{b, 0})
+	release := func() { p.flow.mu.Lock(); p.flow.dnsClose(b); p.flow.mu.Unlock() }
+	return next, func() { stop(); cancel(); release() }, true, nil
+}
+func ProfileDNSRefreshBundle(ctx context.Context) error {
+	if ctx == nil {
+		return errProfile
+	}
+	use, ok := ctx.Value(profileDNSBundleKey{}).(profileDNSBundleUse)
+	if !ok {
+		return errProfile
+	}
+	b := use.bundle
+	p := profileRuntime(ctx)
+	if p == nil || b.exchange.query.runtime != p || profileDNSExchangeFrom(ctx) != b.exchange || profileQueryFrom(ctx) != b.exchange.query || profileReceiptFrom(ctx) != b.exchange.query.receipt {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	live := c.dnsBundleLive(b)
+	c.mu.Unlock()
+	if !live {
+		return errProfile
+	}
+	if err := profileEnsureService(ctx, b.exchange.root); err != nil {
+		return err
+	}
+	_, op, err := c.dnsAcquire(b.exchange, b.path, b.targets, b.count, b, ctx)
+	if err != nil {
+		return err
+	}
+	return p.flowRPC(op)
+}
+func ProfileDNSBundleGuard(ctx context.Context, tag string, target xnet.Destination, mux bool) error {
+	if ctx == nil {
+		return errProfile
+	}
+	p := profileRuntime(ctx)
+	use, ok := ctx.Value(profileDNSBundleKey{}).(profileDNSBundleUse)
+	if p == nil || !ok || use.bundle == nil || profileDNSExchangeFrom(ctx) != use.bundle.exchange || profileQueryFrom(ctx) != use.bundle.exchange.query || profileReceiptFrom(ctx) != use.bundle.exchange.query.receipt || use.bundle.exchange.query.runtime != p || ctx.Err() != nil || !p.flowFresh() {
+		return errProfile
+	}
+	b := use.bundle
+	c := p.flow
+	c.mu.Lock()
+	live := c.dnsBundleLive(b)
+	renew := live && b.deadline.Sub(c.clock()) <= b.renewLead
+	c.mu.Unlock()
+	if !live {
+		return errProfile
+	}
+	if renew {
+		if err := ProfileDNSRefreshBundle(ctx); err != nil {
+			return err
+		}
+	}
+	value, err := profileValue(target)
+	if err != nil {
+		return err
+	}
+	branch := byte(0)
+	if mux {
+		branch = 1
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.dnsBundleLive(b) || use.index < 0 || use.index >= b.count || b.path[use.index].branch != branch || b.targets[use.index] != value {
+		return errProfile
+	}
+	subject, found := profileSubject(&c.manifest, tag)
+	if !found || u16(c.manifest.rows[8][b.path[use.index].scope], 0) != subject {
+		return errProfile
+	}
+	return nil
+}
+
+func profileDNSChainContext(ctx context.Context, target xnet.Destination, nextTag string) (context.Context, error) {
+	use, ok := ctx.Value(profileDNSBundleKey{}).(profileDNSBundleUse)
+	p := profileRuntime(ctx)
+	if !ok || p == nil || use.bundle == nil || profileDNSExchangeFrom(ctx) != use.bundle.exchange || profileQueryFrom(ctx) != use.bundle.exchange.query || profileReceiptFrom(ctx) != use.bundle.exchange.query.receipt {
+		return ctx, errProfile
+	}
+	b := use.bundle
+	c := p.flow
+	value, err := profileValue(target)
+	if err != nil {
+		return ctx, err
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	next := use.index + 1
+	if !c.dnsBundleLive(b) || next < 1 || next >= b.count || b.targets[next] != value {
+		return ctx, errProfile
+	}
+	subject, found := profileSubject(&c.manifest, nextTag)
+	scope := b.path[next].scope
+	if !found || u16(c.manifest.rows[8][scope], 0) != subject {
+		return ctx, errProfile
+	}
+	child := context.WithValue(ctx, profileDNSBundleKey{}, profileDNSBundleUse{b, next})
+	return context.WithValue(child, profileRouteKey{}, profileSelectedRoute{subject: subject, scope: scope, branches: 1 << b.path[next].branch, effective: value, chained: true}), nil
+}
