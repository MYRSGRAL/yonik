+type profileUDPPhase byte
+
+const (
+	profileUDPBound profileUDPPhase = iota
+	profileUDPWaiting
+	profileUDPPermitted
+	profileUDPReading
+	profileUDPHeld
+	profileUDPMatched
+	profileUDPDenied
+	profileUDPClosing
+	profileUDPClosed
+	profileUDPUnknown
+)
+
+type profileUDPAssociation struct {
+	reply                                                     func(context.Context, []byte, [40]byte, func() error) error
+	mu                                                        sync.Mutex
+	flow                                                      *profileFlowControl
+	launch                                                    profileLaunch
+	ctx                                                       context.Context
+	cancel                                                    context.CancelFunc
+	receiver                                                  profileUDPReceiver
+	phase                                                     profileUDPPhase
+	id, cookie, control, lastPacket, lastPermit, openSequence uint64
+	deadline                                                  time.Time
+	sent                                                      time.Time
+	consumedSent                                              time.Time
+	permit                                                    [256]byte
+	buffers                                                   [2][]byte
