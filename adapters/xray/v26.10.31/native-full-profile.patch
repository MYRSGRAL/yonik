+// Opaque control/relay custody. Endpoint — DATA для SOCKS reply, не FlowGrant;
+// raw FD, socket writer и payload API не экспортируются.
+type ProfileUDPControl struct {
+	actor   *profileUDPActor
+	request *profileUDPControlRequest
+	cancel  context.CancelFunc
+	stop    func() bool
+}
+
+func ProfileOpenSOCKSUDPControl(ctx context.Context) (*ProfileUDPControl, error) {
+	p := profileRuntime(ctx)
+	if p == nil || !p.flowFresh() || p.udpActor == nil {
+		return nil, ErrProfileUnsupported
+	}
+	a, _ := ctx.Value(profileAcceptedKey{}).(*profileAccepted)
+	if a == nil || a.runtime != p || int(a.index) >= len(p.flow.manifest.rows[6]) || p.flow.manifest.rows[6][a.index][0] != 2 {
+		return nil, errProfile
+	}
+	child, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(p.ctx, cancel)
+	r, e := p.udpActor.submit(child, a)
+	if e != nil {
+		stop()
+		cancel()
+		return nil, e
+	}
+	select {
+	case <-r.done:
+	case <-child.Done():
+		stop()
+		cancel()
+		return nil, child.Err()
+	case <-p.ctx.Done():
+		stop()
+		cancel()
+		return nil, errProfile
+	}
+	p.udpActor.mu.Lock()
+	valid := r.phase == 4 && r.err == nil && r.association != nil && child.Err() == nil && p.ctx.Err() == nil
+	p.udpActor.mu.Unlock()
+	if !valid {
+		stop()
+		cancel()
+		return nil, errProfile
+	}
+	return &ProfileUDPControl{actor: p.udpActor, request: r, cancel: cancel, stop: stop}, nil
+}
+func (c *ProfileUDPControl) OnCancel(fn func()) func() bool {
+	if c == nil || c.actor == nil || c.request == nil || fn == nil {
+		return func() bool { return false }
+	}
+	return context.AfterFunc(c.request.ctx, fn)
+}
+func (c *ProfileUDPControl) Endpoint() (xnet.Destination, error) {
+	if c == nil || c.actor == nil || c.request == nil {
+		return xnet.Destination{}, errProfile
+	}
+	c.actor.mu.Lock()
+	defer c.actor.mu.Unlock()
+	r := c.request
+	if r.phase != 4 || r.association == nil || r.ctx.Err() != nil || c.actor.runtime.ctx.Err() != nil {
+		return xnet.Destination{}, errProfile
+	}
+	return xnet.UDPDestination(xnet.LocalHostIP, xnet.Port(r.association.bound.port)), nil
+}
+func (c *ProfileUDPControl) Close() error {
+	if c == nil {
+		return nil
+	}
+	if c.actor == nil || c.request == nil || c.cancel == nil || c.stop == nil {
+		return errProfile
+	}
+	c.cancel()
+	c.stop()
+	<-c.request.closed
+	c.actor.mu.Lock()
+	defer c.actor.mu.Unlock()
+	if p := c.request.producer; p != nil {
+		if p.finished {
+			return p.result
+		}
+		return c.request.err
+	}
+	// Нет durable-flow retirement counterpart в этом atomic milestone.
+	// Даже успешный local CloseAndJoin не становится KnownClosed/UCR.
+	return errors.Join(ErrProfileUnsupported, c.request.err)
+}
