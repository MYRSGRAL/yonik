+++ b/common/mux/yonik_r9_lifecycle_test.go
@@ -0,0 +1,394 @@
+package mux
+
+import (
+	"context"
+	goerrors "errors"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+var r9MuxCleanupError = goerrors.New("R9 mux cleanup Unknown")
+
+type r9MuxEndpoint struct {
+	calls            atomic.Int32
+	once             sync.Once
+	entered, release chan struct{}
+	err              error
+	beforeClose      func()
+}
+
+type r9MuxBlockedInput struct {
+	entered, release    chan struct{}
+	readOnce, closeOnce sync.Once
+}
+
+func (r *r9MuxBlockedInput) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	r.readOnce.Do(func() { close(r.entered) })
+	<-r.release
+	return nil, io.EOF
+}
+func (r *r9MuxBlockedInput) Close() error {
+	r.closeOnce.Do(func() { close(r.release) })
+	return nil
+}
+
+type r9MuxSink struct{}
+
+func (*r9MuxSink) WriteMultiBuffer(b buf.MultiBuffer) error { buf.ReleaseMulti(b); return nil }
+func (*r9MuxSink) Close() error                             { return nil }
+
+func TestYonikR9MuxMonitorWakesWaitingDispatchBeforeJoin(t *testing.T) {
+	retired := make(chan error, 1)
+	w, tasks := r9MuxConstruct(t, transport.Link{Reader: &r9MuxEndpoint{}, Writer: &r9MuxSink{}}, func(e error) { retired <- e })
+	input := &r9MuxBlockedInput{entered: make(chan struct{}), release: make(chan struct{})}
+	ctx := session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Target: net.TCPDestination(net.DomainAddress("synthetic.invalid"), 443)}})
+	dispatched := make(chan bool, 1)
+	go func() { dispatched <- w.Dispatch(ctx, &transport.Link{Reader: input, Writer: &r9MuxSink{}}) }()
+	<-input.entered
+	w.requestClose()
+	tasks.fetch()
+	tasks.monitor()
+	if !<-dispatched || w.Close() != nil || <-retired != nil {
+		t.Fatal("monitor не дождался Dispatch/input cleanup")
+	}
+}
+
+func (e *r9MuxEndpoint) ReadMultiBuffer() (buf.MultiBuffer, error) { return nil, io.EOF }
+func (e *r9MuxEndpoint) WriteMultiBuffer(b buf.MultiBuffer) error {
+	buf.ReleaseMulti(b)
+	return io.ErrClosedPipe
+}
+func (e *r9MuxEndpoint) Close() error {
+	e.once.Do(func() {
+		e.calls.Add(1)
+		if e.beforeClose != nil {
+			e.beforeClose()
+		}
+		if e.entered != nil {
+			close(e.entered)
+			<-e.release
+		}
+	})
+	return e.err
+}
+
+type r9MuxVoid struct{ interrupted atomic.Bool }
+
+func (e *r9MuxVoid) ReadMultiBuffer() (buf.MultiBuffer, error) { return nil, io.EOF }
+func (e *r9MuxVoid) WriteMultiBuffer(b buf.MultiBuffer) error {
+	buf.ReleaseMulti(b)
+	return io.ErrClosedPipe
+}
+func (e *r9MuxVoid) Interrupt() { e.interrupted.Store(true) }
+
+type r9MuxTasks struct{ fetch, monitor func() }
+
+// Pure constructor runner удерживает реальные fetch/monitor до fake barriers.
+func r9MuxConstruct(t *testing.T, link transport.Link, retire func(error)) (*ClientWorker, r9MuxTasks) {
+	t.Helper()
+	var options *profileWorkerOptions
+	if retire != nil {
+		options = &profileWorkerOptions{retire: retire}
+	}
+	var queued []func()
+	w, e := newClientWorker(link, ClientStrategy{}, options, func(task func()) { queued = append(queued, task) })
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { w.timer.Stop() })
+	if len(queued) != 2 {
+		t.Fatal("constructor tasks")
+	}
+	return w, r9MuxTasks{fetch: queued[0], monitor: queued[1]}
+}
+
+func TestYonikR9MuxCloseWaitsForActualMonitorCleanup(t *testing.T) {
+	for _, phase := range []string{"session", "writer", "reader"} {
+		t.Run(phase, func(t *testing.T) {
+			input, output, reader, writer := &r9MuxEndpoint{}, &r9MuxEndpoint{}, &r9MuxEndpoint{}, &r9MuxEndpoint{}
+			target := input
+			if phase == "writer" {
+				target = writer
+			}
+			if phase == "reader" {
+				target = reader
+			}
+			target.err = r9MuxCleanupError
+			target.entered = make(chan struct{})
+			target.release = make(chan struct{})
+			retired := make(chan error, 1)
+			w, tasks := r9MuxConstruct(t, transport.Link{Reader: reader, Writer: writer}, func(e error) { retired <- e })
+			if s := w.sessionManager.Allocate(&ClientStrategy{}, input, output); s == nil {
+				t.Fatal("session fixture")
+			}
+			closed := make(chan error, 1)
+			go func() { closed <- w.Close() }()
+			<-w.done.Wait()
+			tasks.fetch()
+			monitorDone := make(chan struct{})
+			go func() { tasks.monitor(); close(monitorDone) }()
+			<-target.entered
+			var earlyClose, earlyRetire bool
+			var closeErr, retireErr error
+			select {
+			case closeErr = <-closed:
+				earlyClose = true
+			default:
+			}
+			select {
+			case retireErr = <-retired:
+				earlyRetire = true
+			default:
+			}
+			close(target.release)
+			<-monitorDone
+			if !earlyClose {
+				closeErr = <-closed
+			}
+			if !earlyRetire {
+				retireErr = <-retired
+			}
+			if earlyClose || earlyRetire || !goerrors.Is(closeErr, r9MuxCleanupError) || !goerrors.Is(retireErr, r9MuxCleanupError) {
+				t.Fatalf("cleanup не подтверждён: earlyClose=%v earlyRetire=%v close=%v retire=%v", earlyClose, earlyRetire, closeErr, retireErr)
+			}
+			if again := w.Close(); again != closeErr {
+				t.Fatal("повторный Close изменил final result", again, closeErr)
+			}
+			for _, e := range []*r9MuxEndpoint{input, output, reader, writer} {
+				if e.calls.Load() != 1 {
+					t.Fatal("cleanup повторён или потерян", e.calls.Load())
+				}
+			}
+			select {
+			case <-retired:
+				t.Fatal("повторный retirement")
+			default:
+			}
+		})
+	}
+}
+
+func TestYonikR9MuxVoidInterruptIsNotCleanupProof(t *testing.T) {
+	leaf := &r9MuxVoid{}
+	retired := make(chan error, 1)
+	w, tasks := r9MuxConstruct(t, transport.Link{Reader: leaf, Writer: leaf}, func(e error) { retired <- e })
+	result := make(chan error, 1)
+	go func() { result <- w.Close() }()
+	<-w.done.Wait()
+	tasks.fetch()
+	tasks.monitor()
+	if e := <-result; e == nil {
+		t.Fatal("void Interrupt выдан за KnownClosed")
+	}
+	if e := <-retired; e == nil {
+		t.Fatal("неподтверждённый cleanup освободил custody")
+	}
+	if !leaf.interrupted.Load() {
+		t.Fatal("не сделана даже best-effort остановка")
+	}
+}
+
+func TestYonikR9MuxLegacyCloseStillSignalOnly(t *testing.T) {
+	reader, writer := &r9MuxEndpoint{}, &r9MuxEndpoint{}
+	w, tasks := r9MuxConstruct(t, transport.Link{Reader: reader, Writer: writer}, nil)
+	if e := w.Close(); e != nil {
+		t.Fatal(e)
+	}
+	if reader.calls.Load() != 0 || writer.calls.Load() != 0 {
+		t.Fatal("legacy Close стал synchronous cleanup")
+	}
+	tasks.fetch()
+	tasks.monitor()
+}
+
+type r9MuxNeverFactory struct{ calls atomic.Int32 }
+
+func (f *r9MuxNeverFactory) Create() (*ClientWorker, error) {
+	f.calls.Add(1)
+	return nil, goerrors.New("unexpected factory")
+}
+func TestYonikR9MuxGroupShutdownReleasesPickerLockAndRetainsError(t *testing.T) {
+	reader, writer := &r9MuxEndpoint{}, &r9MuxEndpoint{err: r9MuxCleanupError}
+	w, tasks := r9MuxConstruct(t, transport.Link{Reader: reader, Writer: writer}, func(error) {})
+	factory := &r9MuxNeverFactory{}
+	picker := &IncrementalWorkerPicker{Factory: factory, workers: []*ClientWorker{w}}
+	group := &profileWorkers{picker: picker}
+	writer.beforeClose = func() { picker.access.Lock(); picker.access.Unlock() }
+	result := make(chan error, 1)
+	go func() { result <- group.Close() }()
+	<-w.done.Wait()
+	tasks.fetch()
+	tasks.monitor()
+	err := <-result
+	if !goerrors.Is(err, r9MuxCleanupError) {
+		t.Fatal("group потерял cleanup error", err)
+	}
+	if again := group.Close(); again != err {
+		t.Fatal("повторный group Close потерял Unknown")
+	}
+	if _, _, e := picker.pickInternal(); e == nil || factory.calls.Load() != 0 {
+		t.Fatal("shutdown picker создаёт новый worker")
+	}
+}
+
+func TestYonikR9MuxConstructorEOFPublishesStateBeforeTasks(t *testing.T) {
+	var queued []func()
+	starts := 0
+	retired := 0
+	var worker *ClientWorker
+	reader, writer := &r9MuxEndpoint{}, &r9MuxEndpoint{}
+	options := &profileWorkerOptions{retire: func(e error) {
+		retired++
+		if e != nil || worker.Close() != nil {
+			t.Error("reentrant retirement Close")
+		}
+	}}
+	var e error
+	worker, e = newClientWorker(transport.Link{Reader: reader, Writer: writer}, ClientStrategy{}, options, func(task func()) {
+		starts++
+		if starts == 1 {
+			task()
+		} else {
+			queued = append(queued, task)
+		}
+	})
+	if e != nil {
+		t.Fatal(e)
+	}
+	if !worker.Closed() || worker.managed == nil || retired != 0 {
+		t.Fatal("early EOF потерял lifecycle до публикации")
+	}
+	queued[0]()
+	if worker.Close() != nil || retired != 1 || reader.calls.Load() != 1 || writer.calls.Load() != 1 {
+		t.Fatal("EOF cleanup не завершён")
+	}
+}
+
+type r9MuxProxy struct {
+	process func(context.Context, *transport.Link, internet.Dialer) error
+}
+
+func (p r9MuxProxy) Process(ctx context.Context, link *transport.Link, dialer internet.Dialer) error {
+	return p.process(ctx, link, dialer)
+}
+
+func TestYonikR9MuxFactoryProcessStopAndEarlyEOFDoNotSelfWait(t *testing.T) {
+	for _, early := range []bool{false, true} {
+		entered := make(chan struct{})
+		canceled, releaseProcess := make(chan struct{}), make(chan struct{})
+		var processCalls, processExited atomic.Int32
+		factory := &DialingWorkerFactory{profileContext: context.Background(), Proxy: r9MuxProxy{process: func(ctx context.Context, _ *transport.Link, _ internet.Dialer) error {
+			processCalls.Add(1)
+			close(entered)
+			defer processExited.Add(1)
+			<-ctx.Done()
+			close(canceled)
+			<-releaseProcess
+			return ctx.Err()
+		}}}
+		var tasks []func()
+		retired := make(chan error, 1)
+		worker, e := factory.createWorker(func(e error) { retired <- e }, func(task func()) { tasks = append(tasks, task) })
+		if e != nil {
+			t.Fatal(e)
+		}
+		if len(tasks) != 3 || worker.managed == nil {
+			t.Fatal("factory lifecycle не установлен до goroutines")
+		}
+		if early {
+			worker.requestClose()
+			tasks[2]()
+		} else {
+			go tasks[2]()
+			<-entered
+		}
+		result := make(chan error, 1)
+		go func() { result <- worker.Close() }()
+		<-worker.done.Wait()
+		go tasks[0]()
+		monitorDone := make(chan struct{})
+		go func() { tasks[1](); close(monitorDone) }()
+		if !early {
+			<-canceled
+			select {
+			case <-result:
+				t.Fatal("Close не дождался actual process exit")
+			default:
+			}
+			select {
+			case <-retired:
+				t.Fatal("retirement до actual process exit")
+			default:
+			}
+			close(releaseProcess)
+		}
+		<-monitorDone
+		if e = <-result; e != nil {
+			t.Fatal(e)
+		}
+		if e = <-retired; e != nil {
+			t.Fatal(e)
+		}
+		want := int32(1)
+		if early {
+			want = 0
+		}
+		if processCalls.Load() != want || processExited.Load() != want {
+			t.Fatal("process стартовал после stop или cleanup не дождался process")
+		}
+	}
+}
+
+func TestYonikR9MuxFactoryProcessErrorRequestsStopWithoutSelfWait(t *testing.T) {
+	factory := &DialingWorkerFactory{profileContext: context.Background(), Proxy: r9MuxProxy{process: func(context.Context, *transport.Link, internet.Dialer) error {
+		return goerrors.New("synthetic operation denied")
+	}}}
+	var tasks []func()
+	retired := make(chan error, 1)
+	w, err := factory.createWorker(func(e error) { retired <- e }, func(task func()) { tasks = append(tasks, task) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	tasks[2]()
+	if !w.Closed() {
+		t.Fatal("process error не запросил stop")
+	}
+	go tasks[0]()
+	tasks[1]()
+	if w.Close() != nil || <-retired != nil {
+		t.Fatal("operation error подменил cleanup result")
+	}
+}
+
+func TestYonikR9MuxSessionErrorSurvivesRemoval(t *testing.T) {
+	reader, writer := &r9MuxEndpoint{}, &r9MuxEndpoint{}
+	retired := make(chan error, 1)
+	worker, tasks := r9MuxConstruct(t, transport.Link{Reader: reader, Writer: writer}, func(e error) { retired <- e })
+	input, output := &r9MuxEndpoint{err: r9MuxCleanupError}, &r9MuxEndpoint{}
+	session := worker.allocateManagedSession(&transport.Link{Reader: input, Writer: output})
+	if session == nil {
+		t.Fatal("managed session")
+	}
+	session.Close(false)
+	if worker.sessionManager.Size() != 0 {
+		t.Fatal("session не удалена")
+	}
+	tasks.fetch()
+	tasks.monitor()
+	if e := worker.Close(); !goerrors.Is(e, r9MuxCleanupError) {
+		t.Fatal("утрачена ошибка удалённой session", e)
+	}
+	if e := <-retired; !goerrors.Is(e, r9MuxCleanupError) {
+		t.Fatal("retirement потерял Unknown", e)
+	}
+	if input.calls.Load() != 1 || output.calls.Load() != 1 {
+		t.Fatal("leaf cleanup повторён")
+	}
+}
diff --git a/common/yonikbroker/profile_cleanup.go b/common/yonikbroker/profile_cleanup.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_cleanup.go
@@ -0,0 +1,42 @@
+package nativehooks
+
+import (
+	"errors"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/transport/pipe"
+	"io"
+)
+
+var ErrProfileCleanupUnknown = errors.New("full-profile cleanup unconfirmed")
+
+// Void Interrupt сам по себе не подтверждает cleanup. Для concrete owned pipe
+// проверяется синхронный closed postcondition; другой void API даёт Unknown.
+func ProfileCleanupResource(value any) error {
+	if resource, ok := value.(interface{ ProfileCleanup() error }); ok {
+		return resource.ProfileCleanup()
+	}
+	switch resource := value.(type) {
+	case *pipe.Reader:
+		resource.Interrupt()
+		pending, err := resource.ReadMultiBuffer()
+		if len(pending) != 0 {
+			buf.ReleaseMulti(pending)
+			return ErrProfileCleanupUnknown
+		}
+		if errors.Is(err, io.ErrClosedPipe) || errors.Is(err, io.EOF) {
+			return nil
+		}
+		return errors.Join(ErrProfileCleanupUnknown, err)
+	case *pipe.Writer:
+		resource.Interrupt()
+		return resource.Close()
+	case io.Closer:
+		return resource.Close()
+	default:
+		if resource, ok := value.(common.Interruptible); ok {
+			resource.Interrupt()
+		}
+		return ErrProfileCleanupUnknown
+	}
+}
