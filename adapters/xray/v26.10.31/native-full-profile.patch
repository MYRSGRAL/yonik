+func (h *dnsDirectHarness) next(t *testing.T, kind uint16) *profileOperation {
+	t.Helper()
+	select {
+	case op := <-h.f.p.flowQueue:
+		if op.kind != kind {
+			t.Fatalf("want %d got %d", kind, op.kind)
+		}
+		if err := h.f.c.dispatch(op); err != nil {
+			t.Fatal(err)
+		}
+		return op
+	case got := <-h.done:
+		t.Fatalf("caller ended before %d: %v", kind, got.err)
+	case <-time.After(time.Second):
+		t.Fatalf("missing request %d", kind)
+	}
+	return nil
+}
+func dnsDirectReply(op *profileOperation) *profilePacket {
+	t := op.dnsDirect.owner
+	e := t.bundle.exchange
+	body := make([]byte, 64)
+	be.PutUint16(body, 2)
+	body[2] = 1
+	remaining := uint64(op.deadline.Sub(op.sent))
+	kind := op.dnsDirect.expected
+	base := uint64(70) + 10*(t.bundle.id-41)
+	switch kind {
+	case 36:
+		id, contextID := base+1, base+2
+		if op.dnsDirect.physical {
+			id = base + 3
+			contextID = t.exchangeReservation
+			be.PutUint16(body[56:], 2)
+		}
+		for _, v := range []struct {
+			at    int
+			value uint64
+		}{{8, id}, {16, e.id}, {24, t.bundle.id}, {32, contextID}, {40, e.query.runtime.admission.launch.epoch}, {48, remaining}} {
+			be.PutUint64(body[v.at:], v.value)
+		}
+		be.PutUint16(body[58:], 1)
+		body[60] = op.body[2]
+	case 37:
+		for _, v := range []struct {
+			at    int
+			value uint64
+		}{{8, t.physicalReservation}, {16, base + 4}, {24, e.id}, {32, t.bundle.id}, {40, e.query.runtime.admission.launch.epoch}, {48, remaining}} {
+			be.PutUint64(body[v.at:], v.value)
+		}
+	case 39:
+		for _, v := range []struct {
+			at    int
+			value uint64
+		}{{8, t.exchange}, {16, base + 5}, {24, e.id}, {32, t.bundle.id}, {40, 1}, {48, remaining}} {
+			be.PutUint64(body[v.at:], v.value)
+		}
+		be.PutUint16(body[56:], 1)
+		body[58] = 1
+	}
+	return &profilePacket{kind: kind, reply: op.sequence, body: body}
+}
+func (h *dnsDirectHarness) ack(t *testing.T, op *profileOperation) {
+	t.Helper()
+	if err := h.f.c.accept(*dnsDirectReply(op)); err != nil {
+		t.Fatal(err)
+	}
+}
+func (h *dnsDirectHarness) reserves(t *testing.T) *profileOperation {
+	t.Helper()
+	exchange := h.next(t, 35)
+	select {
+	case <-h.factory:
+		t.Fatal("factory before exchange ACK")
+	default:
+	}
+	h.ack(t, exchange)
+	physical := h.next(t, 35)
+	select {
+	case <-h.factory:
+		t.Fatal("factory before physical ACK")
+	default:
+	}
+	h.ack(t, physical)
+	return physical
+}
+func (h *dnsDirectHarness) ready(t *testing.T) net.Conn {
+	t.Helper()
+	physical := h.reserves(t)
+	proof := h.next(t, 52)
+	if proof.sequence != physical.sequence {
+		t.Fatal("PhysicalAck changed reservation sequence")
+	}
+	raw := <-h.proof
+	if string(raw[:8]) != "DNSPHY02" || len(raw) != 192 || u64(raw, 128) != proof.dnsDirect.owner.exchangeReservation || u64(raw, 152) != proof.dnsDirect.owner.physicalReservation {
+		t.Fatal("raw proof layout")
+	}
+	select {
+	case got := <-h.done:
+		t.Fatal("publication before PhysicalAck", got.err)
+	default:
+	}
+	h.ack(t, proof)
+	logical := h.next(t, 38)
+	if ProfileLogicalGate(h.ctx) == nil {
+		t.Fatal("send before LogicalAck")
+	}
+	select {
+	case got := <-h.done:
+		t.Fatal("publication before LogicalAck", got.err)
+	default:
+	}
+	h.ack(t, logical)
+	got := <-h.done
+	if got.err != nil || got.conn == nil {
+		t.Fatal(got.err)
+	}
+	return got.conn
+}
