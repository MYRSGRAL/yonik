+func TestProfileDNSNumericReservationDeadlineAndBlockedFactoryCustody(t *testing.T) {
+	for _, failedClose := range []bool{false, true} {
+		t.Run(fmt.Sprint(failedClose), func(t *testing.T) {
+			n := numericPublished(t, 1, 6)
+			n.launch(t, n.source, n.target)
+			op := n.dnsTo42(t)
+			originalDeadline := n.wire.f.now.Add(5 * time.Millisecond)
+			op.dnsNumeric.waiter.reservationDeadline = originalDeadline
+			op.dnsNumeric.deadline = originalDeadline
+			n.ack(t, op)
+			result := n.result(t)
+			if result.err != nil || !op.grant.deadline.Equal(originalDeadline) {
+				t.Fatal("Numeric продлил исходную reservation", result.err)
+			}
+			entered, resume := make(chan struct{}), make(chan struct{})
+			done := make(chan error, 1)
+			bad := &profileErrorConn{}
+			go func() {
+				_, err := ProfileDialPhysical(result.ctx, result.target, func(context.Context) (net.Conn, error) {
+					close(entered)
+					<-resume
+					if failedClose {
+						return bad, nil
+					}
+					return &flowFakeConn{}, nil
+				})
+				done <- err
+			}()
+			<-entered
+			result.release()
+			close(resume)
+			if err := <-done; err == nil {
+				t.Fatal("late factory опубликовал отменённый Numeric")
+			}
+			if ProfileLogicalGate(result.ctx) == nil {
+				t.Fatal("отменённый USER ожил")
+			}
+			if failedClose {
+				if n.wire.f.p.closeTransports() == nil || bad.count != 1 {
+					t.Fatal("Unknown cleanup потерян или повторён")
+				}
+				if n.wire.f.p.closeTransports() == nil || bad.count != 1 {
+					t.Fatal("повторный close превратил Unknown в Known")
+				}
+			}
+		})
+	}
+}
