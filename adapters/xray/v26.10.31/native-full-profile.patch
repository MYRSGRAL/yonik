diff --git a/common/yonikbroker/profile_proof_os_linux.go b/common/yonikbroker/profile_proof_os_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_proof_os_linux.go
@@ -0,0 +1,337 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"net/netip"
+	"os"
+	"syscall"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"golang.org/x/sys/unix"
+)
+
+// Разбор по одному cmsg сохраняет уже принятые rights при повреждённом suffix.
+func profileParseAncillary(body, oob []byte, flags int, adopt func(int) profileProofFD) profileProofPacket {
+	p := profileProofPacket{body: body, invalid: flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0}
+	for len(oob) > 0 {
+		h, data, rest, e := unix.ParseOneSocketControlMessage(oob)
+		if e != nil {
+			p.invalid = true
+			break
+		}
+		oob = rest
+		m := unix.SocketControlMessage{Header: h, Data: data}
+		if h.Level != unix.SOL_SOCKET {
+			p.invalid = true
+			continue
+		}
+		switch h.Type {
+		case unix.SCM_RIGHTS:
+			p.rightsMessages++
+			if len(m.Data)%4 != 0 {
+				p.invalid = true
+				m.Data = m.Data[:len(m.Data)&^3]
+			}
+			fds, e := unix.ParseUnixRights(&m)
+			if e != nil {
+				p.invalid = true
+				continue
+			}
+			if len(fds) == 0 || p.rightsMessages != 1 {
+				p.invalid = true
+			}
+			for _, fd := range fds {
+				if p.count >= len(p.rights) {
+					p.invalid = true
+					adopt(fd).Close()
+					continue
+				}
+				p.rights[p.count] = adopt(fd)
+				p.count++
+			}
+		case unix.SCM_CREDENTIALS:
+			p.credentials++
+			cred, e := unix.ParseUnixCredentials(&m)
+			if e != nil {
+				p.invalid = true
+			} else {
+				p.pid, p.uid = cred.Pid, cred.Uid
+			}
+		default:
+			p.invalid = true
+		}
+	}
+	return p
+}
+func profileAdoptFD(fd int) profileProofFD {
+	return &profileFileFD{file: os.NewFile(uintptr(fd), "profile-proof-owned")}
+}
+func (p *ProfileRuntime) proofPeerAlive() bool { return p.peerAlive() == nil }
+func (p *ProfileRuntime) receiveBootstrap(deadline time.Time) (profileProofPacket, error) {
+	for time.Now().Before(deadline) {
+		if p.peerAlive() != nil {
+			return profileProofPacket{}, errProfile
+		}
+		fds := []unix.PollFd{{Fd: int32(p.channel.Fd()), Events: unix.POLLIN}, {Fd: int32(p.peer.Fd()), Events: unix.POLLIN}}
+		wait := time.Until(deadline)
+		if wait > 20*time.Millisecond {
+			wait = 20 * time.Millisecond
+		}
+		n, e := unix.Poll(fds, int((wait+time.Millisecond-1)/time.Millisecond))
+		if e == unix.EINTR {
+			continue
+		}
+		if e != nil || fds[1].Revents != 0 {
+			return profileProofPacket{}, errProfile
+		}
+		if n == 0 {
+			continue
+		}
+		if fds[0].Revents&unix.POLLIN == 0 {
+			return profileProofPacket{}, errProfile
+		}
+		body := make([]byte, 128)
+		oob := make([]byte, unix.CmsgSpace(16*4)+unix.CmsgSpace(unix.SizeofUcred))
+		n, control, flags, _, e := unix.Recvmsg(int(p.channel.Fd()), body, oob, unix.MSG_DONTWAIT|unix.MSG_CMSG_CLOEXEC)
+		if n < 0 {
+			n = 0
+		}
+		if n > len(body) {
+			n = len(body)
+			flags |= unix.MSG_TRUNC
+		}
+		packet := profileParseAncillary(body[:n], oob[:control], flags, profileAdoptFD)
+		// V2 codec/state source-only: actor/delivery и parity ещё не готовы.
+		// Никакого ACK, downgrade или System UDP effect до общего review.
+		if n >= 8 && string(body[:8]) == "YNKPF002" {
+			packet.invalid = true
+		}
+		if e != nil || n == 0 {
+			packet.invalid = true
+			return packet, errProfile
+		}
+		return packet, nil
+	}
+	return profileProofPacket{}, errProfileTimeout
+}
+func (p *ProfileRuntime) validateProofFD(fd profileProofFD) error {
+	return fd.withFD(func(n int) error {
+		kind, e := unix.GetsockoptInt(n, unix.SOL_SOCKET, unix.SO_TYPE)
+		if e != nil || kind != unix.SOCK_SEQPACKET {
+			return errProfile
+		}
+		address, e := unix.Getsockname(n)
+		if e != nil {
+			return errProfile
+		}
+		if _, ok := address.(*unix.SockaddrUnix); !ok {
+			return errProfile
+		}
+		cred, e := unix.GetsockoptUcred(n, unix.SOL_SOCKET, unix.SO_PEERCRED)
+		if e != nil || !profileSenderValid(p.admission.launch, cred.Pid, cred.Uid, uint32(os.Geteuid())) {
+			return errProfile
+		}
+		var a, b unix.Stat_t
+		if unix.Fstat(n, &a) != nil || unix.Fstat(int(p.channel.Fd()), &b) != nil || a.Dev == b.Dev && a.Ino == b.Ino {
+			return errProfile
+		}
+		flags, e := unix.FcntlInt(uintptr(n), unix.F_GETFD, 0)
+		if e != nil || flags&unix.FD_CLOEXEC == 0 {
+			return errProfile
+		}
+		return unix.SetsockoptInt(n, unix.SOL_SOCKET, unix.SO_PASSCRED, 1)
+	})
+}
+func (p *ProfileRuntime) sendBootstrapAck(body []byte) error {
+	if len(body) != 40 || p.peerAlive() != nil {
+		return errProfile
+	}
+	n, e := unix.SendmsgN(int(p.channel.Fd()), body, nil, nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+	if e != nil || n != len(body) {
+		return errProfile
+	}
+	return nil
+}
+func (p *ProfileRuntime) proofHealth() error {
+	if p.proofs == nil || p.proofs.fd == nil {
+		return errProfile
+	}
+	return p.proofs.fd.withFD(func(n int) error {
+		fds := []unix.PollFd{{Fd: int32(n), Events: unix.POLLIN}}
+		count, e := unix.Poll(fds, 0)
+		if e != nil || count != 0 {
+			return errProfile
+		}
+		return nil
+	})
+}
+func (p *ProfileRuntime) sendSocketProof(body []byte, socket profileProofFD) error {
+	return p.proofs.fd.withFD(func(channel int) error {
+		return socket.withFD(func(fd int) error {
+			if p.peerAlive() != nil {
+				return errProfile
+			}
+			actual, e := profileSocketTuple(fd)
+			if e != nil || len(body) != 192 || string(actual[:]) != string(body[148:188]) {
+				return errProfile
+			}
+			n, e := unix.SendmsgN(channel, body, unix.UnixRights(fd), nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+			if e == unix.EAGAIN || e == unix.EWOULDBLOCK {
+				return errProfileProofBusy
+			}
+			if e != nil || n != len(body) {
+				return errProfile
+			}
+			return nil
+		})
+	})
+}
+func profileSockaddrValue(a unix.Sockaddr) (profileDestinationValue, error) {
+	v := profileDestinationValue{network: 6}
+	switch a := a.(type) {
+	case *unix.SockaddrInet4:
+		v.family = 4
+		v.port = uint16(a.Port)
+		v.address = netip.AddrFrom4(a.Addr).String()
+	case *unix.SockaddrInet6:
+		if a.ZoneId != 0 {
+			return v, errProfile
+		}
+		ip := netip.AddrFrom16(a.Addr).Unmap()
+		v.family = 6
+		if ip.Is4() {
+			v.family = 4
+		}
+		v.port = uint16(a.Port)
+		v.address = ip.String()
+	default:
+		return v, errProfile
+	}
+	if !v.valid() {
+		return v, errProfile
+	}
+	return v, nil
+}
+func profileSocketTuple(fd int) ([40]byte, error) {
+	var empty [40]byte
+	kind, e := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_TYPE)
+	if e != nil || kind != unix.SOCK_STREAM {
+		return empty, errProfile
+	}
+	protocol, e := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_PROTOCOL)
+	if e != nil || protocol != unix.IPPROTO_TCP {
+		return empty, errProfile
+	}
+	remote, e := unix.Getpeername(fd)
+	if e != nil {
+		return empty, errProfile
+	}
+	local, e := unix.Getsockname(fd)
+	if e != nil {
+		return empty, errProfile
+	}
+	r, e := profileSockaddrValue(remote)
+	if e != nil {
+		return empty, e
+	}
+	l, e := profileSockaddrValue(local)
+	if e != nil {
+		return empty, e
+	}
+	return profileTuple(xnet.TCPDestination(xnet.ParseAddress(r.address), xnet.Port(r.port)), xnet.TCPDestination(xnet.ParseAddress(l.address), xnet.Port(l.port)))
+}
+func profileDuplicateAccepted(conn xnet.Conn, tuple [40]byte) (profileProofFD, error) {
+	return profileDuplicateAcceptedWith(conn, tuple, func(fd uintptr) (profileProofFD, error) {
+		n, e := unix.FcntlInt(fd, unix.F_DUPFD_CLOEXEC, 3)
+		if e != nil {
+			return nil, e
+		}
+		return profileAdoptFD(n), nil
+	}, func(fd profileProofFD) (actual [40]byte, err error) {
+		err = fd.withFD(func(n int) error { var e error; actual, e = profileSocketTuple(n); return e })
+		return actual, err
+	})
+}
+func profileDuplicateAcceptedWith(conn xnet.Conn, tuple [40]byte, duplicate func(uintptr) (profileProofFD, error), inspect func(profileProofFD) ([40]byte, error)) (profileProofFD, error) {
+	source, ok := conn.(syscall.Conn)
+	if !ok {
+		return nil, ErrProfileUnsupported
+	}
+	raw, e := source.SyscallConn()
+	if e != nil {
+		return nil, e
+	}
+	var owned profileProofFD
+	var result error
+	e = raw.Control(func(fd uintptr) {
+		owned, result = duplicate(fd)
+		if result != nil {
+			return
+		}
+		if owned == nil {
+			result = errProfile
+			return
+		}
+		actual, e := inspect(owned)
+		if e != nil || actual != tuple {
+			result = errProfile
+		}
+	})
+	if e != nil {
+		result = e
+	}
+	if result != nil {
+		return owned, result
+	}
+	if owned == nil {
+		return nil, errProfile
+	}
+	return owned, nil
+}
+func (p *ProfileRuntime) proofPollFD() (int, error) {
+	if p.proofs == nil || p.proofs.fd == nil {
+		return -1, errProfile
+	}
+	fd := -1
+	e := p.proofs.fd.withFD(func(n int) error { fd = n; return nil })
+	return fd, e
+}
+func (p *ProfileRuntime) rejectRights(packet profileProofPacket) error {
+	var result error
+	for i, fd := range packet.rights {
+		if fd != nil {
+			if e := fd.Close(); e != nil {
+				p.proofRejected[i] = fd
+				result = e
+			}
+		}
+	}
+	if result != nil {
+		p.mu.Lock()
+		p.admission.state = profileUnknown
+		p.mu.Unlock()
+	}
+	return result
+}
+func (p *ProfileRuntime) rejectProofInput() {
+	if p.proofs == nil || p.proofs.fd == nil {
+		return
+	}
+	var packet profileProofPacket
+	_ = p.proofs.fd.withFD(func(fd int) error {
+		var body [128]byte
+		oob := make([]byte, unix.CmsgSpace(16*4)+unix.CmsgSpace(unix.SizeofUcred))
+		n, control, flags, _, _ := unix.Recvmsg(fd, body[:], oob, unix.MSG_DONTWAIT|unix.MSG_CMSG_CLOEXEC)
+		if n < 0 {
+			n = 0
+		}
+		if n > len(body) {
+			n = len(body)
+		}
+		packet = profileParseAncillary(body[:n], oob[:control], flags, profileAdoptFD)
+		return nil
+	})
+	_ = p.rejectRights(packet)
+}
diff --git a/common/yonikbroker/profile_proof_linux.go b/common/yonikbroker/profile_proof_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_proof_linux.go
@@ -0,0 +1,240 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"sync"
+	"time"
+)
+
+var errProfileProofBusy = errors.New("profile proof channel backpressure")
+
+const profileAcceptedFDCredit = 256
+
+var errProfileProofCancelled = errors.New("profile proof request cancelled")
+
+// Kernel handle потребляется только через private scoped callback. Read/Write,
+// raw socket getters и произвольных integer FD constructors у API нет.
+type profileProofFD interface {
+	Close() error
+	withFD(func(int) error) error
+}
+type profileFileFD struct {
+	mu     sync.Mutex
+	file   *os.File
+	closed bool
+	result error
+}
+
+func (f *profileFileFD) Close() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !f.closed {
+		f.closed = true
+		f.result = f.file.Close()
+	}
+	return f.result
+}
+func (f *profileFileFD) withFD(fn func(int) error) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.closed || f.file == nil {
+		return errProfile
+	}
+	return fn(int(f.file.Fd()))
+}
+
+type profileProofPacket struct {
+	body               []byte
+	rights             [32]profileProofFD
+	count, credentials int
+	rightsMessages     int
+	pid                int32
+	uid                uint32
+	invalid            bool
+}
+type profileProofBootstrapIO interface {
+	receiveBootstrap(time.Time) (profileProofPacket, error)
+	validateProofFD(profileProofFD) error
+	sendBootstrapAck([]byte) error
+	proofPeerAlive() bool
+}
+type profileProofChannel struct {
+	version     uint16
+	mu          sync.Mutex
+	launch      profileLaunch
+	fd          profileProofFD
+	custody     [32]profileProofFD
+	lastProof   uint64
+	lastEmitted uint64
+	closed      bool
+	result      error
+	peer        func() bool
+	check       func() error
+	send        func([]byte, profileProofFD) error
+}
+
+func (c *profileProofChannel) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.closed {
+		c.closed = true
+		for i, fd := range c.custody {
+			if fd != nil {
+				e := fd.Close()
+				c.result = errors.Join(c.result, e)
+				if e == nil {
+					c.custody[i] = nil
+				}
+			}
+		}
+	}
+	return c.result
+}
+func (c *profileProofChannel) live() bool {
+	if c == nil {
+		return false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return !c.closed && c.result == nil && c.fd != nil && (c.peer == nil || c.peer()) && (c.check == nil || c.check() == nil)
+}
+func (c *profileProofChannel) bootstrap(r profileLaunch, ch profileProofBootstrapIO, deadline time.Time, clock func() time.Time) error {
+	if r.mode != 2 || ch == nil || c.fd != nil || c.closed || !clock().Before(deadline) {
+		return errProfile
+	}
+	packet, e := ch.receiveBootstrap(deadline)
+	c.launch = r
+	c.custody = packet.rights
+	fail := func() error { return errors.Join(errProfile, c.Close()) }
+	expected, e2 := profileProofBootstrap(r)
+	version := uint16(1)
+	if len(packet.body) == 128 && string(packet.body[:8]) == "YNKPF002" && u16(packet.body, 8) == 2 {
+		version = 2
+		expected, e2 = profileProofBootstrapV2(r)
+	}
+	if e != nil || e2 != nil || packet.invalid || packet.count != 1 || packet.rightsMessages != 1 || packet.credentials != 1 || !profileSenderValid(r, packet.pid, packet.uid, 0) || !bytes.Equal(packet.body, expected[:]) || !clock().Before(deadline) || !ch.proofPeerAlive() {
+		return fail()
+	}
+	c.fd = packet.rights[0]
+	if c.fd == nil || ch.validateProofFD(c.fd) != nil {
+		return fail()
+	}
+	ack := profileProofAck(expected)
+	if ch.sendBootstrapAck(ack[:]) != nil || !clock().Before(deadline) || !ch.proofPeerAlive() {
+		return fail()
+	}
+	c.version = version
+	return nil
+}
+func (c *profileProofChannel) prepare(op *profileOperation) error {
+	if op == nil || op.receipt == nil || op.receipt.association == nil {
+		return errProfile
+	}
+	a := op.receipt.association
+	if op.ctx.Err() != nil || a.ctx.Err() != nil {
+		return errProfileProofCancelled
+	}
+	if a.proof == nil || a.provenance != 2 || a.tuple != op.receipt.tuple || !c.live() {
+		return errProfile
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.lastProof >= ^uint64(0)-1 {
+		return errProfile
+	}
+	if op.proof == 0 {
+		c.lastProof++
+		op.proof = c.lastProof
+	}
+	return nil
+}
+func (c *profileProofChannel) sendOpen(op *profileOperation) error {
+	if op.proofSent {
+		return errProfile
+	}
+	c.mu.Lock()
+	replay := op.proof <= c.lastEmitted
+	c.mu.Unlock()
+	if replay {
+		return errProfile
+	}
+	if op.ctx.Err() != nil || op.receipt.association.ctx.Err() != nil {
+		return errProfileProofCancelled
+	}
+	if !c.live() {
+		return errProfile
+	}
+	b, e := profileSocketRecord(c.launch, op.sequence, op.proof, op.receipt.index, op.receipt.tuple)
+	if e != nil {
+		return e
+	}
+	if c.send == nil {
+		return errProfile
+	}
+	if e = c.send(b[:], op.receipt.association.proof); e != nil {
+		return e
+	}
+	c.mu.Lock()
+	c.lastEmitted = op.proof
+	c.mu.Unlock()
+	op.proofSent = true
+	if op.ctx.Err() != nil {
+		return errProfileProofCancelled
+	}
+	return nil
+}
+
+func (c *profileFlowControl) closeAcceptedProofs() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var result error
+	for _, a := range c.accepted {
+		if a != nil {
+			result = errors.Join(result, a.closeProofLocked(c))
+		}
+	}
+	return result
+}
+func (a *profileAccepted) closeProofLocked(c *profileFlowControl) error {
+	if a.proof != nil {
+		if e := a.proof.Close(); e != nil {
+			return e
+		}
+		a.proof = nil
+	}
+	if a.proofCredit {
+		a.proofCredit = false
+		c.buffered -= profileAcceptedFDCredit
+	}
+	return nil
+}
+func (c *profileFlowControl) proofRequired(op *profileOperation) bool {
+	return c.mode == 2 && op.kind == 16 && op.receipt.provenance == 2
+}
+func (c *profileFlowControl) tryProof(op *profileOperation) error {
+	if !c.proofRequired(op) || op.proofSent {
+		return nil
+	}
+	// EAGAIN не разрешает более позднему proof обогнать ранний monotonic ID.
+	for _, other := range c.pending {
+		if other != nil && other != op && c.proofRequired(other) && !other.proofSent && !other.cancelled && other.ctx.Err() == nil && other.proof < op.proof {
+			return nil
+		}
+	}
+	if c.sendProof == nil {
+		return errProfile
+	}
+	e := c.sendProof(op)
+	if e == errProfileProofBusy {
+		return nil
+	}
+	if e == errProfileProofCancelled {
+		op.cancelled = true
+		return nil
+	}
+	return e
+}
diff --git a/common/yonikbroker/profile_proof.go b/common/yonikbroker/profile_proof.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_proof.go
@@ -0,0 +1,69 @@
+package nativehooks
+
+import "crypto/sha256"
+
+func profileProofBootstrap(r profileLaunch) (b [128]byte, err error) {
+	if r.mode != 2 {
+		return b, errProfile
+	}
+	copy(b[:], "YNKPF001")
+	be.PutUint16(b[8:], 1)
+	be.PutUint16(b[10:], 128)
+	be.PutUint16(b[12:], 1)
+	copy(b[16:], r.nonce[:])
+	copy(b[48:], r.digest[:])
+	copy(b[80:], r.session[:])
+	copy(b[96:], r.invocation[:])
+	be.PutUint64(b[112:], r.generation)
+	be.PutUint64(b[120:], r.epoch)
+	return b, nil
+}
+func profileProofAck(b [128]byte) (ack [40]byte) {
+	copy(ack[:], "YNKPFA01")
+	if string(b[:8]) == "YNKPF002" && u16(b[:], 8) == 2 {
+		copy(ack[:], "YNKPFA02")
+	}
+	h := sha256.Sum256(b[:])
+	copy(ack[8:], h[:])
+	return ack
+}
+
+func profileProofBootstrapV2(r profileLaunch) (b [128]byte, err error) {
+	b, err = profileProofBootstrap(r)
+	if err != nil {
+		return b, err
+	}
+	copy(b[:], "YNKPF002")
+	be.PutUint16(b[8:], 2)
+	return b, nil
+}
+func profileSocketRecord(r profileLaunch, request, proof uint64, ingress uint16, tuple [40]byte) (b [192]byte, err error) {
+	if r.mode != 2 || request == 0 || request == ^uint64(0) || proof == 0 || proof == ^uint64(0) || ingress >= 4 || tuple[0] != 6 || !profileProofTuple(tuple) {
+		return b, errProfile
+	}
+	copy(b[:], "YNKSPF01")
+	be.PutUint16(b[8:], 1)
+	be.PutUint16(b[10:], 192)
+	be.PutUint16(b[12:], 1)
+	copy(b[16:], r.digest[:])
+	copy(b[48:], r.session[:])
+	copy(b[64:], r.invocation[:])
+	be.PutUint64(b[80:], r.generation)
+	be.PutUint64(b[88:], r.epoch)
+	copy(b[96:], r.nonce[:])
+	be.PutUint64(b[128:], request)
+	be.PutUint64(b[136:], proof)
+	be.PutUint16(b[144:], ingress)
+	b[146] = 2
+	copy(b[148:], tuple[:])
+	return b, nil
+}
+func profileProofTuple(t [40]byte) bool {
+	if t[0] != 6 || !zero(t[2:4]) || u16(t[:], 4) == 0 || u16(t[:], 6) == 0 {
+		return false
+	}
+	if t[1] == 4 {
+		return zero(t[12:24]) && zero(t[28:40]) && profileIP(t[8:12]) && profileIP(t[24:28])
+	}
+	return t[1] == 6 && profileIP(t[8:24]) && profileIP(t[24:40])
+}
diff --git a/common/yonikbroker/profile_socket_proof_linux_test.go b/common/yonikbroker/profile_socket_proof_linux_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_socket_proof_linux_test.go
@@ -0,0 +1,553 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"bytes"
+	"context"
+	_ "embed"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	xnet "github.com/xtls/xray-core/common/net"
+	"golang.org/x/sys/unix"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+//go:embed profile-system-proof-v1.json
+var systemProofVector []byte
+
+type proofFixture struct {
+	Launch    string `json:"launch_hex"`
+	Bootstrap string `json:"bootstrap_hex"`
+	Ack       string `json:"bootstrap_ack_hex"`
+	Socket    string `json:"socket_hex"`
+}
+
+func proofVector(t *testing.T) (profileLaunch, proofFixture) {
+	t.Helper()
+	var v proofFixture
+	if e := json.Unmarshal(systemProofVector, &v); e != nil {
+		t.Fatal(e)
+	}
+	b, e := hex.DecodeString(v.Launch)
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, e := decodeProfileLaunch(b)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return r, v
+}
+func proofBytes(t *testing.T, s string) []byte {
+	t.Helper()
+	b, e := hex.DecodeString(s)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return b
+}
+
+type proofFakeFD struct {
+	mu     sync.Mutex
+	closed bool
+	calls  int
+	result error
+}
+
+func (f *proofFakeFD) Close() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !f.closed {
+		f.closed = true
+		f.calls++
+	}
+	return f.result
+}
+func (f *proofFakeFD) withFD(fn func(int) error) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.closed {
+		return errProfile
+	}
+	return fn(71)
+}
+
+type proofFakeBootstrap struct {
+	packet                             profileProofPacket
+	alive                              bool
+	clock                              *time.Time
+	advance                            time.Duration
+	readError, validateError, ackError error
+	reads, validates                   int
+	ack                                []byte
+}
+
+func (f *proofFakeBootstrap) receiveBootstrap(time.Time) (profileProofPacket, error) {
+	f.reads++
+	if f.clock != nil {
+		*f.clock = f.clock.Add(f.advance)
+	}
+	return f.packet, f.readError
+}
+func (f *proofFakeBootstrap) validateProofFD(profileProofFD) error {
+	f.validates++
+	return f.validateError
+}
+func (f *proofFakeBootstrap) sendBootstrapAck(b []byte) error {
+	f.ack = append([]byte(nil), b...)
+	return f.ackError
+}
+func (f *proofFakeBootstrap) proofPeerAlive() bool { return f.alive }
+
+func TestProfileProofExactRustWireAndTupleOrientation(t *testing.T) {
+	r, v := proofVector(t)
+	bootstrap, e := profileProofBootstrap(r)
+	if e != nil || !bytes.Equal(bootstrap[:], proofBytes(t, v.Bootstrap)) {
+		t.Fatal("YNKPF001 parity", e)
+	}
+	ack := profileProofAck(bootstrap)
+	if !bytes.Equal(ack[:], proofBytes(t, v.Ack)) {
+		t.Fatal("YNKPFA01 hash parity")
+	}
+	vector := proofBytes(t, v.Socket)
+	var tuple [40]byte
+	copy(tuple[:], vector[148:188])
+	record, e := profileSocketRecord(r, 3, 1, 0, tuple)
+	if e != nil || !bytes.Equal(record[:], vector) {
+		t.Fatal("YNKSPF01 parity", e)
+	}
+	if u16(tuple[:], 4) != 32001 || u16(tuple[:], 6) != 1080 {
+		t.Fatal("initiator/ingress flipped")
+	}
+	for _, request := range []uint64{0, ^uint64(0)} {
+		if _, e = profileSocketRecord(r, request, 1, 0, tuple); e == nil {
