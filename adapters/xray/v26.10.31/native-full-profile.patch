+type serviceBlockedConn struct {
+	serviceDNSConn
+	entered, release, closed chan struct{}
+	readOnce, closeOnce      sync.Once
+}
+
+func (c *serviceBlockedConn) Read(b []byte) (int, error) {
+	c.readOnce.Do(func() { close(c.entered) })
+	select {
+	case <-c.closed:
+		return 0, io.ErrClosedPipe
+	case <-c.release:
+		return c.serviceDNSConn.Read(b)
+	}
+}
+func (c *serviceBlockedConn) Close() error {
+	c.closeOnce.Do(func() { close(c.closed) })
+	return c.serviceDNSConn.Close()
+}
