+		t.Fatal(err)
+	}
+	op = owner.requests[owner.used-1]
+	if op.deadline != original {
+		t.Fatal("Resource retry extended cleanup")
+	}
+	h.f.now = original
+	if err := h.f.c.accept(dnsFactoryRetired(op, 1)); err == nil || !owner.unknown || owner.released {
+		t.Fatal("late cleanup ACK became KnownClosed")
+	}
+}
