+func flowSubject(name string, kind byte, stream, tcp, udp uint16) []byte {
+	b := []byte{0, byte(len(name))}
+	b = append(b, []byte(name)...)
+	b = append(b, kind, 0)
+	for _, v := range []uint16{stream, tcp, udp} {
+		p := make([]byte, 2)
+		be.PutUint16(p, v)
+		b = append(b, p...)
+	}
+	return b
+}
+func flowScope(subject uint16, input, dial, carrier, action byte, endpoint, stream, chain uint16) []byte {
+	b := make([]byte, 24)
+	be.PutUint16(b, subject)
+	b[2] = input
+	b[3] = 1
+	b[4] = dial
+	b[5] = carrier
+	for i := 8; i < 20; i++ {
+		b[i] = 255
+	}
+	be.PutUint16(b[8:], endpoint)
+	be.PutUint16(b[12:], stream)
+	be.PutUint16(b[16:], chain)
+	b[20] = action
+	return b
+}
+func flowEndpoint(network byte, address string, port uint16) []byte {
+	return append((profileDestinationValue{network: network, address: address, port: port, family: 4}).encode(), 0, 0, 0, 0)
+}
+func flowEdge(source, next uint16) []byte {
+	b := make([]byte, 8)
+	be.PutUint16(b, source)
+	be.PutUint16(b[2:], next)
+	b[5] = 1
+	return b
+}
+func (f *flowFixture) chainGraph(t *testing.T, variant string) {
+	rows := f.c.manifest.rows
+	firstKind, transport, security := byte(1), byte(3), byte(1)
+	if variant == "hysteria" {
+		firstKind = 4
+		transport = 4
+		security = 0
+	}
+	streamA := make([]byte, 36)
+	streamA[0] = transport
+	streamA[1] = security
+	streamA[4] = 1
+	streamB := make([]byte, 36)
+	streamB[0] = 2
+	streamB[4] = 2
+	rows[3] = [][]byte{streamA, streamB}
+	if variant == "grpc-udp-to-tcp" {
+		rows[0] = [][]byte{flowSubject("a", 1, 0, 0, 1), flowSubject("b", 2, 1, 2, 3)}
+		streamA[0] = 2
+		streamA[1] = 0
+		rows[1] = [][]byte{flowEndpoint(6, "198.51.100.1", 443), flowEndpoint(6, "198.51.100.2", 8388), flowEndpoint(17, "198.51.100.2", 8388)}
+		rows[8] = [][]byte{flowScope(0, 6, 6, 6, 2, 0, 0, 0), flowScope(0, 17, 6, 6, 2, 0, 0, 1), flowScope(1, 6, 6, 6, 1, 1, 1, 65535), flowScope(1, 17, 17, 17, 1, 2, 65535, 65535)}
+		rows[2] = [][]byte{flowEdge(0, 2), flowEdge(1, 2)}
+	} else if variant == "ss-raw-udp" {
+		rows[0] = [][]byte{flowSubject("a", 2, 0, 0, 1), flowSubject("b", 1, 1, 2, 3)}
+		streamA[0] = 2
+		streamA[1] = 0
+		rows[1] = [][]byte{flowEndpoint(6, "198.51.100.1", 443), flowEndpoint(17, "198.51.100.1", 443), flowEndpoint(6, "198.51.100.2", 8388)}
+		rows[8] = [][]byte{flowScope(0, 6, 6, 6, 2, 0, 0, 0), flowScope(0, 17, 17, 17, 2, 1, 65535, 1), flowScope(1, 6, 6, 6, 1, 2, 1, 65535), flowScope(1, 17, 6, 6, 1, 2, 1, 65535)}
+		rows[2] = [][]byte{flowEdge(0, 2), flowEdge(1, 3)}
+	} else {
+		rows[0] = [][]byte{flowSubject("a", firstKind, 0, 0, 1), flowSubject("b", 2, 1, 2, 3)}
+		rows[1] = [][]byte{flowEndpoint(17, "198.51.100.1", 443), flowEndpoint(6, "198.51.100.2", 8388), flowEndpoint(17, "198.51.100.2", 8388)}
+		rows[8] = [][]byte{flowScope(0, 6, 6, 17, 2, 0, 0, 0), flowScope(0, 17, 6, 17, 2, 0, 0, 1), flowScope(1, 6, 6, 6, 1, 1, 1, 65535), flowScope(1, 17, 17, 17, 1, 2, 65535, 65535)}
+		rows[2] = [][]byte{flowEdge(0, 3), flowEdge(1, 3)}
+		// TCP mux disabled, XUDP enabled, UDP/443 skip: B TCP normal;
+		// B UDP имеет обе branches, но source endpoint:443 выбирает normal.
+		s := rows[8][3]
+		s[3] = 3
+		s[6] = 6
+		s[7] = 6
+		be.PutUint16(s[10:], 1)
+		be.PutUint16(s[14:], 1)
+		s[21] = 1
+	}
+	f.installManifest(t, rows)
+}
+func TestProfileFlowChainCarrierBecomesNextInput(t *testing.T) {
+	for _, variant := range []string{"xhttp-h3", "hysteria", "ss-raw-udp", "grpc-udp-to-tcp"} {
+		t.Run(variant, func(t *testing.T) {
+			f := newFlowFixture(t, 1)
+			f.chainGraph(t, variant)
+			stop := f.serve(t)
+			defer stop()
+			ctx := context.WithValue(f.p.ctx, profileContextKey{}, f.p)
+			ctx, e := ProfileAccept(ctx, fakeTCPFlowConn(), "i")
+			if e != nil {
+				t.Fatal(e)
+			}
+			destination := xnet.TCPDestination(xnet.DomainAddress("original.invalid"), 443)
+			if variant == "ss-raw-udp" || variant == "grpc-udp-to-tcp" {
+				conn := &flowFakeConn{local: &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 49152}, remote: &net.UDPAddr{IP: net.IPv4(192, 0, 2, 1), Port: 32001}}
+				ctx, e = ProfileAssociateUDP(ctx, conn)
+				if e != nil {
+					t.Fatal(e)
+				}
+				destination = xnet.UDPDestination(destination.Address, 443)
+			}
+			original, closeOriginal, e := ProfileOpenOriginal(ctx, destination)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer closeOriginal()
+			selected, e := ProfileSelectRoute(original, "a", destination)
+			if e != nil {
+				t.Fatal(e)
+			}
+			first, release, e := ProfileAuthorizeHandler(selected, "a", destination, false)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer release()
+			aTCP := xnet.TCPDestination(xnet.IPAddress(net.IPv4(198, 51, 100, 1)), 443)
+			aUDP := xnet.UDPDestination(aTCP.Address, 443)
+			dial := aTCP
+			if variant == "ss-raw-udp" {
+				dial = aUDP
+			}
+			carrier, wrong := aUDP, aTCP
+			nextScope := uint16(3)
+			if variant == "grpc-udp-to-tcp" {
+				carrier, wrong = aTCP, aUDP
+				nextScope = 2
+			}
+			if ProfileCheckDial(first, dial, false) != nil || ProfileCheckDial(first, carrier, true) != nil {
+				t.Fatal("source D/C")
+			}
+			if _, e = ProfileChain(first, wrong, "b"); e == nil {
+				t.Fatal("original/default protocol вместо carrier")
+			}
+			chained, e := ProfileChain(first, carrier, "b")
+			if e != nil {
+				t.Fatal(e)
+			}
+			if variant == "xhttp-h3" || variant == "hysteria" {
+				if _, _, e = ProfileAuthorizeHandler(chained, "b", carrier, true); e == nil {
+					t.Fatal("mux bool обошёл exact nextBranchMask")
+				}
+			}
+			if _, _, e = ProfileAuthorizeHandler(chained, "b", wrong, false); e == nil {
+				t.Fatal("next input вместо C")
+			}
+			second, releaseSecond, e := ProfileAuthorizeHandler(chained, "b", carrier, false)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer releaseSecond()
+			g := second.Value(profileGrantKey{}).(*profileGrant)
+			if g.scope != nextScope || g.receipt.original.network != profileReceiptFrom(original).original.network || g.receipt.id != profileReceiptFrom(original).id {
+				t.Fatal("original/provenance changed")
+			}
+			bNetwork := xnet.Network_UDP
+			expectedStream := uint16(65535)
+			if variant == "ss-raw-udp" || variant == "grpc-udp-to-tcp" {
+				bNetwork = xnet.Network_TCP
+				expectedStream = 1
+			}
+			bDial := xnet.Destination{Network: bNetwork, Address: xnet.IPAddress(net.IPv4(198, 51, 100, 2)), Port: 8388}
+			if g.stream != expectedStream || ProfileCheckDial(second, bDial, false) != nil {
+				t.Fatal("raw UDP/configured stream")
+			}
+		})
+	}
+}
