+func syntheticProfileSnapshot() ([]byte, profileAsset) {
+	b := make([]byte, 120+32+8+2)
+	copy(b, "YNKDNS01")
+	be.PutUint16(b[8:], 1)
+	be.PutUint16(b[10:], 120)
+	b[16] = 1
+	b[152] = 3
+	b[153] = 1
+	b[154] = 2
+	be.PutUint32(b[156:], 5000)
+	be.PutUint16(b[160:], 16)
+	// hostname empty, search empty, один localhost stub, hosts empty.
+	b = append(b, 0, 0, 0, 0, 0, 1, 4, 0, 0, 53, 127, 0, 0, 1, 0, 0)
+	be.PutUint32(b[12:], uint32(len(b)))
+	a := profileAsset{dns: true, size: uint64(len(b)), digest: sha256.Sum256(b)}
+	copy(a.source[:], b[16:48])
+	return b, a
+}
+func TestProfileSnapshotExactHashLayoutAndBounds(t *testing.T) {
