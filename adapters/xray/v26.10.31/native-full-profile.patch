+	if e := <-retired; !goerrors.Is(e, r9MuxCleanupError) {
+		t.Fatal("retirement потерял Unknown", e)
+	}
+	if input.calls.Load() != 1 || output.calls.Load() != 1 {
+		t.Fatal("leaf cleanup повторён")
+	}
+}
diff --git a/common/yonikbroker/profile_cleanup.go b/common/yonikbroker/profile_cleanup.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_cleanup.go
@@ -0,0 +1,42 @@
+package nativehooks
+
+import (
+	"errors"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/transport/pipe"
+	"io"
+)
+
+var ErrProfileCleanupUnknown = errors.New("full-profile cleanup unconfirmed")
+
+// Void Interrupt сам по себе не подтверждает cleanup. Для concrete owned pipe
+// проверяется синхронный closed postcondition; другой void API даёт Unknown.
+func ProfileCleanupResource(value any) error {
+	if resource, ok := value.(interface{ ProfileCleanup() error }); ok {
+		return resource.ProfileCleanup()
+	}
+	switch resource := value.(type) {
+	case *pipe.Reader:
+		resource.Interrupt()
+		pending, err := resource.ReadMultiBuffer()
+		if len(pending) != 0 {
+			buf.ReleaseMulti(pending)
+			return ErrProfileCleanupUnknown
+		}
+		if errors.Is(err, io.ErrClosedPipe) || errors.Is(err, io.EOF) {
+			return nil
+		}
+		return errors.Join(ErrProfileCleanupUnknown, err)
+	case *pipe.Writer:
+		resource.Interrupt()
+		return resource.Close()
+	case io.Closer:
+		return resource.Close()
+	default:
+		if resource, ok := value.(common.Interruptible); ok {
+			resource.Interrupt()
+		}
+		return ErrProfileCleanupUnknown
+	}
+}
