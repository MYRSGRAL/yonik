+func TestProfileDNSDirectCloseWaitsJoinAndDurableRetirement(t *testing.T) {
+	h := dnsDirectStart(t, 6, nil, nil)
+	conn := h.ready(t)
+	h.conn.closeEntered = make(chan struct{})
+	h.conn.closeRelease = make(chan struct{})
+	done := make(chan error, 1)
+	go func() { done <- conn.Close() }()
+	<-h.conn.closeEntered
+	owner := h.f.c.dnsDirect[0]
+	if err := h.f.c.tick(); err != nil {
+		t.Fatal(err)
+	}
+	if owner.localDone || owner.released || h.f.c.dnsFDUsed != profileRXFD+2 {
+		t.Fatal("close without join released")
+	}
+	close(h.conn.closeRelease)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	// Каждый шаг issuer retirement подтверждён отдельно. Один ACK не закрывает
+	// actual Go duplicate и не отменяет соседнюю association/query.
+	for step := 0; step < 5; step++ {
+		if err := h.f.c.tick(); err != nil {
+			t.Fatal(err)
+		}
+		op := owner.requests[owner.used-1]
+		var reply profilePacket
+		if op.kind == 45 {
+			body := make([]byte, 40)
+			be.PutUint16(body, 2)
+			body[2], body[3], body[28] = 1, op.body[2], 1
+			be.PutUint64(body[8:], u64(op.body, 8))
+			be.PutUint64(body[16:], u64(op.body, 16))
+			be.PutUint64(body[32:], op.sequence)
+			reply = profilePacket{kind: 46, reply: op.sequence, body: body}
+		} else {
+			reply = dnsCancelAck(op.sequence, u64(op.body, 8))
+		}
+		if err := h.f.c.accept(reply); err != nil {
+			t.Fatal(err)
+		}
+		if owner.released {
+			t.Fatal("released before complete retirement")
+		}
+	}
+	if err := h.f.c.tick(); err != nil {
+		t.Fatal(err)
+	}
+	if !owner.released || owner.unknown || h.f.c.dnsFDUsed != profileRXFD || h.fd.calls != 1 {
+		t.Fatal("confirmed cleanup not released exactly once")
+	}
+	if err := conn.Close(); err != nil || h.conn.closes != 1 {
+		t.Fatal("repeat close changed result")
+	}
+}
