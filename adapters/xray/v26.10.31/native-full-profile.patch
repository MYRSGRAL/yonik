+func (f *flowFixture) serve(t *testing.T) func() {
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for {
+			select {
+			case <-stop:
+				return
+			case op := <-f.p.flowQueue:
+				if e := f.c.dispatch(op); e != nil {
+					f.c.mu.Lock()
+					f.c.finish(op, e)
+					f.c.mu.Unlock()
+					continue
+				}
+				var reply profilePacket
+				if op.kind == 16 {
+					reply = f.ingressReply(op)
+				} else {
+					reply = f.grantReply(op, 2)
+				}
+				if e := f.c.accept(reply); e != nil {
+					f.c.mu.Lock()
+					f.c.finish(op, e)
+					f.c.mu.Unlock()
+				}
+			}
+		}
+	}()
+	return func() { close(stop); wg.Wait() }
+}
