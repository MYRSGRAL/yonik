+	return []net.IP{net.IP{192, 0, 2, 1}}, 42, nil
+}
+func TestYonikDNSClientOwnedLogsSuppressedLegacyPreserved(t *testing.T) {
+	capture := &outerLog{}
+	log.RegisterHandler(capture)
+	for _, owned := range []bool{false, true} {
+		for _, prior := range []bool{false, true} {
+			capture.messages = nil
+			c := &Client{server: outerServer{}, timeoutMs: time.Second, ipOption: &fdns.IPOption{IPv4Enable: true}, expectedIPs: outerMatcher{}, unexpectedIPs: outerMatcher{}, actPrior: prior, actUnprior: prior}
+			ips, _, e := c.queryIP(context.Background(), "Private.INVALID", fdns.IPOption{IPv4Enable: true}, owned)
+			if e != nil || len(ips) != 1 {
+				t.Fatal("фильтрация изменилась", e)
+			}
+			if owned && len(capture.messages) != 0 || !owned && len(capture.messages) != 2 {
+				t.Fatal("граница логов нарушена", owned, prior, capture.messages)
+			}
+		}
+	}
+}
