@@ -0,0 +1,668 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"bytes"
+	"context"
+	_ "embed"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"sync/atomic"
+	"testing"
