+func serviceReply(f *flowFixture, op *profileOperation) profilePacket {
+	id := op.object
+	if id == 0 {
+		f.grantID++
+		id = f.grantID
+	}
+	b := make([]byte, 56)
+	b[0], b[1] = 1, op.grant.class
+	be.PutUint64(b[4:], id)
+	be.PutUint32(b[20:], 1000)
+	revision := f.c.manifest.policy
+	if op.receipt != nil {
+		be.PutUint64(b[12:], op.receipt.id)
+		revision = op.receipt.revision
+		if f.c.mode == 2 {
+			b[2], b[40] = 1, 2
+			be.PutUint64(b[32:], uint64(20*time.Millisecond))
+			be.PutUint64(b[48:], 42)
+		}
+	}
+	be.PutUint64(b[24:], revision)
+	return profilePacket{kind: 19, reply: op.sequence, object: id, body: b}
