+func TestProfileDNSSetupMappingFourCannotDowngradeToV1Snapshot(t *testing.T) {
+	for _, mapping := range []uint16{3, 4} {
+		t.Run(map[uint16]string{3: "legacy-control", 4: "no-downgrade"}[mapping], func(t *testing.T) {
+			f := newFlowFixture(t, 1)
