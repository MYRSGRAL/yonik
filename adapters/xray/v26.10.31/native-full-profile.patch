+	udpActorDeliver(t, actor, r, receiver)
+	receiver.got = profileUDPReceiveResult{n: len(receiver.raw), tuple: fakeFlowTuple(17), cookie: r.association.cookie, bound: r.association.bound, queueBytes: 65536}
+	be.PutUint16(receiver.got.tuple[4:], sourcePort)
