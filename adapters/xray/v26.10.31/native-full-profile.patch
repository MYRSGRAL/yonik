+func TestProfileUDPProducerSniffingBoundary(t *testing.T) {
+	for _, metadata := range []bool{false, true} {
+		ctx := session.ContextWithContent(context.Background(), &session.Content{SniffingRequest: session.SniffingRequest{Enabled: true, MetadataOnly: metadata}})
+		called := false
+		p := &profileUDPProducer{runtime: &ProfileRuntime{}, dispatch: func(context.Context, xnet.Destination, *transport.Link) error { called = true; return nil }}
+		u := &profileUDPFlow{ctx: ctx, cancel: func() {}, receipt: &profileReceipt{}, tasks: 1, original: profileDestinationValue{family: 4, network: 17, address: "1.1.1.1", port: 53}}
+		p.runFlow(u)
+		if called != metadata {
+			t.Fatal("payload sniffer reached dispatcher", metadata, called)
+		}
+	}
+	u := &profileUDPFlow{ctx: context.Background(), payload: []byte("secret"), transferred: true}
+	if mb, e := (&profileUDPPayloadReader{flow: u}).ReadMultiBuffer(); e == nil || len(mb) != 0 || u.read {
+		t.Fatal("reader exposed payload without bound grant")
+	}
+}
