+// Единственная публикация strict actual caller до Release/cache update.
+func ownedPublishResponse(ctx context.Context, owned bool, raw []byte, rec *IPRecord) error {
+	if !owned && !hooks.ProfileResolverRequired(ctx) {
+		return nil
+	}
+	if rec == nil || !rec.owned {
+		return hooks.ErrProfileUnsupported
+	}
+	data, err := hooks.ProfileDNSPublish(ctx, raw)
+	if err != nil {
+		return err
+	}
+	expiry, err := hooks.ProfileDNSCacheRecord(ctx, data, rec.IP)
+	if err != nil {
+		return err
+	}
+	rec.producer = data
+	rec.Expire = expiry
+	return nil
+}
+
+type ownedDNSWaiterChooser interface {
+	ProfileDNSWaiterContext(context.Context, xnet.Destination) (context.Context, func(), error)
+}
+
+func prepareOwnedWaiter(ctx context.Context, data *hooks.ProfileDNSProducerData, chooser any, expected *xnet.Destination) ([]xnet.IP, uint32, error) {
+	request, target, err := hooks.ProfileDNSDataRequest(ctx, data)
+	if err != nil {
+		return nil, 0, err
+	}
+	if expected == nil || expected.Address == nil || expected.Network != target.Network || expected.Port != target.Port || expected.Address.String() != target.Address.String() {
+		return nil, 0, hooks.ErrProfileUnsupported
+	}
+	router, ok := chooser.(ownedDNSWaiterChooser)
+	if !ok {
+		return nil, 0, hooks.ErrProfileUnsupported
+	}
+	exchange, release, err := hooks.ProfileDNSExchangeContext(ctx, request, target)
+	if err != nil {
+		return nil, 0, err
+	}
+	next, releasePath, err := router.ProfileDNSWaiterContext(toDnsContext(exchange, target.String()), target)
+	if err != nil {
+		release()
+		return nil, 0, err
+	}
+	if err = hooks.ProfileDNSBindWaiter(next, data); err != nil {
+		releasePath()
+		release()
+		return nil, 0, err
+	}
+	// Result lifetime принадлежит собственному private query waiter.
+	context.AfterFunc(ctx, func() { releasePath(); release() })
+	return hooks.ProfileDNSDataAnswer(next, data)
+}
