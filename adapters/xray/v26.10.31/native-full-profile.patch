+
+var r9MuxCleanupError = goerrors.New("R9 mux cleanup Unknown")
+
+type r9MuxEndpoint struct {
+	calls            atomic.Int32
+	once             sync.Once
+	entered, release chan struct{}
+	err              error
+	beforeClose      func()
+}
+
+type r9MuxBlockedInput struct {
+	entered, release    chan struct{}
+	readOnce, closeOnce sync.Once
+}
+
+func (r *r9MuxBlockedInput) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	r.readOnce.Do(func() { close(r.entered) })
+	<-r.release
+	return nil, io.EOF
+}
+func (r *r9MuxBlockedInput) Close() error {
+	r.closeOnce.Do(func() { close(r.release) })
+	return nil
+}
+
+type r9MuxSink struct{}
+
+func (*r9MuxSink) WriteMultiBuffer(b buf.MultiBuffer) error { buf.ReleaseMulti(b); return nil }
+func (*r9MuxSink) Close() error                             { return nil }
+
+func TestYonikR9MuxMonitorWakesWaitingDispatchBeforeJoin(t *testing.T) {
+	retired := make(chan error, 1)
+	w, tasks := r9MuxConstruct(t, transport.Link{Reader: &r9MuxEndpoint{}, Writer: &r9MuxSink{}}, func(e error) { retired <- e })
+	input := &r9MuxBlockedInput{entered: make(chan struct{}), release: make(chan struct{})}
+	ctx := session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Target: net.TCPDestination(net.DomainAddress("synthetic.invalid"), 443)}})
+	dispatched := make(chan bool, 1)
+	go func() { dispatched <- w.Dispatch(ctx, &transport.Link{Reader: input, Writer: &r9MuxSink{}}) }()
+	<-input.entered
+	w.requestClose()
+	tasks.fetch()
+	tasks.monitor()
+	if !<-dispatched || w.Close() != nil || <-retired != nil {
+		t.Fatal("monitor не дождался Dispatch/input cleanup")
+	}
+}
+
+func (e *r9MuxEndpoint) ReadMultiBuffer() (buf.MultiBuffer, error) { return nil, io.EOF }
+func (e *r9MuxEndpoint) WriteMultiBuffer(b buf.MultiBuffer) error {
+	buf.ReleaseMulti(b)
+	return io.ErrClosedPipe
+}
+func (e *r9MuxEndpoint) Close() error {
+	e.once.Do(func() {
+		e.calls.Add(1)
+		if e.beforeClose != nil {
+			e.beforeClose()
+		}
+		if e.entered != nil {
+			close(e.entered)
+			<-e.release
+		}
+	})
+	return e.err
+}
+
+type r9MuxVoid struct{ interrupted atomic.Bool }
+
+func (e *r9MuxVoid) ReadMultiBuffer() (buf.MultiBuffer, error) { return nil, io.EOF }
+func (e *r9MuxVoid) WriteMultiBuffer(b buf.MultiBuffer) error {
+	buf.ReleaseMulti(b)
+	return io.ErrClosedPipe
+}
+func (e *r9MuxVoid) Interrupt() { e.interrupted.Store(true) }
+
+type r9MuxTasks struct{ fetch, monitor func() }
+
+// Pure constructor runner удерживает реальные fetch/monitor до fake barriers.
+func r9MuxConstruct(t *testing.T, link transport.Link, retire func(error)) (*ClientWorker, r9MuxTasks) {
+	t.Helper()
+	var options *profileWorkerOptions
+	if retire != nil {
+		options = &profileWorkerOptions{retire: retire}
+	}
+	var queued []func()
+	w, e := newClientWorker(link, ClientStrategy{}, options, func(task func()) { queued = append(queued, task) })
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { w.timer.Stop() })
+	if len(queued) != 2 {
+		t.Fatal("constructor tasks")
+	}
+	return w, r9MuxTasks{fetch: queued[0], monitor: queued[1]}
+}
+
+func TestYonikR9MuxCloseWaitsForActualMonitorCleanup(t *testing.T) {
+	for _, phase := range []string{"session", "writer", "reader"} {
+		t.Run(phase, func(t *testing.T) {
+			input, output, reader, writer := &r9MuxEndpoint{}, &r9MuxEndpoint{}, &r9MuxEndpoint{}, &r9MuxEndpoint{}
+			target := input
+			if phase == "writer" {
+				target = writer
+			}
+			if phase == "reader" {
+				target = reader
+			}
+			target.err = r9MuxCleanupError
+			target.entered = make(chan struct{})
+			target.release = make(chan struct{})
+			retired := make(chan error, 1)
+			w, tasks := r9MuxConstruct(t, transport.Link{Reader: reader, Writer: writer}, func(e error) { retired <- e })
+			if s := w.sessionManager.Allocate(&ClientStrategy{}, input, output); s == nil {
+				t.Fatal("session fixture")
+			}
+			closed := make(chan error, 1)
+			go func() { closed <- w.Close() }()
+			<-w.done.Wait()
+			tasks.fetch()
+			monitorDone := make(chan struct{})
+			go func() { tasks.monitor(); close(monitorDone) }()
+			<-target.entered
+			var earlyClose, earlyRetire bool
+			var closeErr, retireErr error
+			select {
+			case closeErr = <-closed:
+				earlyClose = true
+			default:
+			}
+			select {
+			case retireErr = <-retired:
+				earlyRetire = true
+			default:
+			}
+			close(target.release)
+			<-monitorDone
+			if !earlyClose {
+				closeErr = <-closed
+			}
+			if !earlyRetire {
+				retireErr = <-retired
+			}
+			if earlyClose || earlyRetire || !goerrors.Is(closeErr, r9MuxCleanupError) || !goerrors.Is(retireErr, r9MuxCleanupError) {
+				t.Fatalf("cleanup не подтверждён: earlyClose=%v earlyRetire=%v close=%v retire=%v", earlyClose, earlyRetire, closeErr, retireErr)
+			}
+			if again := w.Close(); again != closeErr {
+				t.Fatal("повторный Close изменил final result", again, closeErr)
+			}
+			for _, e := range []*r9MuxEndpoint{input, output, reader, writer} {
+				if e.calls.Load() != 1 {
+					t.Fatal("cleanup повторён или потерян", e.calls.Load())
+				}
+			}
+			select {
+			case <-retired:
+				t.Fatal("повторный retirement")
+			default:
+			}
+		})
+	}
+}
