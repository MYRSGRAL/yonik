+	one := &serviceBlockedConn{entered: make(chan struct{}), release: make(chan struct{}), closed: make(chan struct{})}
+	two := &serviceBlockedConn{entered: make(chan struct{}), release: make(chan struct{}), closed: make(chan struct{})}
+	configure := func(c *serviceBlockedConn) {
+		c.remote = &net.UDPAddr{IP: net.IPv4(127, 0, 0, 53), Port: 53}
+		c.respond = func(b []byte) []byte { return serviceAnswer(t, b, false, false) }
