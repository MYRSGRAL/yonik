+
+func TestYonikDNSNumericOuterDoesNotReturnBeforeGuardOrOnPartialError(t *testing.T) {
+	entered, allow := make(chan struct{}), make(chan struct{})
+	done := make(chan struct{})
+	var ips []net.IP
+	var ttl uint32
+	var result error
+	begin := func(ctx context.Context, _ string) (context.Context, func(), error) { return ctx, func() {}, nil }
+	lookup := func(context.Context, string, fdns.IPOption) ([]net.IP, uint32, error) {
+		return []net.IP{{203, 0, 113, 9}, {203, 0, 113, 10}}, 60, nil
+	}
+	finish := func(context.Context, string, []net.IP, uint32) ([]net.IP, uint32, error) {
+		close(entered)
+		<-allow
+		return []net.IP{{203, 0, 113, 9}}, 60, errors.New("numeric denied")
+	}
+	go func() {
+		ips, ttl, result = profileDNSLookup(context.Background(), "Original.INVALID", fdns.IPOption{IPv4Enable: true}, lookup, begin, func(context.Context, string, []net.IP) error { return nil }, finish)
+		close(done)
+	}()
+	<-entered
+	select {
+	case <-done:
+		t.Fatal("caller returned before Numeric permission")
+	default:
+	}
+	close(allow)
+	<-done
+	if result == nil || ips != nil || ttl != 0 {
+		t.Fatal("partial result escaped Numeric denial")
+	}
+}
+
+// Private injection проверяет реальный outer pipeline без core/network.
+func TestYonikDNSOuterExactQueryReleaseAndReturn(t *testing.T) {
+	for _, mode := range []string{"narrow", "wrong-name", "wrong-ip", "neighbor", "replay", "cancel", "stale", "provider-cache", "lookup-error", "begin-error"} {
+		t.Run(mode, func(t *testing.T) {
+			type key struct{}
+			token := new(int)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			released, looked, checked := 0, 0, 0
+			deny := errors.New("нет authority")
+			begin := func(c context.Context, n string) (context.Context, func(), error) {
+				if n != "Original.INVALID" {
+					t.Fatal("original изменён")
+				}
+				if mode == "begin-error" {
+					return c, func() {}, deny
+				}
+				return context.WithValue(c, key{}, token), func() { released++ }, nil
+			}
+			lookup := func(c context.Context, n string, _ fdns.IPOption) ([]net.IP, uint32, error) {
+				looked++
+				if c.Value(key{}) != token || n != "Original.INVALID" {
+					t.Fatal("query context потерян")
+				}
+				if mode == "lookup-error" {
+					return nil, 0, deny
+				}
+				if mode == "cancel" {
+					cancel()
+				}
+				return []net.IP{net.IP{192, 0, 2, 1}}, 42, nil
+			}
+			check := func(c context.Context, n string, ips []net.IP) error {
+				checked++
+				if c.Value(key{}) != token || n != "Original.INVALID" || len(ips) != 1 {
+					t.Fatal("check не получил exact result")
+				}
+				if mode != "narrow" {
+					return deny
+				}
+				return nil
+			}
+			ips, ttl, e := profileDNSLookup(ctx, "Original.INVALID", fdns.IPOption{IPv4Enable: true}, lookup, begin, check)
+			if mode == "narrow" {
+				if e != nil || len(ips) != 1 || ttl != 42 {
+					t.Fatal("narrowing потерян")
+				}
+			} else if e == nil || ips != nil || ttl != 0 {
+				t.Fatal("непроверенный result вышел")
+			}
+			if mode == "begin-error" {
+				if looked != 0 || released != 0 {
+					t.Fatal("эффект до scope")
+				}
+			} else if released != 1 {
+				t.Fatal("release не exact once")
+			}
+			if mode == "lookup-error" && checked != 0 {
+				t.Fatal("ошибка lookup стала ответом")
+			}
+		})
+	}
+}
