+	if err := c.accept(dnsCancelAck(holder.cancelSequence, op.sequence)); err != nil {
+		t.Fatal(err)
+	}
+	reply, _ := numericGolden(t, 1, op.receipt.id)
+	reply.reply = op.sequence
+	if c.accept(reply) == nil || !holder.unknown || holder.released {
+		t.Fatal("Known cancel resurrected late GRANT")
+	}
+}
