+		c.mu.Lock()
+		c.numericClose(n)
+		c.mu.Unlock()
+		return ctx, noop, target, true, err
+	}
+	c.mu.Lock()
+	n.query = profileQueryFrom(query)
+	n.query.refs++
+	c.mu.Unlock()
+	query = context.WithValue(query, profileNumericKey{}, n)
+	_, _, err = lookup(query, v.address)
+	c.mu.Lock()
+	valid := err == nil && n.answered && n.grant != nil && c.numericParentLive(n) && c.grantLive(n.grant)
+	if !valid {
+		c.numericClose(n)
+		n.query.closeLocked()
+	}
+	c.mu.Unlock()
+	if !valid {
+		return ctx, noop, target, true, errProfile
+	}
+	// USER handoff не содержит DNS exchange/query key и не меняет original host.
+	next := context.WithValue(n.grant.ctx, profileGrantKey{}, n.grant)
+	next = context.WithValue(next, profileRouteKey{}, profileSelectedRoute{subject: n.subject, scope: n.scope, branches: 1, effective: n.target})
+	release := func() { c.mu.Lock(); c.numericClose(n); n.query.closeLocked(); c.mu.Unlock() }
+	return next, release, profileNumericDestination(n.target), true, nil
+}
+func profileNumericDestination(v profileDestinationValue) xnet.Destination {
+	network := xnet.Network_TCP
+	if v.network == 17 {
+		network = xnet.Network_UDP
+	}
+	return xnet.Destination{Network: network, Address: xnet.ParseAddress(v.address), Port: xnet.Port(v.port)}
+}
+
+// Production outer caller не выпускает USER answer на одном class3 receipt.
+func ProfileFinishDNSAnswer(ctx context.Context, name string, ips []net.IP, ttl uint32) ([]net.IP, uint32, error) {
+	p := profileRuntime(ctx)
+	if p == nil {
+		if err := ProfileCheckDNSAnswer(ctx, name, ips); err != nil {
+			return nil, 0, err
+		}
+		return ips, ttl, nil
+	}
+	n, _ := ctx.Value(profileNumericKey{}).(*profileNumeric)
+	if n == nil {
+		if err := ProfileCheckDNSAnswer(ctx, name, ips); err != nil {
+			return nil, 0, err
+		}
+		return ips, ttl, nil
+	}
+	q := profileQueryFrom(ctx)
+	c := p.flow
+	c.mu.Lock()
+	if n.runtime != p || q != n.query || profileReceiptFrom(ctx) != n.receipt || ctx.Err() != nil || q.name != profileCanonicalQuery(name) || !q.ready || n.attempted || n.answered || !c.numericParentLive(n) || ttl == 0 || len(ips) == 0 || len(ips) > 256 {
+		c.mu.Unlock()
+		return nil, 0, errProfile
+	}
+	// Validate весь returned narrowing, затем выбрать один admitted member.
+	var w *profileDNSWaiter
+	member := -1
+	for _, raw := range ips {
+		ip, ok := netip.AddrFromSlice(raw)
+		if !ok {
+			c.mu.Unlock()
+			return nil, 0, errProfile
+		}
+		ip = ip.Unmap()
+		found := false
+		for _, candidate := range q.waiters {
+			if candidate == nil || !c.dnsWaiterLive(candidate) {
+				continue
+			}
+			for i, value := range candidate.data.members[:candidate.data.count] {
+				if value == ip {
+					found = true
+					if w == nil {
+						w = candidate
+						member = i
+					}
+				}
+			}
+		}
+		if !found {
+			c.mu.Unlock()
+			return nil, 0, errProfile
+		}
+	}
+	if w == nil || w.numeric != nil || w.bundle.exchange.query.receipt != n.receipt || w.bundle.exchange.root.revision != n.revision || q.name != profileCanonicalQuery(n.original.address) {
+		c.mu.Unlock()
+		return nil, 0, errProfile
+	}
+	ip := w.data.members[member]
+	if ip.IsLoopback() || ip.IsLinkLocalUnicast() || ip.IsMulticast() || ip.IsUnspecified() {
+		c.mu.Unlock()
+		return nil, 0, ErrProfileUnsupported
+	}
+	n.waiter = w
+	n.member = uint16(member)
+	n.target = n.original
+	n.target.family = 6
+	if ip.Is4() {
+		n.target.family = 4
+	}
+	n.target.address = ip.String()
+	n.deadline = w.deadline
+	for _, d := range []time.Time{w.reservationDeadline, w.bundle.deadline, w.data.expires, c.sessionDeadline, c.clock().Add(time.Second)} {
+		if d.Before(n.deadline) {
+			n.deadline = d
+		}
+	}
+	root := w.bundle.exchange.root
+	if c.serviceOwnerRequired(root) && root.ownerDeadline.Before(n.deadline) {
+		n.deadline = root.ownerDeadline
+	}
+	slot := -1
+	for i, g := range c.grants {
+		if g == nil && i < int(c.manifest.caps[0]) {
+			slot = i
+			break
+		}
+	}
+	if slot < 0 || !c.numericParentLive(n) {
+		c.mu.Unlock()
+		return nil, 0, errProfileFlowBusy
+	}
+	grantBase := context.WithValue(context.WithValue(n.ctx, profileDNSQueryKey{}, (*profileDNSQuery)(nil)), profileDNSExchangeKey{}, (*profileDNSExchange)(nil))
+	grantCtx, cancel := context.WithCancel(grantBase)
+	g := &profileGrant{numeric: n, class: 1, receipt: n.receipt, ctx: grantCtx, cancel: cancel, effective: n.target, subject: n.subject, scope: n.scope, stream: n.stream, chain: n.chain, branch: n.branch, slot: uint16(slot), prepared: true}
+	n.grant = g
+	c.grants[slot] = g
+	n.receipt.grantCount++
+	base := make([]byte, 20)
+	be.PutUint64(base, n.receipt.id)
+	base[8] = 1
+	be.PutUint16(base[10:], n.subject)
+	be.PutUint16(base[12:], n.chain)
+	be.PutUint16(base[14:], n.stream)
+	be.PutUint16(base[16:], n.scope)
+	base[18] = n.branch
+	base = append(base, n.original.encode()...)
+	base = append(base, n.original.encode()...)
+	base = append(base, 255, 255, 0, 0)
+	base = append(base, make([]byte, 16)...)
+	body := make([]byte, 16)
+	be.PutUint16(body, 2)
+	be.PutUint16(body[2:], n.member)
+	be.PutUint64(body[4:], w.id)
+	be.PutUint16(body[12:], uint16(len(base)))
+	body[14], body[15] = 1, 1
+	body = append(body, base...)
+	// DNS-only compact numeric prefix7, legacy Destination остаётся прежним.
+	dst := make([]byte, 7)
+	dst[0], dst[1] = n.target.family, n.target.network
+	be.PutUint16(dst[2:], n.target.port)
+	a := ip.AsSlice()
+	dst[4] = byte(len(a))
+	body = append(body, dst...)
+	body = append(body, a...)
+	if !profileDNSV2Body(42, body) {
+		c.numericClose(n)
+		c.mu.Unlock()
+		return nil, 0, errProfile
+	}
+	op := &profileOperation{dnsNumeric: n, ctx: ctx, receipt: n.receipt, grant: g, kind: 42, body: body, done: make(chan struct{})}
+	n.bodyDigest = sha256.Sum256(body)
+	n.op = op
+	c.mu.Unlock()
+	if err := p.flowRPC(op); err != nil {
+		return nil, 0, err
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.numericParentLive(n) || !c.grantLive(g) || n.answered {
+		return nil, 0, errProfile
+	}
+	n.answered = true
+	return []net.IP{append(net.IP(nil), ip.AsSlice()...)}, ttl, nil
+}
+
+func (c *profileFlowControl) numericDispatch(op *profileOperation) error {
+	n := op.dnsNumeric
+	if op.submitted || op.completed {
+		return nil
+	}
+	if !c.numericParentLive(n) || n.attempted || n.waiter.numeric != nil || !profileDNSV2Body(42, op.body) || sha256.Sum256(op.body) != n.bodyDigest {
+		c.numericClose(n)
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	op.sent = c.clock()
+	op.deadline = n.deadline
+	op.sessionDeadline = c.sessionDeadline
+	if !op.sent.Before(op.deadline) {
+		c.numericClose(n)
+		c.dnsNotify(op, errProfile)
+		return nil
+	}
+	// Irreversible narrowing фиксируется до write, включая uncertain send.
+	n.attempted = true
+	n.receipt.numericOnly = true
+	n.waiter.numeric = n
+	op.submitted = true
+	seq, err := c.write(42, 0, op.body)
+	op.sequence = seq
+	if seq > c.lastSent {
+		c.lastSent = seq
+	}
+	if err != nil || !profileDNSV2ID(seq) {
+		n.unknown = true
+		c.numericClose(n)
+		c.dnsNotify(op, errProfile)
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) numericAccept(f profilePacket) (bool, error) {
+	for _, n := range c.numerics[:c.numericUsed] {
+		if f.kind == 48 && n.cancelSequence != 0 && f.reply == n.cancelSequence {
+			if n.cancelAck || !profileDNSV2Body(48, f.body) || f.object != 0 || f.body[2] != 1 || u64(f.body, 8) != n.op.sequence || !c.clock().Before(n.cleanupDeadline) {
+				n.unknown = true
+				return true, errProfile
+			}
+			n.cancelAck = true
+			return true, nil
+		}
+		if f.kind == 34 && n.closeSequence != 0 && f.reply == n.closeSequence {
+			if n.closeAck || !profileCloseACK(f, 3, n.grant.id) || f.body[1] != 1 || !c.clock().Before(n.cleanupDeadline) {
+				n.unknown = true
+				return true, errProfile
+			}
+			n.closeAck = true
+			return true, nil
+		}
+		op := n.op
+		if op == nil || !op.submitted || f.reply != op.sequence {
+			continue
+		}
+		if n.received || n.cancelAck || f.kind != 19 || len(f.body) != 56 {
+			if f.kind == 19 && len(f.body) == 56 && f.body[0] == 1 && f.object != 0 && f.object == u64(f.body, 4) {
+				n.rejectedID = f.object
+			}
+			n.unknown = true
+			c.numericClose(n)
+			return true, errProfile
+		}
+		n.received = true
+		op.body = nil
+		b := f.body
+		if b[0] != 1 {
+			if f.object != 0 || (b[0] != 2 && b[0] != 3) || b[1] != 1 || !zero(b[2:]) {
+				n.unknown = true
+			}
+			if b[0] == 3 {
+				n.unknown = true
+			}
+			c.numericClose(n)
+			c.dnsNotify(op, errProfile)
+			return true, nil
+		}
+		// Общий GRANT19 decoder проверяет mandatory Known/receipt/flow/revision.
+		err := c.publish(op, f)
+		if err != nil {
+			if f.object == u64(b, 4) && f.object != 0 {
+				n.rejectedID = f.object
+			}
+			n.unknown = true
+			c.numericClose(n)
+			c.dnsNotify(op, errProfile)
+			return true, err
+		}
+		g := n.grant
+		if n.deadline.Before(g.deadline) {
+			g.deadline = n.deadline
+		}
+		if c.mode == 2 && n.deadline.Before(g.ownerDeadline) {
+			g.ownerDeadline = n.deadline
+		}
+		if !c.numericParentLive(n) || !c.clock().Before(op.deadline) || !c.grantLive(g) {
+			c.numericClose(n)
+			c.dnsNotify(op, errProfile)
+			return true, nil
+		}
+		c.dnsNotify(op, nil)
+		return true, nil
+	}
+	return false, nil
+}
+func (c *profileFlowControl) numericTick() error {
+	for _, n := range c.numerics[:c.numericUsed] {
+		if n.released || n.unknown {
+			continue
+		}
+		if !c.numericParentLive(n) || n.grant != nil && (n.grant.closed || !n.grant.deadline.IsZero() && !c.clock().Before(n.grant.deadline)) {
+			c.numericClose(n)
+		}
+		if !n.closed {
+			continue
+		}
+		if n.cleanupDeadline == c.sessionDeadline {
+			until := c.clock()
+			if !n.deadline.IsZero() {
+				until = n.deadline
+			}
+			n.cleanupDeadline = until.Add(time.Second)
+			if c.sessionDeadline.Before(n.cleanupDeadline) {
+				n.cleanupDeadline = c.sessionDeadline
+			}
+		}
+		if !c.clock().Before(n.cleanupDeadline) {
+			n.unknown = true
+			continue
+		}
+		if n.op != nil && n.op.submitted && !n.received {
+			c.dnsNotify(n.op, errProfile)
+			if n.cancelSequence == 0 {
+				seq, err := c.dnsCancel(1, n.op.sequence)
+				if err != nil {
+					n.unknown = true
+					return err
+				}
+				n.cancelSequence = seq
+			}
+			if !n.cancelAck || c.clock().Before(n.op.deadline) {
+				continue
+			}
+		}
+		if n.grant != nil && n.grant.id != 0 && !n.closeAck {
+			if n.closeSequence == 0 {
+				body := make([]byte, 12)
+				body[0] = 3
+				be.PutUint64(body[4:], n.grant.id)
+				seq, err := c.write(32, 0, body)
+				if seq > c.lastSent {
+					c.lastSent = seq
+				}
+				n.closeSequence = seq
+				if err != nil || !profileDNSV2ID(seq) {
+					n.unknown = true
+					return errProfile
+				}
+			}
+			continue
+		}
+		if n.query != nil {
+			n.query.closeLocked()
+			n.query.refs--
+			n.query.releaseLocked()
+		}
+		if g := n.grant; g != nil {
+			c.grants[g.slot] = nil
+			n.receipt.grantCount--
+		}
+		n.released = true
+		c.operations -= profileNumericPending
+		c.buffered -= profileNumericCredit - 16*1024
+	}
+	return nil
+}
+func (c *profileFlowControl) numericFloor(floor uint64) uint64 {
+	for _, n := range c.numerics[:c.numericUsed] {
+		if n.released {
+			continue
+		}
+		if op := n.op; op != nil && op.submitted && !n.received && op.sequence < floor {
+			floor = op.sequence
+		}
+		if n.cancelSequence != 0 && !n.cancelAck && n.cancelSequence < floor {
+			floor = n.cancelSequence
+		}
+		if n.closeSequence != 0 && !n.closeAck && n.closeSequence < floor {
+			floor = n.closeSequence
+		}
+	}
+	return floor
+}
+
+func ProfileNumericPhysicalAttempt(ctx context.Context, target xnet.Destination) error {
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	if g == nil {
+		if pool, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool); pool != nil {
+			candidate, err := pool.resolve(ctx)
+			if err != nil {
+				return err
+			}
+			if candidate.numeric != nil {
+				return ErrProfileUnsupported
+			}
+		}
+		return nil
+	}
+	if g.numeric == nil {
+		return nil
+	}
+	n := g.numeric
+	c := n.runtime.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	v, err := profileValue(target)
+	physical, _ := ctx.Value(profilePhysicalContextKey{}).(bool)
+	if err != nil || v != n.target || n.physicalAttempted || physical || profileReceiptFrom(ctx) != g.receipt || ctx.Err() != nil || !c.grantLive(g) || c.mode == 2 && !c.clock().Before(g.ownerDeadline) {
+		return ErrProfileUnsupported
+	}
+	n.physicalAttempted = true
+	return nil
+}
