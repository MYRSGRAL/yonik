+func dnsBundleReply(op *profileOperation, id, revision uint64) profilePacket {
+	b := make([]byte, 64)
+	be.PutUint16(b, 2)
+	b[2] = 1
+	be.PutUint64(b[8:], id)
+	be.PutUint64(b[16:], u64(op.body, 8))
+	be.PutUint64(b[24:], u64(op.body, 16))
+	be.PutUint64(b[32:], u64(op.body, 24))
+	be.PutUint64(b[40:], min(uint64(time.Second), u64(op.body, 40)))
+	be.PutUint16(b[48:], u16(op.body, 50))
+	be.PutUint64(b[56:], revision)
+	return profilePacket{kind: 56, reply: op.sequence, body: b}
+}
