+	raw.remote = &net.UDPAddr{IP: net.IPv4(127, 0, 0, 53), Port: 53}
+	raw.respond = func(b []byte) []byte { return serviceAnswer(t, b, false, false) }
+	f.p.dnsDial = func(context.Context, string, string) (net.Conn, error) { return raw, nil }
+	result := make(chan error, 1)
+	go func() { _, _, e := ProfileLookupSnapshot(ctx, "held.invalid", true, false); result <- e }()
+	<-raw.entered
+	scopeClose()
+	<-raw.cleanupEntered
+	f.c.mu.Lock()
+	held := q.refs == 1 && f.c.dnsQueries[q.slot] == q && f.c.buffered >= profileDNSLookupCredit
+	f.c.mu.Unlock()
+	close(raw.cleanupRelease)
+	if e = <-result; e == nil || !held {
+		t.Fatal("cancel released live lookup credits", held, e)
+	}
+	f.c.mu.Lock()
+	if q.refs != 0 || f.c.dnsQueries[q.slot] != nil {
+		t.Fatal("finished lookup retained reservation")
+	}
+	before := f.c.buffered
+	f.c.mu.Unlock()
+	scopeClose()
+	f.c.mu.Lock()
+	after := f.c.buffered
+	f.c.mu.Unlock()
+	if before != after {
+		t.Fatal("duplicate scope release")
+	}
+}
+
+func TestProfileServiceFixedMetadataFitsReservedBudget(t *testing.T) {
+	// Closed query scopes могут удерживаться grant/op contexts до tick. Между
+	// ticks admission допускает максимум256 requests через tombstone reservation.
+	fixed := unsafe.Sizeof(profileFlowControl{}) +
+		4096*(unsafe.Sizeof(profileReceipt{})+unsafe.Sizeof(profileGrant{})+unsafe.Sizeof(profileAccepted{})+unsafe.Sizeof(profileFlowReader{})+unsafe.Sizeof(profileFlowWriter{})) +
+		64*(unsafe.Sizeof(profileOperation{})+2048) + 256*(unsafe.Sizeof(profileDNSQuery{})+1024) +
+		128*(unsafe.Sizeof(ProfilePool{})+unsafe.Sizeof(profilePhysicalConn{})+unsafe.Sizeof(profileResourceCustody{})+1024) + 256*1024
+	if fixed > profileFlowFixedCredit {
+		t.Fatal("fixed metadata exceeds preflight reservation", fixed, profileFlowFixedCredit)
+	}
+}
diff --git a/common/yonikbroker/profile_service_linux.go b/common/yonikbroker/profile_service_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_service_linux.go
@@ -0,0 +1,412 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+)
+
+func profileGrantCredit(g *profileGrant) uint64 {
+	return uint64((len(g.effective.address)+15)&^15) + uint64((len(g.query)+15)&^15)
+}
+func profileDecodedDestination(b []byte) (profileDestinationValue, bool) {
+	c := profileCursor{b: b}
+	h := c.take(8)
+	if h == nil {
+		return profileDestinationValue{}, false
+	}
+	a := c.take(int(u16(h, 4)))
+	v := profileDestinationValue{family: h[0], network: h[1], port: u16(h, 2), address: string(a)}
+	if h[0] != 3 {
+		ip, ok := netip.AddrFromSlice(a)
+		if !ok {
+			return v, false
+		}
+		v.address = ip.String()
+	}
+	return v, !c.bad && v.valid()
+}
+func (c *profileFlowControl) resolverPeer(index uint16, system bool) (profileDestinationValue, bool) {
+	if int(index) >= len(c.manifest.rows[4]) {
+		return profileDestinationValue{}, false
+	}
+	row := c.manifest.rows[4][index]
+	if system && row[0] != 2 {
+		return profileDestinationValue{}, false
+	}
+	v, ok := profileDecodedDestination(row[36:])
+	return v, ok && v.family != 3 && row[1] == v.network
+}
+func (c *profileFlowControl) allocateService(ctx context.Context, r *profileReceipt, g *profileGrant, kind uint16, body []byte) (*profileGrant, *profileOperation, error) {
+	if ctx == nil || ctx.Err() != nil || !c.live() || !c.operationAvailable() || r != nil && (!c.receiptLive(r) || r.id == 0) {
+		return nil, nil, errProfile
+	}
+	slot := -1
+	for i, item := range c.grants {
+		if item == nil && i < int(c.manifest.caps[0]) {
+			slot = i
+			break
+		}
+	}
+	extra := profileGrantCredit(g)
+	if slot < 0 || c.buffered+extra+c.manifest.memoryCredit > uint64(c.manifest.caps[4]) {
+		return nil, nil, errProfileFlowBusy
+	}
+	g.ctx, g.cancel = context.WithCancel(ctx)
+	g.slot, g.receipt = uint16(slot), r
+	c.grants[slot] = g
+	c.buffered += extra
+	if r != nil {
+		r.grantCount++
+	}
+	op, e := c.operation(g.ctx, r, g, kind, 0, body)
+	if e != nil {
+		c.closeGrant(g)
+	}
+	return g, op, e
+}
+func (c *profileFlowControl) dnsBody(g *profileGrant) []byte {
+	b := make([]byte, 20)
+	be.PutUint64(b, g.receipt.id)
+	b[8] = 3
+	for _, offset := range []int{10, 12, 14, 16} {
+		be.PutUint16(b[offset:], 65535)
+	}
+	b = append(b, g.receipt.original.encode()...)
+	b = append(b, g.effective.encode()...)
+	var field [4]byte
+	be.PutUint16(field[:], g.resolver)
+	be.PutUint16(field[2:], uint16(len(g.query)))
+	b = append(b, field[:]...)
+	b = append(b, g.query...)
+	b = append(b, make([]byte, 16)...)
+	return b
+}
+func (c *profileFlowControl) authorizeDNS(ctx context.Context, r *profileReceipt, index uint16, query string) (*profileGrant, *profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	peer, ok := c.resolverPeer(index, false)
+	if !ok || !profileDomain([]byte(query)) || r == nil {
+		return nil, nil, errProfile
+	}
+	g := &profileGrant{class: 3, resolver: index, query: query, effective: peer, subject: 65535, scope: 65535, stream: 65535, chain: 65535, receipt: r, bound: true}
+	return c.allocateService(ctx, r, g, 18, c.dnsBody(g))
+}
+func profileProbeBody(g *profileGrant) []byte {
+	b := make([]byte, 8)
+	be.PutUint16(b, g.purpose)
+	be.PutUint16(b[2:], g.serviceIndex)
+	be.PutUint16(b[4:], g.subject)
+	be.PutUint16(b[6:], g.resolver)
+	return b
+}
+func (c *profileFlowControl) probe(ctx context.Context, purpose, index, subject, resolver uint16) (*profileGrant, *profileOperation, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if int(subject) >= len(c.manifest.rows[0]) {
+		return nil, nil, errProfile
+	}
+	g := &profileGrant{class: 2, purpose: purpose, serviceIndex: index, subject: subject, resolver: resolver, chain: 65535, stream: 65535, scope: 65535}
+	if purpose == 1 {
+		if int(index) >= len(c.manifest.rows[7]) || resolver != 65535 {
+			return nil, nil, errProfile
+		}
+		row := c.manifest.rows[7][index]
+		cur := profileCursor{b: row[4:]}
+		host := string(cur.str(253))
+		cur.str(2048)
+		n := int(cur.n16())
+		found := false
+		for i := 0; i < n; i++ {
+			if cur.n16() == subject {
+				found = true
+			}
+		}
+		if !found || !cur.done() {
+			return nil, nil, errProfile
+		}
+		g.effective = profileDestinationValue{family: 3, network: 6, port: u16(row, 2), address: host}
+		if ip, e := netip.ParseAddr(host); e == nil {
+			g.effective.family = 6
+			if ip.Is4() {
+				g.effective.family = 4
+			}
+		}
+		s := c.manifest.rows[0][subject]
+		g.scope = u16(s, len(s)-4)
+	} else if purpose == 2 {
+		if int(index) >= len(c.manifest.rows[1]) {
+			return nil, nil, errProfile
+		}
+		ep, ok := profileDecodedDestination(c.manifest.rows[1][index])
+		if !ok || ep.family != 3 {
+			return nil, nil, errProfile
+		}
+		found := false
+		for _, s := range c.manifest.rows[8] {
+			if u16(s, 0) == subject && (s[20] == 1 && u16(s, 8) == index || s[21] == 1 && u16(s, 10) == index) {
+				found = true
+			}
+		}
+		peer, ok := c.resolverPeer(resolver, true)
+		if !found || !ok {
+			return nil, nil, errProfile
+		}
+		g.class, g.query, g.effective, g.bound = 3, ep.address, peer, true
+	} else {
+		return nil, nil, errProfile
+	}
+	return c.allocateService(ctx, nil, g, 20, profileProbeBody(g))
+}
+func (c *profileFlowControl) refreshServiceLocked(g *profileGrant) (*profileOperation, error) {
+	if !c.grantLive(g) || g.id == 0 {
+		return nil, errProfile
+	}
+	if g.refresh != nil {
+		return g.refresh, nil
+	}
+	kind, body := uint16(20), profileProbeBody(g)
+	if g.receipt != nil {
+		kind, body = 18, c.dnsBody(g)
+	}
+	op, e := c.operation(g.ctx, g.receipt, g, kind, g.id, body)
+	if e == nil {
+		g.refresh = op
+	}
+	return op, e
+}
+func (c *profileFlowControl) publishService(op *profileOperation, f profilePacket) error {
+	g, b := op.grant, f.body
+	flow, revision := uint64(0), c.manifest.policy
+	// Только private original receipt связывает USER DNS с System attribution.
+	if g.receipt != nil {
+		if g.class != 3 || g.purpose != 0 || op.kind != 18 || op.receipt != g.receipt || !c.receiptLive(g.receipt) || g.receipt.id == 0 {
+			return errProfile
+		}
+		flow, revision = g.receipt.id, g.receipt.revision
+	} else if op.kind != 20 || op.receipt != nil || g.purpose == 0 {
+		return errProfile
+	}
+	required := byte(0)
+	if c.mode == 2 && g.receipt != nil {
+		required = 1
+	}
+	if f.kind != 19 || len(b) != 56 || b[0] != 1 || b[1] != g.class || b[2] != required || b[3] != 0 || u64(b, 4) == 0 || f.object != u64(b, 4) || u64(b, 12) != flow || u32(b, 20) == 0 || u32(b, 20) > 1000 || u64(b, 24) != revision || !zero(b[41:48]) {
+		return errProfile
+	}
+	ownerNS, ownerKind, ownerID := u64(b, 32), b[40], u64(b, 48)
+	if required == 0 {
+		if ownerNS != 0 || ownerKind != 0 || ownerID != 0 {
+			return errProfile
+		}
+	} else if ownerNS == 0 || ownerNS > uint64(20*time.Millisecond) || ownerKind < 1 || ownerKind > 2 || ownerID == 0 {
+		return errProfile
+	}
+	id := u64(b, 4)
+	if op.object == 0 {
+		if id <= c.highestGrant {
+			return errProfile
+		}
+	} else if id != op.object || g.id != id || !c.grantLive(g) {
+		return errProfile
+	}
+	deadline := op.sent.Add(time.Duration(u32(b, 20)) * time.Millisecond)
+	if op.sessionDeadline.Before(deadline) {
+		deadline = op.sessionDeadline
+	}
+	ownerDeadline := op.sent.Add(time.Duration(ownerNS))
+	if op.object != 0 && ownerKind == g.ownerKind && ownerID == g.ownerID && g.ownerDeadline.Before(ownerDeadline) {
+		ownerDeadline = g.ownerDeadline
+	}
+	if !c.clock().Before(deadline) || required == 1 && !c.clock().Before(ownerDeadline) {
+		return errProfile
+	}
+	g.id, g.deadline, g.revision = id, deadline, revision
+	g.ownerDeadline, g.ownerKind, g.ownerID = ownerDeadline, ownerKind, ownerID
+	if id > c.highestGrant {
+		c.highestGrant = id
+	}
+	return nil
+}
+func profileEnsureService(ctx context.Context, g *profileGrant) error {
+	p := profileRuntime(ctx)
+	if p == nil || g == nil || g.class != 2 && g.class != 3 || ctx.Err() != nil || !p.flowFresh() {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	if !c.grantLive(g) {
+		c.mu.Unlock()
+		return errProfile
+	}
+	renew := g.deadline.Sub(c.clock()) <= 250*time.Millisecond || c.serviceOwnerRequired(g) && g.ownerDeadline.Sub(c.clock()) <= 5*time.Millisecond
+	var op *profileOperation
+	var e error
+	if renew {
+		op, e = c.refreshServiceLocked(g)
+	}
+	c.mu.Unlock()
+	if e != nil {
+		return e
+	}
+	if op != nil {
+		if e = p.flowRPC(op); e != nil {
+			return e
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.grantLive(g) || c.serviceOwnerRequired(g) && !c.clock().Before(g.ownerDeadline) {
+		return errProfile
+	}
+	return nil
+}
+func (c *profileFlowControl) serviceOwnerRequired(g *profileGrant) bool {
+	return c.mode == 2 && g.class == 3 && g.receipt != nil
+}
+func profileServiceGrant(ctx context.Context) *profileGrant {
+	g, _ := ctx.Value(profileGrantKey{}).(*profileGrant)
+	if g != nil && g.class == 2 {
+		return g
+	}
+	return nil
+}
+func profileSourceValid(ctx context.Context) error {
+	if g := profileServiceGrant(ctx); g != nil {
+		return profileEnsureService(ctx, g)
+	}
+	return ProfileOriginalValid(ctx)
+}
+func profileProbeTarget(ctx context.Context, target profileDestinationValue, subject *uint16) error {
+	g := profileServiceGrant(ctx)
+	if profileEnsureService(ctx, g) != nil || target != g.effective || subject != nil && *subject != g.subject {
+		return errProfile
+	}
+	return nil
+}
+
+// URL/tag выбирают только exact manifest scope. Authority приходит из GRANT.
+func ProfileOpenProbe(ctx context.Context, tag, rawURL string) (context.Context, func(), error) {
+	p := profileRuntime(ctx)
+	noop := func() {}
+	if p == nil {
+		return ctx, noop, nil
+	}
+	if len(rawURL) > 253+2048+32 || len(tag) > 160 || !p.flowFresh() || len(p.flow.manifest.rows[7]) != 1 {
+		return ctx, noop, errProfile
+	}
+	row := p.flow.manifest.rows[7][0]
+	cur := profileCursor{b: row[4:]}
+	host, path := string(cur.str(253)), string(cur.str(2048))
+	u, e := url.Parse(rawURL)
+	scheme := "http"
+	if row[0] == 2 {
+		scheme = "https"
+	}
+	if e != nil || u.User != nil || u.Fragment != "" || u.Hostname() != host || u.Scheme != scheme {
+		return ctx, noop, errProfile
+	}
+	port := u.Port()
+	if port == "" {
+		port = "80"
+		if u.Scheme == "https" {
+			port = "443"
+		}
+	}
+	actualPath := u.EscapedPath()
+	if actualPath == "" {
+		actualPath = "/"
+	}
+	if u.RawQuery != "" || u.ForceQuery {
+		actualPath += "?" + u.RawQuery
+	}
+	portValue, portError := strconv.ParseUint(port, 10, 16)
+	if portError != nil || uint16(portValue) != u16(row, 2) || actualPath != path {
+		return ctx, noop, errProfile
+	}
+	subject, ok := profileSubject(&p.flow.manifest, tag)
+	if !ok {
+		return ctx, noop, errProfile
+	}
+	g, op, e := p.flow.probe(ctx, 1, 0, subject, 65535)
+	if e != nil {
+		return ctx, noop, e
+	}
+	if e = p.flowRPC(op); e != nil {
+		return ctx, noop, e
+	}
+	return context.WithValue(g.ctx, profileGrantKey{}, g), func() { p.flow.mu.Lock(); p.flow.closeGrant(g); p.flow.mu.Unlock() }, nil
+}
+
+func profileBindProbe(ctx context.Context, route profileSelectedRoute, branch byte) (context.Context, func(), error) {
+	p := profileRuntime(ctx)
+	g := profileServiceGrant(ctx)
+	noop := func() {}
+	if profileProbeTarget(ctx, route.effective, &route.subject) != nil {
+		return ctx, noop, errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	s := c.manifest.rows[8][g.scope]
+	if branch > 1 || s[3]&(1<<branch) == 0 || g.bound && g.branch != branch {
+		return ctx, noop, errProfile
+	}
+	if g.bound {
+		return ctx, noop, nil
+	}
+	g.branch, g.stream, g.chain, g.bound = branch, u16(s, 12+int(branch)*2), u16(s, 16+int(branch)*2), true
+	return ctx, noop, nil
+}
+
+func profileResolverAddress(v profileDestinationValue) string {
+	return net.JoinHostPort(v.address, strconv.Itoa(int(v.port)))
+}
+func profileCanonicalQuery(name string) string { return strings.ToLower(strings.TrimSuffix(name, ".")) }
+func ProfileProbeDialContext(parent, callback context.Context) (context.Context, func(), error) {
+	if parent == nil || callback == nil || parent.Err() != nil || callback.Err() != nil {
+		return nil, func() {}, errProfile
+	}
+	g := profileServiceGrant(parent)
+	if ProfileSession(parent) && (profileEnsureService(parent, g) != nil || profileRuntime(callback) != nil && profileRuntime(callback) != profileRuntime(parent)) {
+		return nil, func() {}, errProfile
+	}
+	base := CarryProfileSession(parent, callback)
+	deadline, hasDeadline := parent.Deadline()
+	if other, ok := callback.Deadline(); ok && (!hasDeadline || other.Before(deadline)) {
+		deadline, hasDeadline = other, true
+	}
+	var ctx context.Context
+	var cancel context.CancelFunc
+	if hasDeadline {
+		ctx, cancel = context.WithDeadline(base, deadline)
+	} else {
+		ctx, cancel = context.WithCancel(base)
+	}
+	stop := context.AfterFunc(parent, cancel)
+	stopGrant := func() bool { return false }
+	if g != nil {
+		ctx = context.WithValue(ctx, profileGrantKey{}, g)
+		stopGrant = context.AfterFunc(g.ctx, cancel)
+	}
+	return ctx, func() { stop(); stopGrant(); cancel() }, nil
+}
+
+func ProfileProbeDialTarget(ctx context.Context, target xnet.Destination) error {
+	if !ProfileSession(ctx) {
+		return nil
+	}
+	v, e := profileValue(target)
+	if e != nil {
+		return e
+	}
+	return profileProbeTarget(ctx, v, nil)
+}
diff --git a/common/yonikbroker/profile_resolver_linux.go b/common/yonikbroker/profile_resolver_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_resolver_linux.go
@@ -0,0 +1,576 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"errors"
+	"net"
+	"net/netip"
+	"sort"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+// Latch только запрещает legacy fallback после authenticated owned launch.
+// Он не хранит runtime и не выдаёт authority callers без private context.
+var profileResolverClosed atomic.Bool
+
+func ProfileResolverRequired(ctx context.Context) bool {
+	return ProfileSession(ctx) || profileResolverClosed.Load()
+}
+
+var errProfileDNSMissing = errors.New("snapshot DNS name not found")
+
+func (s *profileSnapshot) names(name string) []string {
+	if len(name) == 0 || len(name) > 254 || len(name) == 254 && !strings.HasSuffix(name, ".") {
+		return nil
+	}
+	avoid := func(n string) bool { return strings.HasSuffix(strings.ToLower(strings.TrimSuffix(n, ".")), ".onion") }
+	if strings.HasSuffix(name, ".") {
+		if avoid(name) {
+			return nil
+		}
+		return []string{name}
+	}
+	first := strings.Count(name, ".") >= int(s.ndots)
+	name += "."
+	result := make([]string, 0, s.searchCount+1)
+	if first && !avoid(name) {
+		result = append(result, name)
+	}
+	for _, suffix := range s.search[:s.searchCount] {
+		candidate := name + string(suffix)
+		if len(candidate) <= 254 && !avoid(candidate) {
+			result = append(result, candidate)
+		}
+	}
+	if !first && !avoid(name) {
+		result = append(result, name)
+	}
+	return result
+}
+func (s *profileSnapshot) files(name string, v4, v6 bool) []net.IP {
+	key := profileCanonicalQuery(name)
+	if strings.Contains(key, ".") {
+		key += "."
+	}
+	i := sort.Search(s.hostCount, func(i int) bool { c := profileCursor{b: s.hosts[i]}; return string(c.str(253)) >= key })
+	if i == s.hostCount {
+		return nil
+	}
+	c := profileCursor{b: s.hosts[i]}
+	if string(c.str(253)) != key {
+		return nil
+	}
+	count := int(c.n16())
+	ips := make([]net.IP, 0, count)
+	for j := 0; j < count; j++ {
+		family := c.take(1)[0]
+		n := 4
+		if family == 6 {
+			n = 16
+		}
+		ip := c.take(n)
+		if family == 4 && v4 || family == 6 && v6 {
+			ips = append(ips, append(net.IP(nil), ip...))
+		}
+	}
+	return ips
+}
+func (p *ProfileRuntime) snapshotRow(peer int, network byte) (uint16, bool) {
+	s := p.snapshot
+	for i, row := range p.flow.manifest.rows[4] {
+		// Internal DNS-subject paths требуют собственного typed caller binding;
+		// default localdns не подставляет себе другой admitted subject.
+		if row[0] != 2 || row[1] != network || u16(row, 2) != 65535 {
+			continue
+		}
+		v, ok := profileDecodedDestination(row[36:])
+		if ok && v.family == s.families[peer] {
+			a, _ := netip.ParseAddr(v.address)
+			if bytes.Equal(a.AsSlice(), s.peers[peer]) && bytes.Equal(row[4:36], s.encoded[16:48]) {
+				return uint16(i), true
+			}
+		}
+	}
+	return 0, false
+}
+func (p *ProfileRuntime) dnsAuthority(ctx context.Context, index uint16, query, origin string) (*profileGrant, error) {
+	if q := profileQueryFrom(ctx); q != nil {
+		ctx = q.ctx
+	}
+	var g *profileGrant
+	var op *profileOperation
+	var e error
+	if pool, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool); pool != nil {
+		if pool.state.runtime != p || pool.endpoint.address != origin {
+			return nil, errProfile
+		}
+		if _, e := pool.Context(ctx); e != nil {
+			return nil, e
+		}
+		row := p.flow.manifest.rows[8][pool.scope]
+		ep := u16(row, 8+int(pool.branch)*2)
+		g, op, e = p.flow.probe(ctx, 2, ep, u16(row, 0), index)
+	} else {
+		r := profileReceiptFrom(ctx)
+		if r == nil {
+			return nil, ErrProfileUnsupported
+		}
+		g, op, e = p.flow.authorizeDNS(ctx, r, index, profileCanonicalQuery(query))
+	}
+	if e != nil {
+		return nil, e
+	}
+	if e = p.flowRPC(op); e != nil {
+		return nil, e
+	}
+	return g, nil
+}
+func (p *ProfileRuntime) releaseDNS(g *profileGrant) {
+	p.flow.mu.Lock()
+	p.flow.closeGrant(g)
+	p.flow.mu.Unlock()
+}
+func (p *ProfileRuntime) dnsRequest(name string, qtype dnsmessage.Type, flags uint16) ([]byte, error) {
+	qname, e := dnsmessage.NewName(name)
+	if e != nil {
+		return nil, e
+	}
+	var id uint16
+	if p.dnsID != nil {
+		id = p.dnsID()
+	} else {
+		var b [2]byte
+		if _, e = rand.Read(b[:]); e != nil {
+			return nil, e
+		}
+		id = u16(b[:], 0)
+	}
+	b := dnsmessage.NewBuilder(make([]byte, 0, 512), dnsmessage.Header{ID: id, RecursionDesired: true, AuthenticData: flags&8 != 0})
+	if e = b.StartQuestions(); e != nil {
+		return nil, e
+	}
+	if e = b.Question(dnsmessage.Question{Name: qname, Type: qtype, Class: dnsmessage.ClassINET}); e != nil {
+		return nil, e
+	}
+	if flags&16 != 0 {
+		if e = b.StartAdditionals(); e != nil {
+			return nil, e
+		}
+		var h dnsmessage.ResourceHeader
+		if e = h.SetEDNS0(1232, dnsmessage.RCodeSuccess, false); e != nil {
+			return nil, e
+		}
+		if e = b.OPTResource(h, dnsmessage.OPTResource{}); e != nil {
+			return nil, e
+		}
+	}
+	return b.Finish()
+}
+func profileDNSQuestionMatch(request, response []byte) bool {
+	var q, r dnsmessage.Parser
+	qh, e := q.Start(request)
+	if e != nil {
+		return false
+	}
+	rh, e := r.Start(response)
+	if e != nil || !rh.Response || rh.ID != qh.ID || rh.OpCode != 0 {
+		return false
+	}
+	qq, e := q.Question()
+	if e != nil {
+		return false
+	}
+	rq, e := r.Question()
+	if e != nil || qq.Type != rq.Type || qq.Class != rq.Class || !strings.EqualFold(qq.Name.String(), rq.Name.String()) {
+		return false
+	}
+	return r.SkipQuestion() == dnsmessage.ErrSectionDone
+}
+
+type profileDNSRecord struct {
+	name, alias string
+	ip          netip.Addr
+	ttl         uint32
+	kind        dnsmessage.Type
+}
+
+func profileDNSAnswers(request, response []byte, qtype dnsmessage.Type) ([]net.IP, uint32, bool, error) {
+	if len(response) < 12 {
+		return nil, 0, false, errProfile
+	}
+	// До RR/string materialization; весь response также ограничен DNS wire length.
+	if int(u16(response, 6))+int(u16(response, 8))+int(u16(response, 10)) > 256 {
+		return nil, 0, false, errProfileFlowBusy
+	}
+	if !profileDNSQuestionMatch(request, response) {
+		return nil, 0, false, errProfile
+	}
+	var parser dnsmessage.Parser
+	h, e := parser.Start(response)
+	if e != nil {
+		return nil, 0, false, e
+	}
+	q, e := parser.Question()
+	if e != nil {
+		return nil, 0, false, e
+	}
+	parser.SkipAllQuestions()
+	if h.RCode == dnsmessage.RCodeNameError {
+		return nil, 0, h.Truncated, errProfileDNSMissing
+	}
+	if h.RCode != dnsmessage.RCodeSuccess {
+		return nil, 0, h.Truncated, errProfile
+	}
+	var records [256]profileDNSRecord
+	count := 0
+	for {
+		rh, e := parser.AnswerHeader()
+		if e == dnsmessage.ErrSectionDone {
+			break
+		}
+		if e != nil {
+			return nil, 0, h.Truncated, e
+		}
+		v := profileDNSRecord{name: strings.ToLower(rh.Name.String()), ttl: rh.TTL, kind: rh.Type}
+		if !profileDNSName([]byte(v.name), false) {
+			return nil, 0, h.Truncated, errProfile
+		}
+		if rh.Class != dnsmessage.ClassINET {
+			if e = parser.SkipAnswer(); e != nil {
+				return nil, 0, h.Truncated, e
+			}
+			continue
+		}
+		switch rh.Type {
+		case dnsmessage.TypeA:
+			r, e := parser.AResource()
+			if e != nil {
+				return nil, 0, h.Truncated, e
+			}
+			v.ip = netip.AddrFrom4(r.A)
+		case dnsmessage.TypeAAAA:
+			r, e := parser.AAAAResource()
+			if e != nil {
+				return nil, 0, h.Truncated, e
+			}
+			v.ip = netip.AddrFrom16(r.AAAA)
+		case dnsmessage.TypeCNAME:
+			r, e := parser.CNAMEResource()
+			if e != nil {
+				return nil, 0, h.Truncated, e
+			}
+			v.alias = strings.ToLower(r.CNAME.String())
+			if !profileDNSName([]byte(v.alias), false) {
+				return nil, 0, h.Truncated, errProfile
+			}
+		default:
+			if e = parser.SkipAnswer(); e != nil {
+				return nil, 0, h.Truncated, e
+			}
+			continue
+		}
+		records[count] = v
+		count++
+	}
+	if e = parser.SkipAllAuthorities(); e != nil {
+		return nil, 0, h.Truncated, e
+	}
+	for {
+		rh, e := parser.AdditionalHeader()
+		if e == dnsmessage.ErrSectionDone {
+			break
+		}
+		if e != nil {
+			return nil, 0, h.Truncated, e
+		}
+		if rh.Type == dnsmessage.TypeOPT && rh.ExtendedRCode(h.RCode) != dnsmessage.RCodeSuccess {
+			return nil, 0, h.Truncated, errProfile
+		}
+		if e = parser.SkipAdditional(); e != nil {
+			return nil, 0, h.Truncated, e
+		}
+	}
+	sort.Slice(records[:count], func(i, j int) bool { return records[i].name < records[j].name })
+	name := strings.ToLower(q.Name.String())
+	ttl := uint32(300)
+	var visited [16]string
+	for depth := 0; depth < len(visited); depth++ {
+		for _, old := range visited[:depth] {
+			if old == name {
+				return nil, 0, h.Truncated, errProfile
+			}
+		}
+		visited[depth] = name
+		i := sort.Search(count, func(i int) bool { return records[i].name >= name })
+		ips := make([]net.IP, 0, 4)
+		alias := ""
+		for ; i < count && records[i].name == name; i++ {
+			r := records[i]
+			if r.ttl < ttl {
+				ttl = r.ttl
+			}
+			if r.kind == dnsmessage.TypeCNAME {
+				if alias != "" && alias != r.alias {
+					return nil, 0, h.Truncated, errProfile
+				}
+				alias = r.alias
+			} else if r.kind == qtype && r.ip.IsValid() {
+				ips = append(ips, append(net.IP(nil), r.ip.AsSlice()...))
+			}
+		}
+		if alias != "" {
+			if len(ips) != 0 {
+				return nil, 0, h.Truncated, errProfile
+			}
+			name = alias
+			continue
+		}
+		if len(ips) == 0 {
+			return nil, 0, h.Truncated, errProfileDNSMissing
+		}
+		return ips, ttl, h.Truncated, nil
+	}
+	return nil, 0, h.Truncated, errProfile
+}
+func (p *ProfileRuntime) snapshotOne(ctx context.Context, origin, name string, qtype dnsmessage.Type) ([]net.IP, uint32, error) {
+	s := p.snapshot
+	offset := uint32(0)
+	if s.flags&1 != 0 {
+		offset = s.rotation.Add(1) - 1
+	}
+	request, e := p.dnsRequest(name, qtype, s.flags)
+	if e != nil {
+		return nil, 0, e
+	}
+	var last error = errProfileDNSMissing
+	for attempt := 0; attempt < int(s.attempts); attempt++ {
+		for j := 0; j < s.count; j++ {
+			peer := int((offset + uint32(j)) % uint32(s.count))
+			network := byte(17)
+			if s.flags&4 != 0 {
+				network = 6
+			}
+			for {
+				index, ok := p.snapshotRow(peer, network)
+				if !ok {
+					return nil, 0, errProfile
+				}
+				g, e := p.dnsAuthority(ctx, index, name, origin)
+				if e != nil {
+					return nil, 0, e
+				}
+				query, cancel := context.WithTimeout(ctx, time.Duration(s.timeout)*time.Millisecond)
+				response, e := p.dnsWire(query, g, request)
+				var ips []net.IP
+				var ttl uint32
+				var truncated bool
+				if e == nil {
+					truncated = network == 17 && len(response) >= 4 && profileDNSQuestionMatch(request, response) && response[2]&2 != 0
+					if !truncated {
+						ips, ttl, _, e = profileDNSAnswers(request, response, qtype)
+					}
+				}
+				if profileEnsureService(query, g) != nil {
+					e = errProfile
+					ips = nil
+				}
+				cancel()
+				if e == nil && !truncated {
+					e = p.keepDNSGrant(ctx, g)
+				}
+				if e != nil || truncated {
+					p.releaseDNS(g)
+				}
+				if ctx.Err() != nil {
+					return nil, 0, ctx.Err()
+				}
+				if truncated && network == 17 {
+					network = 6
+					continue
+				}
+				if e == nil {
+					return ips, ttl, nil
+				}
+				if errors.Is(e, errProfileDNSMissing) {
+					return nil, 0, e
+				}
+				last = e
+				break
+			}
+		}
+	}
+	return nil, 0, last
+}
+
+// Нет общего cache/singleflight: pinned netgo не кеширует ответы; каждый caller
+// получает свой query grant, deadline, socket и post-result fence.
+func ProfileLookupSnapshot(ctx context.Context, name string, v4, v6 bool) ([]net.IP, uint32, error) {
+	if ctx == nil {
+		return nil, 0, errProfile
+	}
+	own := profileQueryFrom(ctx) == nil
+	scoped, release, e := ProfileDNSQueryContext(ctx, name)
+	if e != nil {
+		return nil, 0, e
+	}
+	defer release()
+	ips, ttl, e := profileLookupSnapshot(scoped, name, v4, v6)
+	if e == nil && own {
+		e = ProfileCheckDNSAnswer(scoped, name, ips)
+	}
+	if e != nil {
+		return nil, 0, e
+	}
+	return ips, ttl, nil
+}
+func profileLookupSnapshot(ctx context.Context, name string, v4, v6 bool) ([]net.IP, uint32, error) {
+	p := profileRuntime(ctx)
+	if p == nil || ctx == nil || ctx.Err() != nil || !p.flowFresh() || p.snapshot == nil || !v4 && !v6 || !profileDNSName([]byte(name), false) {
+		return nil, 0, errProfile
+	}
+	// Mapping4 требует отдельного SourceObservation/WaiterReceipt. Ни hosts,
+	// ни literal DATA не получают старую V1 publication authority как fallback.
+	if p.flow.manifest.mapping == 4 {
+		return nil, 0, ErrProfileUnsupported
+	}
+	q := profileQueryFrom(ctx)
+	if q == nil || q.runtime != p {
+		return nil, 0, errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	if !q.liveLocked() || q.refs != 0 || q.ready {
+		c.mu.Unlock()
+		return nil, 0, errProfile
+	}
+	q.refs++
+	c.mu.Unlock()
+	defer func() { c.mu.Lock(); q.refs--; q.releaseLocked(); c.mu.Unlock() }()
+	if ip, e := netip.ParseAddr(name); e == nil {
+		ip = ip.Unmap()
+		if ip.Zone() != "" || ip.Is4() && !v4 || ip.Is6() && !v6 {
+			return nil, 0, errProfileDNSMissing
+		}
+		c.mu.Lock()
+		q.literal = true
+		c.mu.Unlock()
+		return p.snapshotResult(ctx, []net.IP{append(net.IP(nil), ip.AsSlice()...)}, 300)
+	}
+	query, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stop := context.AfterFunc(p.ctx, cancel)
+	defer stop()
+	if r := profileReceiptFrom(ctx); r != nil {
+		stopReceipt := context.AfterFunc(r.ctx, cancel)
+		defer stopReceipt()
+	}
+	index, ok := p.snapshotRow(0, 17)
+	if !ok {
+		return nil, 0, errProfile
+	}
+	g, e := p.dnsAuthority(query, index, name, name)
+	if e != nil {
+		return nil, 0, e
+	}
+	s := p.snapshot
+	if s.order == 1 || s.order == 3 {
+		ips := s.files(name, v4, v6)
+		if len(ips) > 0 {
+			if profileEnsureService(query, g) != nil {
+				p.releaseDNS(g)
+				return nil, 0, errProfile
+			}
+			if e = p.keepDNSGrant(ctx, g); e != nil {
+				p.releaseDNS(g)
+				return nil, 0, e
+			}
+			return p.snapshotResult(ctx, ips, 300)
+		}
+		if s.order == 1 {
+			p.releaseDNS(g)
+			return nil, 0, errProfileDNSMissing
+		}
+	}
+	p.releaseDNS(g)
+	var last error = errProfileDNSMissing
+	for _, candidate := range s.names(name) {
+		types := []dnsmessage.Type{}
+		if v4 {
+			types = append(types, dnsmessage.TypeA)
+		}
+		if v6 {
+			types = append(types, dnsmessage.TypeAAAA)
+		}
+		type result struct {
+			ips []net.IP
+			ttl uint32
+			err error
+		}
+		results := make([]result, len(types))
+		var all []net.IP
+		ttl := uint32(300)
+		if s.flags&2 != 0 {
+			for i, typ := range types {
+				results[i].ips, results[i].ttl, results[i].err = p.snapshotOne(query, name, candidate, typ)
+			}
+		} else {
+			type indexed struct {
+				index int
+				r     result
+			}
+			lane := make(chan indexed, len(types))
+			for i, typ := range types {
+				go func(i int, typ dnsmessage.Type) {
+					ips, ttl, e := p.snapshotOne(query, name, candidate, typ)
+					lane <- indexed{i, result{ips, ttl, e}}
+				}(i, typ)
+			}
+			for range types {
+				r := <-lane
+				results[r.index] = r.r
+			}
+		}
+		for _, r := range results {
+			if r.err != nil {
+				last = r.err
+			} else {
+				all = append(all, r.ips...)
+				if r.ttl < ttl {
+					ttl = r.ttl
+				}
+			}
+		}
+		if query.Err() != nil || !p.flowFresh() {
+			return nil, 0, errProfile
+		}
+		if len(all) > 0 {
+			return p.snapshotResult(ctx, all, ttl)
+		}
+	}
+	if s.order == 4 {
+		if ips := s.files(name, v4, v6); len(ips) > 0 {
+			g, e := p.dnsAuthority(query, index, name, name)
+			if e != nil {
+				return nil, 0, e
+			}
+			if e = profileEnsureService(query, g); e != nil {
+				p.releaseDNS(g)
+				return nil, 0, e
+			}
+			if e = p.keepDNSGrant(ctx, g); e != nil {
+				p.releaseDNS(g)
+				return nil, 0, e
+			}
+			return p.snapshotResult(ctx, ips, 300)
+		}
+	}
+	return nil, 0, last
+}
diff --git a/common/yonikbroker/profile_dns_query_linux.go b/common/yonikbroker/profile_dns_query_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_dns_query_linux.go
@@ -0,0 +1,208 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sort"
+)
+
+type profileDNSQueryKey struct{}
+type profileDNSQuery struct {
+	runtime                      *ProfileRuntime
+	receipt                      *profileReceipt
+	pool                         *ProfilePool
+	ctx                          context.Context
+	cancel                       context.CancelFunc
+	name                         string
+	original                     string
+	snapshot                     *profileSnapshot
+	grants                       [2]*profileGrant
+	waiters                      [2]*profileDNSWaiter
+	ips                          [256]netip.Addr
+	count, refs, slot            int
+	ready, closed, used, literal bool
+}
+
+func profileQueryFrom(ctx context.Context) *profileDNSQuery {
+	q, _ := ctx.Value(profileDNSQueryKey{}).(*profileDNSQuery)
+	return q
+}
+func (q *profileDNSQuery) liveLocked() bool {
+	c := q.runtime.flow
+	return !q.closed && !q.used && q.ctx.Err() == nil && q.snapshot == q.runtime.snapshot && c.live() && c.dnsQueries[q.slot] == q && (q.receipt != nil && c.receiptLive(q.receipt) || q.pool != nil && q.pool.state.runtime == q.runtime)
+}
+func (q *profileDNSQuery) releaseLocked() {
+	if q.closed && q.refs == 0 && q.runtime.flow.dnsQueries[q.slot] == q {
+		q.runtime.flow.dnsQueries[q.slot] = nil
+		q.runtime.flow.buffered -= profileDNSLookupCredit
+	}
+}
+func (q *profileDNSQuery) closeLocked() {
+	if !q.closed {
+		q.closed = true
+		q.cancel()
+		for _, g := range q.grants {
+			q.runtime.flow.closeGrant(g)
+		}
+	}
+	q.releaseLocked()
+}
+
+// Query scope резервирует metadata/buffers, но не разрешает DNS I/O.
+// Все эффекты требуют отдельного authenticated DNSGrant.
+func ProfileDNSQueryContext(ctx context.Context, name string) (context.Context, func(), error) {
+	noop := func() {}
+	p := profileRuntime(ctx)
+	if p == nil {
+		if ProfileResolverRequired(ctx) {
+			return ctx, noop, errProfile
+		}
+		return ctx, noop, nil
+	}
+	if ctx.Err() != nil || len(name) > 254 || !profileDNSName([]byte(name), false) || !p.flowFresh() {
+		return ctx, noop, errProfile
+	}
+	if q := profileQueryFrom(ctx); q != nil {
+		c := p.flow
+		c.mu.Lock()
+		valid := q.runtime == p && q.name == profileCanonicalQuery(name) && q.liveLocked()
+		c.mu.Unlock()
+		if !valid {
+			return ctx, noop, errProfile
+		}
+		return ctx, noop, nil
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	r := profileReceiptFrom(ctx)
+	pool, _ := ctx.Value(profilePoolContextKey{}).(*ProfilePool)
+	if !c.live() || r == nil && (pool == nil || pool.state.runtime != p) || r != nil && (!c.receiptLive(r) || r.id == 0) {
+		return ctx, noop, errProfile
+	}
+	slot := -1
+	for i, q := range c.dnsQueries {
+		if q == nil && i < int(c.manifest.caps[3]) {
+			slot = i
+			break
+		}
+	}
+	if slot < 0 || c.buffered+c.manifest.memoryCredit+profileDNSLookupCredit > uint64(c.manifest.caps[4]) {
+		return ctx, noop, errProfileFlowBusy
+	}
+	base, cancel := context.WithCancel(ctx)
+	q := &profileDNSQuery{runtime: p, receipt: r, pool: pool, ctx: base, cancel: cancel, name: profileCanonicalQuery(name), original: name, snapshot: p.snapshot, slot: slot}
+	child := context.WithValue(base, profileDNSQueryKey{}, q)
+	q.ctx = child
+	c.dnsQueries[slot] = q
+	c.buffered += profileDNSLookupCredit
+	return child, func() { c.mu.Lock(); q.closeLocked(); c.mu.Unlock() }, nil
+}
+func (p *ProfileRuntime) keepDNSGrant(ctx context.Context, g *profileGrant) error {
+	q := profileQueryFrom(ctx)
+	if q == nil || q.runtime != p || profileEnsureService(ctx, g) != nil {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !q.liveLocked() {
+		return errProfile
+	}
+	for i, existing := range q.grants {
+		if existing == g {
+			return nil
+		}
+		if existing == nil {
+			q.grants[i] = g
+			return nil
+		}
+	}
+	return errProfileFlowBusy
+}
+func (p *ProfileRuntime) snapshotResult(ctx context.Context, ips []net.IP, ttl uint32) ([]net.IP, uint32, error) {
+	q := profileQueryFrom(ctx)
+	if q == nil || q.runtime != p || ctx.Err() != nil || !p.flowFresh() {
+		return nil, 0, errProfile
+	}
+	for _, g := range q.grants {
+		if g != nil && profileEnsureService(q.ctx, g) != nil {
+			return nil, 0, errProfile
+		}
+	}
+	c := p.flow
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !q.liveLocked() || q.ready || len(ips) == 0 || len(ips) > len(q.ips) || q.grants[0] == nil && !q.literal {
+		return nil, 0, errProfile
+	}
+	for i, ip := range ips {
+		v, ok := netip.AddrFromSlice(ip)
+		if !ok {
+			return nil, 0, errProfile
+		}
+		q.ips[i] = v.Unmap()
+	}
+	q.count = len(ips)
+	sort.Slice(q.ips[:q.count], func(i, j int) bool { return q.ips[i].Compare(q.ips[j]) < 0 })
+	q.ready = true
+	return ips, ttl, nil
+}
+func ProfileCheckDNSAnswer(ctx context.Context, name string, ips []net.IP) error {
+	p := profileRuntime(ctx)
+	if p == nil {
+		return CheckAfterDNS(ctx)
+	}
+	q := profileQueryFrom(ctx)
+	if q == nil || q.runtime != p || q.name != profileCanonicalQuery(name) || ctx.Err() != nil || !p.flowFresh() {
+		return errProfile
+	}
+	c := p.flow
+	c.mu.Lock()
+	if !q.liveLocked() || !q.ready {
+		c.mu.Unlock()
+		return errProfile
+	}
+	grants := q.grants
+	c.mu.Unlock()
+	for _, g := range grants {
+		if g != nil && profileEnsureService(q.ctx, g) != nil {
+			return errProfile
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !q.liveLocked() || !q.ready || len(ips) == 0 || len(ips) > 256 {
+		return errProfile
+	}
+	// Provider USER answer требует Numeric42 через production result guard.
+	for _, w := range q.waiters {
+		if w != nil {
+			return ErrProfileUnsupported
+		}
+	}
+	for _, w := range q.waiters {
+		if w != nil && !c.dnsWaiterLive(w) {
+			return errProfile
+		}
+	}
+	for _, ip := range ips {
+		v, ok := netip.AddrFromSlice(ip)
+		if !ok {
+			return errProfile
+		}
+		v = v.Unmap()
+		i := sort.Search(q.count, func(i int) bool { return q.ips[i].Compare(v) >= 0 })
+		if i == q.count || q.ips[i] != v {
+			return errProfile
+		}
+	}
+	q.used = true
+	return nil
+}
+
+// Старый API не получает query/RRset и не может подтвердить scoped answer.
+func ProfileCheckDNSResult(context.Context) error { return errProfile }
diff --git a/common/yonikbroker/profile_dns_io_linux.go b/common/yonikbroker/profile_dns_io_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/profile_dns_io_linux.go
@@ -0,0 +1,209 @@
+//go:build linux
+
+package nativehooks
+
+import (
+	"context"
+	"errors"
+	xnet "github.com/xtls/xray-core/common/net"
+	"golang.org/x/net/dns/dnsmessage"
+	"io"
+	"net"
+	"sync"
+)
+
+type profileDNSConnection struct {
+	conn net.Conn
+	once sync.Once
+	err  error
+}
+
+func (c *profileDNSConnection) Close() error {
+	c.once.Do(func() { c.err = c.conn.Close() })
+	return c.err
+}
+
+// Reservation видима shutdown до factory; sockets и service sockets делят cap.
+func (p *ProfileRuntime) dnsConnection(ctx context.Context, g *profileGrant) (*profileDNSConnection, *profileResourceCustody, error) {
+	if g == nil || g.class != 3 || profileEnsureService(ctx, g) != nil {
+		return nil, nil, errProfile
+	}
+	s := p.transportState()
+	s.mu.Lock()
+	count, slot := 0, -1
+	for i, entry := range s.objects {
+		if entry != nil {
+			count++
+		} else if slot < 0 && i < int(p.flow.manifest.caps[2]) {
+			slot = i
+		}
+	}
+	physical := s.pending
+	for _, socket := range s.sockets {
+		if socket != nil {
+			physical++
+		}
+	}
+	for _, item := range s.objects {
+		if item != nil {
+			if _, ok := item.value.(*profileDNSConnection); ok {
+				physical++
+			}
+		}
+	}
+	if !s.live() || slot < 0 || count >= int(p.flow.manifest.caps[2]) || physical >= int(p.flow.manifest.caps[1]) {
+		s.mu.Unlock()
+		return nil, nil, errProfileFlowBusy
+	}
+	entry := &profileResourceCustody{state: s, slot: slot, ready: make(chan struct{}), pending: true}
+	s.objects[slot] = entry
+	s.objectPending++
+	s.pending++
+	s.mu.Unlock()
+	dial := p.dnsDial
+	if dial == nil {
+		dial = (&net.Dialer{}).DialContext
+	}
+	network := "udp"
+	if g.effective.network == 6 {
+		network = "tcp"
+	}
+	raw, err := dial(ctx, network, profileResolverAddress(g.effective))
+	var value *profileDNSConnection
+	if raw != nil {
+		value = &profileDNSConnection{conn: raw}
+	}
+	s.mu.Lock()
+	entry.pending = false
+	s.objectPending--
+	s.pending--
+	if value != nil {
+		entry.value = value
+	}
+	entry.closing = err != nil || value == nil || !s.live()
+	close(entry.ready)
+	s.mu.Unlock()
+	if err == nil && value != nil {
+		actual, e := profileValueFromAddr(raw.RemoteAddr())
+		if e != nil || actual != g.effective || profileEnsureService(ctx, g) != nil {
+			err = errProfile
+		}
+	} else if err == nil {
+		err = errProfile
+	}
+	if err != nil {
+		return nil, nil, errors.Join(err, entry.Close())
+	}
+	s.mu.Lock()
+	publish := !entry.terminal && s.live()
+	s.mu.Unlock()
+	if !publish {
+		return nil, nil, errors.Join(errProfile, entry.Close())
+	}
+	return value, entry, nil
+}
+func profileValueFromAddr(addr net.Addr) (profileDestinationValue, error) {
+	if addr == nil {
+		return profileDestinationValue{}, errProfile
+	}
+	return profileValue(xnet.DestinationFromAddr(addr))
+}
+
+func (p *ProfileRuntime) dnsWire(ctx context.Context, g *profileGrant, request []byte) (response []byte, err error) {
+	if len(request) > 4096 || profileEnsureService(ctx, g) != nil {
+		return nil, errProfile
+	}
+	var parser dnsmessage.Parser
+	if _, e := parser.Start(request); e != nil {
+		return nil, errProfile
+	}
+	question, e := parser.Question()
+	if e != nil || question.Type != dnsmessage.TypeA && question.Type != dnsmessage.TypeAAAA || question.Class != dnsmessage.ClassINET {
+		return nil, errProfile
+	}
+	name := profileCanonicalQuery(question.Name.String())
+	allowed := name == profileCanonicalQuery(g.query)
+	if g.purpose == 2 && p.snapshot != nil {
+		for _, candidate := range p.snapshot.names(g.query) {
+			if name == profileCanonicalQuery(candidate) {
+				allowed = true
+			}
+		}
+	}
+	if !allowed {
+		return nil, errProfile
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stopGrant := context.AfterFunc(g.ctx, cancel)
+	defer stopGrant()
+	stopSession := context.AfterFunc(p.ctx, cancel)
+	defer stopSession()
+	c, entry, err := p.dnsConnection(ctx, g)
+	if err != nil {
+		return nil, err
+	}
+	stopIO := context.AfterFunc(ctx, func() { entry.Close() })
+	defer stopIO()
+	defer func() {
+		if e := entry.Close(); e != nil {
+			response = nil
+			err = errors.Join(err, e)
+		}
+	}()
+	if deadline, ok := ctx.Deadline(); ok {
+		if err = c.conn.SetDeadline(deadline); err != nil {
+			return nil, err
+		}
+	}
+	if profileEnsureService(ctx, g) != nil {
+		return nil, errProfile
+	}
+	packet := request
+	if g.effective.network == 6 {
+		packet = make([]byte, len(request)+2)
+		be.PutUint16(packet, uint16(len(request)))
+		copy(packet[2:], request)
+	}
+	if n, e := c.conn.Write(packet); e != nil || n != len(packet) {
+		if e == nil {
+			e = io.ErrShortWrite
+		}
+		return nil, e
+	}
+	if g.effective.network == 6 {
+		var length [2]byte
+		if _, err = io.ReadFull(c.conn, length[:]); err != nil {
+			return nil, err
+		}
+		n := int(u16(length[:], 0))
+		if n < 12 {
+			return nil, errProfile
+		}
+		response = make([]byte, n)
+		_, err = io.ReadFull(c.conn, response)
+	} else {
+		response = make([]byte, 65535)
+		for {
+			n, e := c.conn.Read(response)
+			err = e
+			if err != nil {
+				break
+			}
+			if profileDNSQuestionMatch(request, response[:n]) {
+				response = response[:n]
+				break
+			}
+			if profileEnsureService(ctx, g) != nil {
+				return nil, errProfile
+			}
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	if profileEnsureService(ctx, g) != nil {
+		return nil, errProfile
+	}
+	return response, nil
+}
