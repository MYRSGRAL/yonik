+func TestProfileDNSV2CanonicalEnvelopes(t *testing.T) {
+	raw := profileDNSV2Golden
+	var e error
+	var corpus struct {
+		Negotiations []struct {
+			Mode                             int
+			LaunchHex, DescriptorHex, AckHex string
+		}
+		Vectors        []dnsV2Vector
+		RejectedFrames []struct {
+			Case                string
+			Patches             []dnsV2Fields
+			Rights, Credentials *int
+		}
+	}
+	if e = json.Unmarshal(raw, &corpus); e != nil {
+		t.Fatal(e)
+	}
+	launches := map[int]profileLaunch{}
+	decode := func(s string) []byte {
+		v, e := hex.DecodeString(s)
+		if e != nil {
+			t.Fatal(e)
+		}
+		return v
+	}
+	for _, v := range corpus.Negotiations {
+		launch, e := decodeProfileLaunch(decode(v.LaunchHex))
+		if e != nil {
+			t.Fatal(e)
+		}
+		launches[v.Mode] = launch
+		descriptor, ack := decode(v.DescriptorHex), decode(v.AckHex)
+		if !profileDNSV2Negotiate(launch, descriptor, ack, 0, 0) {
+			t.Fatal("canonical negotiation denied")
+		}
+		descriptor[208] ^= 1
+		if profileDNSV2Negotiate(launch, descriptor, ack, 0, 0) {
+			t.Fatal("changed schema accepted")
+		}
+	}
+	vectors := map[string]dnsV2Vector{}
+	frames := map[string][]byte{}
+	for vectorIndex, v := range corpus.Vectors {
+		v := v
+		t.Run(v.Name, func(t *testing.T) {
+			body := make([]byte, v.Size)
+			dnsV2Materialize(t, body, v.Fields)
+			if v.Accepted != nil && !*v.Accepted {
+				if profileDNSV2Body(v.Kind, body) {
+					t.Fatal("rejected CODEC3 basis accepted")
+				}
+				return
+			}
+			var frame []byte
+			if v.Kind == 52 {
+				frame = body
+			} else {
+				frame = launches[v.Mode].packet(v.Kind, uint64(100+vectorIndex), 0, body)
+				if v.Direction == "issuer" {
+					be.PutUint64(frame[24:], 9)
+				}
+			}
+			// Exact sequence берётся из frozen fixture, а не из JSON floating-point.
+			if v.FrameHex != "" {
+				expected := decode(v.FrameHex)
+				if v.Kind != 52 {
+					copy(frame[16:24], expected[16:24])
+				}
+				if string(frame) != string(expected) {
+					t.Fatal("frame parity")
+				}
+			}
+			encoded := make([]byte, len(frame))
+			reply := uint64(0)
+			if v.Direction == "issuer" {
+				reply = 9
+			}
+			n, e := profileDNSV2Encode(launches[v.Mode], v.Kind, uint64(100+vectorIndex), reply, body, encoded)
+			if e != nil || n != len(frame) || string(encoded) != string(frame) {
+				t.Fatal("canonical encoder parity", e)
+			}
+			h := sha256.Sum256(frame)
+			if hex.EncodeToString(h[:]) != v.FrameSha256 {
+				t.Fatal("frame hash")
+			}
+			vectors[v.Name] = v
+			frames[v.Name] = frame
+			if !profileDNSV2Envelope(launches[v.Mode], frame, v.Direction == "issuer", v.Rights, v.Credentials, 9) {
+				t.Fatal("canonical frame denied")
+			}
+		})
+	}
+	for i, v := range corpus.RejectedFrames {
+		v := v
+		t.Run(v.Case+"-frame-negative-"+strconv.Itoa(i), func(t *testing.T) {
+			base := vectors[v.Case]
+			frame := append([]byte(nil), frames[v.Case]...)
+			dnsV2Materialize(t, frame, v.Patches)
+			rights, credentials := base.Rights, base.Credentials
+			if v.Rights != nil {
+				rights = *v.Rights
+			}
+			if v.Credentials != nil {
+				credentials = *v.Credentials
+			}
+			if profileDNSV2Envelope(launches[base.Mode], frame, base.Direction == "issuer", rights, credentials, 9) {
+				t.Fatal("invalid frame accepted")
+			}
+		})
+	}
+}
+
+func dnsV2Materialize(t *testing.T, out []byte, fields []dnsV2Fields) {
+	t.Helper()
+	for _, f := range fields {
+		var off int
+		var kind string
+		if e := json.Unmarshal(f[0], &off); e != nil {
+			t.Fatal(e)
+		}
+		if e := json.Unmarshal(f[1], &kind); e != nil {
+			t.Fatal(e)
+		}
+		var b []byte
+		if kind == "hex" {
+			var s string
+			if e := json.Unmarshal(f[2], &s); e != nil {
+				t.Fatal(e)
+			}
+			var e error
+			b, e = hex.DecodeString(s)
+			if e != nil {
+				t.Fatal(e)
+			}
+		} else if kind == "fill" {
+			var p [2]int
+			if e := json.Unmarshal(f[2], &p); e != nil {
+				t.Fatal(e)
+			}
+			b = make([]byte, p[1])
+			for i := range b {
+				b[i] = byte(p[0])
+			}
+		} else {
+			var n uint64
+			if e := json.Unmarshal(f[2], &n); e != nil {
+				t.Fatal(e)
+			}
+			size := map[string]int{"u8": 1, "u16": 2, "u32": 4, "u64": 8}[kind]
+			if size == 0 {
+				t.Fatal(kind)
+			}
+			b = make([]byte, size)
+			for i := size - 1; i >= 0; i-- {
+				b[i] = byte(n)
+				n >>= 8
+			}
+			if n != 0 {
+				t.Fatal("integer overflow")
+			}
+		}
+		if off < 0 || off+len(b) > len(out) {
+			t.Fatal("fixture bounds")
+		}
+		copy(out[off:], b)
+	}
+}
+func TestProfileDNSV2CanonicalBodies(t *testing.T) {
+	raw := profileDNSV2Golden
+	var e error
+	if h := sha256.Sum256(raw); hex.EncodeToString(h[:]) != "fe4ad88a6f519ee00051b7a02192c04e7a795ff869dd3ff3ebc2f6cffebf06a5" {
+		t.Fatal("canonical corpus pin")
+	}
+	var corpus struct {
+		Vectors      []dnsV2Vector
+		SnapshotRows []struct {
+			Flags uint32
+			Hex   string
+		}
+		RejectedBodies []struct {
+			Case            string
+			Patches         []dnsV2Fields
+			AppendZeroBytes int
+		}
+	}
+	if e = json.Unmarshal(raw, &corpus); e != nil {
+		t.Fatal(e)
+	}
+	vectors := make(map[string]dnsV2Vector)
+	bodies := make(map[string][]byte)
+	for _, v := range corpus.Vectors {
+		v := v
+		t.Run(v.Name, func(t *testing.T) {
+			b := make([]byte, v.Size)
+			dnsV2Materialize(t, b, v.Fields)
+			h := sha256.Sum256(b)
+			if hex.EncodeToString(h[:]) != v.BodySha256 {
+				t.Fatal("body bytes/hash mismatch")
+			}
+			if v.BodyHex != "" && hex.EncodeToString(b) != v.BodyHex {
+				t.Fatal("body hex mismatch")
+			}
+			vectors[v.Name] = v
+			bodies[v.Name] = b
+			if v.Accepted != nil && !*v.Accepted {
+				if profileDNSV2Body(v.Kind, b) {
+					t.Fatal("rejected CODEC3 basis accepted")
+				}
+				return
+			}
+			if !profileDNSV2Body(v.Kind, b) {
+				t.Fatal("canonical positive rejected")
+			}
+		})
+	}
+	for i, v := range corpus.RejectedBodies {
+		v := v
+		t.Run(v.Case+"-negative-"+strconv.Itoa(i), func(t *testing.T) {
+			base, ok := vectors[v.Case]
+			if !ok {
+				t.Fatal("missing vector")
+			}
+			b := append([]byte(nil), bodies[v.Case]...)
+			dnsV2Materialize(t, b, v.Patches)
+			b = append(b, make([]byte, v.AppendZeroBytes)...)
+			if profileDNSV2Body(base.Kind, b) {
+				t.Fatal("canonical negative accepted")
+			}
+		})
+	}
+	for _, row := range corpus.SnapshotRows {
+		b, e := hex.DecodeString(row.Hex)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if !profileDNSV2SnapshotRow(b) {
+			t.Fatal("canonical snapshot role rejected", row.Flags)
+		}
+		for _, flags := range []uint32{0, 1, 8, 10} {
+			be.PutUint32(b[72:], flags)
+			if profileDNSV2SnapshotRow(b) {
+				t.Fatal("invalid snapshot role accepted", flags)
+			}
+		}
+	}
+}
