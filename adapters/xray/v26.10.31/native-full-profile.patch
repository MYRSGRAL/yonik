+func (m *profileCapsule) addAsset(a profileAsset) bool {
+	if a.size == 0 || a.size > 64*1024*1024 {
+		return false
+	}
+	var total uint64
+	for i := 0; i < m.assetCount; i++ {
+		old := m.assets[i]
+		if old.digest == a.digest {
+			return old == a
+		}
+		total += old.size
+	}
+	if total+a.size > 64*1024*1024 || m.assetCount == 16 {
+		return false
+	}
+	m.assets[m.assetCount] = a
+	m.assetCount++
+	return true
