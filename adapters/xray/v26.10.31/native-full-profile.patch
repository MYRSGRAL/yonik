+func dnsWireWaiterReply(op *profileOperation) profilePacket {
+	w := op.dnsResult.owner.waiter
+	e := w.bundle.exchange
+	b := make([]byte, 64)
+	be.PutUint16(b, 2)
+	b[2] = 1
+	if op.kind == 35 {
+		for _, v := range []struct {
+			at int
+			n  uint64
+		}{{8, uint64(1000 + e.id)}, {16, e.id}, {24, w.bundle.id}, {40, w.data.epoch}, {48, uint64(op.deadline.Sub(op.sent))}} {
+			be.PutUint64(b[v.at:], v.n)
+		}
+		be.PutUint16(b[58:], 1)
+		b[60] = 3
+		return profilePacket{kind: 36, reply: op.sequence, body: b}
+	}
+	for _, v := range []struct {
+		at int
+		n  uint64
+	}{{8, uint64(2000 + e.id)}, {16, w.data.id}, {24, w.reservation}, {32, e.id}, {40, w.data.epoch}, {48, uint64(op.deadline.Sub(op.sent))}} {
+		be.PutUint64(b[v.at:], v.n)
+	}
+	be.PutUint16(b[56:], uint16(w.data.count))
+	b[58], b[59] = 1, 1
+	return profilePacket{kind: 54, reply: op.sequence, body: b}
+}
