+func (f *flowFixture) installManifest(t *testing.T, rows [11][][]byte) {
+	t.Helper()
+	m := f.c.manifest
+	b := make([]byte, 128)
+	be.PutUint64(b[64:], 1)
+	be.PutUint32(b[72:], m.lease)
+	b[76] = f.c.mode
+	b[77] = f.c.mode - 1
+	be.PutUint16(b[78:], 3)
+	be.PutUint64(b[80:], m.policy)
+	for i, v := range m.caps {
+		be.PutUint32(b[88+i*4:], v)
+	}
+	be.PutUint16(b[120:], 11)
+	for i, table := range rows {
+		var encoded []byte
+		for _, row := range table {
+			prefix := make([]byte, 4)
+			be.PutUint16(prefix, uint16(len(row)))
+			encoded = append(encoded, prefix...)
+			encoded = append(encoded, row...)
+		}
+		p := make([]byte, 8)
+		be.PutUint16(p, uint16(i+1))
+		be.PutUint16(p[2:], uint16(len(table)))
+		be.PutUint32(p[4:], uint32(len(encoded)))
+		b = append(b, p...)
+		b = append(b, encoded...)
+	}
+	r := f.p.admission.launch
+	rehashProfileCapsule(b, &r)
+	next, e := decodeProfileCapsule(b, r)
+	if e != nil {
+		t.Fatal("fake producer manifest", e)
+	}
+	f.c.manifest = next
+	f.p.admission.launch = r
+	f.p.admission.capsule = next
