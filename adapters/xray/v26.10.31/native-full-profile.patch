+	f := &flowFixture{now: time.Now(), sequence: 2}
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	p := &ProfileRuntime{ctx: ctx, cancel: cancel, admission: profileAdmission{launch: r, capsule: m, state: profileAdmitted, deadline: f.now.Add(time.Minute)}, flowQueue: make(chan *profileOperation, 64)}
+	f.p = p
+	live := func() bool { return ctx.Err() == nil && f.now.Before(p.admission.deadline) }
+	f.c = newProfileFlowControl(m, mode, func() time.Time { return f.now }, func(kind uint16, object uint64, b []byte) (uint64, error) {
+		f.sequence++
+		f.writes = append(f.writes, profilePacket{kind: kind, sequence: f.sequence, object: object, body: append([]byte(nil), b...)})
+		return f.sequence, nil
+	}, live)
+	p.flow = f.c
+	p.flowFence = live
+	if mode == 2 {
+		// Остальные control tests моделируют уже проверенный kernel proof.
+		// Actual export/bootstrap/custody проверяются отдельными pure controls.
+		p.proofs = &profileProofChannel{launch: r, fd: &flowProofFD{}, peer: live, send: func([]byte, profileProofFD) error { return nil }}
+		f.c.proofAlive = p.proofs.live
+		p.duplicateAccepted = func(xnet.Conn, [40]byte) (profileProofFD, error) { return &flowProofFD{}, nil }
+		f.c.prepareProof = func(op *profileOperation) error {
