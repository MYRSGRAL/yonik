+	if e := f.c.accept(dnsCancelAck(op.dns.cancelSequence, op.sequence)); e != nil {
+		t.Fatal(e)
+	}
+	f.now = op.deadline
+	if e := f.c.tick(); e != nil {
+		t.Fatal(e)
+	}
+	if !b.released || !op.dns.replied || !op.dns.settled || f.c.dnsCleanupResult() != nil {
+		t.Fatal("known request cleanup did not retire locally")
+	}
+	if e := f.c.accept(dnsBundleReply(op, 99, 1)); e == nil {
+		t.Fatal("KnownClosed tombstone admitted late Allow")
+	}
+	if b.id != 0 || b.rejectedID != 99 || !b.unknown || ProfileDNSBundleGuard(dnsUse(b), "a", target, false) == nil || f.c.dnsCleanupResult() == nil {
+		t.Fatal("late issuer effects lost Unknown custody or gained authority")
+	}
+}
