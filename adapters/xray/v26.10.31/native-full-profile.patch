+func TestYonikDNSOwnedMetadataDoesNotChangeUserOutboundOrDetachCancel(t *testing.T) {
+	parent, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	original := &session.Outbound{Target: xnet.TCPDestination(xnet.ParseAddress("user.invalid"), 443)}
+	parent = session.ContextWithOutbounds(parent, []*session.Outbound{original})
+	child := ownedDNSMetadataContext(parent)
+	got := session.OutboundsFromContext(child)
+	if len(got) != 1 || got[0] == original {
+		t.Fatal("DNS dispatcher shares mutable user outbound")
+	}
+	got[0].Target = xnet.UDPDestination(xnet.ParseAddress("192.0.2.53"), 53)
+	if original.Target.Address.String() != "user.invalid" {
+		t.Fatal("DNS rewrote original native target")
+	}
+	cancel()
+	if child.Err() == nil {
+		t.Fatal("DNS metadata detached cancellation")
+	}
+	many := session.ContextWithOutbounds(context.Background(), make([]*session.Outbound, 257))
+	if ownedDNSMetadataContext(many).Err() == nil {
+		t.Fatal("metadata bound ignored")
+	}
