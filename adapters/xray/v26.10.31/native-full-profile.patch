+package main
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+
+	nativehooks "github.com/xtls/xray-core/common/yonikbroker"
+	"github.com/xtls/xray-core/core"
+)
+
+// Ни core.New, ни feature Start не выполняются: только production caller
+// с in-memory admission/factory boundaries.
+func TestYonikProfileMainNoConstructionBeforeAdmission(t *testing.T) {
+	for _, reason := range []string{"absent", "wrong-peer", "digest", "expired", "assets", "revoked"} {
+		t.Run(reason, func(t *testing.T) {
+			data := []byte("synthetic exact config")
+			constructed := false
+			prepare := func(actual []byte, check bool, _ func(context.Context) error) (*nativehooks.ProfileRuntime, error) {
+				if check || !bytes.Equal(actual, data) {
+					t.Fatal("изменены exact bytes/mode")
+				}
+				return nil, errors.New(reason)
+			}
+			s, p, e := prepareProfileServer(data, prepare, func(context.Context, []byte) (core.Server, error) { constructed = true; return nil, nil })
+			if e == nil || s != nil || p != nil || constructed {
+				t.Fatal("main обошёл admission")
+			}
+		})
+	}
+}
